<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Agency Voucher</title>
  <style>
    body { font-family: Arial, sans-serif; font-size: 13px; }
    .voucher-box { border: 2px solid #000; padding: 10px; }
    .header {
      text-align: center;
      font-weight: bold;
      font-size: 20px;
      margin-bottom: 5px;
    }
    .subheader {
      text-align: center;
      font-size: 11px;
      margin-bottom: 20px;
    }
    .voucher-title {
      text-align: center;
      font-weight: bold;
      font-size: 18px;
      /* text-decoration: underline; */
      margin-bottom: 15px;
    }
    .info-table {
      width: 100%;
      border: 1px solid #000;
      border-collapse: collapse;
      margin-bottom: 15px;
    }
    .info-table td {
      border: 1px solid #000;
      padding: 6px 8px;
      vertical-align: top;
    }
    .info-table .label {
      font-weight: bold;
      width: 35%;
    }
    .bookings-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
      margin-bottom: 15px;
      font-size: 10px;
      table-layout: fixed;
    }
    .bookings-table th,
    .bookings-table td {
      border: 1px solid #000;
      padding: 4px 3px;
      word-wrap: break-word;
      overflow: hidden;
    }
    .bookings-table th {
      background: #f0f0f0;
      font-weight: bold;
      font-size: 9px;
    }
    .bookings-table td {
      font-size: 9px;
    }
    /* Column widths for better fit */
    .bookings-table th:nth-child(1),
    .bookings-table td:nth-child(1) { width: 3%; } /* # */
    .bookings-table th:nth-child(2),
    .bookings-table td:nth-child(2) { width: 14%; } /* Guest */
    .bookings-table th:nth-child(3),
    .bookings-table td:nth-child(3) { width: 5%; } /* Room */
    .bookings-table th:nth-child(4),
    .bookings-table td:nth-child(4) { width: 12%; } /* Reservation Date */
    .bookings-table th:nth-child(5),
    .bookings-table td:nth-child(5) { width: 12%; } /* Check-in */
    .bookings-table th:nth-child(6),
    .bookings-table td:nth-child(6) { width: 12%; } /* Check-out */
    .bookings-table th:nth-child(7),
    .bookings-table td:nth-child(7) { width: 8%; } /* Total */
    .bookings-table th:nth-child(8),
    .bookings-table td:nth-child(8) { width: 8%; } /* Paid */
    .bookings-table th:nth-child(9),
    .bookings-table td:nth-child(9) { width: 8%; } /* Balance */
    .bookings-table th:nth-child(10),
    .bookings-table td:nth-child(10) { width: 8%; } /* Payment Status */
    .text-right { text-align: right !important; }
    .text-center { text-align: center !important; }
    .bookings-table .text-center { text-align: center !important; }
    .bookings-table .text-right { text-align: right !important; }
    .totals-row {
      font-weight: bold;
      background: #d9d9d9;
    }
    .prepared {
      margin-top: 10px;
      font-weight: bold;
    }
    .policy {
      font-size: 11px;
      margin-top: 20px;
    }
    .policy-title {
      font-weight: bold;
      margin-top: 10px;
    }
    .policy ul {
      margin: 0;
      padding-left: 20px;
    }
    .red-box {
      margin-top: 15px;
      background: red;
      color: white;
      font-weight: bold;
      text-align: center;
      padding: 8px;
    }

    .voucher-box img {
      height: 150px;
    }

  </style>
</head>
<body>
  <div class="voucher-box">
 <!-- Wrapper with relative positioning -->
    <div style="position: relative; text-align: center; margin-bottom: 5px;">
        <!-- Logo centered -->
        <img src="<%= imageUrl %>" alt="MSTAY Logo" >
    
        <!-- Voucher number absolutely positioned top-right -->
        <div style="position: absolute; top: 0; right: 0; font-weight: bold; font-size: 13px;">
        VOUCHER NO: <%= voucherNo || 'N/A' %>
        </div>
    </div>
    
    <div class="subheader">
      Clark Terrace Building, Lot 2 Block 1, The Villages Prince Balagtas Avenue, Clark Freeport Zone, Pampanga, 2023<br>
      📞 (GLOBE) 0945 146 7000 | (SMART) 0969 049 7000
    </div>

    <div class="voucher-title">VOUCHER</div>

    <table class="info-table">
      <tr>
        <td class="label">AGENCY:</td>
        <td><%= agencyName || 'N/A' %></td>
      </tr>
      <tr>
        <td class="label">DATE RANGE:</td>
        <td>
          <% 
            const formatDate = (dateStr) => {
              try {
                const d = new Date(dateStr);
                return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
              } catch(e) {
                return dateStr;
              }
            };
          %>
          <%= formatDate(fromDate) %> to <%= formatDate(toDate) %>
        </td>
      </tr>
    </table>

    <table class="bookings-table">
      <thead>
        <tr>
          <th class="text-center">#</th>
          <th>Guest</th>
          <th class="text-center">Room</th>
          <th class="text-center">Reservation Date</th>
          <th class="text-center">Check-in</th>
          <th class="text-center">Check-out</th>
          <th class="text-right">Total</th>
          <th class="text-right">Paid</th>
          <th class="text-right">Balance</th>
          <th class="text-center">Payment Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (Array.isArray(bookings) && bookings.length > 0) { %>
          <% bookings.forEach(function(b, index) { %>
            <tr>
              <td class="text-center"><%= index + 1 %></td>
              <td><%= b.guest || '-' %></td>
              <td class="text-center"><%= b.room || '-' %></td>
              <td class="text-center"><%= b.reservationDate || '-' %></td>
              <td class="text-center"><%= b.checkIn || '-' %></td>
              <td class="text-center"><%= b.checkOut || '-' %></td>
              <td class="text-right"><%= (b.total != null ? parseFloat(b.total).toLocaleString() : '-') %></td>
              <td class="text-right"><%= (b.paid != null ? parseFloat(b.paid).toLocaleString() : '-') %></td>
              <td class="text-right"><%= (b.balance != null ? parseFloat(b.balance).toLocaleString() : '-') %></td>
              <td class="text-center"><%= b.paymentStatus || '-' %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="10" class="text-center">No bookings found for this agency and date range.</td>
          </tr>
        <% } %>
      </tbody>
      </tfoot>
    </table>

    <table style="width: 100%; border-collapse: collapse; margin-top: 15px; font-weight: bold; font-size: 14px;">
        <tr style="background: #d9d9d9; border-top: 2px solid #000; border-bottom: 2px solid #000;">
          <td style="padding: 10px; width: 30%; text-align: left;">
            <strong>TOTAL AMOUNT:</strong><br>
            <span style="font-size: 16px;"><%= (totals && totals.totalAmount != null ? parseFloat(totals.totalAmount).toLocaleString() : '0') %></span>
          </td>
          <td style="padding: 10px; width: 40%; text-align: center;">
            <strong>PAID AMOUNT:</strong><br>
            <span style="font-size: 16px;"><%= (totals && totals.totalPaid != null ? parseFloat(totals.totalPaid).toLocaleString() : '0') %></span>
          </td>
          <td style="padding: 10px; width: 30%; text-align: right;">
            <strong>BALANCE:</strong><br>
            <span style="font-size: 16px;"><%= (totals && totals.totalBalance != null ? parseFloat(totals.totalBalance).toLocaleString() : '0') %></span>
          </td>
        </tr>
        <tr>
          <td colspan="3" style="padding: 8px; text-align: center;">
            PREPARED BY: <%= generatedBy || 'System User' %>
          </td>
        </tr>
      </table>

    <div class="policy">
      <div class="policy-title">Cancellation Refund Policy</div>
      <ul>
        <li>1 night penalty for cancellation 20 days before check-in</li>
        <li>2 nights penalty for cancellation 10 days before check-in</li>
        <li>Full penalty for cancellation 5 days before check-in</li>
      </ul>

      <div class="policy-title">Reservation Policy</div>
      <ul>
        <li>Reservation fee is non-refundable</li>
        <li>Reservation fee is deducted from accommodation balance</li>
        <li>Rescheduling must be done 1 week before arrival</li>
      </ul>

      <div class="policy-title">Security Deposit</div>
      <ul>
        <li>Prepare PHP 2,000 CASH deposit per room upon check-in</li>
        <li>It is refundable upon checkout</li>
      </ul>
    </div>

    <div class="red-box">
      CHECK-IN TIME: 3:00 PM<br>
      CHECK-OUT TIME: 12:00 NN
    </div>
  </div>
</body>
</html>


