<form id="new-agency-form" method="POST">
    <div class="modal fade" id="new-agency-modal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h4 class="modal-title">Add New Agency</h4>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="row">
              <!-- Agency Name -->
              <div class="col-lg-12 p-t-20">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <input class="mdl-textfield__input" type="text" id="agencyName" name="name" required>
                  <label class="mdl-textfield__label">Agency Name <span style="color: red;">*</span></label>
                </div>
              </div>
  
              <!-- Contact Number -->
              <div class="col-lg-12 p-t-20">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <input class="mdl-textfield__input" type="text" id="agencyContactNumber" name="contactNumber">
                  <label class="mdl-textfield__label">Contact Number</label>
                </div>
              </div>
            </div>
          </div>
  
          <!-- Submit Button -->
          <div class="modal-footer">
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>
  </form>

