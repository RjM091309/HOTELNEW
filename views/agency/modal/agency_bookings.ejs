  text-align: center;
}
#agency-bookings-modal .table td:first-child input[type="checkbox"],
#agency-bookings-modal .table th:first-child input[type="checkbox"] {
  width: 12px;
  height: 12px;
  cursor: pointer;
  accent-color: #0d6efd;
  appearance: auto;
  -webkit-appearance: checkbox;
  -moz-appearance: checkbox;
}
#agency-bookings-modal input,
#agency-bookings-modal select,
