  color: #ffffff;
  background: #0c2a42;
}
#agency-bookings-modal .tab-item.is-active {
  background: #0c2a42;
  color: #ffffff;
  border-color: #0c2a42;
}
#agency-bookings-modal .table th:first-child,
#agency-bookings-modal .table td:first-child {
