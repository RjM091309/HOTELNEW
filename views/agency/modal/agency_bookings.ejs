  background: #f8f9fa;
  border-radius: 10px;
  border: 1px solid #e9ecef;
  padding: 10px 12px;
}
#agency-bookings-modal .summary-label {
  font-size: 0.85rem;
  color: #6c757d;
}
#agency-bookings-modal .summary-value {
  font-weight: 700;
  font-size: 1rem;
}
#agency-bookings-modal .divider {
  height: 1px;
  background: #e9ecef;
}
#agency-bookings-modal .pay-option {
  display: flex;
  align-items: center;
  gap: 10px;
  border: 2px solid #e9ecef;
  border-radius: 10px;
  padding: 10px 12px;
  cursor: pointer;
  min-width: 200px;
  position: relative;
  transition: all 0.2s ease;
  background: #fff;
  flex: 1 1 200px;
}
#agency-bookings-modal .pay-option:hover {
  border-color: #0d6efd;
  box-shadow: 0 4px 12px rgba(13,110,253,0.15);
}
#agency-bookings-modal .pay-option .option-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(135deg, #0d6efd, #0b5ed7);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
#agency-bookings-modal .pay-option .option-title {
  font-weight: 600;
  color: #212529;
  font-size: 0.95rem;
}
#agency-bookings-modal .pay-option .option-desc {
  font-size: 0.9rem;
  color: #6c757d;
}
#agency-bookings-modal .pay-option input[type="radio"] {
  opacity: 0;
  position: absolute;
  width: 0;
  height: 0;
  pointer-events: none;
}
#agency-bookings-modal .pay-option .option-radio label {
