        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <header>Integration Management</header>
            </div>
            <div class="dashboard-card-body">
                
                <!-- Integration Table -->
                <div class="table-scrollable">
                    <table id="integrationTable" class="table table-hover table-bordered full-width">
