<!-- ======================================== -->
<!-- SCRIPT LOADING -->
<!-- ======================================== -->



<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Load integration script with proper timing
        setTimeout(function() {
            var integrationScript = document.createElement('script');
            integrationScript.src = '/js/integration/integration-data.js';
            document.body.appendChild(integrationScript);
        }, 300);
    });
</script>
