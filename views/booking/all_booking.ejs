<script>
    window.openRemarksModal = openRemarksModal;
    // Open existing group modal + fetch details
    function openGroupFromAll(groupId){
        // Reuse groupBookingModal from group page if present; if not, create minimal modal
        let modalEl = document.getElementById('groupBookingModal');
        if (!modalEl){
            const tmpl = document.createElement('div');
            tmpl.innerHTML = `
            <div class="modal fade" id="groupBookingModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg"><div class="modal-content">
                    <div class="modal-header"><h5 class="modal-title">Individual Booking Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <table class="table table-bordered"><thead>
                            <tr><th style="width: 120px;">Guest Name</th><th>Room Number</th><th>Check-In Date</th><th>Check-Out Date</th><th style="width: 120px;">Status</th><th>Payment</th><th>Services Availed</th></tr>
                        </thead><tbody></tbody></table>
                        <div class="mt-3">
                            <h6 class="mb-2">Summary</h6>
                            <table class="table table-sm table-striped table-bordered align-middle" id="groupBookingSummary">
                                <thead class="table-dark">
                                    <tr>
                                        <th class="text-start" style="width: 75%">Description</th>
                                        <th class="text-end" style="width: 25%">Amount</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                                <tfoot>
                                    <tr class="table-dark">
                                        <td class="text-start"><b>Grand Total</b></td>
                                        <td id="groupBookingSummaryGrand" class="text-end"><b>0.00</b></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div></div></div>`;
            document.body.appendChild(tmpl.firstElementChild);
            modalEl = document.getElementById('groupBookingModal');
        }

        // Fetch details
        $.get(`/booking/group_booking_details/${groupId}`, function(resp){
            const tbody = modalEl.querySelector('tbody');
            tbody.innerHTML = '';
            (resp.bookingDetails || []).forEach(row => {
                const tr = document.createElement('tr');
                const fmt = (d) => d ? new Date(d).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) : '-';
                tr.innerHTML = `<td>${row.CUSTOMER_NAME ?? '-'}</td>
                                <td>${row.ROOM_NUMBER ?? '-'}</td>
                                <td>${fmt(row.CHECK_IN_DATE)}</td>
                                <td>${fmt(row.CHECK_OUT_DATE)}</td>
                                <td>${row.BOOKING_STATUS ?? '-'}</td>
                                <td>${row.TOTAL_COST != null ? parseFloat(row.TOTAL_COST).toLocaleString('en-US', { minimumFractionDigits: 2 }) : '-'}</td>
                                <td>${row.SERVICES_AVAILED ?? '-'}</td>`;
                tbody.appendChild(tr);
            });

            // Render summary if available
            const summary = resp.summary || null;
            const sumBody = modalEl.querySelector('#groupBookingSummary tbody');
            const sumGrand = modalEl.querySelector('#groupBookingSummaryGrand');
            if (sumBody) {
                sumBody.innerHTML = '';
            }
            if (summary && sumBody && sumGrand){
                const fmtAmt = (n) => parseFloat(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const nRoom = parseFloat(summary.roomTotal || 0);
                const nServices = parseFloat(summary.servicesTotal || 0);
                const nExt = parseFloat(summary.extensionsTotal || 0);
                const nDisc = parseFloat(summary.discount || 0);
                const nRes = parseFloat(summary.reservationFee || 0);
                const nGrand = parseFloat(summary.grandTotal || 0);

                const rows = [];
                rows.push(`<tr><td class="text-start">Rooms Total</td><td class="text-end">${fmtAmt(nRoom)}</td></tr>`);
                if (nServices > 0) rows.push(`<tr><td class="text-start">Services Total</td><td class="text-end">${fmtAmt(nServices)}</td></tr>`);
                if (nExt > 0) rows.push(`<tr><td class="text-start">Extensions Total</td><td class="text-end">${fmtAmt(nExt)}</td></tr>`);
                if (nDisc > 0) rows.push(`<tr><td class="text-start">Less: Discount</td><td class="text-end text-danger">-${fmtAmt(nDisc)}</td></tr>`);
                if (nRes > 0) rows.push(`<tr><td class="text-start">Less: Reservation Fee</td><td class="text-end text-danger">-${fmtAmt(nRes)}</td></tr>`);

                sumBody.innerHTML = rows.join('');
                sumGrand.innerHTML = `<b>${fmtAmt(nGrand)}</b>`;
            }
            const bsModal = new bootstrap.Modal(modalEl);
            bsModal.show();
        }).fail(() => {
            Swal.fire({ icon: 'error', title: 'Failed', text: 'Unable to load group details.' });
        });
    }
</script>

