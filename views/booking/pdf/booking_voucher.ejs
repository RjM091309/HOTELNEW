<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Booking Voucher</title>
  <style>
    body { font-family: Arial, sans-serif; font-size: 13px; }
    .voucher-box { border: 2px solid #000; padding: 20px; }
    .header {
      text-align: center;
      font-weight: bold;
      font-size: 20px;
      margin-bottom: 5px;
    }
    .subheader {
      text-align: center;
      font-size: 11px;
      margin-bottom: 20px;
    }
    .voucher-title {
      text-align: center;
      font-weight: bold;
      font-size: 18px;
      /* text-decoration: underline; */
      margin-bottom: 15px;
    }
    .info-table {
      width: 100%;
      border: 1px solid #000;
      border-collapse: collapse;
      margin-bottom: 15px;
    }
    .info-table td {
      border: 1px solid #000;
      padding: 6px 8px;
      vertical-align: top;
    }
    .info-table .label {
      font-weight: bold;
      width: 35%;
    }
    .remarks-box {
      padding: 8px;
      min-height: 50px;
      /* white-space: pre-line; */
    }
    .total {
      text-align: right;
      font-weight: bold;
      font-size: 16px;
      border-top: 2px solid #000;
      padding-top: 8px;
    }
    .prepared {
      margin-top: 10px;
      font-weight: bold;
    }
    .policy {
      font-size: 11px;
      margin-top: 20px;
    }
    .policy-title {
      font-weight: bold;
      margin-top: 10px;
    }
    .policy ul {
      margin: 0;
      padding-left: 20px;
    }
    .red-box {
      margin-top: 15px;
      background: red;
      color: white;
      font-weight: bold;
      text-align: center;
      padding: 8px;
    }

    .voucher-box img {
      height: 150px;
    }

  </style>
</head>
<body>
  <div class="voucher-box">
 <!-- Wrapper with relative positioning -->
    <div style="position: relative; text-align: center; margin-bottom: 5px;">
        <!-- Logo centered -->
        <img src="<%= imageUrl %>" alt="MSTAY Logo" >
    
        <!-- Voucher number absolutely positioned top-right -->
        <div style="position: absolute; top: 0; right: 0; font-weight: bold; font-size: 13px;">
        VOUCHER NO: <%= voucherNo || 'N/A' %>
        </div>
    </div>
    
    <div class="subheader">
      Clark Terrace Building, Lot 2 Block 1, The Villages Prince Balagtas Avenue, Clark Freeport Zone, Pampanga, 2023<br>
      📞 (GLOBE) 0945 146 7000 | (SMART) 0969 049 7000
    </div>

    <div class="voucher-title">VOUCHER</div>

    <table class="info-table">
      <tr>
        <td class="label">SOURCE / GUEST NAME:</td>
        <td><%= fullname %></td>
      </tr>
      <tr>
        <td class="label">RESERVATION DATE:</td>
        <td><%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></td>
      </tr>
      <tr>
        <td class="label">ARRIVAL DATE:</td>
        <td><%= new Date(dateFrom).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></td>
      </tr>
      <tr>
        <td class="label">DEPARTURE DATE:</td>
        <td><%= new Date(dateTo).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></td>
      </tr>
      <tr>
        <td class="label">NO. PAX:</td>
        <td>-</td>
      </tr>
      <tr>
        <td class="label">LENGTH OF STAY:</td>
        <td>
          <% 
            try {
              const from = new Date(dateFrom);
              const to = new Date(dateTo);
              const diffDays = Math.ceil((to - from) / (1000 * 60 * 60 * 24));
              const nights = diffDays || 1;
          %>
          <%= nights %> NIGHT<%= nights > 1 ? 'S' : '' %>
          <% } catch(e) { %>1 NIGHT<% } %>
        </td>
      </tr>
      <tr>
        <td class="label">ROOM TYPE:</td>
        <td><%= roomNumber %> - (<%= roomType %>)</td>
      </tr>
      <tr>
        <td class="label">REMARKS:</td>
        <td class="remarks-box">
          <% 
            const lines = [];
      
            if (remarks && remarks.trim()) lines.push(remarks.trim());
            lines.push('Room Accomodation');
      
            const paxTotal = (parseInt(breakfastAdult || 0) || 0) + (parseInt(breakfastKid || 0) || 0);
            if (paxTotal > 0) lines.push(`${paxTotal} Pax Breakfast Included`);
      
            if (pickup && parseFloat(pickup) > 0) lines.push('With Pick-Up');
            if (dropoff && parseFloat(dropoff) > 0) lines.push('With Drop-off');

          %>
          <%- lines.join('<br>') %>
        </td>
      </tr>
      
      <% if (reservationFee && parseFloat(reservationFee) > 0) { %>
      <tr>
        <td class="label">RESERVATION FEE:</td>
        <td>PHP <%= parseFloat(reservationFee).toLocaleString() %></td>
      </tr>
      <% } %>
      
      <% if (discount && parseFloat(discount) > 0) { %>
      <tr>
        <td class="label">DISCOUNT:</td>
        <td>PHP <%= parseFloat(discount).toLocaleString() %></td>
      </tr>
      <% } %>
      
      <% if (checkOutStatus == 1) { %>
      <tr>
        <td class="label">CHECK-OUT STATUS:</td>
        <td>Late Check-Out</td>
      </tr>
          <% if (lateCheckoutFee && parseFloat(lateCheckoutFee) > 0) { %>
      <tr>
        <td class="label">LATE CHECK-OUT FEE:</td>
        <td>PHP <%= parseFloat(lateCheckoutFee).toLocaleString() %></td>
      </tr>
          <% } %>
      <% } %>
      
    </table>

    <%
    // Safely get values with multiple fallbacks
    let cleanTotal = 0;
    let cleanPaid = 0;
    let cleanBalance = 0;
    
    // Get total
    if (typeof total !== 'undefined' && total !== null && total !== '') {
        cleanTotal = parseFloat(total.toString().replace(/,/g, '')) || 0;
    }
    
    // Get paid amount
    if (typeof paidAmount !== 'undefined' && paidAmount !== null && paidAmount !== '') {
        cleanPaid = parseFloat(paidAmount.toString().replace(/,/g, '')) || 0;
    }
    
    // Get or compute balance
    if (typeof balance !== 'undefined' && balance !== null && balance !== '') {
        cleanBalance = parseFloat(balance.toString().replace(/,/g, '')) || 0;
    } else {
        // Compute balance from total and paid
        cleanBalance = Math.max(0, cleanTotal - cleanPaid);
    }
    %>
    <table style="width: 100%; border-collapse: collapse; margin-top: 15px; font-weight: bold; font-size: 14px;">
        <tr style="background: #d9d9d9; border-top: 2px solid #000; border-bottom: 2px solid #000;">
          <td style="padding: 10px; width: 30%; text-align: left;">
            <strong>TOTAL AMOUNT:</strong><br>
            <span style="font-size: 16px;">PHP <%= cleanTotal.toLocaleString() %></span>
          </td>
          <td style="padding: 10px; width: 40%; text-align: center;">
            <strong>PAID AMOUNT:</strong><br>
            <span style="font-size: 16px;">PHP <%= cleanPaid.toLocaleString() %></span>
          </td>
          <td style="padding: 10px; width: 30%; text-align: right;">
            <strong>BALANCE:</strong><br>
            <span style="font-size: 16px;">PHP <%= cleanBalance.toLocaleString() %></span>
          </td>
        </tr>
        <tr>
          <td colspan="3" style="padding: 8px; text-align: center;">
            PREPARED BY: <%= encodedBy %>
          </td>
        </tr>
      </table>

    <div class="policy">
      <div class="policy-title">Cancellation Refund Policy</div>
      <ul>
        <li>1 night penalty for cancellation 20 days before check-in</li>
        <li>2 nights penalty for cancellation 10 days before check-in</li>
        <li>Full penalty for cancellation 5 days before check-in</li>
      </ul>

      <div class="policy-title">Reservation Policy</div>
      <ul>
        <li>Reservation fee is non-refundable</li>
        <li>Reservation fee is deducted from accommodation balance</li>
        <li>Rescheduling must be done 1 week before arrival</li>
      </ul>

      <div class="policy-title">Security Deposit</div>
      <ul>
        <li>Prepare PHP 2,000 CASH deposit per room upon check-in</li>
        <li>It is refundable upon checkout</li>
      </ul>
    </div>

    <div class="red-box">
      CHECK-IN TIME: 3:00 PM<br>
      CHECK-OUT TIME: 12:00 NN
    </div>
  </div>
</body>
</html>
