<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Invoice</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 10px 20px;
    }

    .header {
      text-align: center;
      margin-bottom: 20px;
      margin-top: 0;
    }

    .header img {
      height: 100px;
      width: auto;
      object-fit: contain;
      image-rendering: -webkit-optimize-contrast;
    }

    .invoice-title {
      font-size: 28px;
      font-weight: bold;
      
    }

    .sub-header {
      text-align: center;
      font-size: 14px;
    }

    .info-table, .remarks-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      font-size: 14px;
    }

    .info-table th, .info-table td {
      border: 1px solid #f3c200;
      padding: 10px;
      text-align: center;
    }

    .info-table td:nth-child(1),
    .info-table td:nth-child(2),
    .info-table th:nth-child(1),
    .info-table th:nth-child(2) {
      word-wrap: break-word;
      word-break: break-word;
      white-space: normal;
      max-width: 150px;
      vertical-align: middle;
    }

    .totals {
  margin-top: 20px;
  font-size: 14px;
  margin-left: auto;          /* push to right side */
  width: fit-content;         /* only occupy needed space */
  text-align: left;           /* left-align the content inside */
}

.totals .label {
  font-weight: bold;
  margin: 0;
}

.totals .sub {
  font-weight: normal;
  margin: 0 0 2px 20px;
  font-size: 12px;
}

    .totals p {
  margin: 2px 0;
}

    .remarks-title {
      font-weight: bold;
      font-size: 14px;
      background: #e3e8ed;
      padding: 10px;
      margin-top: 30px;
    }

    .bank-details {
      margin-top: 30px;
      font-size: 13px;
    }

    .issued-by {
      font-weight: bold;
      margin-top: 10px;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .text-center {
      text-align: center;
    }

    .text-right {
      text-align: right;
    }
  </style>
</head>
<body>

  <div class="header">
    <img src="<%= imageUrl %>" alt="logo" class="logo-default" />

    <div class="invoice-title">INVOICE</div>
    <div class="sub-header">
      <div>Clark Terrace Building, Lot 2 Block 1, The Villages Prince Balagtas Avenue,</div>
      <div>Clark Freeport Zone, Pampanga, 2023</div>
      <div>(GLOBE) 0945 146 7000 (SMART) 0969 049 7000</div>
    </div>
  </div>

  <% 
    const formatCurrency = (value) => Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const bookingStatus = ((BOOKING_STATUS || '').toString().toLowerCase());
    const isCancelled = bookingStatus === 'cancelled';
    const cancellationFee = Number(CANCELLATION_FEE || 0);
    const refundAmount = Number(REFUND_AMOUNT || 0);
    const reservationFeeValue = Number(RESERVATION_FEE || 0);
    const discountValue = Number(DISCOUNT || 0);
    const roomTotalValue = Number(ROOM_TOTAL || 0);
    const servicesTotalValue = Number(SERVICES_TOTAL || 0);
    const tableTotalValue = roomTotalValue + servicesTotalValue;
    const totalPaidBeforeValue = Number(TOTAL_PAID_BEFORE || TOTAL_PAID || 0);
    const totalPaidValue = totalPaidBeforeValue;
    const paidAfterCancellationValue = isCancelled ? Number(PAID_AFTER_CANCELLATION || 0) : totalPaidBeforeValue;
    const roomPaidValue = Number(ROOM_PAID || 0);
    const extendedPaidValue = Number(EXTENDED_PAID || 0);
    const servicesPaidValue = Number(SERVICES_PAID || 0);
    const displayRoomTotal = isCancelled ? 0 : roomTotalValue;
    const displayServicesTotal = isCancelled ? 0 : servicesTotalValue;
    const totalChargesValue = isCancelled ? cancellationFee : Number(GRAND_TOTAL || 0);
    const totalDueValue = isCancelled ? 0 : Math.max(0, totalChargesValue - totalPaidBeforeValue);

    const paymentTypeLabels = {
      room: 'Room Payment',
      extended: 'Extension',
      service: 'Service',
      pickdrop: 'Pick-up/Drop-off',
      reservation_fee: 'Reservation Fee',
      refund: 'Refund',
      cancellation_fee: 'Cancellation Fee'
    };
    const paymentMethodLabels = {
      cash: 'Cash',
      credit_card: 'Credit Card',
      credit: 'Credit',
      marker: 'Credit',
      check: 'Check',
      bank_transfer: 'Bank Transfer'
    };
    const formatPaymentTypeLabel = (type) => paymentTypeLabels[(type || '').toLowerCase()] || type || '-';
    const formatPaymentMethodLabel = (method) => paymentMethodLabels[(method || '').toLowerCase()] || method || '-';
    const formatPaymentDate = (value) => {
      if (!value) return '-';
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '-';
      return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    };
  %>

  <div style="display: flex; justify-content: space-between; margin-top: 10px;">
    <div><b>Date:</b> <%= DATE_ISSUED %></div>
    <div><b>Invoice #:</b> <%= CONFIRMATION_NUMBER %></div>
  </div>

  <div style="margin-top: 10px;">
    <b>Billed to:</b> <%= DISPLAY_NAME %>
  </div>

  <table class="info-table">
    <thead>
      <tr>
        <th>DATE</th>
        <th>GUEST NAME</th>
        <th>DESCRIPTION</th>
        <th>QTY</th>
        <th>AMOUNT</th>
      </tr>
    </thead>
    <tbody>
      <% 
        const totalRows = 1 + (isCancelled ? 0 : (SERVICES_LIST && SERVICES_LIST.length > 0 ? SERVICES_LIST.length : 0));
        const rowspanValue = totalRows;
      %>
      <tr>
        <td rowspan="<%= rowspanValue %>"><%= CHECKIN_DATE %> TO <%= CHECKOUT_DATE %></td>
        <td rowspan="<%= rowspanValue %>"><%= CUSTOMER_NAME %></td>
        <td>ROOM CHARGE</td>
        <td><%= TOTAL_NIGHTS %> NIGHTS</td>
        <td><%= formatCurrency(displayRoomTotal) %></td>
      </tr>
      <% if (!isCancelled && SERVICES_LIST && SERVICES_LIST.length > 0) { %>
        <% SERVICES_LIST.forEach((service) => { %>
          <% 
            const serviceName = (service.SERVICE_NAME || '').toLowerCase();
            const isSpecialService = serviceName === 'upgrade' || serviceName === 'pick-up' || serviceName === 'drop-off';
            const qtyDisplay = isSpecialService ? '-' : (service.QTY || 1);
          %>
          <tr>
            <td><%= service.SERVICE_NAME %></td>
            <td><%= qtyDisplay %></td>
            <td><%= formatCurrency(service.TOTAL_COST || 0) %></td>
          </tr>
        <% }); %>
      <% } %>
    </tbody>
  </table>

  <div class="totals">
    <p class="label"><b>CHARGE SUMMARY:</b></p>
    <% const roomLabel = (!isCancelled && EXTENDED_DAYS > 0) ? 'ROOM & EXTENSION' : 'ROOM'; %>
    <p class="sub"><%= roomLabel %>: <%= formatCurrency(displayRoomTotal) %></p>
    <p class="sub">SERVICES: <%= formatCurrency(displayServicesTotal) %></p>
    
    <% if (!isCancelled && reservationFeeValue > 0) { %>
      <p class="sub"  style="color: #28a745;">RESERVATION FEE: -<%= formatCurrency(reservationFeeValue) %></p>
    <% } %>
    
    <% if (discountValue > 0) { %>
      <p class="sub" style="color: #28a745;">DISCOUNT: -<%= formatCurrency(discountValue) %></p>
    <% } %>

    <% if (isCancelled) { %>
      <p class="sub" style="color: #d35400;">CANCELLATION FEE: <%= formatCurrency(cancellationFee) %></p>
    <% } %>
    
    <p class="label"><b>TOTAL CHARGES:</b> <%= formatCurrency(totalChargesValue) %></p>
  </div>
  
  
  
  

  <div class="remarks-title">REMARKS</div>
  <table class="remarks-table">
  
    <div class="totals">
      
      <!-- <hr style="margin: 5px 0;"> -->
      <p class="label"><b>TAX:</b> 0</p>

      <% if (PAYMENTS_LIST && PAYMENTS_LIST.length > 0) { %>
        <p class="label"><b>PAYMENT DETAILS:</b></p>
        <table class="info-table" style="margin-top: 8px; margin-bottom: 12px; font-size: 12px;">
          <thead>
            <tr>
              <th>Date</th>
              <th>Description</th>
              <th>Method</th>
              <th>Amount</th>
              <th>Received By</th>
            </tr>
          </thead>
          <tbody>
            <% PAYMENTS_LIST.forEach((payment) => {
              const amount = Number(payment.AMOUNT_PAID || 0);
              const isRefund = payment.PAYMENT_TYPE === 'refund' || amount < 0;
              const typeLabel = formatPaymentTypeLabel(payment.PAYMENT_TYPE);
              const remarks = (payment.REMARKS || '').trim();
              const description = remarks ? `${typeLabel} — ${remarks}` : typeLabel;
              const amountDisplay = isRefund
                ? `-${formatCurrency(Math.abs(amount))}`
                : formatCurrency(amount);
            %>
              <tr>
                <td><%= formatPaymentDate(payment.PAYMENT_DATE) %></td>
                <td><%= description %></td>
                <td><%= formatPaymentMethodLabel(payment.PAYMENT_METHOD) %></td>
                <td><%= amountDisplay %></td>
                <td><%= payment.RECEIVED_BY || '-' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <p class="label"><b>TOTAL PAID:</b> <%= formatCurrency(totalPaidBeforeValue) %></p>
      <% } else { %>
        <p class="label"><b>PAYMENT:</b> <%= formatCurrency(totalPaidBeforeValue) %></p>
      <% } %>
      
      <% if (isCancelled) { %>
        <% if (!(PAYMENTS_LIST && PAYMENTS_LIST.length > 0)) { %>
          <p class="sub">TOTAL PAID (BEFORE CANCELLATION): <%= formatCurrency(totalPaidBeforeValue) %></p>
        <% } %>
        <p class="sub">PAID AMOUNT (AFTER CANCELLATION): <%= formatCurrency(paidAfterCancellationValue) %></p>
        <% if (refundAmount > 0) { %>
          <p class="sub">REFUND AMOUNT: <%= formatCurrency(refundAmount) %></p>
        <% } %>
      <% } else if (!(PAYMENTS_LIST && PAYMENTS_LIST.length > 0)) { %>
        <p class="sub">ROOM PAID: <%= formatCurrency(roomPaidValue) %></p>
        <% if (EXTENDED_DAYS > 0) { %>
          <p class="sub">EXTENSION PAID: <%= formatCurrency(extendedPaidValue) %></p>
        <% } %>
        <p class="sub">SERVICES PAID: <%= formatCurrency(servicesPaidValue) %></p>
        
        <% if (reservationFeeValue > 0) { %>
          <p class="sub" style="color: #28a745;">RESERVATION FEE PAID: -<%= formatCurrency(reservationFeeValue) %></p>
        <% } %>
        
        <% if (discountValue > 0) { %>
          <p class="sub" style="color: #28a745;">DISCOUNT APPLIED: -<%= formatCurrency(discountValue) %></p>
        <% } %>
      <% } %>
      
      <p class="label"><b class="red">TOTAL DUE:</b><span class="red"> <%= formatCurrency(totalDueValue) %></span></p>
    </div>
  </table>
  

  <div style="display: flex; justify-content: space-between; margin-top: 30px; font-size: 13px;">
    <div style="line-height: 1.5;">
      <b>MAIN STAY HOTEL BANK ACCOUNT</b><br>
      BANK DETAILS: BDO<br>
      BANK NAME: MAIN STAY HOTEL<br>
      ACCOUNT NUMBER: 005738009996
    </div>
    <div style="text-align: right; font-weight: bold; align-self: flex-start;">
      ISSUED BY: <%= ISSUED_BY %>
    </div>
  </div>
  

</body>
</html>
