<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Invoice</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 20px;
    }

    .header {
      text-align: center;
      margin-bottom: 20px;
    }

    .header img {
      height: 150px;
    }

    .invoice-title {
      font-size: 28px;
      font-weight: bold;
      margin: 15px 0;
    }

    .sub-header {
      text-align: center;
      font-size: 14px;
    }

    .info-table, .remarks-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      font-size: 14px;
    }

    .info-table th, .info-table td {
      border: 1px solid #f3c200;
      padding: 10px;
      text-align: center;
    }

    .totals {
  margin-top: 20px;
  font-size: 14px;
  margin-left: auto;          /* push to right side */
  width: fit-content;         /* only occupy needed space */
  text-align: left;           /* left-align the content inside */
}

.totals .label {
  font-weight: bold;
  margin: 0;
}

.totals .sub {
  font-weight: normal;
  margin: 0 0 2px 20px;
  font-size: 12px;
}

    .totals p {
  margin: 2px 0;
}

    .remarks-title {
      font-weight: bold;
      font-size: 14px;
      background: #e3e8ed;
      padding: 10px;
      margin-top: 30px;
    }

    .bank-details {
      margin-top: 30px;
      font-size: 13px;
    }

    .issued-by {
      font-weight: bold;
      margin-top: 10px;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .text-center {
      text-align: center;
    }

    .text-right {
      text-align: right;
    }
  </style>
</head>
<body>

  <div class="header">
    <img src="<%= imageUrl %>" alt="logo" class="logo-default" />

    <div class="invoice-title">INVOICE</div>
    <div class="sub-header">
      <div>Clark Terrace Building, Lot 2 Block 1, The Villages Prince Balagtas Avenue,</div>
      <div>Clark Freeport Zone, Pampanga, 2023</div>
      <div>(GLOBE) 0945 146 7000 (SMART) 0969 049 7000</div>
    </div>
  </div>

  <% 
    const formatCurrency = (value) => Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const bookingStatus = ((BOOKING_STATUS || '').toString().toLowerCase());
    const isCancelled = bookingStatus === 'cancelled';
    const cancellationFee = Number(CANCELLATION_FEE || 0);
    const refundAmount = Number(REFUND_AMOUNT || 0);
    const reservationFeeValue = Number(RESERVATION_FEE || 0);
    const discountValue = Number(DISCOUNT || 0);
    const roomTotalValue = Number(ROOM_TOTAL || 0);
    const servicesTotalValue = Number(SERVICES_TOTAL || 0);
    const tableTotalValue = roomTotalValue + servicesTotalValue;
    const totalPaidBeforeValue = Number(TOTAL_PAID_BEFORE || TOTAL_PAID || 0);
    const totalPaidValue = totalPaidBeforeValue;
    const paidAfterCancellationValue = isCancelled ? Number(PAID_AFTER_CANCELLATION || 0) : totalPaidBeforeValue;
    const roomPaidValue = Number(ROOM_PAID || 0);
    const extendedPaidValue = Number(EXTENDED_PAID || 0);
    const servicesPaidValue = Number(SERVICES_PAID || 0);
    const displayRoomTotal = isCancelled ? 0 : roomTotalValue;
    const displayServicesTotal = isCancelled ? 0 : servicesTotalValue;
    const totalChargesValue = isCancelled ? cancellationFee : Number(GRAND_TOTAL || 0);
    const totalDueValue = isCancelled ? 0 : Math.max(0, totalChargesValue - totalPaidBeforeValue);
  %>

  <div style="display: flex; justify-content: space-between; margin-top: 10px;">
    <div><b>Date:</b> <%= DATE_ISSUED %></div>
    <div><b>Invoice #:</b> <%= INVOICE_NO %></div>
  </div>

  <div style="margin-top: 10px;">
    <b>Billed to:</b> <%= DISPLAY_NAME %>
  </div>

  <table class="info-table">
    <thead>
      <tr>
        <th>DATE</th>
        <th>GUEST NAME</th>
        <th>DESCRIPTION</th>
        <th>NO OF ROOMS</th>
        <th>NO. OF NIGHTS</th>
        <th>TOTAL</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><%= CHECKIN_DATE %> TO <%= CHECKOUT_DATE %></td>
        <td><%= CUSTOMER_NAME %></td>
        <td>ROOM ACCOMMODATION</td>
        <td><%= ROOM_COUNT %> ROOMS (<%= ROOM_TYPE %>)</td>
        <td><%= TOTAL_NIGHTS %> NIGHTS</td>
        <td>PHP <%= formatCurrency(tableTotalValue) %></td>
      </tr>
    </tbody>
  </table>

  <div class="totals">
    <p class="label"><b>CHARGE SUMMARY:</b></p>
    <% const roomLabel = (!isCancelled && EXTENDED_DAYS > 0) ? 'ROOM & EXTENSION' : 'ROOM'; %>
    <p class="sub"><%= roomLabel %>: PHP <%= formatCurrency(displayRoomTotal) %></p>
    <p class="sub">SERVICES: PHP <%= formatCurrency(displayServicesTotal) %></p>
    
    <% if (!isCancelled && reservationFeeValue > 0) { %>
      <p class="sub"  style="color: #28a745;">RESERVATION FEE: -PHP <%= formatCurrency(reservationFeeValue) %></p>
    <% } %>
    
    <% if (discountValue > 0) { %>
      <p class="sub" style="color: #28a745;">DISCOUNT: -PHP <%= formatCurrency(discountValue) %></p>
    <% } %>

    <% if (isCancelled) { %>
      <p class="sub" style="color: #d35400;">CANCELLATION FEE: PHP <%= formatCurrency(cancellationFee) %></p>
    <% } %>
    
    <p class="label"><b>TOTAL CHARGES:</b> PHP <%= formatCurrency(totalChargesValue) %></p>
  </div>
  
  
  
  

  <div class="remarks-title">REMARKS</div>
  <table class="remarks-table">
  
    <div class="totals">
      
      <!-- <hr style="margin: 5px 0;"> -->
      <p class="label"><b>TAX:</b> PHP 0</p>
      <p class="label"><b>PAYMENT:</b> PHP <%= formatCurrency(totalPaidBeforeValue) %></p>
      
      <% if (isCancelled) { %>
        <p class="sub">TOTAL PAID (BEFORE CANCELLATION): PHP <%= formatCurrency(totalPaidBeforeValue) %></p>
        <p class="sub">PAID AMOUNT (AFTER CANCELLATION): PHP <%= formatCurrency(paidAfterCancellationValue) %></p>
        <% if (refundAmount > 0) { %>
          <p class="sub">REFUND AMOUNT: PHP <%= formatCurrency(refundAmount) %></p>
        <% } %>
      <% } else { %>
        <p class="sub">ROOM PAID: PHP <%= formatCurrency(roomPaidValue) %></p>
        <% if (EXTENDED_DAYS > 0) { %>
          <p class="sub">EXTENSION PAID: PHP <%= formatCurrency(extendedPaidValue) %></p>
        <% } %>
        <p class="sub">SERVICES PAID: PHP <%= formatCurrency(servicesPaidValue) %></p>
        
        <% if (reservationFeeValue > 0) { %>
          <p class="sub" style="color: #28a745;">RESERVATION FEE PAID: -PHP <%= formatCurrency(reservationFeeValue) %></p>
        <% } %>
        
        <% if (discountValue > 0) { %>
          <p class="sub" style="color: #28a745;">DISCOUNT APPLIED: -PHP <%= formatCurrency(discountValue) %></p>
        <% } %>
      <% } %>
      
      <p class="label"><b class="red">TOTAL DUE:</b><span class="red"> PHP <%= formatCurrency(totalDueValue) %></span></p>
    </div>
  </table>
  

  <div style="display: flex; justify-content: space-between; margin-top: 30px; font-size: 13px;">
    <div style="line-height: 1.5;">
      <b>M STAY HOTEL BANK ACCOUNT</b><br>
      BANK DETAILS: BDO<br>
      BANK NAME: M STAY HOTEL CORP.<br>
      ACCOUNT NUMBER: 005738009996
    </div>
    <div style="text-align: right; font-weight: bold; align-self: flex-start;">
      ISSUED BY: <%= ISSUED_BY %>
    </div>
  </div>
  

</body>
</html>
