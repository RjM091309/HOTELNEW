<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Group Booking Voucher</title>
  <style>
    body { font-family: Arial, sans-serif; font-size: 13px; }
    .voucher-box { border: 2px solid #000; padding: 20px; }
    .header {
      text-align: center;
      font-weight: bold;
      font-size: 20px;
      margin-bottom: 5px;
    }
    .subheader {
      text-align: center;
      font-size: 11px;
      margin-bottom: 20px;
    }
    .voucher-title {
      text-align: center;
      font-weight: bold;
      font-size: 18px;
      margin-bottom: 15px;
    }
    .info-table {
      width: 100%;
      border: 1px solid #000;
      border-collapse: collapse;
      margin-bottom: 15px;
    }
    .info-table td {
      border: 1px solid #000;
      padding: 6px 8px;
      vertical-align: top;
    }
    .info-table .label {
      font-weight: bold;
      width: 35%;
    }
    .remarks-box {
      padding: 8px;
      min-height: 50px;
    }
    .total {
      text-align: right;
      font-weight: bold;
      font-size: 16px;
      border-top: 2px solid #000;
      padding-top: 8px;
    }
    .prepared {
      margin-top: 10px;
      font-weight: bold;
    }
    .policy {
      font-size: 11px;
      margin-top: 20px;
    }
    .policy-title {
      font-weight: bold;
      margin-top: 10px;
    }
    .policy ul {
      margin: 0;
      padding-left: 20px;
    }
    .red-box {
      margin-top: 15px;
      background: red;
      color: white;
      font-weight: bold;
      text-align: center;
      padding: 8px;
    }
    .voucher-box img {
      height: 150px;
    }
  </style>
</head>
<body>
  <div class="voucher-box">
    <div style="position: relative; text-align: center; margin-bottom: 5px;">
        <% if (typeof imageUrl !== 'undefined' && imageUrl) { %>
        <img src="<%= imageUrl %>" alt="MSTAY Logo" >
        <% } %>
        <div style="position: absolute; top: 0; right: 0; font-weight: bold; font-size: 13px;">
        VOUCHER NO: <%= voucherNo || 'N/A' %>
        </div>
    </div>
    <div class="subheader">
      Clark Terrace Building, Lot 2 Block 1, The Villages Prince Balagtas Avenue, Clark Freeport Zone, Pampanga, 2023<br>
      📞 (GLOBE) 0945 146 7000 | (SMART) 0969 049 7000
    </div>
    <div class="voucher-title">GROUP VOUCHER</div>
    <table class="info-table">
      <tr>
        <td class="label">GROUP NAME:</td>
        <td><%= groupName %></td>
      </tr>
      <tr>
        <td class="label">GROUP CONTACT:</td>
        <td><%= groupContact %></td>
      </tr>
      <tr>
        <td class="label">RESERVATION DATE:</td>
        <td><%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></td>
      </tr>
      <tr>
        <td class="label">ARRIVAL DATE:</td>
        <td><%= new Date(dateFrom).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></td>
      </tr>
      <tr>
        <td class="label">DEPARTURE DATE:</td>
        <td><%= new Date(dateTo).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></td>
      </tr>
      <tr>
        <td class="label">ROOMS:</td>
        <td><%= roomSummary %></td>
      </tr>
      <tr>
        <td class="label">REMARKS:</td>
        <td class="remarks-box">
          <% 
            const lines = [];
            if (remarks && remarks.trim()) {
              lines.push(remarks.trim());
            }
            
            // Only add default "Room Accommodation" if remarks is empty or doesn't already contain accommodation text
            const remarksLower = (remarks || '').toLowerCase();
            const hasAccommodationText = remarksLower.includes('room accommodation') || 
                                         remarksLower.includes('room accomodation') ||
                                         remarksLower.includes('accommodation') ||
                                         remarksLower.includes('accomodation');
            
            if (!hasAccommodationText) {
              lines.push('Room Accommodation');
            }
            
            const paxTotal = (parseInt(breakfastAdult || 0) || 0) + (parseInt(breakfastKid || 0) || 0);
            if (paxTotal > 0) lines.push(`${paxTotal} Pax Breakfast Included`);
            if (pickup && parseFloat(pickup) > 0) lines.push('With Pick-Up');
            if (dropoff && parseFloat(dropoff) > 0) lines.push('With Drop-off');
          %>
          <%- lines.join('<br>') %>
        </td>
      </tr>
      
      <% if (typeof reservationFee !== 'undefined' && reservationFee && parseFloat(reservationFee) > 0) { %>
      <tr>
        <td class="label">RESERVATION FEE:</td>
        <td>PHP <%= parseFloat(reservationFee).toLocaleString() %></td>
      </tr>
      <% } %>
      
      <% if (checkOutStatus == 1) { %>
      <tr>
        <td class="label">CHECK-OUT STATUS:</td>
        <td>Late Check-Out</td>
      </tr>
      <% } %>
      
    </table>

    <%
    // Safely get values with multiple fallbacks
    let cleanTotal = 0;
    let cleanPaid = 0;
    let cleanBalance = 0;
    let cleanRoomCharges = 0;
    let cleanServices = 0;
    let cleanDiscount = 0;
    let cleanLateCheckoutFee = 0;
    
    // Get total
    if (typeof total !== 'undefined' && total !== null && total !== '') {
        cleanTotal = parseFloat(total.toString().replace(/,/g, '')) || 0;
    }
    
    // Get paid amount
    if (typeof paidAmount !== 'undefined' && paidAmount !== null && paidAmount !== '') {
        cleanPaid = parseFloat(paidAmount.toString().replace(/,/g, '')) || 0;
    }
    
    // Get or compute balance
    if (typeof balance !== 'undefined' && balance !== null && balance !== '') {
        cleanBalance = parseFloat(balance.toString().replace(/,/g, '')) || 0;
    } else {
        // Compute balance from total and paid
        cleanBalance = Math.max(0, cleanTotal - cleanPaid);
    }
    
    // Get room charges (if provided)
    if (typeof roomCharges !== 'undefined' && roomCharges !== null && roomCharges !== '') {
        const roomChargesStr = roomCharges.toString().trim().replace(/[,\s₱₹$]/g, '').replace(/[^\d.]/g, '');
        cleanRoomCharges = parseFloat(roomChargesStr) || 0;
    }
    
    // Get services total (if provided)
    if (typeof servicesTotal !== 'undefined' && servicesTotal !== null && servicesTotal !== '') {
        const servicesStr = servicesTotal.toString().trim().replace(/,/g, '').replace(/[^\d.]/g, '');
        cleanServices = parseFloat(servicesStr) || 0;
    }
    
    // Get discount (if provided)
    if (typeof discount !== 'undefined' && discount !== null && discount !== '') {
        const discountStr = discount.toString().trim().replace(/[,\s₱₹$]/g, '').replace(/[^\d.]/g, '');
        cleanDiscount = parseFloat(discountStr) || 0;
    }
    
    // Get late checkout fee (if provided)
    if (typeof lateCheckoutFee !== 'undefined' && lateCheckoutFee !== null && lateCheckoutFee !== '') {
        const lateCheckoutStr = lateCheckoutFee.toString().trim().replace(/[,\s₱₹$]/g, '').replace(/[^\d.]/g, '');
        cleanLateCheckoutFee = parseFloat(lateCheckoutStr) || 0;
    }
    %>
    
    <!-- Charges Breakdown -->
    <table style="width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 10px;">
      <tr>
        <td style="padding: 8px; border: 1px solid #000; font-weight: bold; width: 50%;">Total Room Charges:</td>
        <td style="padding: 8px; border: 1px solid #000; text-align: right; width: 50%;">PHP <%= cleanRoomCharges.toLocaleString() %></td>
      </tr>
      <tr>
        <td style="padding: 8px; border: 1px solid #000; font-weight: bold; width: 50%;">Total Services:</td>
        <td style="padding: 8px; border: 1px solid #000; text-align: right; width: 50%;">PHP <%= cleanServices.toLocaleString() %></td>
      </tr>
      <% if (cleanLateCheckoutFee > 0) { %>
      <tr>
        <td style="padding: 8px; border: 1px solid #000; font-weight: bold; width: 50%;">Late Check-out Fee:</td>
        <td style="padding: 8px; border: 1px solid #000; text-align: right; width: 50%;">PHP <%= cleanLateCheckoutFee.toLocaleString() %></td>
      </tr>
      <% } %>
      <% if (cleanDiscount > 0) { %>
      <tr>
        <td style="padding: 8px; border: 1px solid #000; font-weight: bold; width: 50%;">Discount:</td>
        <td style="padding: 8px; border: 1px solid #000; text-align: right; width: 50%; color: #d9534f;">-PHP <%= cleanDiscount.toLocaleString() %></td>
      </tr>
      <% } %>
    </table>
    <table style="width: 100%; border-collapse: collapse; margin-top: 15px; font-weight: bold; font-size: 14px;">
        <tr style="background: #d9d9d9; border-top: 2px solid #000; border-bottom: 2px solid #000;">
          <td style="padding: 10px; width: 30%; text-align: left;">
            <strong>TOTAL AMOUNT:</strong><br>
            <span style="font-size: 16px;">PHP <%= cleanTotal.toLocaleString() %></span>
          </td>
          <td style="padding: 10px; width: 40%; text-align: center;">
            <strong>PAID AMOUNT:</strong><br>
            <span style="font-size: 16px;">PHP <%= cleanPaid.toLocaleString() %></span>
          </td>
          <td style="padding: 10px; width: 30%; text-align: right;">
            <strong>BALANCE:</strong><br>
            <span style="font-size: 16px;">PHP <%= cleanBalance.toLocaleString() %></span>
          </td>
        </tr>
        <tr>
          <td colspan="3" style="padding: 8px; text-align: center;">
            PREPARED BY: <%= encodedBy %>
          </td>
        </tr>
      </table>
    <div class="policy">
      <div class="policy-title">Cancellation Refund Policy</div>
      <ul>
        <li>1 night penalty for cancellation 20 days before check-in</li>
        <li>2 nights penalty for cancellation 10 days before check-in</li>
        <li>Full penalty for cancellation 5 days before check-in</li>
      </ul>
      <div class="policy-title">Reservation Policy</div>
      <ul>
        <li>Reservation fee is non-refundable</li>
        <li>Reservation fee is deducted from accommodation balance</li>
        <li>Rescheduling must be done 1 week before arrival</li>
      </ul>
      <div class="policy-title">Security Deposit</div>
      <ul>
        <li>Prepare PHP 2,000 CASH deposit per room upon check-in</li>
        <li>It is refundable upon checkout</li>
      </ul>
    </div>
    <div class="red-box">
      CHECK-IN TIME: 3:00 PM<br>
      CHECK-OUT TIME: 12:00 NN
    </div>
  </div>
</body>
</html> 