<div class="modal fade" id="modal-cancel-group-booking" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title"><i class="fa fa-users"></i> Cancel Group Booking</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="cancelGroupBookingId">
          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="groupManualOverrideToggle">
            <label class="form-check-label" for="groupManualOverrideToggle">Enter refund amount manually.</label>
          </div>
          
          <div id="groupManualFields" style="display: none;">
            <div class="mb-2">
              <label>Refundable Amount (₱)</label>
              <input type="number" id="groupManualRefund" class="form-control" step="0.01">
            </div>
          </div>
          <div class="mb-3">
            <label for="groupCancelReason" class="form-label">Reason</label>
            <textarea class="form-control" id="groupCancelReason" rows="3" placeholder="Optional..."></textarea>
          </div>
          <div class="alert alert-warning">
            This action will cancel all individual bookings within this group and cannot be undone. Cancellation penalties apply based on policy.
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button class="btn btn-danger" id="confirmGroupCancelBtn">Confirm Cancel</button>
        </div>
      </div>
    </div>
  </div>
  
<!-- Include external JavaScript files -->
<script>
	document.addEventListener('DOMContentLoaded', function() {
		
		// Load cancel_group_booking.js immediately - this is critical for group booking functionality
		var cancelGroupBookingScript = document.createElement('script');
		cancelGroupBookingScript.src = '/js/booking/cancel_group_booking.js';
		document.body.appendChild(cancelGroupBookingScript);
	});
</script>
