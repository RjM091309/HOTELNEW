<div class="modal fade" id="modal-cancel-booking" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title">Cancel Booking</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="cancelBookingId">
          
          <!-- Booking Details Summary -->
          <div class="card mb-3" id="cancelBookingDetails" style="display: none;">
            <div class="card-header bg-light">
              <h6 class="mb-0"><i class="fa fa-info-circle"></i> Booking Details</h6>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6 mb-2">
                  <strong>Total Amount:</strong>
                  <span class="float-end" id="cancelTotalAmount">₱0.00</span>
                </div>
                <div class="col-md-6 mb-2">
                  <strong>Paid Amount:</strong>
                  <span class="float-end text-success" id="cancelPaidAmount">₱0.00</span>
                </div>
                <div class="col-md-6 mb-2">
                  <strong>Balance:</strong>
                  <span class="float-end text-danger" id="cancelBalance">₱0.00</span>
                </div>
                <div class="col-md-6 mb-2">
                  <strong>Max Refund:</strong>
                  <span class="float-end text-info" id="cancelMaxRefund">₱0.00</span>
                </div>
              </div>
            </div>
          </div>
          
        <div class="row mb-3">
          <div class="col-md-6 mb-2">
            <label class="form-label">Refundable Amount (₱)</label>
            <input type="number" id="manualRefund" class="form-control" step="0.01" min="0" max="0" placeholder="0.00" style="color: #000 !important;">
            <small class="text-muted" id="refundHelpText">Enter the amount to refund.</small>
          </div>
          <div class="col-md-6 mb-2">
            <label class="form-label">Cancellation Fee (₱)</label>
            <input type="number" id="manualCancellationFee" class="form-control" step="0.01" min="0" max="0" placeholder="0.00" style="color: #000 !important;">
            <small class="text-muted" id="feeHelpText">Enter the cancellation penalty.</small>
          </div>
        </div>
        <div class="alert alert-info mb-3" id="noPaymentNote" style="display: none;">
          <i class="fa fa-info-circle"></i> <strong>No Payment Made:</strong> Refund is locked at ₱0.00. You can set the cancellation fee to any amount up to the total booking amount.
        </div>
          <div class="mb-3">
            <label for="cancelReason" class="form-label">Reason</label>
            <textarea class="form-control" id="cancelReason" rows="3" placeholder="Optional..." style="color: #000 !important;"></textarea>
          </div>
          <div class="alert alert-warning">
           This action cannot be undone. Refunds are released only after manual approval.
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button class="btn btn-danger" id="confirmCancelBtn">Confirm Cancel</button>
        </div>
      </div>
    </div>
  </div>
  
<!-- Include external JavaScript files -->
<script>
	document.addEventListener('DOMContentLoaded', function() {
		
		// Load add_booking.js immediately - this is critical for booking functionality
		var cancelBookingScript = document.createElement('script');
		cancelBookingScript.src = '/js/booking/cancel_booking.js';
		document.body.appendChild(cancelBookingScript);
	});
</script>