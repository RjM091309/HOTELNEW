  function initializeEditGroupFlatpickr() {
    if (editGroupFlatpickrInstance) {
      editGroupFlatpickrInstance.destroy();
    }

    editGroupFlatpickrInstance = flatpickr('#editGroupDaterange', {
      mode: 'range',
      dateFormat: 'M d, Y',
      showMonths: 2,
      minDate: 'today',
      onClose: function(selectedDates, dateStr, instance) {
        if (selectedDates.length === 2) {
          const startDate = selectedDates[0];
          const endDate = selectedDates[1];
          const diffMs = endDate.getTime() - startDate.getTime();
          const nights = Math.max(1, Math.round(diffMs / (1000 * 3600 * 24)));
          $('#editGroupNights').val(nights);
          instance.input.value = `${dateStr} (${nights} night/s)`;
          computeEditGroupTotal();
        }
      }
    });
  }

  function getEditSelectedDateRange() {
    const raw = $('#editGroupDaterange').val();
    if (!raw) return null;
    const parts = raw.split(' to ');
    if (parts.length < 2) return null;
    const start = parts[0].trim();
    const end = parts[1].split('(')[0].trim();
    return { start, end };
  }

  function displayEditGroupRooms(blocks, title, groupNameAttr) {
    const list = $('#editGroupRoomsList');
    const section = $(`div[data-group-name="${groupNameAttr}"]`);

    if (!section.length) {
      const sectionHtml = `
        <div class="group-rooms-section" data-group-name="${groupNameAttr}">
          <h6 class="text-info mb-2">${title}</h6>
          <div class="group-rooms-options"></div>
        </div>`;
      list.append(sectionHtml);
    }

    const targetContainer = list.find(`div[data-group-name="${groupNameAttr}"] .group-rooms-options`);
    targetContainer.empty();

    if (!blocks || !blocks.length) {
      targetContainer.append('<p class="text-warning mb-0">No rooms found.</p>');
      return;
    }

    blocks.forEach((block, index) => {
      const blockKey = `${groupNameAttr}-${index}`;
      const roomNumbers = block.map(room => `${room.ROOM_NUMBER}`).join(', ');
      const roomIds = block.map(room => room.IDNo).join(',');
      const option = `
        <div class="form-check room-option">
          <div class="room-option-header">
            <input class="form-check-input" type="radio" name="editGroupBlock" id="editGroupBlock${blockKey}" data-block-group="${groupNameAttr}" data-block-index="${index}" value="${roomIds}">
            <label class="form-check-label" for="editGroupBlock${blockKey}">
              ${roomNumbers}
            </label>
          </div>
        </div>`;
      targetContainer.append(option);
    });
  }

  function displayEditGroupRoomResults({ consecutiveBlocks, nonConsecutiveBlocks, availableRooms, unassignedConflicts }) {
    const list = $('#editGroupRoomsList');
    list.empty();
    $('#editGroupAvailabilityWarning').hide();

    editGroupUnassignedConflicts = (unassignedConflicts && unassignedConflicts.length) ? unassignedConflicts : [];
    editGroupAvailableRooms = availableRooms || [];

    // Show unassigned conflicts warning if any
    if (editGroupUnassignedConflicts.length) {
      const conflictText = editGroupUnassignedConflicts.map(conf =>
        `${conf.reserved} ${conf.bed} bed rooms reserved for unassigned bookings`
      ).join(', ');
      $('#editGroupRoomsList').prepend(`
        <div class="alert alert-warning mb-3">
          <strong>Unassigned Rooms Notice:</strong> Some rooms may be reserved for unassigned bookings: ${conflictText}
        </div>
      `);
    }

    if (!editGroupAvailableRooms || !editGroupAvailableRooms.length) {
      list.append('<p class="text-danger">No rooms available for the selected dates.</p>');
      $('#editGroupResultsContainer').show();
      $('#editGroupSelectedRooms').val('');
      $('#editGroupSelectedRoomPrices').val('');
      return;
    }

    // Render rooms directly in the main list container
    const roomsHtml = editGroupAvailableRooms.map(room => {
      const bedCount = parseInt(room.ROOM_BED, 10);
      const bedBadge = Number.isFinite(bedCount) && bedCount > 0
        ? `<span class="bed-badge">${bedCount}<i class="fa fa-bed"></i></span>`
        : '';
      const isSelected = window.editGroupManualSelectedRooms.includes(room.IDNo) ||
                         window.editGroupManualSelectedRooms.includes(String(room.IDNo)) ||
                         window.editGroupManualSelectedRooms.includes(parseInt(room.IDNo));
      return `
        <div class="form-check room-option">
          <input class="form-check-input edit-group-manual-checkbox" type="checkbox" data-room-id="${room.IDNo}" ${isSelected ? 'checked' : ''}>
          <label class="form-check-label ms-2">
            ${room.ROOM_NUMBER}${bedBadge ? ` ${bedBadge}` : ''}
          </label>
        </div>`;
    }).join('');
    $('#editGroupRoomsList').append(`<div class="manual-rooms-container">${roomsHtml}</div>`);

    $('#editGroupResultsContainer').show();
    
    // Automatically populate the breakdown for pre-selected rooms
    updateEditManualSelectedRoomValues();
    computeEditGroupTotal();
    
    // Refresh the disabled state of checkboxes
    refreshEditManualSelectionDisabledState();
  }


  function attachEditGroupRoomSelectionHandler() {
    $('#editGroupRoomsList').on('change', 'input[name="editGroupBlock"]', function() {
      const groupNameAttr = $(this).data('block-group');
      const blockIndex = parseInt($(this).data('block-index'), 10);

      let sourceBlocks = [];
      if (groupNameAttr === 'consecutive') {
        sourceBlocks = editGroupBlocks;
      } else if (groupNameAttr === 'non-consecutive') {
        sourceBlocks = editGroupNonConsecutiveBlocks;
      } else if (groupNameAttr === 'available') {
        sourceBlocks = buildEditSingleRoomBlocks(editGroupAvailableRooms);
      }

      const block = sourceBlocks[blockIndex];
      if (!block) return;

      const dates = getEditSelectedDateRange();
      if (!dates) {
        Swal.fire('Missing Dates', 'Please select a date range first.', 'warning');
        $(this).prop('checked', false);
        return;
      }

      const bookingType = $('#editGroupBookingRoute').val();
      const computedPrices = [];
      block.forEach(room => {
        const price = typeof room.RESOLVED_PRICE === 'number'
          ? room.RESOLVED_PRICE
          : (() => {
              const seasonalPrices = room.SEASONAL_PRICES || [];
              const bedCount = parseInt(room.ROOM_BED, 10);
              const seasonId = getSeasonIdForDate(dates.start, seasonalPrices);
              const match = seasonalPrices.find(price => parseInt(price.bedCount, 10) === bedCount && price.bookingType === bookingType && parseInt(price.seasonId, 10) === parseInt(seasonId, 10));
              return match ? parseFloat(match.price) : 0;
            })();
        computedPrices.push(price);
      });

      const selectedIds = block.map(room => room.IDNo);
      const selectedNumbers = block.map(room => room.ROOM_NUMBER);
      $('#editGroupSelectedRooms').val(selectedIds.join(','));
      $('#editGroupSelectedRoomPrices').val(computedPrices.join(','));
      $('#editGroupSelectedRoomNumbers').val(selectedNumbers.join(','));
    });
  }

  function buildEditSingleRoomBlocks(rooms) {
    return rooms.map(room => [room]);
  }

  function getSeasonIdForDate(checkInDate, seasonalPrices) {
    if (!seasonalPrices || !seasonalPrices.length) return null;
    const checkIn = new Date(checkInDate);
    const mmdd = `${(checkIn.getMonth() + 1).toString().padStart(2, '0')}${checkIn.getDate().toString().padStart(2, '0')}`;

    for (const price of seasonalPrices) {
      const start = new Date(price.startDate);
      const end = new Date(price.endDate);
      const startKey = `${(start.getMonth() + 1).toString().padStart(2, '0')}${start.getDate().toString().padStart(2, '0')}`;
      const endKey = `${(end.getMonth() + 1).toString().padStart(2, '0')}${end.getDate().toString().padStart(2, '0')}`;

      const isWithinSameYear = startKey <= endKey && mmdd >= startKey && mmdd <= endKey;
      const crossesYear = startKey > endKey && (mmdd >= startKey || mmdd <= endKey);

      if (isWithinSameYear || crossesYear) {
        return price.seasonId;
      }
    }
    return null;
  }

  function handleEditGroupSearchRooms() {
    $('#editGroupSearchRooms').on('click', function() {
      const dates = getEditSelectedDateRange();
      const neededRooms = $('#editGroupNumberOfRooms').val();
      const neededRoomsNum = parseInt(neededRooms, 10);
      const bed1Needed = parseInt($('#editGroupBed1Count').val(), 10) || 0;
      const bed2Needed = parseInt($('#editGroupBed2Count').val(), 10) || 0;
      const totalBedNeeded = bed1Needed + bed2Needed;
      const bookingRoute = $('#editGroupBookingRoute').val();

      if (!dates) {
        Swal.fire('Missing Date Range', 'Please select a valid date range.', 'warning');
        return;
      }
      if (!neededRooms) {
        Swal.fire('Missing Room Count', 'Please enter the number of rooms needed.', 'warning');
        return;
      }
      if (!bookingRoute) {
        Swal.fire('Missing Booking Resource', 'Please select a booking resource before searching for rooms.', 'warning');
        return;
      }

      const checkInStatus = $('#editGroupCheckInStatus').val();
      const checkOutStatus = $('#editGroupCheckOutStatus').val();

      if (!checkInStatus || checkInStatus === '') {
        Swal.fire('Missing Check-In Status', 'Please select a Check-In Status before searching for rooms.', 'warning');
        return;
      }

      if (!checkOutStatus || checkOutStatus === '') {
        Swal.fire('Missing Check-Out Status', 'Please select a Check-Out Status before searching for rooms.', 'warning');
        return;
      }

      if ((bed1Needed > 0 || bed2Needed > 0) && totalBedNeeded !== neededRoomsNum) {
        Swal.fire('Bed Count Mismatch', 'The sum of bed requirements must equal the total number of rooms needed.', 'warning');
        return;
      }

      if (neededRoomsNum > 0 && totalBedNeeded === 0) {
        Swal.fire('Bed Requirement Missing', 'Please specify how many rooms should have 1 bed or 2 beds before searching.', 'warning');
        return;
      }

      editGroupRequiredBed1 = bed1Needed;
      editGroupRequiredBed2 = bed2Needed;

      $.ajax({
        url: '/booking/find_consecutive_rooms',
        type: 'POST',
        data: {
          startDate: dates.start,
          endDate: dates.end,
          neededRooms: neededRooms,
          floorNumber: $('#editGroupFloorSelect').val() || '',
          bed1Needed: bed1Needed,
          bed2Needed: bed2Needed,
          bookingRoute: bookingRoute,
          checkInStatus: $('#editGroupCheckInStatus').val(),
          checkOutStatus: $('#editGroupCheckOutStatus').val(),
          excludeGroupBookingId: $('#editGroupBookingId').val() || ''
        },
        success: function(response) {
          if (!response.success) {
            Swal.fire('No Rooms Found', response.message || 'No available rooms for the selected criteria.', 'info');
            displayEditGroupRoomResults({ consecutiveBlocks: [], nonConsecutiveBlocks: [], availableRooms: [] });
            return;
          }

          const data = response.data || {};
          let availableRooms = data.availableRooms || [];

          // Include originally selected rooms even if not currently available
          const currentBookingId = $('#editGroupBookingId').val();

          if (currentBookingId && window.editGroupManualSelectedRooms.length > 0) {
            // Get room details for originally selected rooms
            const originallySelectedRoomDetails = [];
            window.editGroupManualSelectedRooms.forEach(roomId => {
              // Find room details from previous search results or add enhanced placeholder
              const existingRoom = availableRooms.find(room => room.IDNo === roomId) ||
                                   editGroupAvailableRooms.find(room => room.IDNo === roomId);
              if (existingRoom) {
                originallySelectedRoomDetails.push(existingRoom);
              } else {
                // Add enhanced placeholder room data if not found in current search
                originallySelectedRoomDetails.push({
                  IDNo: roomId,
                  ROOM_NUMBER: `Room ${roomId}`,
                  ROOM_BED: 1, // Default to 1 bed
                  RESOLVED_PRICE: 1000, // Default price
                  SEASONAL_PRICES: [] // Will use fallback pricing
                });
              }
            });

            // Combine available rooms with originally selected rooms (avoid duplicates)
            const existingIds = availableRooms.map(room => room.IDNo);
            const newRooms = originallySelectedRoomDetails.filter(room => !existingIds.includes(room.IDNo));
            availableRooms = [...availableRooms, ...newRooms];
          }

          // Check if we have enough rooms (including originally selected ones for editing)
          const totalAvailableRooms = availableRooms.length;
          const originallySelectedCount = window.editGroupManualSelectedRooms.length;
          if (neededRoomsNum > totalAvailableRooms && originallySelectedCount === 0) {
            displayEditGroupRoomResults({ consecutiveBlocks: [], nonConsecutiveBlocks: [], availableRooms: [] });
            return;
          }

          editGroupNonConsecutiveBlocks = data.nonConsecutiveBlocks || [];
          editGroupAvailableRooms = availableRooms; // Update available rooms with current search results
          displayEditGroupRoomResults({
            consecutiveBlocks: data.consecutiveBlocks || [],
            nonConsecutiveBlocks: editGroupNonConsecutiveBlocks,
            availableRooms,
            unassignedConflicts: data.unassignedConflicts || []
          });
        },
        error: function(err) {
          console.error('Error finding rooms:', err);
          Swal.fire('Error', 'There was a problem searching for rooms. Please try again.', 'error');
        }
      });
    });
  }

