  // Load breakfast and transport prices for edit form
  function loadEditGroupServicePrices() {
    // Load breakfast service IDs and prices
    fetch('/booking/get-breakfast-prices')
      .then(res => res.json())
      .then(data => {
        if (!Array.isArray(data)) return;
        const adult = data.find(item => item.SERVICE_NAME.toLowerCase().includes('adult'));
        const kid = data.find(item => item.SERVICE_NAME.toLowerCase().includes('kid'));
        if (adult) {
          editGroupBreakfastAdultBaseId = adult.IDNo;
        }
        if (kid) {
          editGroupBreakfastKidBaseId = kid.IDNo;
        }
      })
      .catch(err => console.error('Failed to load breakfast services:', err));

    // Load transport services
    fetch('/booking/get-pick-drop')
      .then(res => res.json())
      .then(data => {
        if (!Array.isArray(data)) return;
        const pickup = data.find(item => item.SERVICE_NAME.toLowerCase().includes('pick'));
        const dropoff = data.find(item => item.SERVICE_NAME.toLowerCase().includes('drop'));
        if (pickup) {
          editGroupPickupBaseId = pickup.IDNo;
        }
        if (dropoff) {
          editGroupDropoffBaseId = dropoff.IDNo;
        }
      })
      .catch(err => console.error('Failed to load transport services:', err));
  }

