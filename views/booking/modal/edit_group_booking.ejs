  // Form submission
  $('#editGroupBookingForm').on('submit', function(e) {
    e.preventDefault();

    // Compute per-room discounts for Senior/PWD (aligned to room order)
    const computeSeniorPerRoomDiscounts = (pricesRaw, nights, percent, roomCount) => {
      const prices = pricesRaw
        ? pricesRaw.split(',').map(p => parseFloat(p) || 0)
        : [];
      const nNights = parseInt(nights, 10) || 0;
      const discountDecimal = (parseFloat(percent) || 0) / 100;
      const count = parseInt(roomCount, 10) || 0;
      const discounts = prices.map(() => 0);
      if (count <= 0 || discountDecimal <= 0 || nNights <= 0 || prices.length === 0) return discounts;
      const sorted = prices.map((price, idx) => ({ price, idx })).sort((a, b) => b.price - a.price);
      for (let i = 0; i < Math.min(count, sorted.length); i++) {
        const { price, idx } = sorted[i];
        discounts[idx] = price * nNights * discountDecimal;
      }
      return discounts;
    };

    const formData = {
      groupBookingId: $('#editGroupBookingId').val(),
      selectedRooms: $('#editGroupSelectedRooms').val(),
      selectedRoomPrice: $('#editGroupSelectedRoomPrices').val(),
      qty: $('#editGroupNights').val(),
      daterange: $('#editGroupDaterange').val(),
      groupName: $('#editGroupName').val(),
      groupContact: $('#editGroupContact').val(),
      numberOfRooms: $('#editGroupNumberOfRooms').val(),
      paidAmount: $('#editGroupPaidAmount').val(),
      bookingRoute: $('#editGroupBookingRoute').val(),
      guestType: $('#editGroupGuestType').val(),
      guestLevel: $('#editGroupGuestLevel').val(),
      checkInStatus: $('#editGroupCheckInStatus').val(),
      checkOutStatus: $('#editGroupCheckOutStatus').val(),
      holdPending: $('#editGroupHoldPendingCheckbox').is(':checked') ? 'true' : 'false',
      remarks: $('#editGroupRemarks').val(),
      agencyId: $('#editGroupBookingRoute').val() === 'agency' ? $('#editGroupAgencySelect').val() : null,
      agencyPayer: $('#editGroupBookingRoute').val() === 'agency'
        ? ($('input[name="editGroupAgencyPayer"]:checked').val() || 'agency')
        : null,
      breakfastAdultQty: $('#editGroupBreakfastAdultQty').val(),
      breakfastAdultPrice: $('#editGroupBreakfastAdultPrice').val(),
      breakfastAdultId: $('#editGroupBreakfastAdultId').val(),
      breakfastKidQty: $('#editGroupBreakfastKidQty').val(),
      breakfastKidPrice: $('#editGroupBreakfastKidPrice').val(),
      breakfastKidId: $('#editGroupBreakfastKidId').val(),
      breakfastIndividual: $('#editGroupBreakfastIndividual').is(':checked') ? 'on' : '',
      pickupServiceId: $('#editGroupPickupServiceId').val(),
      pickupPrice: $('#editGroupPickupPrice').val(),
      dropoffServiceId: $('#editGroupDropoffServiceId').val(),
      dropoffPrice: $('#editGroupDropoffPrice').val(),
      seniorPwdDiscount: $('#editGroupIncludeSeniorPwdDiscount').is(':checked') ? parseFloat($('#editGroupSeniorPwdDiscount').val()) || 0 : 0,
      seniorPwdDiscountPercent: $('#editGroupIncludeSeniorPwdDiscount').is(':checked') ? parseFloat($('#editGroupSeniorPwdDiscountPercent').val()) || 0 : 0,
      seniorPwdRoomCount: $('#editGroupIncludeSeniorPwdDiscount').is(':checked') ? parseInt($('#editGroupSeniorPwdRoomCount').val()) || 0 : 0,
      perRoomDiscounts: computeSeniorPerRoomDiscounts(
        $('#editGroupSelectedRoomPrices').val(),
        $('#editGroupNights').val(),
        $('#editGroupSeniorPwdDiscountPercent').val(),
        $('#editGroupSeniorPwdRoomCount').val()
      ),
      discount: $('#editGroupDiscount').val(),
      individualBilling: $('#editGroupIndividualBilling').is(':checked') ? 'on' : '', // Inverted logic
      lateCheckoutFee: parseFloat($('#editGroupLateCheckoutFee').val()) || 0
    };

    // Collect individual booking dates if they exist
    const individualBookingDates = {};
    $('.edit-individual-checkin').each(function() {
      const bookingId = $(this).data('booking-id');
      const checkInInput = $(`.edit-individual-checkin[data-booking-id="${bookingId}"]`);
      const checkOutInput = $(`.edit-individual-checkout[data-booking-id="${bookingId}"]`);
      
      if (bookingId && checkInInput.length && checkOutInput.length) {
        const checkIn = checkInInput.val();
        const checkOut = checkOutInput.val();
        
        if (checkIn && checkOut) {
          individualBookingDates[bookingId] = {
            checkIn: checkIn,
            checkOut: checkOut
          };
        }
      }
    });
    
    // Add individual booking dates to formData if any exist
    if (Object.keys(individualBookingDates).length > 0) {
      formData.individualBookingDates = individualBookingDates;
    }

    // Validate that number of rooms needed matches selected rooms count
    const selectedRooms = formData.selectedRooms;
    const numberOfRooms = parseInt(formData.numberOfRooms, 10) || 0;

    if (selectedRooms) {
      const selectedRoomsArray = selectedRooms.split(',').filter(Boolean);
      const selectedRoomsCount = selectedRoomsArray.length;

      if (selectedRoomsCount !== numberOfRooms) {
        Swal.fire({
          icon: 'error',
          title: 'Room Count Mismatch',
          html: `Number of Rooms Needed (${numberOfRooms}) does not match the number of selected rooms (${selectedRoomsCount}).<br><br>Please select exactly ${numberOfRooms} room(s) or update the "Number of Rooms Needed" field.`,
          confirmButtonText: 'OK',
          width: '600px'
        });
        return;
      }
    }

    $.ajax({
      url: '/booking/update_group_booking',
      type: 'POST',
      data: formData,
      success: function(response) {
        if (response.success) {
          $('#modal-edit-group-booking').modal('hide');
          Swal.fire({
            title: 'Success!',
            text: 'Group booking updated successfully!',
            icon: 'success',
            confirmButtonText: 'OK'
          }).then(() => {
            location.reload();
          });
        } else {
          Swal.fire({
            title: 'Error!',
            text: response.message || 'Failed to update group booking',
            icon: 'error',
            confirmButtonText: 'OK'
          });
        }
      },
      error: function(err) {
        console.error('Error updating group booking:', err);
        Swal.fire({
          title: 'Error!',
          text: 'An error occurred while updating the group booking',
          icon: 'error',
          confirmButtonText: 'OK'
        });
      }
    });
  });

  // Manual selection handlers for edit modal
  function attachEditGroupManualSelectionHandlers() {
    $('#editGroupRoomsList').on('change', '.edit-group-manual-checkbox', function() {
      const roomId = $(this).data('room-id');
      const roomIdNum = parseInt(roomId, 10);
      if ($(this).is(':checked')) {
        if (window.editGroupManualSelectedRooms.length < parseInt($('#editGroupNumberOfRooms').val(), 10)) {
          window.editGroupManualSelectedRooms.push(roomId);
        } else {
          $(this).prop('checked', false);
          return;
        }
      } else {
        // Remove by both string and number versions
        window.editGroupManualSelectedRooms = window.editGroupManualSelectedRooms.filter(id =>
          id !== roomId && id !== roomIdNum && id !== String(roomIdNum)
        );
      }
      
      // Refresh the disabled state of all checkboxes
      refreshEditManualSelectionDisabledState();
      updateEditManualSelectedRoomValues();
      updateEditRoomFilterAndCount();
      computeEditGroupTotal();
    });
  }

  function hasReachedEditManualSelectionLimit() {
    const neededRooms = parseInt($('#editGroupNumberOfRooms').val(), 10) || 0;
    const selectedCount = window.editGroupManualSelectedRooms.length;

    if (editGroupRequiredBed1 || editGroupRequiredBed2) {
      const summary = getEditManualBedSummary();
      if (summary.bed1 >= editGroupRequiredBed1 && summary.bed2 >= editGroupRequiredBed2 && selectedCount >= neededRooms) {
        return true;
      }
      return selectedCount >= neededRooms;
    }

    return neededRooms > 0 && selectedCount >= neededRooms;
  }

  function getEditManualBedSummary() {
    const summary = { bed1: 0, bed2: 0 };
    window.editGroupManualSelectedRooms.forEach(roomId => {
      const room = editGroupAvailableRooms.find(r => r.IDNo === roomId);
      if (room) {
        const bedCount = parseInt(room.ROOM_BED, 10);
        if (bedCount === 1) summary.bed1++;
        else if (bedCount === 2) summary.bed2++;
      }
    });
    return summary;
  }

  function refreshEditManualSelectionDisabledState() {
    const limitReached = hasReachedEditManualSelectionLimit();
    const summary = getEditManualBedSummary();
    $('#editGroupRoomsList .edit-group-manual-checkbox').each(function() {
      const roomId = parseInt($(this).data('room-id'), 10);
      const room = editGroupAvailableRooms.find(r => r.IDNo === roomId);
      const bedType = room ? parseInt(room.ROOM_BED, 10) : null;

      // Only disable rooms that are NOT needed
      if (editGroupRequiredBed2 === 0 && bedType === 2) {
        // If 0 2-bed rooms needed, disable all 2-bed rooms only  
        $(this).prop('checked', false).prop('disabled', true);
        window.editGroupManualSelectedRooms = window.editGroupManualSelectedRooms.filter(id => id !== roomId);
        return;
      }

      if (editGroupRequiredBed1 || editGroupRequiredBed2) {
        if (bedType === 1 && summary.bed1 >= editGroupRequiredBed1 && !window.editGroupManualSelectedRooms.includes(roomId)) {
          $(this).prop('disabled', true);
          return;
        }
        if (bedType === 2 && summary.bed2 >= editGroupRequiredBed2 && !window.editGroupManualSelectedRooms.includes(roomId)) {
          $(this).prop('disabled', true);
          return;
        }
      }

      if (limitReached && !window.editGroupManualSelectedRooms.includes(roomId)) {
        $(this).prop('disabled', true);
      } else {
        $(this).prop('disabled', false);
      }
    });
  }

  function updateEditManualSelectedRoomValues() {
    const selectedRooms = editGroupAvailableRooms.filter(room =>
      window.editGroupManualSelectedRooms.includes(room.IDNo) ||
      window.editGroupManualSelectedRooms.includes(String(room.IDNo)) ||
      window.editGroupManualSelectedRooms.includes(parseInt(room.IDNo))
    );
    const dates = getEditSelectedDateRange();
    const bookingType = getEditGroupPriceBookingType();

    // For originally selected rooms that might not have complete data, use a default price
    const computedBasePrices = selectedRooms.map(room => {
      if (typeof room.RESOLVED_PRICE === 'number' && room.RESOLVED_PRICE > 0) {
        return room.RESOLVED_PRICE;
      }

      // Try to calculate from seasonal prices
      if (dates && room.SEASONAL_PRICES && room.SEASONAL_PRICES.length > 0) {
        const bedCount = parseInt(room.ROOM_BED, 10) || 1;
        const seasonId = getSeasonIdForDate(dates.start, room.SEASONAL_PRICES);
        if (seasonId !== null) {
          const match = room.SEASONAL_PRICES.find(price =>
            parseInt(price.bedCount, 10) === bedCount &&
            price.bookingType === bookingType &&
            parseInt(price.seasonId, 10) === parseInt(seasonId, 10)
          );
          if (match) {
            return parseFloat(match.price);
          }
        }
      }

      // Default fallback price
      return 1000; // Default room price
    });

    $('#editGroupSelectedRooms').val(selectedRooms.map(room => room.IDNo).join(','));
    $('#editGroupSelectedRoomPrices').val(computedBasePrices.join(','));

    // Update room breakdown if needed
    if (selectedRooms.length > 0) {
      populateEditBreakdown(selectedRooms, computedBasePrices);
    }
    
    // Trigger total computation after room prices are updated
    if (typeof computeEditGroupTotal === 'function') {
      computeEditGroupTotal();
    }
  }

  function populateEditBreakdown(selectedRooms, computedPrices) {
    const container = $('#editGroupRoomBreakdown');
    container.empty();
    if (!selectedRooms || !selectedRooms.length) {
      return;
    }

    // Get main nights (for bookings without individual dates)
    const mainNights = parseInt($('#editGroupNights').val(), 10) || 0;
    
    // Get individual booking dates and map to room numbers
    // Map: roomNumber -> nights
    const individualNightsMap = {};
    $('.edit-individual-nights').each(function() {
      const roomNumber = $(this).data('room-number');
      const nights = parseInt($(this).val(), 10) || 0;
      if (roomNumber && nights > 0) {
        individualNightsMap[roomNumber] = nights;
      }
    });
    
    let html = '<div class="group-room-breakdown"><b>Selected Room Prices:</b><ul>';
    selectedRooms.forEach((room, idx) => {
      const price = computedPrices[idx] || 0;
      const roomNumber = room.ROOM_NUMBER || room.roomNumber;
      
      // Use individual nights if available, otherwise use main nights
      const nights = individualNightsMap[roomNumber] || mainNights;
      const total = nights > 0 ? price * nights : price;
      
      // Add indicator if using individual nights
      const nightsLabel = individualNightsMap[roomNumber] ? ` (${nights} nights - different dates)` : ` (${nights} nights)`;
      
      html += `<li>Room ${roomNumber}: ₱${price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} per night ${nights > 0 ? `(₱${total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} total${nightsLabel})` : ''}</li>`;
    });
    html += '</ul></div>';
    container.html(html);
  }

