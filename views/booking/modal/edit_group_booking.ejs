    const $lateFee = $('#editGroupLateCheckoutFeeDisplay');
    const $ciField = $('#editGroupCheckInStatus');
    const $coField = $('#editGroupCheckOutStatus');

    $ci.toggle(!isHoldPending);
    $co.toggle(!isHoldPending);

    if (isHoldPending) {
      if ($lateFee.length) $lateFee.hide();
      $ciField.prop('required', false);
      $coField.prop('required', false);
      if (!$ciField.val()) $ciField.val('1');
      if (!$coField.val()) $coField.val('0');
    } else {
      $ciField.prop('required', true);
      $coField.prop('required', true);
    }
  }
