      const bookingRoute = $('#editGroupBookingRoute').val();
      const checkInStatus = $('#editGroupCheckInStatus').val();
      const checkOutStatus = $('#editGroupCheckOutStatus').val();
      
      // Only auto-search if all required fields are filled
      // This will refresh the available rooms list but won't clear selected rooms
      if (daterange && numberOfRooms && bookingRoute && checkInStatus && checkOutStatus) {
        $('#editGroupSearchRooms').click();
      }
    });

    // Auto-compute total when fees, discounts, or services change
    $('#editGroupDiscount').on('input change', function() {
      computeEditGroupTotal();
    });

    // Auto-compute total when breakfast quantities or prices change
    $('#editGroupBreakfastAdultQty, #editGroupBreakfastAdultPrice, #editGroupBreakfastKidQty, #editGroupBreakfastKidPrice').on('input change', function() {
      computeEditGroupTotal();
    });

    // Auto-compute total when pickup/dropoff prices change
    $('#editGroupPickupPrice, #editGroupDropoffPrice').on('input change', function() {
      computeEditGroupTotal();
    });

    // Auto-compute total when checkboxes are toggled
    $('#editGroupIncludeReservationFee, #editGroupIncludeDiscount, #editGroupIncludeBreakfast, #editGroupIncludePickup, #editGroupIncludeDropoff, #editGroupIndividualBilling').on('change', function() {
      computeEditGroupTotal();
      
      // If Individual Billing checkbox changed, refresh the services list display
      if ($(this).attr('id') === 'editGroupIndividualBilling') {
        const groupBookingId = $('#editGroupBookingId').val();
        if (groupBookingId && typeof updateEditGroupAddedServicesList === 'function') {
          updateEditGroupAddedServicesList(groupBookingId);
        }
      }
    });

    // Auto-compute total when breakfast individual checkbox is toggled
    $('#editGroupBreakfastIndividual').on('change', function() {
      computeEditGroupTotal();
    });

    // Set service IDs when checkboxes are checked
    $('#editGroupIncludeBreakfast').on('change', function() {
      if ($(this).is(':checked')) {
        $('#editGroupBreakfastAdultId').val('74'); // Breakfast adult service ID
        $('#editGroupBreakfastKidId').val('75'); // Breakfast kid service ID
      }
    });

    $('#editGroupIncludePickup').on('change', function() {
      if ($(this).is(':checked')) {
        $('#editGroupPickupServiceId').val('76'); // Pickup service ID
      }
    });

    $('#editGroupIncludeDropoff').on('change', function() {
      if ($(this).is(':checked')) {
        $('#editGroupDropoffServiceId').val('77'); // Dropoff service ID
      }
    });

    // Paid amount formatting and update handler
    $('#editGroupPaidAmount').on('blur', function() {
      if (typeof formatPaidAmount === 'function') {
        formatPaidAmount(this);
      }
      computeEditGroupTotal();
    });

    // Auto-compute total when paid amount changes
    $('#editGroupPaidAmount').on('input change', function() {
      computeEditGroupTotal();
    });

    // Voucher generation button handler for edit group booking
    $('#editBtnGroupVoucherPreview').on('click', function() {
      // Check if there's an existing group booking ID
      const groupBookingId = $('#editGroupBookingId').val();
      let vno = $('#editGroupVoucherNo').val();
      
      // If no voucher number set and we have a group booking ID, try to fetch confirmation number
      if (!vno && groupBookingId) {
        // Try to get confirmation number from existing booking
        $.ajax({
          url: `/booking/get-group-voucher-data/${groupBookingId}`,
          method: 'GET',
          async: false, // Synchronous to wait for result
          success: function (response) {
            if (response.success && response.data && response.data.confirmationNumber) {
              vno = response.data.confirmationNumber;
              $('#editGroupVoucherNo').val(vno);
            }
          }
        });
      }
      
      // If still no voucher number, generate one based on date and room
      if (!vno) {
        const daterange = $('#editGroupDaterange').val() || '';
        const dateFromStr = daterange.includes(' to ') ? daterange.split(' to ')[0] : '';
        let datePart = '';
        if (dateFromStr) {
          const d = new Date(dateFromStr);
          if (!isNaN(d.getTime())) {
            const yyyy = d.getFullYear();
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const dd = String(d.getDate()).padStart(2, '0');
            datePart = `${yyyy}${mm}${dd}`;
          }
        }
        const selectedRoomNumbers = ($('#editGroupSelectedRoomNumbers').val()||'').split(',').filter(Boolean);
        let firstRoomNumber = '';
        if (selectedRoomNumbers.length > 0) {
          firstRoomNumber = selectedRoomNumbers[0];
        } else {
          const selectedRoomIds = ($('#editGroupSelectedRooms').val()||'').split(',').filter(Boolean);
          if (selectedRoomIds.length > 0 && editGroupAvailableRooms.length > 0) {
            const match = editGroupAvailableRooms.find(r => String(r.IDNo) === String(selectedRoomIds[0]));
            if (match && match.ROOM_NUMBER) firstRoomNumber = match.ROOM_NUMBER;
          }
        }
        if (datePart && firstRoomNumber) {
          vno = `${datePart}0${firstRoomNumber}`;
        } else if (firstRoomNumber) {
          const today = new Date();
          const tyyyy = today.getFullYear();
          const tmm = String(today.getMonth() + 1).padStart(2, '0');
          const tdd = String(today.getDate()).padStart(2, '0');
          vno = `${tyyyy}${tmm}${tdd}0${firstRoomNumber}`;
        } else {
          vno = groupBookingId || 'GV' + Date.now();
        }
        $('#editGroupVoucherNo').val(vno);
      }

      const daterange = $('#editGroupDaterange').val() || '';
      const dateFrom = daterange.includes(' to ') ? daterange.split(' to ')[0] : '';
      const dateTo = daterange.includes(' to ') ? daterange.split(' to ')[1].split('(')[0].trim() : '';
      
      // Prefer precomputed room numbers from hidden input
      const selectedRoomNumbers = ($('#editGroupSelectedRoomNumbers').val()||'').split(',').filter(Boolean);
      let roomNumbersForVoucher = '';
      
      if (selectedRoomNumbers.length > 0) {
        roomNumbersForVoucher = selectedRoomNumbers.join(', ');
      } else {
        // Fallback: If room numbers not available, try to get from available rooms by ID
        const selectedRoomIds = ($('#editGroupSelectedRooms').val()||'').split(',').filter(Boolean);
        if (selectedRoomIds.length > 0 && editGroupAvailableRooms.length > 0) {
          const roomNumbersFromIds = selectedRoomIds.map(id => {
            const room = editGroupAvailableRooms.find(r => r.IDNo.toString() === id.toString());
            return room ? room.ROOM_NUMBER : null;
          }).filter(Boolean);
          roomNumbersForVoucher = roomNumbersFromIds.length > 0 
            ? roomNumbersFromIds.join(', ') 
            : 'No rooms selected';
        } else {
          roomNumbersForVoucher = 'No rooms selected';
        }
      }

      const totalText = $('#editGroupComputedTotal').text() || '0';
      // Extract numeric value, handling consolidated format
      const numericTotal = totalText.replace(/[^0-9.]/g, '').split(' ')[0] || '0';
      
      const paidText = $('#editGroupComputedPaidAmount').text() || '0';
      const numericPaid = paidText.replace(/[^0-9.]/g, '').split(' ')[0] || '0';
      
      const balanceText = $('#editGroupComputedBalance').text() || '0';
      const numericBalance = balanceText.replace(/[^0-9.]/g, '').split(' ')[0] || '0';

      // Calculate room charges
      const nights = parseInt($('#editGroupNights').val(), 10) || 0;
      const pricesRaw = $('#editGroupSelectedRoomPrices').val();
      const prices = pricesRaw ? pricesRaw.split(',').map(p => parseFloat(p) || 0) : [];
      const baseSubtotal = prices.reduce((sum, price) => sum + price, 0);
      const roomCharges = baseSubtotal * nights;
      
      // Calculate services total (exclude late checkout fee)
      const adultQty = $('#editGroupIncludeBreakfast').is(':checked') ? (parseInt($('#editGroupBreakfastAdultQty').val(), 10) || 0) : 0;
      const adultPrice = parseFloat($('#editGroupBreakfastAdultPrice').val()) || 0;
      const kidQty = $('#editGroupIncludeBreakfast').is(':checked') ? (parseInt($('#editGroupBreakfastKidQty').val(), 10) || 0) : 0;
      const kidPrice = parseFloat($('#editGroupBreakfastKidPrice').val()) || 0;
      const breakfastIndividual = $('#editGroupBreakfastIndividual').is(':checked');
      const selectedRooms = $('#editGroupSelectedRooms').val();
      const numRooms = selectedRooms ? selectedRooms.split(',').length : 1;
      const breakfastTotal = (adultQty * adultPrice) + (kidQty * kidPrice);
      const breakfastTotalWithIndividual = breakfastIndividual ? breakfastTotal * numRooms : breakfastTotal;
      const pickupPrice = $('#editGroupIncludePickup').is(':checked') ? parseFloat($('#editGroupPickupPrice').val()) || 0 : 0;
      const dropoffPrice = $('#editGroupIncludeDropoff').is(':checked') ? parseFloat($('#editGroupDropoffPrice').val()) || 0 : 0;
      // Exclude late checkout fee from servicesTotal as it's displayed separately
      const servicesTotal = breakfastTotalWithIndividual + pickupPrice + dropoffPrice;

      const bookingData = {
        voucherNo: vno,
        groupName: $('#editGroupName').val() || 'Group Booking',
        groupContact: $('#editGroupContact').val() || '',
        dateFrom: dateFrom,
        dateTo: dateTo,
        roomSummary: roomNumbersForVoucher || 'No rooms selected',
        breakfastAdult: $('#editGroupBreakfastAdultQty').val() || 0,
        breakfastKid: $('#editGroupBreakfastKidQty').val() || 0,
        breakfastAdultPrice: adultPrice,
        breakfastKidPrice: kidPrice,
        pickup: pickupPrice,
        dropoff: dropoffPrice,
        remarks: $('#editGroupRemarks').val() || '',
        total: numericTotal,
        paidAmount: numericPaid,
        balance: numericBalance,
        checkOutStatus: $('#editGroupCheckOutStatus').val() || 0,
        lateCheckoutFee: parseFloat($('#editGroupLateCheckoutFee').val()) || 0,
        seniorPwdDiscount: $('#editGroupIncludeSeniorPwdDiscount').is(':checked') ? parseFloat($('#editGroupSeniorPwdDiscount').val()) || 0 : 0,
        discount: $('#editGroupIncludeDiscount').is(':checked') ? (parseFloat($('#editGroupDiscount').val()) || 0) : 0,
        reservationFee: 0, // Default to 0 for group bookings
        roomCharges: roomCharges.toFixed(2),
        servicesTotal: servicesTotal.toFixed(2)
      };

      const form = $('<form>', {
        method: 'POST',
        action: '/booking/generate-group-voucher',
        target: '_blank'
      });
      for (let key in bookingData) {
        form.append($('<input>', { type: 'hidden', name: key, value: bookingData[key] }));
      }
      $('body').append(form);
      form.submit();
      form.remove();
    });
  });

})();

// ================================
// GLOBAL FUNCTIONS FOR EXTRA SERVICES
// ================================

// Update added services list (global function)
function updateEditGroupAddedServicesList(groupBookingId) {
    const serviceList = $('#editGroup_added-services-list');
    if (!serviceList.length) return;

    serviceList.empty();

    const groupServices = window.editGroupAddedServicesMap[groupBookingId] || [];
    
    // Filter out hidden services
    const visibleServices = groupServices.filter(service => !service.HIDDEN_FOR_UI);

    if (visibleServices.length === 0) {
        // Hide entire Extra Services section when no services
        $('#editGroup_extra-services-wrapper').hide();
        $('#editGroup_extra-services-hr').hide();
        serviceList.hide();
        return;
    }

    // Show Extra Services section when there are services
    $('#editGroup_extra-services-wrapper').show();
    $('#editGroup_extra-services-hr').show();
    serviceList.show();

    // Check if Individual Billing is enabled (inverted logic: checked = individual, unchecked = master)
    const isIndividualBilling = $('#editGroupIndividualBilling').is(':checked');
    
    // If Individual Billing, group services by booking
    if (isIndividualBilling) {
        // Group services by booking ID
        const servicesByBooking = {};
        visibleServices.forEach(service => {
            const bookingId = service.BOOKING_ID || service.bookingId || 'unknown';
            if (!servicesByBooking[bookingId]) {
                servicesByBooking[bookingId] = {
                    bookingId: bookingId,
                    roomNumber: service.ROOM_NUMBER || service.roomNumber || `Booking ${bookingId}`,
                    services: []
                };
            }
            servicesByBooking[bookingId].services.push(service);
        });

        // Display grouped by booking
        Object.values(servicesByBooking).forEach(bookingGroup => {
            // Add booking header
            const bookingHeader = $(`
                <div class="mb-2 mt-3" style="background-color: #1a1f23; border-radius: 4px; padding: 8px; border-left: 3px solid #6f9c40;">
                    <span style="font-weight: 600; color: #9fe073; font-size: 0.85rem;">
                        <i class="fas fa-door-open me-1"></i>Room ${bookingGroup.roomNumber}
                    </span>
                </div>
            `);
            serviceList.append(bookingHeader);

            // Add services for this booking
            bookingGroup.services.forEach((service, index) => {
                const serviceCost = parseFloat(service.SERVICE_COST) || 0;
                const quantity = parseInt(service.QUANTITY) || 0;
                const isUpgrade = service.SERVICE_ID === 71 || 
                                 service.SERVICE_NAME?.toLowerCase() === 'upgrade';
                const quantityDisplay = isUpgrade ? '-' : quantity;
                const totalCost = serviceCost * quantity;
                const costDisplay = (isNaN(totalCost) || totalCost === 0)
                    ? '<span class="badge bg-success">FREE</span>'
                    : `₱${totalCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

                let statusDisplay;
                if (service.STATUS === 'unpaid') {
                    statusDisplay = '<span class="badge bg-warning">UNPAID</span>';
                } else if (service.STATUS === 'paid') {
                    statusDisplay = '<span class="badge bg-success">PAID</span>';
                } else {
                    statusDisplay = `<span class="badge bg-secondary">${service.STATUS}</span>`;
                }

                const serviceItem = $(`
                    <div class="mb-2" style="background-color: #2a3135; border-radius: 6px; border: 1px solid #5a6268; padding: 10px; margin-left: 15px;">
                        <div class="row align-items-center">
                            <div class="col-4">
                                <span style="font-weight: 600; color: #ffffff; font-size: 0.9rem;">${service.SERVICE_NAME}</span>
                            </div>
                            <div class="col-2 text-center">
                                <span style="font-weight: 500; color: #bbbbbb; font-size: 0.9rem;">Qty: ${quantityDisplay}</span>
                            </div>
                            <div class="col-3 text-center">
                                <span style="font-weight: 600; color: #ffc107; font-size: 0.9rem;">${costDisplay}</span>
                            </div>
                            <div class="col-3 text-center">
                                ${statusDisplay}
                            </div>
                        </div>
                    </div>
                `);

                serviceList.append(serviceItem);
            });
        });
    } else {
        // Master Billing: Show all services aggregated (no booking grouping)
        visibleServices.forEach((service, index) => {
            const serviceCost = parseFloat(service.SERVICE_COST) || 0;
            const quantity = parseInt(service.QUANTITY) || 0;
            const isUpgrade = service.SERVICE_ID === 71 || 
                             service.SERVICE_NAME?.toLowerCase() === 'upgrade';
            const quantityDisplay = isUpgrade ? '-' : quantity;
            const totalCost = serviceCost * quantity;
            const costDisplay = (isNaN(totalCost) || totalCost === 0)
                ? '<span class="badge bg-success">FREE</span>'
                : `₱${totalCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

            let statusDisplay;
            if (service.STATUS === 'unpaid') {
                statusDisplay = '<span class="badge bg-warning">UNPAID</span>';
            } else if (service.STATUS === 'paid') {
                statusDisplay = '<span class="badge bg-success">PAID</span>';
            } else {
                statusDisplay = `<span class="badge bg-secondary">${service.STATUS}</span>`;
            }

            const serviceItem = $(`
                <div class="mb-2" style="background-color: #2a3135; border-radius: 6px; border: 1px solid #5a6268; padding: 10px;">
                    <div class="row align-items-center">
                        <div class="col-4">
                            <span style="font-weight: 600; color: #ffffff; font-size: 0.9rem;">${service.SERVICE_NAME}</span>
                        </div>
                        <div class="col-2 text-center">
                            <span style="font-weight: 500; color: #bbbbbb; font-size: 0.9rem;">Qty: ${quantityDisplay}</span>
                        </div>
                        <div class="col-3 text-center">
                            <span style="font-weight: 600; color: #ffc107; font-size: 0.9rem;">${costDisplay}</span>
                        </div>
                        <div class="col-3 text-center">
                            ${statusDisplay}
                        </div>
                    </div>
                </div>
            `);

            serviceList.append(serviceItem);
        });
    }
}

// Load existing services for edit group form (global function)
function loadEditGroupExistingServices(groupBookingId) {
    if (!groupBookingId) {
        console.log('loadEditGroupExistingServices: No groupBookingId provided');
        return;
    }
    
    console.log('loadEditGroupExistingServices: Loading services for groupBookingId:', groupBookingId);
    
    // For group bookings, we need to get services from all individual bookings in the group
    // First, get the group booking details to find all booking IDs
    fetch(`/booking/edit_group_booking/${groupBookingId}`)
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            if (!data.success || !data.booking || !data.booking.bookings) {
                console.log('loadEditGroupExistingServices: No bookings found in group');
                window.editGroupAddedServicesMap[groupBookingId] = [];
                updateEditGroupAddedServicesList(groupBookingId);
                if (typeof computeEditGroupTotal === 'function') {
                    computeEditGroupTotal();
                }
                return;
            }
            
            // Get all booking IDs from the group
            const bookingIds = data.booking.bookings.map(b => b.BOOKING_ID || b.bookingId).filter(Boolean);
            console.log('loadEditGroupExistingServices: Found booking IDs:', bookingIds);
            
            if (bookingIds.length === 0) {
                window.editGroupAddedServicesMap[groupBookingId] = [];
                updateEditGroupAddedServicesList(groupBookingId);
                if (typeof computeEditGroupTotal === 'function') {
                    computeEditGroupTotal();
                }
                return;
            }
            
            // Get booking details with room numbers for Individual Billing display
            const bookingsMap = {};
            if (data.booking.bookings) {
                data.booking.bookings.forEach(booking => {
                    const bid = booking.BOOKING_ID || booking.bookingId;
                    if (bid) {
                        bookingsMap[bid] = {
                            roomNumber: booking.ROOM_NUMBER || booking.roomNumber || `Booking ${bid}`,
                            bookingId: bid
                        };
                    }
                });
            }
            
            // Fetch services for all bookings in parallel, keeping track of which booking they belong to
            const servicePromises = bookingIds.map(bookingId => 
                fetch(`/booking/get-booking-services/${bookingId}`)
                    .then(res => res.json())
                    .then(resData => {
                        if (resData.success && resData.data) {
                            // Add booking ID and room number to each service
                            return resData.data.map(service => ({
                                ...service,
                                BOOKING_ID: bookingId,
                                ROOM_NUMBER: bookingsMap[bookingId]?.roomNumber || `Booking ${bookingId}`
                            }));
                        }
                        return [];
                    })
                    .catch(err => {
                        console.error(`Error loading services for booking ${bookingId}:`, err);
                        return [];
                    })
            );
            
            Promise.all(servicePromises)
                .then(allServicesArrays => {
                    // Flatten all services into a single array
                    const allServices = allServicesArrays.flat();
                    console.log('loadEditGroupExistingServices: All services:', allServices);
                    
                    // Filter to show only extra services (exclude transport and form-managed services)
                    // Include: -999 (Extended Stay) - from booking_extension table
                    // Exclude: 
                    // -101 (Pick-up), -102 (Drop-off) - from old system
                    // 72 (Late Checkout), 74 (Breakfast Adult), 75 (Breakfast Kid), 76 (Pick-up), 77 (Drop-off) - managed by checkboxes
                    const excludedServiceIds = [-101, -102, 72, 74, 75, 76, 77];
                    
                    const extraServicesOnly = allServices.filter(service => {
                        const serviceId = parseInt(service.SERVICE_ID);
                        return !excludedServiceIds.includes(serviceId);
                    });
                    
                    console.log('loadEditGroupExistingServices: Filtered extra services:', extraServicesOnly);
                    
                    window.editGroupAddedServicesMap[groupBookingId] = extraServicesOnly.map(service => {
                        const quantity = parseInt(service.QTY || service.QUANTITY || 1);
                        const totalCost = parseFloat(service.TOTAL_COST || 0);
                        
                        // For Extended Stay (SERVICE_ID = -999), the backend provides COST (per unit) in TOTAL_COST field
                        // But we need to calculate: costPerUnit = COST, and display total = COST * QTY
                        // For other services, TOTAL_COST is the total, so we need to divide by quantity
                        let costPerUnit;
                        if (service.SERVICE_ID === -999) {
                            // Extended Stay: TOTAL_COST from backend is COST (per unit), not total
                            // So costPerUnit = TOTAL_COST directly
                            costPerUnit = totalCost;
                        } else {
                            // Other services: Calculate cost per unit (total cost divided by quantity)
                            costPerUnit = quantity > 0 ? totalCost / quantity : totalCost;
                        }
                        
                        return {
                            SERVICE_ID: service.SERVICE_ID,
                            SERVICE_NAME: service.SERVICE_NAME,
                            SERVICE_COST: costPerUnit,
                            QUANTITY: quantity,
                            STATUS: (service.STATUS || 'unpaid').toLowerCase(),
                            IS_CUSTOM: service.SERVICE_ID === -1,
                            ALREADY_SAVED: true,
                            BOOKING_ID: service.BOOKING_ID, // Store booking ID for Individual Billing
                            ROOM_NUMBER: service.ROOM_NUMBER // Store room number for display
                        };
                    });
                    
                    console.log('loadEditGroupExistingServices: Mapped services:', window.editGroupAddedServicesMap[groupBookingId]);
                    updateEditGroupAddedServicesList(groupBookingId);
                    if (typeof computeEditGroupTotal === 'function') {
                        computeEditGroupTotal();
                    }
                })
                .catch(error => {
                    console.error('Error loading existing services:', error);
                    // Initialize empty array on error
                    window.editGroupAddedServicesMap[groupBookingId] = [];
                    updateEditGroupAddedServicesList(groupBookingId);
                    if (typeof computeEditGroupTotal === 'function') {
                        computeEditGroupTotal();
                    }
                });
        })
        .catch(error => {
            console.error('Error loading group booking details:', error);
            window.editGroupAddedServicesMap[groupBookingId] = [];
            updateEditGroupAddedServicesList(groupBookingId);
            if (typeof computeEditGroupTotal === 'function') {
                computeEditGroupTotal();
            }
        });
}
