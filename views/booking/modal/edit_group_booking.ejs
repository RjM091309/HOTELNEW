  // Manual selection handlers for edit modal
  function attachEditGroupManualSelectionHandlers() {
    $('#editGroupRoomsList').on('change', '.edit-group-manual-checkbox', function() {
      const roomId = $(this).data('room-id');
      const roomIdNum = parseInt(roomId, 10);
      if ($(this).is(':checked')) {
        if (window.editGroupManualSelectedRooms.length < parseInt($('#editGroupNumberOfRooms').val(), 10)) {
          window.editGroupManualSelectedRooms.push(roomId);
        } else {
          $(this).prop('checked', false);
          return;
        }
      } else {
        // Remove by both string and number versions
        window.editGroupManualSelectedRooms = window.editGroupManualSelectedRooms.filter(id =>
          id !== roomId && id !== roomIdNum && id !== String(roomIdNum)
        );
      }
      
      // Refresh the disabled state of all checkboxes
      refreshEditManualSelectionDisabledState();
      updateEditManualSelectedRoomValues();
      computeEditGroupTotal();
    });
  }

  function hasReachedEditManualSelectionLimit() {
    const neededRooms = parseInt($('#editGroupNumberOfRooms').val(), 10) || 0;
    const selectedCount = window.editGroupManualSelectedRooms.length;

    if (editGroupRequiredBed1 || editGroupRequiredBed2) {
      const summary = getEditManualBedSummary();
      if (summary.bed1 >= editGroupRequiredBed1 && summary.bed2 >= editGroupRequiredBed2 && selectedCount >= neededRooms) {
        return true;
      }
      return selectedCount >= neededRooms;
    }

    return neededRooms > 0 && selectedCount >= neededRooms;
  }

  function getEditManualBedSummary() {
    const summary = { bed1: 0, bed2: 0 };
    window.editGroupManualSelectedRooms.forEach(roomId => {
      const room = editGroupAvailableRooms.find(r => r.IDNo === roomId);
      if (room) {
        const bedCount = parseInt(room.ROOM_BED, 10);
        if (bedCount === 1) summary.bed1++;
        else if (bedCount === 2) summary.bed2++;
      }
    });
    return summary;
  }

  function refreshEditManualSelectionDisabledState() {
    const limitReached = hasReachedEditManualSelectionLimit();
    const summary = getEditManualBedSummary();
    $('#editGroupRoomsList .edit-group-manual-checkbox').each(function() {
      const roomId = parseInt($(this).data('room-id'), 10);
      const room = editGroupAvailableRooms.find(r => r.IDNo === roomId);
      const bedType = room ? parseInt(room.ROOM_BED, 10) : null;

      // Only disable rooms that are NOT needed
      if (editGroupRequiredBed2 === 0 && bedType === 2) {
        // If 0 2-bed rooms needed, disable all 2-bed rooms only  
        $(this).prop('checked', false).prop('disabled', true);
        window.editGroupManualSelectedRooms = window.editGroupManualSelectedRooms.filter(id => id !== roomId);
        return;
      }

      if (editGroupRequiredBed1 || editGroupRequiredBed2) {
        if (bedType === 1 && summary.bed1 >= editGroupRequiredBed1 && !window.editGroupManualSelectedRooms.includes(roomId)) {
          $(this).prop('disabled', true);
          return;
        }
        if (bedType === 2 && summary.bed2 >= editGroupRequiredBed2 && !window.editGroupManualSelectedRooms.includes(roomId)) {
          $(this).prop('disabled', true);
          return;
        }
      }

      if (limitReached && !window.editGroupManualSelectedRooms.includes(roomId)) {
        $(this).prop('disabled', true);
      } else {
        $(this).prop('disabled', false);
      }
    });
  }

  function updateEditManualSelectedRoomValues() {
    const selectedRooms = editGroupAvailableRooms.filter(room =>
      window.editGroupManualSelectedRooms.includes(room.IDNo) ||
      window.editGroupManualSelectedRooms.includes(String(room.IDNo)) ||
      window.editGroupManualSelectedRooms.includes(parseInt(room.IDNo))
    );
    const dates = getEditSelectedDateRange();
    const bookingType = $('#editGroupBookingRoute').val();

    // For originally selected rooms that might not have complete data, use a default price
    const computedBasePrices = selectedRooms.map(room => {
      if (typeof room.RESOLVED_PRICE === 'number' && room.RESOLVED_PRICE > 0) {
        return room.RESOLVED_PRICE;
      }

      // Try to calculate from seasonal prices
      if (dates && room.SEASONAL_PRICES && room.SEASONAL_PRICES.length > 0) {
        const bedCount = parseInt(room.ROOM_BED, 10) || 1;
        const seasonId = getSeasonIdForDate(dates.start, room.SEASONAL_PRICES);
        if (seasonId !== null) {
          const match = room.SEASONAL_PRICES.find(price =>
            parseInt(price.bedCount, 10) === bedCount &&
            price.bookingType === bookingType &&
            parseInt(price.seasonId, 10) === parseInt(seasonId, 10)
          );
          if (match) {
            return parseFloat(match.price);
          }
        }
      }

      // Default fallback price
      return 1000; // Default room price
    });

    $('#editGroupSelectedRooms').val(selectedRooms.map(room => room.IDNo).join(','));
    $('#editGroupSelectedRoomPrices').val(computedBasePrices.join(','));

    // Update room breakdown if needed
    if (selectedRooms.length > 0) {
      populateEditBreakdown(selectedRooms, computedBasePrices);
    }
  }

  function populateEditBreakdown(selectedRooms, computedPrices) {
    const container = $('#editGroupRoomBreakdown');
    container.empty();
    if (!selectedRooms || !selectedRooms.length) {
      return;
    }

    const nights = parseInt($('#editGroupNights').val(), 10) || 0;
    let html = '<div class="group-room-breakdown"><b>Selected Room Prices:</b><ul>';
    selectedRooms.forEach((room, idx) => {
      const price = computedPrices[idx] || 0;
      const total = nights > 0 ? price * nights : price;
      html += `<li>Room ${room.ROOM_NUMBER}: ₱${price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} per night ${nights > 0 ? `(${formatCurrency(total)} total)` : ''}</li>`;
    });
    html += '</ul></div>';
    container.html(html);
  }

  // Initialize event handlers
  $(document).ready(function() {
    attachEditGroupRoomSelectionHandler();
    attachEditGroupManualSelectionHandlers();
    handleEditGroupSearchRooms();
    
    // Add event handlers for bed requirement changes
    $('#editGroupBed1Count, #editGroupBed2Count').on('input change', function() {
      editGroupRequiredBed1 = parseInt($('#editGroupBed1Count').val(), 10) || 0;
      editGroupRequiredBed2 = parseInt($('#editGroupBed2Count').val(), 10) || 0;
      refreshEditManualSelectionDisabledState();
    });

    // Auto-search when status changes
    $('#editGroupCheckInStatus, #editGroupCheckOutStatus').on('change', function() {
      // Clear selected rooms when status changes
      window.editGroupManualSelectedRooms = [];
      $('#editGroupSelectedRooms').val('');
      $('#editGroupSelectedRoomPrices').val('');
      $('#editGroupRoomBreakdown').empty();
      
      // Refresh room selection state
      refreshEditManualSelectionDisabledState();
      
      const daterange = $('#editGroupDaterange').val();
      const numberOfRooms = $('#editGroupNumberOfRooms').val();
      const bookingRoute = $('#editGroupBookingRoute').val();
      const checkInStatus = $('#editGroupCheckInStatus').val();
      const checkOutStatus = $('#editGroupCheckOutStatus').val();
      
      // Only auto-search if all required fields are filled
      if (daterange && numberOfRooms && bookingRoute && checkInStatus && checkOutStatus) {
        $('#editGroupSearchRooms').click();
      }
    });

    // Auto-compute total when fees, discounts, or services change
    $('#editGroupReservationFee, #editGroupDiscount').on('input change', function() {
      computeEditGroupTotal();
    });

    // Auto-compute total when breakfast quantities or prices change
    $('#editGroupBreakfastAdultQty, #editGroupBreakfastAdultPrice, #editGroupBreakfastKidQty, #editGroupBreakfastKidPrice').on('input change', function() {
      computeEditGroupTotal();
    });

    // Auto-compute total when pickup/dropoff prices change
    $('#editGroupPickupPrice, #editGroupDropoffPrice').on('input change', function() {
      computeEditGroupTotal();
    });

    // Auto-compute total when checkboxes are toggled
    $('#editGroupIncludeReservationFee, #editGroupIncludeDiscount, #editGroupIncludeBreakfast, #editGroupIncludePickup, #editGroupIncludeDropoff, #editGroupConsolidatedBilling').on('change', function() {
      computeEditGroupTotal();
    });

    // Set service IDs when checkboxes are checked
    $('#editGroupIncludeBreakfast').on('change', function() {
      if ($(this).is(':checked')) {
        $('#editGroupBreakfastAdultId').val('74'); // Breakfast adult service ID
        $('#editGroupBreakfastKidId').val('75'); // Breakfast kid service ID
      }
    });

    $('#editGroupIncludePickup').on('change', function() {
      if ($(this).is(':checked')) {
        $('#editGroupPickupServiceId').val('76'); // Pickup service ID
      }
    });

    $('#editGroupIncludeDropoff').on('change', function() {
      if ($(this).is(':checked')) {
        $('#editGroupDropoffServiceId').val('77'); // Dropoff service ID
      }
    });
  });

})();
</script>
