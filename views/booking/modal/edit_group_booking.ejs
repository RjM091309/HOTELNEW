<!-- Edit Group Booking Modal -->
<link rel="stylesheet" href="/plugins/flatpicker/flatpickr.min.css">

<div class="modal fade" id="modal-edit-group-booking" tabindex="-1" role="dialog" aria-labelledby="modalEditGroupBookingLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title" id="modalEditGroupBookingLabel">Edit Group Booking</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="window.location.reload()"></button>
      </div>
      <div class="modal-body">
        <form id="editGroupBookingForm" autocomplete="off">
          <input type="hidden" id="editGroupBookingId" name="groupBookingId">
          <input type="hidden" id="editGroupVoucherNo" name="groupVoucherNo">
          <input type="hidden" id="editGroupSelectedRooms" name="groupSelectedRooms">
          <input type="hidden" id="editGroupSelectedRoomPrices" name="groupSelectedRoomPrices">
          <input type="hidden" id="editGroupSelectedRoomNumbers" name="groupSelectedRoomNumbers">
          <input type="hidden" id="editGroupNights" name="groupNights" value="0">

          <div class="row">
            <div class="col-lg-6">
              <div class="form-group">
                <label class="form-label">Select Date From To</label>
                <input type="text" class="form-control flatpickr-input" id="editGroupDaterange" name="groupDaterange" required>
              </div>
            </div>
            <div class="col-lg-3">
              <div class="form-group">
                <label class="form-label">Number of Rooms Needed</label>
                <input type="number" class="form-control" id="editGroupNumberOfRooms" name="groupNumberOfRooms" min="1" required>
              </div>
            </div>
            <div class="col-lg-3">
              <div class="form-group">
                <label class="form-label">Select Floor (Optional)</label>
                <select class="form-select" id="editGroupFloorSelect" name="groupFloorSelect">
                  <option value="" selected>Select Floor</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-6">
              <div class="form-group">
                <label class="form-label">Check-In Status</label>
                <select class="form-select" id="editGroupCheckInStatus" name="groupCheckInStatus" required>
                  <option value="" disabled selected>Check-In Status</option>
                  <option value="1">Regular Check In</option>
                  <option value="0">Late Check In</option>
                </select>
              </div>
            </div>
            <div class="col-lg-6">
              <div class="form-group">
                <label class="form-label">Check-Out Status</label>
                <select class="form-select" id="editGroupCheckOutStatus" name="groupCheckOutStatus" required>
                  <option value="" disabled selected>Check-Out Status</option>
                  <option value="0">Regular Check Out</option>
                  <option value="1">Late Check Out</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-12 d-flex align-items-center gap-3 flex-wrap">
              <div class="form-group mb-0">
                <label class="form-label mb-1">Bed Requirements</label>
                <div class="d-flex gap-3 flex-wrap">
                  <div class="bed-requirement-group">
                    <label class="form-label mb-1">1 Bed</label>
                    <input type="number" class="form-control" id="editGroupBed1Count" name="groupBed1Count" min="0" value="0">
                  </div>
                  <div class="bed-requirement-group">
                    <label class="form-label mb-1">2 Beds</label>
                    <input type="number" class="form-control" id="editGroupBed2Count" name="groupBed2Count" min="0" value="0">
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-12 d-flex justify-content-start">
              <button type="button" class="btn btn-success" id="editGroupSearchRooms">Search Rooms</button>
            </div>
          </div>

          <div class="row p-t-20" id="editGroupResultsContainer" style="display: none;">
            <div class="col-lg-12">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Available Rooms</h5>
              </div>
              <div id="editGroupRoomsList" class="room-list-container"></div>
              <div class="mt-2 text-warning" id="editGroupAvailabilityWarning" style="display: none;"></div>
              <div id="editGroupRoomBreakdown" class="mt-3"></div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-6">
              <div class="form-group">
                <label class="form-label">Group Name</label>
                <input type="text" class="form-control" id="editGroupName" name="groupName" required>
              </div>
            </div>
            <div class="col-lg-6">
              <div class="form-group">
                <label class="form-label">Group Contact Number</label>
                <input type="text" class="form-control" id="editGroupContact" name="groupContact" required>
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-6">
              <div class="form-group">
                <label class="form-label">Booking Resources</label>
                <select class="form-select" id="editGroupBookingRoute" name="groupBookingRoute" required>
                  <option value="" disabled>Select Booking Resource</option>
                  <option value="walk-in">Walk-in</option>
                  <option value="agency">Agency</option>
                  <option value="booking-channel">Booking Channel</option>
                </select>
              </div>
            </div>
            <div class="col-lg-6" id="editGroupAgencyWrapper" style="display: none;">
              <div class="form-group">
                <label class="form-label">Select Agency</label>
                <select class="form-select" id="editGroupAgencySelect" name="groupAgencySelect">
                  <option value="" disabled selected>Select Agency</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-4">
              <div class="form-group">
                <label class="form-label">Payment Status</label>
                <select class="form-select" id="editGroupPaymentStatus" name="groupPaymentStatus" required>
                  <option value="" disabled selected>Payment Status</option>
                  <option value="paid">Paid</option>
                  <option value="unpaid">Unpaid</option>
                </select>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="form-group">
                <label class="form-label">Guest Type</label>
                <select class="form-select" id="editGroupGuestType" name="groupGuestType" required>
                  <option value="" disabled selected>Guest Type</option>
                </select>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="form-group">
                <label class="form-label">Guest Level</label>
                <select class="form-select" id="editGroupGuestLevel" name="groupGuestLevel" required>
                  <option value="" disabled selected>Guest Level</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-12">
              <div class="form-group">
                <label class="form-label">Remarks</label>
                <textarea class="form-control" id="editGroupRemarks" name="groupRemarks" rows="3" placeholder="Enter any additional remarks or notes for this group booking..."></textarea>
              </div>
            </div>
          </div>

          <div class="row p-t-20 align-items-start">
            <div class="col-lg-4">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="editGroupIncludeBreakfast" name="groupIncludeBreakfast">
                <label class="form-check-label" for="editGroupIncludeBreakfast">Add Breakfast</label>
              </div>
              <div id="editGroupBreakfastFields" class="group-breakfast-fields d-none">
                <div class="group-quantity-wrapper">
                  <input type="number" class="form-control" id="editGroupBreakfastAdultQty" name="groupBreakfastAdultQty" placeholder="Adult Qty" style="max-width: 90px;">
                  <input type="number" class="form-control" id="editGroupBreakfastAdultPrice" name="groupBreakfastAdultPrice" placeholder="Adult Price" min="0" step="0.01">
                  <input type="hidden" id="editGroupBreakfastAdultId" name="groupBreakfastAdultId">
                </div>
                <div class="group-quantity-wrapper">
                  <input type="number" class="form-control" id="editGroupBreakfastKidQty" name="groupBreakfastKidQty" placeholder="Kid Qty" style="max-width: 90px;">
                  <input type="number" class="form-control" id="editGroupBreakfastKidPrice" name="groupBreakfastKidPrice" placeholder="Kid Price" min="0" step="0.01">
                  <input type="hidden" id="editGroupBreakfastKidId" name="groupBreakfastKidId">
                </div>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="editGroupIncludePickup" name="groupIncludePickup">
                <label class="form-check-label" for="editGroupIncludePickup">Add Pick-up</label>
              </div>
              <div id="editGroupPickupWrapper" class="mt-2" style="display: none;">
                <input type="number" class="form-control" id="editGroupPickupPrice" name="groupPickupPrice" placeholder="Pick-up Price" min="0" step="0.01">
                <input type="hidden" id="editGroupPickupServiceId" name="groupPickupServiceId">
              </div>
            </div>
            <div class="col-lg-4">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="editGroupIncludeDropoff" name="groupIncludeDropoff">
                <label class="form-check-label" for="editGroupIncludeDropoff">Add Drop-off</label>
              </div>
              <div id="editGroupDropoffWrapper" class="mt-2" style="display: none;">
                <input type="number" class="form-control" id="editGroupDropoffPrice" name="groupDropoffPrice" placeholder="Drop-off Price" min="0" step="0.01">
                <input type="hidden" id="editGroupDropoffServiceId" name="groupDropoffServiceId">
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-4">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="editGroupIncludeReservationFee">
                <label class="form-check-label" for="editGroupIncludeReservationFee">Reservation Fee (Group)</label>
              </div>
              <div id="editGroupReservationFeeWrapper" class="mt-2" style="display: none;">
                <input type="number" class="form-control" id="editGroupReservationFee" name="groupReservationFee" min="0" value="0">
              </div>
            </div>
            <div class="col-lg-4">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="editGroupIncludeDiscount">
                <label class="form-check-label" for="editGroupIncludeDiscount">Discount (Group)</label>
              </div>
              <div id="editGroupDiscountWrapper" class="mt-2" style="display: none;">
                <input type="number" class="form-control" id="editGroupDiscount" name="groupDiscount" min="0" value="0">
              </div>
            </div>
            <div class="col-lg-4">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="editGroupConsolidatedBilling">
                <label class="form-check-label" for="editGroupConsolidatedBilling">Master Billing</label>
              </div>
              <div class="form-text">
                <small class="text-muted">All charges (rooms, services, fees) go to main booking only</small>
              </div>
            </div>
          </div>

          <hr class="my-4">
          <div class="row p-t-20">
            <div class="col-lg-6">
              <h3>Total: <span id="editGroupComputedTotal">₱0.00</span></h3>
              <div id="editGroupCreditDisplay" style="display: none; margin-top: 10px;">
                <span style="color: #28a745; font-weight: bold;">Credit: <span id="editGroupCreditAmount">₱0.00</span></span>
              </div>
            </div>
            <div class="col-lg-6">
              <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-success" id="btnEditGroupVoucherPreview">Voucher</button>
                <button type="submit" class="btn btn-primary">Update Booking</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="window.location.reload()">Close</button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

