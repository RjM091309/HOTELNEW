<script>
// Make editGroupManualSelectedRooms global so it can be accessed from other scripts
window.editGroupManualSelectedRooms = [];

(function() {
  let editGroupFlatpickrInstance = null;
  let editGroupBlocks = [];
  let editGroupNonConsecutiveBlocks = [];
  let editGroupAvailableRooms = [];
  let editGroupManualMode = false;
  let editGroupPickupBasePrice = '';
  let editGroupPickupBaseId = '';
  let editGroupDropoffBasePrice = '';
  let editGroupDropoffBaseId = '';
  let editGroupBreakfastAdultBasePrice = '';
  let editGroupBreakfastAdultBaseId = '';
  let editGroupBreakfastKidBasePrice = '';
  let editGroupBreakfastKidBaseId = '';
  let editGroupRequiredBed1 = 0;
  let editGroupRequiredBed2 = 0;
  let editGroupUnassignedConflicts = [];

  function resetEditGroupForm() {
    $('#editGroupBookingForm')[0].reset();
    $('#editGroupSelectedRooms').val('');
    $('#editGroupSelectedRoomPrices').val('');
    $('#editGroupNights').val('0');
    editGroupBlocks = [];
    editGroupNonConsecutiveBlocks = [];
    editGroupAvailableRooms = [];
    editGroupManualMode = false;
    // Don't reset window.editGroupManualSelectedRooms here - it should be preserved during edit
    editGroupRequiredBed1 = 0;
    editGroupRequiredBed2 = 0;
    editGroupUnassignedConflicts = [];
    $('#editGroupAgencyWrapper').hide();
    $('#editGroupRoomsList').empty();
    $('#editGroupResultsContainer').hide();
    $('#editGroupComputedTotal').html('₱0.00');
