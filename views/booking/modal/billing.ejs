                                    </button>
                                    <button onclick="printDiv('printableArea')" class="btn btn-print" type="button">
                                        <i class="fa fa-print"></i> Print Receipt
                                    </button>
                                    <button id="generateInvoiceBtn" class="btn btn-invoice" type="button">
                                        <i class="fa fa-file-pdf-o"></i> Generate Invoice
                                    </button>
