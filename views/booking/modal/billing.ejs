<div class="modal fade" id="modal-billing" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" style="z-index: 1070 !important;">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <!-- Added id="printableArea" here so that printDiv() can find the element -->
        <div class="modal-content" id="printableArea">
            <div class="modal-header">
                <h4 class="modal-title">Room No. <span id="billingRoomNumber">N/A</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="white-box billing-receipt-container">
                            <input type="hidden" id="hiddenBookingId" name="hiddenBookingId">
                            
                            <!-- Enhanced Header Section -->
                            <div class="billing-header">
                                <h2 class="billing-title">
                                    <i class="fa fa-file-text-o"></i>
                                    Billing Receipt
                                    <span class="receipt-number">#<span id="confNumber"></span></span>
                                </h2>
                                <div class="billing-divider"></div>
                            </div>
                            
                            <div class="row billing-content">
                                <!-- Left Section: Hotel Info -->
                                <div class="col-md-6">
                                    <div class="hotel-info-section">
                                        <div class="hotel-logo-container">
                                            <img src="/img/Logo-Black.png" alt="Main Stay Hotel" class="hotel-logo" style="height: 80px; width: auto; max-width: 180px; object-fit: contain; display: block; margin: 0;" />
                                        </div>
                                        <div class="hotel-address">
                                            <p><i class="fa fa-map-marker"></i> Clark Terrace Building, Lot 2 Block 1</p>
                                            <p><i class="fa fa-building"></i> The Villages Prince Balagtas Avenue</p>
                                            <p><i class="fa fa-road"></i> Clark Freeport Zone, Pampanga, 2023</p>
                                            <p><i class="fa fa-phone"></i> (GLOBE) 0945 146 7000 · (SMART) 0969 049 7000</p>
                                        </div>
                                    </div>
                                </div>
                            
                                <!-- Right Section: Customer Info -->
                                <div class="col-md-6">
                                    <div class="customer-info-section">
                                        <div class="customer-header bill-to-header">
                                            <h4 class="bill-to-line">
                                                <i class="fa fa-user"></i>
                                                <span class="bill-to-label">Bill To:</span>
                                                <span class="customer-name" id="customerName"></span>
                                                <span class="bill-to-room" id="billingReceiptRoomNo"></span>
                                            </h4>
                                        </div>
                                        <div class="customer-details">
                                            <div class="customer-address" id="customerAddress">
                                                <!--CUSTOMER ADDRESS-->
                                            </div>
                                        </div>
                                        <div class="invoice-date">
                                            <p><i class="fa fa-calendar"></i> <strong>Invoice Date:</strong></p>
                                            <span class="date-value" id="invoiceDate">N/A</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Enhanced Table Section -->
                            <div class="billing-table-section">
                                <div class="table-responsive">
                                    <table class="table table-hover billing-table">
                                        <colgroup>
                                            <col class="col-w-index">
                                            <col class="col-w-date">
                                            <col class="col-w-desc">
                                            <col class="col-w-money">
                                            <col class="col-w-money">
                                            <col class="col-w-money">
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th class="col-index">#</th>
                                                <th class="col-date">Date</th>
                                                <th class="col-desc">Descriptions</th>
                                                <th class="col-money">Base Price</th>
                                                <th class="col-money">Days / QTY</th>
                                                <th class="col-money">Sub Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                           
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            
                            <!-- Enhanced Summary Section -->
                            <div class="billing-summary-section">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="payment-notes">
                                            <div class="note-item">
                                                <i class="fa fa-bed"></i>
                                                <span style="font-size: 1.05rem;">Total Room Charges: <strong id="totalRoomCharges">0.00</strong></span>
                                            </div>
                                            <div class="note-item">
                                                <i class="fa fa-concierge-bell"></i>
                                                <span style="font-size: 1.05rem;">Total Services: <strong id="totalServices">0.00</strong></span>
                                            </div>
                                            <div class="note-item" id="totalPenaltyRow" style="display: none;">
                                                <i class="fa fa-exclamation-triangle"></i>
                                                <span style="font-size: 1.05rem;">Cancellation Fee: <strong id="totalPenalty">0.00</strong></span>
                                            </div>
                                            <div class="note-item">
                                                <i class="fa fa-check-circle"></i>
                                                <span>Receipt generated on <span id="generatedDate"></span></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="payment-summary">
                                            <!-- Paid Image Overlay -->
                                            <div class="paid-image-overlay" id="paidImageOverlay" style="display: none;">
                                                <img id="paidImage" src="/img/paid.png" alt="Paid" class="paid-overlay-image" />
                                            </div>
                                            
                                           
                                            <!-- Total Paid Before Refund (Conditional - only show if there's a refund) -->
                                            <div class="summary-row" id="totalPaidBeforeRefundRow" style="display: none;">
                                                <span class="summary-label">Total Paid (Before Cancelled):</span>
                                                <span class="summary-value paid-before-refund-amount" id="totalPaidBeforeRefund">0.00</span>
                                            </div>

                                            <!-- Per-payment breakdown -->
                                            <div class="payment-breakdown-block" id="billingPaymentBreakdownBlock">
                                                <div class="payment-breakdown-title">Payment Details</div>
                                                <div class="payment-breakdown-table-wrap">
                                                    <table class="payment-breakdown-table" id="billingPaymentBreakdownTable">
                                                        <thead>
                                                            <tr>
                                                                <th>Date</th>
                                                                <th>Method</th>
                                                                <th>Payment Status</th>
                                                                <th class="text-end">Amount</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="billingPaymentBreakdownBody"></tbody>
                                                    </table>
                                                </div>
                                                <div class="payment-breakdown-empty" id="billingPaymentBreakdownEmpty" style="display: none;">
                                                    No payments recorded yet.
                                                </div>
                                            </div>

                                            <div class="summary-row" id="paidAmountRow">
                                                <span class="summary-label" id="paidAmountLabel">Total Paid:</span>
                                                <span class="summary-value paid-amount" id="totalPaid">0.00</span>
                                            </div>
                                             <!-- Reservation Fee (Conditional) -->
                                             <div class="summary-row" id="reservationFeeRow">
                                                <span class="summary-label">Reservation Fee:</span>
                                                <span class="summary-value reservation-fee-amount" id="billingReservationFeeAmount"></span>
                                            </div>
                                            <!-- Discount (Conditional) -->
                                            <div class="summary-row" id="discountRow">
                                                <span class="summary-label">Discount:</span>
                                                <span class="summary-value discount-amount" id="billingDiscountAmount"></span>
                                            </div>
                                            <!-- Refund Amount (Conditional - only show if there's a refund) -->
                                            <div class="summary-row" id="refundAmountRow" style="display: none;">
                                                <span class="summary-label">Refund Amount:</span>
                                                <span class="summary-value refund-amount" id="refundAmount">0.00</span>
                                            </div>
                                            <div class="summary-row">
                                                <span class="summary-label">Balance:</span>
                                                <span class="summary-value balance-amount" id="balanceAmount">₹0.00</span>
                                            </div>
                                            
                                            <div class="summary-row total-row">
                                                <span class="summary-label">Total Amount:</span>
                                                <span class="summary-value total-amount" id="totalPayment">₹0.00</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Enhanced Action Buttons -->
                            <div class="billing-actions">
                                <div class="action-buttons">
                                    <button type="button" id="proceedToPaymentButton" class="btn btn-payment" data-bs-toggle="modal" data-bs-target="#modal-payment">
                                        <i class="fa fa-credit-card"></i> Proceed to Payment
                                    </button>
                                    <div class="voucher-action-wrap">
                                        <div class="voucher-action-menu" id="printReceiptActionMenu" hidden style="display: none;" onclick="event.stopPropagation()">
                                            <button type="button" class="btn btn-sm btn-light voucher-action-btn" onclick="window.printBillingReceipt()">
                                                <i class="fa fa-print me-1"></i>Print
                                            </button>
                                            <button type="button" class="btn btn-sm btn-primary voucher-action-btn" onclick="window.sendBillingReceipt()">
                                                <i class="fa fa-paper-plane me-1"></i>Send
                                            </button>
                                        </div>
                                        <button type="button" class="btn btn-print" onclick="window.toggleActionPopup('printReceiptActionMenu', event)">
                                            <i class="fa fa-print"></i> Print Receipt
                                        </button>
                                    </div>
                                    <button type="button" class="btn btn-close-modal" data-bs-dismiss="modal">
                                        <i class="fa fa-times"></i> Close
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('payment') %>

<!-- Include external JavaScript files -->
<script>
	document.addEventListener('DOMContentLoaded', function() {
		
		// Load add_booking.js immediately - this is critical for booking functionality
		var bookingBillingScript = document.createElement('script');
		bookingBillingScript.src = '/js/booking/billing.js?v=backdrop-fix-1';
		bookingBillingScript.onload = function() {
			if (window.embedHotelLogo) {
				window.embedHotelLogo('#modal-billing .hotel-logo');
			}
		};
		document.body.appendChild(bookingBillingScript);
		
			// Set current date for generated date
	document.getElementById('generatedDate').textContent = new Date().toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric'
	});
	
	// Initialize payment status
	updatePaymentStatus();
	
	// Also check payment status after a short delay to ensure elements are loaded
	setTimeout(updatePaymentStatus, 500);
	
	// Ensure proceed to payment button is properly initialized
	setTimeout(function() {
		const proceedButton = document.getElementById('proceedToPaymentButton');
		if (proceedButton) {
			// Remove any existing event listeners
			proceedButton.replaceWith(proceedButton.cloneNode(true));
			
			// Get the new button reference
			const newProceedButton = document.getElementById('proceedToPaymentButton');
			
			// Add event listener
			newProceedButton.addEventListener('click', function(e) {
				e.preventDefault();
				e.stopPropagation();
				
				// Get the Balance (not total) from the Billing Modal
				const totalPayment = document.getElementById('balanceAmount').textContent.trim();

				// Set both old and new payment amount fields
				const paymentAmountField = document.getElementById('paymentAmount');
				const paymentAmountInputField = document.getElementById('paymentAmountInput');
				
				if (totalPayment) {
					// Remove currency symbols and parse the amount
					const cleanAmount = totalPayment.replace(/[₹$,]/g, '');
					const numericAmount = parseFloat(cleanAmount) || 0;
					
					paymentAmountField.value = totalPayment;
					paymentAmountInputField.value = numericAmount;
					
					// Calculate breakdown from billing data
					const billingTable = document.querySelector('#modal-billing table tbody');
					let roomAmount = 0;
					let extensionAmount = 0;
					let serviceAmount = 0;
					
					if (billingTable) {
						const rows = billingTable.querySelectorAll('tr');
						rows.forEach(row => {
							// Check if row has enough cells before accessing
							if (!row.cells || row.cells.length < 6) {
								return; // Skip rows that don't have the expected structure (e.g., total row)
							}
							
							const descriptionCell = row.cells[2];
							const subTotalCell = row.cells[5];
							
							// Check if cells exist and have content
							if (!descriptionCell || !subTotalCell) {
								return;
							}
							
							const description = descriptionCell.textContent ? descriptionCell.textContent.trim() : '';
							const subTotal = parseFloat(subTotalCell.textContent ? subTotalCell.textContent.replace(/[₹$,]/g, '') : '0') || 0;
							
							// Skip if description is empty or subTotal is 0
							if (!description || subTotal === 0) {
								return;
							}
							
							if (description.toLowerCase().includes('room') || description.toLowerCase().includes('bedroom')) {
								roomAmount += subTotal;
							} else if (description.toLowerCase().includes('extension') || description.toLowerCase().includes('extend')) {
								extensionAmount += subTotal;
							} else {
								serviceAmount += subTotal;
							}
						});
					}
					
					// Get reservation fee and discount
					const reservationFeeElement = document.getElementById('billingReservationFeeAmount');
					const discountElement = document.getElementById('billingDiscountAmount');
					const reservationFee = reservationFeeElement ? parseFloat(reservationFeeElement.textContent.replace(/[₹$,]/g, '')) || 0 : 0;
					const discountAmount = discountElement ? parseFloat(discountElement.textContent.replace(/[₹$,]/g, '')) || 0 : 0;
					
					console.log('Payment Summary Debug:', {
						roomAmount,
						extensionAmount,
						serviceAmount,
						reservationFee,
						discountAmount,
						numericAmount
					});
					
					// Get amount already paid from billing data
					const totalPaidElement = document.getElementById('totalPaid');
					const amountPaid = totalPaidElement ? parseFloat(totalPaidElement.textContent.replace(/[₹$,]/g, '')) || 0 : 0;
					
					console.log('Amount Paid Debug:', amountPaid);
					
					// Update Payment Summary Card with breakdown
					if (typeof updatePaymentSummaryCard === 'function') {
						const roomNumber = document.getElementById('hiddenBookingId')?.dataset.roomNumber || '';
						updatePaymentSummaryCard(numericAmount, {
							roomNumber: roomNumber,
							roomAmount: roomAmount,
							extensionAmount: extensionAmount,
							serviceAmount: serviceAmount,
							reservationFee: reservationFee,
							discountAmount: discountAmount,
							amountPaid: amountPaid
						});
					} else {
						// Fallback to simple update
						const paymentTotalAmountElement = document.getElementById('paymentTotalAmount');
						
						if (paymentTotalAmountElement) {
							paymentTotalAmountElement.textContent = numericAmount.toLocaleString('en-US', {minimumFractionDigits: 2});
						}
					}
				} else {
					paymentAmountField.value = "N/A";
					paymentAmountInputField.value = 0;
					
					// Reset Payment Summary Card elements
					if (typeof updatePaymentSummaryCard === 'function') {
						updatePaymentSummaryCard(0, {});
					} else {
						const paymentTotalAmountElement = document.getElementById('paymentTotalAmount');
						
						if (paymentTotalAmountElement) {
							paymentTotalAmountElement.textContent = '0.00';
						}
					}
				}

				// Close billing modal first
				const billingModal = bootstrap.Modal.getInstance(document.getElementById('modal-billing'));
				if (billingModal) {
					billingModal.hide();
				}

				// Show payment modal
				const paymentModal = new bootstrap.Modal(document.getElementById('modal-payment'));
				paymentModal.show();
			});
		}
	}, 1000);
	});
	
	// Function to update payment status and show/hide paid image
	function updatePaymentStatus() {
		const totalPaidElement = document.getElementById('totalPaid');
		const totalPaymentElement = document.getElementById('totalPayment');
		const balanceAmountElement = document.getElementById('balanceAmount');
		const paidImageOverlay = document.getElementById('paidImageOverlay');
		const proceedBtn = document.getElementById('proceedToPaymentButton');
		
		// Check if elements exist
		if (!totalPaidElement || !totalPaymentElement || !balanceAmountElement || !paidImageOverlay) {
			return;
		}
		
		// Parse amounts, handling both ₹ and ₱ currency symbols
		const totalPaid = parseFloat(totalPaidElement.textContent.replace(/[₹₱,]/g, '')) || 0;
		const totalPayment = parseFloat(totalPaymentElement.textContent.replace(/[₹₱,]/g, '')) || 0;
		const balanceAmount = parseFloat(balanceAmountElement.textContent.replace(/[₹₱,]/g, '')) || 0;
		
		// Check if payment is truly complete - improved logic
		// Balance should be 0 or less, and there should be payments made
		const isPaymentComplete = (balanceAmount <= 0 && totalPaid > 0 && totalPayment > 0);
		
		if (isPaymentComplete) {
			// Show paid image only when payment is complete
			paidImageOverlay.style.display = 'block';
			paidImageOverlay.classList.add('show-paid-status');
			
			// Update proceed button to show "Payment Completed"
			if (proceedBtn) {
				proceedBtn.disabled = true;
				proceedBtn.textContent = 'Payment Completed';
				proceedBtn.classList.remove('btn-payment');
				proceedBtn.classList.add('btn-success');
			}
		} else {
			// Hide paid image for unpaid or partial payments
			paidImageOverlay.style.display = 'none';
			paidImageOverlay.classList.remove('show-paid-status');
			
			// Update proceed button to show "Proceed to Payment"
			if (proceedBtn) {
				proceedBtn.disabled = false;
				proceedBtn.textContent = 'Proceed to Payment';
				proceedBtn.classList.remove('btn-success');
				proceedBtn.classList.add('btn-payment');
			}
		}
	}
	
	// Function to be called when payment data is updated
	function refreshPaymentStatus() {
		updatePaymentStatus();
	}
	
	// Function to manually check payment status (for debugging)
	function checkPaymentStatus() {
		updatePaymentStatus();
	}
	
	// Function to force show paid image (for testing)
	function forceShowPaidImage() {
		const paidImageOverlay = document.getElementById('paidImageOverlay');
		if (paidImageOverlay) {
			paidImageOverlay.style.display = 'block';
			paidImageOverlay.classList.add('show-paid-status');
		}
	}
	
	// printDiv() is provided by /js/booking/billing.js
</script>

