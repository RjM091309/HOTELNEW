/* Paid Image Overlay */
#modal-billing .paid-image-overlay {
    position: absolute;
    top: 50px;
    right: 160px;
    z-index: 10;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.8) rotate(15deg);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

#modal-billing .paid-image-overlay.show-paid-status {
    opacity: 1;
    transform: scale(1) rotate(15deg);
}

#modal-billing .paid-overlay-image {
    width: 160px;
    height: auto;
    opacity: 0.9;
    filter: drop-shadow(0 4px 15px rgba(0, 0, 0, 0.2));
    transform: rotate(15deg);
}

/* Animation for paid status */
@keyframes paidStampAppear {
    0% {
        opacity: 0;
        transform: scale(0.5) rotate(15deg);
    }
    50% {
        transform: scale(1.1) rotate(15deg);
    }
    100% {
        opacity: 1;
        transform: scale(1) rotate(15deg);
    }
}

#modal-billing .paid-image-overlay.show-paid-status {
    animation: paidStampAppear 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

