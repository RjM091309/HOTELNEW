<script>
	document.addEventListener('DOMContentLoaded', function() {
		
		// Load add_booking.js immediately - this is critical for booking functionality
		var bookingScript = document.createElement('script');
		bookingScript.src = '/js/booking/late_checkout_fee.js';
		document.body.appendChild(bookingScript);
		bookingScript.onload = function() {
			var bookingBillingScript = document.createElement('script');
			bookingBillingScript.src = '/js/booking/add_booking.js';
			document.body.appendChild(bookingBillingScript);
		};

		// Load booking_submit.js for form submission handling
		var submitScript = document.createElement('script');
		submitScript.src = '/js/booking/booking_submit.js';
		document.body.appendChild(submitScript);

		// When the Add Booking modal is shown, apply saved check-in/out preferences
		try {
			const modal = document.getElementById('modal-addbooking');
			if (modal) {
				modal.addEventListener('shown.bs.modal', function () {
					try {
						const prefIn = localStorage.getItem('bookingCheckinPref');
						const prefOut = localStorage.getItem('bookingCheckoutPref');
						const inField = document.getElementById('checkInStatus');
						const outField = document.getElementById('checkOutStatus');
                        if (inField && (prefIn === 'R/I' || prefIn === 'L/I')) {
                            inField.value = (prefIn === 'R/I') ? '1' : '0';
                            inField.dispatchEvent(new Event('change'));
                        }
                        if (outField && (prefOut === 'R/O' || prefOut === 'L/O')) {
                            outField.value = (prefOut === 'R/O') ? '0' : '1';
                            outField.dispatchEvent(new Event('change'));
                        }
					} catch (e) { /* no-op */ }

					// Re-assert after a tick in case other scripts adjust defaults
					setTimeout(() => {
						try {
							const prefIn2 = localStorage.getItem('bookingCheckinPref');
							const prefOut2 = localStorage.getItem('bookingCheckoutPref');
							const inField2 = document.getElementById('checkInStatus');
							const outField2 = document.getElementById('checkOutStatus');
                            if (inField2 && (prefIn2 === 'R/I' || prefIn2 === 'L/I')) {
                                inField2.value = (prefIn2 === 'R/I') ? '1' : '0';
                            }
                            if (outField2 && (prefOut2 === 'R/O' || prefOut2 === 'L/O')) {
                                outField2.value = (prefOut2 === 'R/O') ? '0' : '1';
                            }
						} catch (e) { /* no-op */ }
					}, 50);

					// On modal hide, restore options to normal so future opens are clean
					try {
						modal.addEventListener('hidden.bs.modal', function(){
							try {
								const inFieldR = document.getElementById('checkInStatus');
								const outFieldR = document.getElementById('checkOutStatus');
								if (inFieldR) { Array.from(inFieldR.options).forEach(function(opt){ opt.disabled = false; }); }
								if (outFieldR) { Array.from(outFieldR.options).forEach(function(opt){ opt.disabled = false; }); }
							} catch(e) {}
						});
					} catch(e) { /* no-op */ }


					// Persist any user changes to the selects so refresh keeps them
					try {
						const inFieldP = document.getElementById('checkInStatus');
						const outFieldP = document.getElementById('checkOutStatus');
						if (inFieldP) {
							inFieldP.addEventListener('change', function(){
								const code = this.value === '1' ? 'R/I' : 'L/I';
								localStorage.setItem('bookingCheckinPref', code);
							});
						}
						if (outFieldP) {
							outFieldP.addEventListener('change', function(){
								const code = this.value === '0' ? 'R/O' : 'L/O';
								localStorage.setItem('bookingCheckoutPref', code);
							});
						}
					} catch (e) { /* no-op */ }
				});
			}
		} catch (e) { /* no-op */ }
	});
</script>

<script>
// ================================
// LONG-TERM STAY TOGGLE (Add Booking)
// ================================
(function(){
    $(document).ready(function(){
        $('#includeLongTermStay').on('change', function(){
            $('#longTermStayWrapper').toggle(this.checked);
            if (!this.checked) {
                $('#roomChangeNote').val('');
            }
        });

        $('#modal-addbooking').on('hidden.bs.modal', function(){
            $('#includeLongTermStay').prop('checked', false);
            $('#longTermStayWrapper').hide();
            $('#roomChangeNote').val('');
        });
    });
})();
</script>

<script>
// ================================
// HOLD PENDING TOGGLE (Add Booking)
// Hides Check-In/Check-Out Status when the booking is marked Hold Pending,
// since those fields don't apply until the guest actually arrives.
// ================================
(function(){
    function applyHoldPendingUI(isHoldPending) {
        const $ci = $('#divtxtCheckInStatus');
        const $co = $('#divcheckOutStatus');
        const $lateFee = $('#lateCheckoutFeeDisplay');
        const $ciField = $('#checkInStatus');
        const $coField = $('#checkOutStatus');

        $ci.toggle(!isHoldPending);
        $co.toggle(!isHoldPending);

        if (isHoldPending) {
            if ($lateFee.length) $lateFee.hide();
            $ciField.prop('required', false);
            $coField.prop('required', false);
            // Default to Regular/Regular as placeholders until the guest actually checks in
            if (!$ciField.val()) $ciField.val('1');
            if (!$coField.val()) $coField.val('0');
        } else {
            $ciField.prop('required', true);
            $coField.prop('required', true);
        }
    }

    $(document).ready(function(){
        $('#holdPendingCheckbox').on('change', function(){
            applyHoldPendingUI(this.checked);
        });

        $('#modal-addbooking').on('hidden.bs.modal', function(){
            $('#holdPendingCheckbox').prop('checked', false);
            applyHoldPendingUI(false);
        });
    });
})();
</script>

<script>
// ================================
// STATUS ADJACENCY VALIDATION (Add Booking)
// ================================
(function(){
    const bookingsCache = {};

    function toISODateOnly(d) {
        const dd = new Date(d);
        return new Date(dd.getFullYear(), dd.getMonth(), dd.getDate()).toISOString().split('T')[0];
    }

    function parseDateRangeToDates() {
        const dr = $('#daterange').val() || '';
        if (!dr.includes(' to ')) return { checkIn: null, checkOut: null };
        const parts = dr.split(' to ');
        const startStr = parts[0].trim();
        const endStr = (parts[1] || '').split('(')[0].trim();
        if (!startStr || !endStr) return { checkIn: null, checkOut: null };
        const ci = new Date(startStr);
        const co = new Date(endStr);
        if (isNaN(ci.getTime()) || isNaN(co.getTime())) return { checkIn: null, checkOut: null };
        return { checkIn: toISODateOnly(ci), checkOut: toISODateOnly(co) };
    }

    function normalizeCIStatus(b) {
        const v = b.CHECK_IN_STATUS ?? b.check_in_status ?? b.checkInStatus ?? b.checkin_status ?? b.CHECKIN_STATUS ?? b.CHECK_IN;
        if (v === 1 || v === '1' || String(v).toLowerCase() === 'regular') return 1; // regular
        if (v === 0 || v === '0' || String(v).toLowerCase().includes('late')) return 0; // late
        return 1; // default to regular
    }

    function normalizeCOStatus(b) {
        const v = b.CHECK_OUT_STATUS ?? b.check_out_status ?? b.checkOutStatus ?? b.checkout_status ?? b.CHECKOUT_STATUS ?? b.CHECK_OUT ?? b.CHECKOUT ?? b.LATE_CHECKOUT;
        const s = String(v).toLowerCase();
        if (v === 1 || v === '1' || s.includes('late')) return 1; // late
        if (v === 0 || v === '0' || s.includes('regular')) return 0; // regular
        return 0; // default to regular
    }

    async function fetchRoomBookings(roomId) {
        if (!roomId) return [];
        if (bookingsCache[roomId]) return bookingsCache[roomId];
        try {
            const res = await fetch('/calendar/bookings');
            const data = await res.json();
            const arr = Array.isArray(data) ? data : [];
            const filtered = arr.filter(b => String(b.ROOM_ID) === String(roomId));
            bookingsCache[roomId] = filtered;
            return filtered;
        } catch (e) {
            return [];
        }
    }

    async function validateAdjacencyOnDropdown() {
        const roomId = $('#addroom').val();
        const dates = parseDateRangeToDates();
        if (!roomId || !dates.checkIn || !dates.checkOut) return { valid: true };

        const ciStatus = $('#checkInStatus').val(); // '1' regular, '0' late
        const coStatus = $('#checkOutStatus').val(); // '0' regular, '1' late

        const roomBookings = await fetchRoomBookings(roomId);

        // Rule A: If my CO is late (1), the next booking starting on my CO date must NOT be regular CI (1)
        if (String(coStatus) === '1') {
            const conflictA = roomBookings.some(b => {
                const startStr = toISODateOnly(new Date(b.CHECK_IN_DATE ?? b.check_in_date ?? b.checkInDate));
                if (startStr !== dates.checkOut) return false;
                return normalizeCIStatus(b) === 1; // neighbor is regular CI
            });
            if (conflictA) {
                return { valid: false, reason: 'Late Check-out cannot be adjacent to a Regular Check-in on the same date. Only Late Check-in may follow.' };
            }
        }

        // Rule B: If my CI is regular (1), the previous booking ending on my CI date must NOT be late CO (1)
        if (String(ciStatus) === '1') {
            const conflictB = roomBookings.some(b => {
                const endStr = toISODateOnly(new Date(b.CHECK_OUT_DATE ?? b.check_out_date ?? b.checkOutDate));
                if (endStr !== dates.checkIn) return false;
                return normalizeCOStatus(b) === 1; // neighbor is late CO
            });
            if (conflictB) {
                return { valid: false, reason: 'Regular Check-in cannot directly follow a Late Check-out on the same date. Only Late Check-in may follow.' };
            }
        }

        return { valid: true };
    }

    // Preserve previous values to revert on invalid selection
    let prevCI = null;
    let prevCO = null;

    $(document).ready(function(){
        prevCI = $('#checkInStatus').val();
        prevCO = $('#checkOutStatus').val();

        $('#checkInStatus').on('focus', function(){ prevCI = $(this).val(); });
        $('#checkOutStatus').on('focus', function(){ prevCO = $(this).val(); });

        $('#checkInStatus').on('change', async function(){
            const result = await validateAdjacencyOnDropdown();
            if (!result.valid) {
                Swal.fire({
                    title: 'Not Allowed - Check-in Conflict',
                    html: result.reason,
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                $(this).val(prevCI);
                return;
            }
            prevCI = $(this).val();
        });

        $('#checkOutStatus').on('change', async function(){
            const result = await validateAdjacencyOnDropdown();
            if (!result.valid) {
                Swal.fire({
                    title: 'Not Allowed - Check-out Conflict',
                    html: result.reason,
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                $(this).val(prevCO);
                return;
            }
            prevCO = $(this).val();
        });

        // Reset previous values when room/date changes
        $('#addroom').on('change', function(){ prevCI = $('#checkInStatus').val(); prevCO = $('#checkOutStatus').val(); });
        $('#daterange').on('change', function(){ prevCI = $('#checkInStatus').val(); prevCO = $('#checkOutStatus').val(); });
    });
})();
</script>

<script>
// ================================
// ARRIVAL / DEPARTURE SUMMARY BANNER (Add Booking)
// EX) ARRIVAL JUL 18, 2026 / LCI  +  DEPARTURE JUL 22, 2026 / RCO
// ================================
(function(){
    function splitDateRange() {
        const dr = $('#daterange').val() || '';
        if (!dr.includes(' to ')) return { arrival: null, departure: null };
        const parts = dr.split(' to ');
        const arrival = parts[0].trim();
        const departure = (parts[1] || '').split('(')[0].trim();
        if (!arrival || !departure) return { arrival: null, departure: null };
        return { arrival: arrival.toUpperCase(), departure: departure.toUpperCase() };
    }

    // Check-In: value 1 = Regular, 0 = Late. Check-Out: value 0 = Regular, 1 = Late.
    function ciAbbrev() {
        const v = $('#checkInStatus').val();
        if (v === '1') return 'RCI';
        if (v === '0') return 'LCI';
        return null;
    }

    function coAbbrev() {
        const v = $('#checkOutStatus').val();
        if (v === '0') return 'RCO';
        if (v === '1') return 'LCO';
        return null;
    }

    function updateArrivalDepartureSummary() {
        const { arrival, departure } = splitDateRange();
        const ci = ciAbbrev();
        const co = coAbbrev();
        const $summary = $('#arrivalDepartureSummary');
        const $text = $('#arrivalDepartureSummaryText');

        if (!arrival || !departure || !ci || !co) {
            $summary.hide();
            return;
        }

        $text.text(`ARRIVAL ${arrival} / ${ci}  -  DEPARTURE ${departure} / ${co}`);
        $summary.show();
    }

    $(document).ready(function(){
        $('#daterange').on('change', updateArrivalDepartureSummary);
        $('#checkInStatus').on('change', updateArrivalDepartureSummary);
        $('#checkOutStatus').on('change', updateArrivalDepartureSummary);

        $('#modal-addbooking').on('shown.bs.modal', updateArrivalDepartureSummary);
    });
})();
</script>

<script>
// ================================
// FLIGHT NUMBER LOOKUP (Add Booking)
// ================================
// Flight Schedule's FLIGHT_NUMBER column holds the airline name (not a flight code) -
// ARRIVAL holds the actual pick-up flight number, DEPARTURE the actual drop-off flight number.
(function(){
    let flightScheduleList = null;

    function loadFlightScheduleList(callback) {
        if (Array.isArray(flightScheduleList)) {
            callback(flightScheduleList);
            return;
        }
        $.ajax({
            url: '/flight-schedule/api/flights',
            type: 'GET',
            cache: false,
            success: function(response) {
                flightScheduleList = (response.success && Array.isArray(response.data)) ? response.data : [];
                callback(flightScheduleList);
            },
            error: function() {
                flightScheduleList = [];
                callback(flightScheduleList);
            }
        });
    }

    function setupFlightLookup(inputId, dropdownId, codeField) {
        function filterList(term) {
            const list = flightScheduleList || [];
            const needle = (term || '').trim().toUpperCase();
            if (!needle) return list;
            return list.filter(f =>
                (f[codeField] || '').toUpperCase().includes(needle) ||
                (f.FLIGHT_NUMBER || '').toUpperCase().includes(needle)
            );
        }

        function renderDropdown(list) {
            const $dropdown = $('#' + dropdownId);
            if (!list || list.length === 0) {
                $dropdown.html('<div style="padding: 8px 10px; color: #9aa; font-size: 13px;">No flight in Flight Schedule</div>').show();
                return;
            }
            $dropdown.empty();
            list.forEach(function(f){
                const code = f[codeField] || '';
                const airline = f.FLIGHT_NUMBER || '';
                const $item = $('<div class="flight-number-option"></div>')
                    .css({ padding: '6px 10px', cursor: 'pointer', fontSize: '13px', borderBottom: '1px solid #384249' })
                    .html(`<strong>${code}</strong> <span style="color:#9aa;">— ${airline}</span>`)
                    .on('mouseenter', function(){ $(this).css('background-color', '#374047'); })
                    .on('mouseleave', function(){ $(this).css('background-color', ''); })
                    .on('click', function(){
                        $('#' + inputId).val(code);
                        $dropdown.hide();
                    });
                $dropdown.append($item);
            });
            $dropdown.show();
        }

        $(document).on('input', '#' + inputId, function(){
            renderDropdown(filterList($(this).val()));
        });

        $(document).on('click focus', '#' + inputId, function(){
            loadFlightScheduleList(function(){
                renderDropdown(filterList($('#' + inputId).val()));
            });
        });

        $(document).on('click', function(e){
            if (!$(e.target).closest('#' + inputId + ', #' + dropdownId).length) {
                $('#' + dropdownId).hide();
            }
        });
    }

    setupFlightLookup('flightNumber', 'flightNumberDropdown', 'ARRIVAL');
    setupFlightLookup('dropoffFlightNumber', 'dropoffFlightNumberDropdown', 'DEPARTURE');

    $(document).on('shown.bs.modal', '#modal-addbooking', function(){
        flightScheduleList = null;
    });
})();
</script>

