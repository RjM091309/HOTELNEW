<div class="modal fade" id="modal-status" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Change Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="change_status" method="POST">
                    <div class="row mb-2">
                        <div class="col-sm-12">
                            <select class="form-select" id="txtstatus" name="status" data-placeholder="Choose a status..." required>
                                <option disabled selected>-- SELECT STATUS --</option>
                                <option value="check-In">Check In</option>
                                <option value="check-Out">Check Out</option>
                                <option value="pending">Pending</option>
                                <option value="cancelled">Cancelled</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary" id="saveUserBtn">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div> 