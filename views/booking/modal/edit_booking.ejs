<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/plugins/flatpicker/flatpickr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
$(document).ready(function() {
    // Initialize flatpickr for edit form
    let editFlatpickrInstance = null;
    
    function initializeEditFlatpickr() {
        if (editFlatpickrInstance) {
            editFlatpickrInstance.destroy();
        }

        editFlatpickrInstance = flatpickr("#edit_daterange", {
            mode: "range",
            dateFormat: "M d, Y",
            showMonths: 2, // Display two months side by side
            // minDate removed to allow past dates in edit booking modal
            onClose: function(selectedDates, dateStr, instance) {
                if (selectedDates.length === 2) {
                    var startDate = selectedDates[0];
                    var endDate = selectedDates[1];
                    var diffInTime = endDate.getTime() - startDate.getTime();
                    var diffInDays = Math.round(diffInTime / (1000 * 3600 * 24));

                    $('#edit_diffindays').val(diffInDays);
                    var formattedDateRange = dateStr + ' (' + diffInDays + ' night/s)';
                    instance.input.value = formattedDateRange;
                    computeEditTotal();
                    
                    // Auto-refresh room selection if floor is already selected
                    // Preserve the currently selected room if it's still available
                    const selectedFloor = $('#edit_addFloor').val();
                    const currentlySelectedRoom = $('#edit_addroom').val(); // Save current selection
                    if (selectedFloor) {
                        // Store the selected room to restore it after refresh
                        $('#edit_addFloor').data('preserve-room', currentlySelectedRoom);
                        $('#edit_addFloor').trigger('change');
                    }
                }
            }
        });
    }

    // Initialize flatpickr
    initializeEditFlatpickr();

    // Function to toggle breakfast total display for edit form
    function toggleEditBreakfastTotalDisplay() {
        const adultQty = parseInt($('#edit_breakfastAdultQty').val()) || 0;
        const adultUnit = parseFloat($('#edit_breakfastAdultPrice').val()) || 0;
        const adultTotal = adultQty * adultUnit;

        const kidQty = parseInt($('#edit_breakfastKidQty').val()) || 0;
        const kidUnit = parseFloat($('#edit_breakfastKidPrice').val()) || 0;
        const kidTotal = kidQty * kidUnit;

        // Always keep price inputs visible for manual editing
        // Only show total when BOTH qty AND price are entered
        if (adultQty > 0 && adultUnit > 0) {
            $('#edit_breakfastAdultTotal')
                .css('display', 'block')
                .val(`${adultTotal.toFixed(2)}`);
        } else {
            $('#edit_breakfastAdultTotal').css('display', 'none').val('');
        }

        if (kidQty > 0 && kidUnit > 0) {
            $('#edit_breakfastKidTotal')
                .css('display', 'block')
                .val(`${kidTotal.toFixed(2)}`);
        } else {
            $('#edit_breakfastKidTotal').css('display', 'none').val('');
        }
        
        // Always recalculate total when breakfast values change
        computeEditTotal();
    }

    // Event listeners for breakfast quantity and price changes in edit form
    $(document).on('input', '#edit_breakfastAdultQty, #edit_breakfastKidQty, #edit_breakfastAdultPrice, #edit_breakfastKidPrice', toggleEditBreakfastTotalDisplay);

    // Populate Guest Type dropdown using shared utility
    populateGuestTypesDropdown('#edit_guestType', true, 'Guest Type');

    // Populate Guest Level dropdown using shared utility
    populateGuestLevelsDropdown('#edit_guestLevel', true, 'Guest Level');

    // Populate Floor Dropdown using shared utility
    populateFloorDropdownGeneric('#edit_addFloor', true, 'Select Floor');

    // Populate Rooms based on selected floor
    $('#edit_addFloor').change(function () {
        const selectedFloor = $(this).val();
        if (selectedFloor) {
            // Get selected dates for filtering
            const daterange = $('#edit_daterange').val();
            if (!daterange) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Select Dates First',
                    text: 'Please select check-in and check-out dates before selecting a room',
                    confirmButtonText: 'OK'
                });
                return;
            }
            
            // Parse dates from daterange
            const dateRangeParts = daterange.split(' to ');
            const startDateStr = dateRangeParts[0].trim();
            const endDateStr = dateRangeParts[1].split('(')[0].trim();
            
            // Convert to YYYY-MM-DD format
            const checkInDate = moment(startDateStr, 'MMM DD, YYYY').format('YYYY-MM-DD');
            const checkOutDate = moment(endDateStr, 'MMM DD, YYYY').format('YYYY-MM-DD');
            
            // Fetch available rooms for the selected floor and dates
            $.ajax({
                url: '/booking/get_available_rooms_by_floor',
                method: 'POST',
                data: {
                    floor: selectedFloor,
                    checkInDate: checkInDate,
                    checkOutDate: checkOutDate,
                    excludeBookingId: $('#edit_bookingId').val() // Exclude current booking
                },
                success: function (data) {
                    const roomDropdown = $('#edit_addroom');
                    const preserveRoomId = $('#edit_addFloor').data('preserve-room'); // Get room to preserve
                    $('#edit_addFloor').removeData('preserve-room'); // Clear the data after use
                    
                    roomDropdown.empty().append('<option value="" disabled>Select Room</option>');
                    
                    if (data.length === 0) {
                        roomDropdown.append('<option value="" disabled>No available rooms for selected dates</option>');
                    } else {
                        let foundPreservedRoom = false;
                        data.forEach(room => {
                            const isSelected = preserveRoomId && preserveRoomId == room.room_id ? 'selected' : '';
                            if (isSelected) foundPreservedRoom = true;
                            roomDropdown.append(`<option value="${room.room_id}" ${isSelected}>${room.ROOM_NUMBER}</option>`);
                        });
                        
                        // If preserved room was found and selected, trigger change to update room details
                        if (foundPreservedRoom && preserveRoomId) {
                            roomDropdown.val(preserveRoomId).trigger('change');
                        }
                    }
                },
                error: function (err) {
                    console.error('Error fetching available rooms for floor:', err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: 'Failed to fetch available rooms. Please try again.',
                        confirmButtonText: 'OK'
                    });
                }
            });
        }
    });

    // Helper to compute seasonal price for selected room
    function computeEditSeasonalPrice(room) {
        if (!room) return null;
        const seasonalPrices = room.SEASONAL_PRICES || [];
        const daterange = $('#edit_daterange').val() || '';
        const [startDate] = daterange.split(' to ');
        const bookingType = $('#edit_bookingRoute').val();

        function getSeasonIdForDate(checkInDate, seasonal) {
            if (!checkInDate) return null;
            const checkIn = new Date(checkInDate);
            const mmdd = (checkIn.getMonth() + 1).toString().padStart(2, '0') + checkIn.getDate().toString().padStart(2, '0');
            for (const p of (seasonal || [])) {
                const start = new Date(p.startDate);
                const end = new Date(p.endDate);
                const startMMDD = (start.getMonth() + 1).toString().padStart(2, '0') + start.getDate().toString().padStart(2, '0');
                const endMMDD = (end.getMonth() + 1).toString().padStart(2, '0') + end.getDate().toString().padStart(2, '0');
                if ((startMMDD <= endMMDD && mmdd >= startMMDD && mmdd <= endMMDD) ||
                    (startMMDD > endMMDD && (mmdd >= startMMDD || mmdd <= endMMDD))) {
                    return p.seasonId;
                }
            }
            return null;
        }

        const seasonId = getSeasonIdForDate(startDate, seasonalPrices);
        const bedCount = parseInt(room.ROOM_BED);
        const match = seasonalPrices.find(p => parseInt(p.bedCount) === bedCount && p.bookingType === bookingType && parseInt(p.seasonId) === parseInt(seasonId));
        let pricePerNight = match ? parseFloat(match.price) : parseFloat(room.FINAL_PRICE || room.ROOM_PRICE);
        if (!isFinite(pricePerNight)) pricePerNight = 0;
        return pricePerNight;
    }

