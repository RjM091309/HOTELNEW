        const breakfastKidPrice = parseFloat($('#edit_breakfastKidPrice').val().toString().replace(/,/g, '')) || 0;
        const breakfastTotal = parseFloat(((breakfastAdultQty * breakfastAdultPrice) + (breakfastKidQty * breakfastKidPrice)).toFixed(2));
        
        const pickup = $('#edit_includePickup').is(':checked') ? (parseFloat($('#edit_pickupPrice').val().toString().replace(/,/g, '')) || 0) : 0;
        const dropoff = $('#edit_includeDropoff').is(':checked') ? (parseFloat($('#edit_dropoffPrice').val().toString().replace(/,/g, '')) || 0) : 0;
        const lateCheckoutFee = parseFloat($('#edit_lateCheckoutFee').val().toString().replace(/,/g, '')) || 0;
        // Exclude late checkout fee from servicesTotal as it's displayed separately
        const servicesTotal = parseFloat((breakfastTotal + pickup + dropoff).toFixed(2));

        // Get room number text
        let roomNumberText = 'NO ROOM ASSIGNED';
        if (!isDirectReservation) {
            const selectedRoomOption = $('#edit_addroom option:selected');
            roomNumberText = selectedRoomOption.length ? selectedRoomOption.text() : 'NO ROOM ASSIGNED';
        }

        const bookingData = {
            voucherNo: $('#edit_voucherNo').val() || $('#edit_bookingId').val(),
            fullname: $('#edit_bookingRoute').val() === 'agency' 
                ? $('#edit_agencySelect option:selected').text() 
