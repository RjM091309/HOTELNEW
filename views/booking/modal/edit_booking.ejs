<!-- Date Time item CSS -->
<link rel="stylesheet" href="/plugins/flatpicker/flatpickr.min.css">

<div class="modal fade" id="modal-editbooking" tabindex="-1" role="dialog" aria-labelledby="editBookingModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Edit Booking</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="window.location.reload()" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editbooking" method="POST">
                    <!-- Hidden fields -->
                    <input type="hidden" id="edit_bookingId" name="bookingId">
                    <input type="hidden" id="edit_baseprice" name="baseprice">
                    <input type="hidden" id="edit_diffindays" name="diffindays">
                    <input type="hidden" id="edit_guestID" name="guestID">
                    <input type="hidden" id="edit_voucherNo" name="voucherNo">
                    <input type="hidden" id="edit_room_type_hidden" name="room_type_hidden">

                    <div class="row">
                        <!-- BEGIN DATE AND ROOM SELECTION SECTION -->
                        <div class="row p-t-20">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="form-label">Select Date From To</label>
                                    <input class="form-control flatpickr-input" type="text" id="edit_daterange" name="daterange" required>
                                </div>
                            </div>
                            <div id="edit_divroom_type" class="col-lg-3">
                                <div class="form-group">
                                    <label class="form-label">Room View</label>
                                    <input class="form-control" type="text" id="edit_room_type" name="room_type" readonly>
                                </div>
                            </div>
                            <div id="edit_divbedCount" class="col-lg-3">
                                <div class="form-group">
                                    <label class="form-label">Bed Count</label>
                                    <input class="form-control" type="text" id="edit_bedCount" name="bedCount" readonly>
                                </div>
                            </div>
                        </div>

                        <!-- ROOM SELECTION FIELDS -->
                        <div id="edit_divaddFloor" class="col-lg-4">
                            <div class="form-group">
                                <label class="form-label">Select Floor</label>
                                <select class="form-select" id="edit_addFloor">
                                    <option value="" disabled selected>Select Floor</option>
                                </select>
                            </div>
                        </div>
                        
                        <div id="edit_divaddroom" class="col-lg-4">
                            <div class="form-group">
                                <label class="form-label">Select Room</label>
                                <select class="form-select" id="edit_addroom" name="room_id">
                                    <option value="" disabled selected>Select Room</option>
                                </select>
                            </div>
                        </div>

                        <!-- Booking Resources select -->
                        <div id="edit_bookingRouteSinglePlaceholder" class="col-lg-4">
                            <div id="edit_bookingRouteWrapper">
                                <div class="form-group">
                                    <label class="form-label">Booking Resources</label>
                                    <select class="form-select" id="edit_bookingRoute" name="bookingRoute">
                                        <option value="" disabled selected>Booking Resources</option>
                                        <option value="walk-in">Walk-in</option>
                                        <option value="agency">Agency</option>
                                        <option value="booking-channel">Booking Channel</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- ROOM DETAILS -->
                        <div id="edit_divmaxOccupants" class="col-lg-4" style="display: none;">
                            <div class="form-group">
                                <label class="form-label">Max Occupants</label>
                                <input class="form-control" type="text" id="edit_maxOccupants" name="maxOccupants" readonly>
                            </div>
                        </div>
                    
                        <div id="edit_divamenities" class="col-lg-4" style="display: none;">
                            <div class="form-group">
                                <label class="form-label">Amenities</label>
                                <input class="form-control" type="text" id="edit_amenities" name="amenities" readonly>
                            </div>
                        </div>

                        <!-- AGENCY SELECTION -->
                        <div id="edit_agencySelectWrapper" class="col-lg-4" style="display: none;">
                            <div class="form-group">
                                <label class="form-label">Select Agency</label>
                                <select class="form-select" id="edit_agencySelect" name="agencyID">
                                    <option value="" disabled selected>Select Agency</option>
                                </select>
                            </div>
                        </div>
                          
                        <div id="edit_divprice" class="col-lg-4">
                            <div class="form-group">
                                <label class="form-label">Room Rate</label>
                                <input class="form-control" type="text" id="edit_price" name="price" readonly>
                                <div style="margin-top: 0px;">
                                    <input type="checkbox" id="edit_manualPriceToggle"> <label for="edit_manualPriceToggle" style="font-size: 12px;">Enter Price Manually</label>
                                </div>
                            </div>
                        </div>

                        <!-- GUEST INFORMATION -->
                        <div id="edit_divtxtFullNameAdd" class="col-lg-4" style="position: relative;">
                            <div class="form-group">
                                <label class="form-label">Guest</label>
                                <input 
                                    class="form-control" 
                                    type="text" 
                                    id="edit_txtFullNameAdd" 
                                    name="fullname" 
                                    required 
                                    autocomplete="off" 
                                    onkeyup="searchEditCustomer(this.value)"
                                    onblur="hideEditSearchResults()" 
                                >
                            </div>
                            <div id="edit_searchResults"></div>
                        </div>

                        <div id="edit_divtxtNumber" class="col-lg-4">
                            <div class="form-group">
                                <label class="form-label">Contact Number</label>
                                <input class="form-control" type="text" id="edit_txtNumber" name="number" autocomplete="off">
                            </div>
                        </div>

                        <!-- SERVICES SECTION -->
                        <div class="row p-t-10">
                            <div class="col-lg-4">
                                <label><input type="checkbox" id="edit_includeBreakfast"> Breakfast</label>
                                <div id="edit_breakfastInputs" style="display: none; margin-top: 5px;">
                                    <!-- Breakfast - Adult -->
                                    <div class="mb-2 d-flex gap-2 align-items-center">
                                        <input type="number" class="form-control" id="edit_breakfastAdultQty" name="breakfastAdultQty" placeholder="Adult" style="max-width: 80px;">
                                        <input type="number" class="form-control" id="edit_breakfastAdultPrice" name="breakfastAdultPrice" placeholder="Price per Qty" readonly>
                                        <input type="hidden" id="edit_breakfastAdultId" name="breakfastAdultId">
                                    </div>
                                
                                    <!-- Breakfast - Kids -->
                                    <div class="d-flex gap-2 align-items-center">
                                        <input type="number" class="form-control" id="edit_breakfastKidQty" name="breakfastKidQty" placeholder="Kids" style="max-width: 80px;">
                                        <input type="number" class="form-control" id="edit_breakfastKidPrice" name="breakfastKidPrice" placeholder="Price per Qty" readonly>
                                        <input type="hidden" id="edit_breakfastKidId" name="breakfastKidId">
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-lg-4">
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" id="edit_includePickup">
                                    <label class="form-check-label" for="edit_includePickup">Pick-up</label>
                                </div>
                                <div id="edit_pickupWrapper" class="mt-1" style="display: none;">
                                    <input type="number" class="form-control" id="edit_pickupPrice" name="pickupPrice" placeholder="Pick-up Price" readonly>
                                    <input type="hidden" id="edit_pickupServiceId" name="pickupServiceId">
                                </div>
                            </div>
                             
                            <div class="col-lg-4">
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" id="edit_includeDropoff">
                                    <label class="form-check-label" for="edit_includeDropoff">Drop-off</label>
                                </div>
                                <div id="edit_dropoffWrapper" class="mt-1" style="display: none;">
                                    <input type="number" class="form-control" id="edit_dropoffPrice" name="dropoffPrice" placeholder="Drop-off Price" readonly>
                                    <input type="hidden" id="edit_dropoffServiceId" name="dropoffServiceId">
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">
                        
                        <!-- PAYMENT AND STATUS SECTION -->
                        <div id="edit_divpaymentStatus" class="col-lg-3">
                            <div class="form-group">
                                <label class="form-label">Payment Status</label>
                                <select class="form-select" id="edit_paymentStatus" name="paymentStatus" required>
                                    <option disabled selected>Payment Status</option>
                                    <option value="paid">Paid</option>
                                    <option value="unpaid">Unpaid</option>
                                </select>
                            </div>
                        </div>
                        
                        <div id="edit_divtxtCheckInStatus" class="col-lg-3">
                            <div class="form-group">
                                <label class="form-label">Check-In Status</label>
                                <select class="form-select" name="checkInStatus" id="edit_checkInStatus" required>
                                    <option value="" disabled selected>Check-In Status</option>
                                    <option value="1">Regular Check In</option>
                                    <option value="0">Late Check In</option>
                                </select>
                            </div>
                        </div>

                        <div id="edit_divtxtCheckOutStatus" class="col-lg-3">
                            <div class="form-group">
                                <label class="form-label">Check-Out Status</label>
                                <select class="form-select" name="checkOutStatus" id="edit_checkOutStatus" required>
                                    <option value="" disabled selected>Check-Out Status</option>
                                    <option value="0">Regular Check Out</option>
                                    <option value="1">Late Check Out</option>
                                </select>
                            </div>
                        </div>

                        <div id="edit_divtxtGuestType" class="col-lg-3">
                            <div class="form-group">
                                <label class="form-label">Guest Type</label>
                                <select class="form-select" id="edit_guestType" name="guestType" data-placeholder="Guest Type" required>
                                    <option value="" disabled selected>Guest Type</option>
                                </select>
                            </div>
                        </div>

                        <div id="edit_divtxtGuestLevel" class="col-lg-3">
                            <div class="form-group">
                                <label class="form-label">Guest Level</label>
                                <select class="form-select" id="edit_guestLevel" name="guestLevel" required>
                                    <option value="" disabled selected>Guest Level</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-lg-12">
                            <div class="form-group">
                                <label class="form-label">Additional Remarks (optional)</label>
                                <textarea class="form-control" id="edit_bookingRemarks" name="bookingRemarks" rows="3"></textarea>
                            </div>
                        </div>

                        <!-- Reservation Fee and Discount Section -->
                        <hr class="my-4">
                        <div class="row p-t-20">
                            <div class="col-lg-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="edit_includeReservationFee">
                                    <label class="form-check-label" for="edit_includeReservationFee">Reservation Fee</label>
                                </div>
                                <div id="edit_reservationFeeWrapper" class="mt-2" style="display: none;">
                                    <input type="number" class="form-control" id="edit_reservationFeeAmount" name="reservationFeeAmount" placeholder="Enter Reservation Fee Amount" step="1" min="0">
                                    <small class="text-muted" style="font-size: 11px; color: #bbbbbb !important;">(Downpayment - not included in total)</small>
                                </div>
                            </div>
                            
                            <div class="col-lg-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="edit_includeDiscount">
                                    <label class="form-check-label" for="edit_includeDiscount">Discount</label>
                                </div>
                                <div id="edit_discountWrapper" class="mt-2" style="display: none;">
                                    <input type="number" class="form-control" id="edit_discountAmount" name="discountAmount" placeholder="Enter Discount Amount" step="1" min="0">
                                </div>
                            </div>
                        </div>

                        <h3>Total: <span id="edit_computedTotal">0.00</span></h3>
                        <div id="edit_creditDisplay" style="display: none; margin-top: 10px;">
                            <span style="color: #28a745; font-weight: bold;">Credit: <span id="edit_creditAmount">0.00</span></span>
                        </div>
                    </div>
                    
                    <!-- Submit button -->
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Update Booking</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="window.location.reload()">Close</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

