            roomType: isDirectReservation ? 'NO ROOM ASSIGNED' : $('#edit_room_type_hidden').val(),
            roomRate: $('#edit_price').val(),
            breakfastAdult: $('#edit_breakfastAdultQty').val() || '0',
            breakfastAdultPrice: $('#edit_breakfastAdultPrice').val() || '0',
            breakfastKid: $('#edit_breakfastKidQty').val() || '0',
            breakfastKidPrice: $('#edit_breakfastKidPrice').val() || '0',
            pickup: $('#edit_includePickup').is(':checked') ? $('#edit_pickupPrice').val() : 0,
            dropoff: $('#edit_includeDropoff').is(':checked') ? $('#edit_dropoffPrice').val() : 0,
            remarks: $('#edit_bookingRemarks').val(),
            total: computedTotalRaw,
            balance: computedBalanceRaw,
            paidAmount: computedPaidAmountRaw,
            checkInStatus: $('#edit_checkInStatus').val(),
            checkOutStatus: $('#edit_checkOutStatus').val(),
            lateCheckoutFee: $('#edit_lateCheckoutFee').val() || '0',
            reservationFee: '0', // Edit form doesn't have reservation fee
            discount: $('#edit_includeDiscount').is(':checked') ? $('#edit_discountAmount').val() : 0,
            roomCharges: roomCharges.toFixed(2),
            servicesTotal: servicesTotal.toFixed(2),
            directReservationFlag: isDirectReservation ? 'true' : 'false',
        };
        
        const form = $('<form>', {
            method: 'POST',
            action: '/booking/generate-voucher',
            target: '_blank'
        });

        for (let key in bookingData) {
            form.append($('<input>', {
                type: 'hidden',
                name: key,
                value: bookingData[key]
            }));
        }

        $('body').append(form);
        form.submit();
        form.remove();
    });
});

// ================================
// STATUS ADJACENCY VALIDATION
// ================================
(function(){
    const bookingsCache = {};

    function toISODateOnly(d) {
        const dd = new Date(d);
        return new Date(dd.getFullYear(), dd.getMonth(), dd.getDate()).toISOString().split('T')[0];
    }

    function parseDateRangeToDates() {
        const dr = $('#edit_daterange').val() || '';
        if (!dr.includes(' to ')) return { checkIn: null, checkOut: null };
        const parts = dr.split(' to ');
        const startStr = parts[0].trim();
        const endStr = (parts[1] || '').split('(')[0].trim();
        if (!startStr || !endStr) return { checkIn: null, checkOut: null };
        const ci = new Date(startStr);
        const co = new Date(endStr);
        if (isNaN(ci.getTime()) || isNaN(co.getTime())) return { checkIn: null, checkOut: null };
        return { checkIn: toISODateOnly(ci), checkOut: toISODateOnly(co) };
    }

    function normalizeCIStatus(b) {
        const v = b.CHECK_IN_STATUS ?? b.check_in_status ?? b.checkInStatus ?? b.checkin_status ?? b.CHECKIN_STATUS ?? b.CHECK_IN;
        if (v === 1 || v === '1' || String(v).toLowerCase() === 'regular') return 1; // regular
        if (v === 0 || v === '0' || String(v).toLowerCase().includes('late')) return 0; // late
        return 1; // default to regular
    }

    function normalizeCOStatus(b) {
        const v = b.CHECK_OUT_STATUS ?? b.check_out_status ?? b.checkOutStatus ?? b.checkout_status ?? b.CHECKOUT_STATUS ?? b.CHECK_OUT ?? b.CHECKOUT ?? b.LATE_CHECKOUT;
        const s = String(v).toLowerCase();
        if (v === 1 || v === '1' || s.includes('late')) return 1; // late
        if (v === 0 || v === '0' || s.includes('regular')) return 0; // regular
        return 0; // default to regular
    }

    async function fetchRoomBookings(roomId) {
        if (!roomId) return [];
        if (bookingsCache[roomId]) return bookingsCache[roomId];
        try {
            const res = await fetch('/calendar/bookings');
            const data = await res.json();
            const arr = Array.isArray(data) ? data : [];
            const filtered = arr.filter(b => String(b.ROOM_ID) === String(roomId));
            bookingsCache[roomId] = filtered;
            return filtered;
        } catch (e) {
            return [];
        }
    }

    async function validateAdjacencyOnDropdown() {
        const roomId = $('#edit_addroom').val();
        const bookingId = $('#edit_bookingId').val();
        const dates = parseDateRangeToDates();
        if (!roomId || !dates.checkIn || !dates.checkOut) return { valid: true };

        const ciStatus = $('#edit_checkInStatus').val(); // '1' regular, '0' late
        const coStatus = $('#edit_checkOutStatus').val(); // '0' regular, '1' late

        const roomBookings = await fetchRoomBookings(roomId);

        // Rule A: If my CO is late (1), the next booking starting on my CO date must NOT be regular CI (1)
        if (String(coStatus) === '1') {
            const conflictA = roomBookings.some(b => {
                if (String(b.BookingID ?? b.bookingId) === String(bookingId)) return false;
                const startStr = toISODateOnly(new Date(b.CHECK_IN_DATE ?? b.check_in_date ?? b.checkInDate));
                if (startStr !== dates.checkOut) return false;
                return normalizeCIStatus(b) === 1; // neighbor is regular CI
            });
            if (conflictA) {
                return { valid: false, reason: 'Late Check-out cannot be adjacent to a Regular Check-in on the same date. Only Late Check-in may follow.' };
            }
        }

        // Rule B: If my CI is regular (1), the previous booking ending on my CI date must NOT be late CO (1)
        if (String(ciStatus) === '1') {
            const conflictB = roomBookings.some(b => {
                if (String(b.BookingID ?? b.bookingId) === String(bookingId)) return false;
                const endStr = toISODateOnly(new Date(b.CHECK_OUT_DATE ?? b.check_out_date ?? b.checkOutDate));
                if (endStr !== dates.checkIn) return false;
                return normalizeCOStatus(b) === 1; // neighbor is late CO
            });
            if (conflictB) {
                return { valid: false, reason: 'Regular Check-in cannot directly follow a Late Check-out on the same date. Only Late Check-in may follow.' };
            }
        }

        return { valid: true };
    }

    // Preserve previous values to revert on invalid selection
    let prevCI = null;
    let prevCO = null;

    // Initialize previous values when modal is shown
    $(document).on('shown.bs.modal', '#modal-editbooking', function() {
        prevCI = $('#edit_checkInStatus').val();
        prevCO = $('#edit_checkOutStatus').val();
    });

    $(document).ready(function(){
        $('#edit_checkInStatus').on('focus', function(){ prevCI = $(this).val(); });
        $('#edit_checkOutStatus').on('focus', function(){ prevCO = $(this).val(); });

        $('#edit_checkInStatus').on('change', async function(){
            const result = await validateAdjacencyOnDropdown();
            if (!result.valid) {
                Swal.fire({
                    title: 'Not Allowed',
                    html: result.reason,
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                $(this).val(prevCI);
                return;
            }
            prevCI = $(this).val();
        });

        $('#edit_checkOutStatus').on('change', async function(){
            const result = await validateAdjacencyOnDropdown();
            if (!result.valid) {
                Swal.fire({
                    title: 'Not Allowed',
                    html: result.reason,
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                $(this).val(prevCO);
                return;
            }
            prevCO = $(this).val();
        });

        // Reset previous values when room/date changes
        $('#edit_addroom').on('change', function(){ prevCI = $('#edit_checkInStatus').val(); prevCO = $('#edit_checkOutStatus').val(); });
        $('#edit_daterange').on('change', function(){ prevCI = $('#edit_checkInStatus').val(); prevCO = $('#edit_checkOutStatus').val(); });
    });
})();

// Function to format paid amount to 2 decimal places
function formatEditPaidAmount(input) {
    const value = parseFloat(input.value) || 0;
    input.value = value.toFixed(2);
}

// Function to calculate late check-out fee for edit form
function calculateEditLateCheckoutFee() {
    const checkOutStatus = $('#edit_checkOutStatus').val();
    const existingFee = $('#edit_lateCheckoutFee').val();
    
    // Only calculate if we have valid data
    if (!checkOutStatus) {
        // If no existing fee, set to 0
        if (!existingFee || parseFloat(existingFee) == 0) {
            $('#edit_lateCheckoutFee').val(0);
            $('#edit_lateCheckoutFeeDisplay').hide();
        }
        return;
    }
    
    let lateCheckoutFee = 0;
    
    if (checkOutStatus == 1) { // Late Check Out
        // Only set to 2000 if there's no existing fee
        if (!existingFee || parseFloat(existingFee) == 0) {
            lateCheckoutFee = 2000; // ₱2,000 default fee for Late Check Out
            $('#edit_lateCheckoutFee').val(lateCheckoutFee);
            $('#edit_lateCheckoutFeeInput').val(lateCheckoutFee);
        } else {
            // Keep the existing fee
            lateCheckoutFee = parseFloat(existingFee);
        }
        $('#edit_lateCheckoutFeeDisplay').show();
    } else {
        // Regular Check Out - no fee
        $('#edit_lateCheckoutFee').val(0);
        $('#edit_lateCheckoutFeeInput').val(0);
        $('#edit_lateCheckoutFeeDisplay').hide();
    }
    
    // Recalculate total to include late check-out fee
    computeEditTotal();
}

// Function to compute total for edit form
function computeEditTotal() {
    console.log('computeEditTotal called');
    const roomRate = parseFloat($('#edit_baseprice').val()) || 0;
    const nights = parseInt($('#edit_diffindays').val()) || 1;
    
    const adultQty = parseInt($('#edit_breakfastAdultQty').val()) || 0;
    const adultPrice = parseFloat($('#edit_breakfastAdultPrice').val()) || 0;
    const kidQty = parseInt($('#edit_breakfastKidQty').val()) || 0;
    const kidPrice = parseFloat($('#edit_breakfastKidPrice').val()) || 0;
    
    const pickupPrice = $('#edit_includePickup').prop('checked') ? parseFloat($('#edit_pickupPrice').val()) || 0 : 0;
    const dropoffPrice = $('#edit_includeDropoff').prop('checked') ? parseFloat($('#edit_dropoffPrice').val()) || 0 : 0;
    
    const discount = $('#edit_includeDiscount').prop('checked') ? parseFloat($('#edit_discountAmount').val()) || 0 : 0;
    
    // Get late check-out fee
    const lateCheckoutFee = parseFloat($('#edit_lateCheckoutFee').val()) || 0;
    
    // Get paid amount and validate it doesn't exceed total
    let paidAmount = parseFloat($('#edit_paidAmount').val()) || 0;
    
    const subtotal = (roomRate * nights) + (adultQty * adultPrice) + (kidQty * kidPrice) + pickupPrice + dropoffPrice + lateCheckoutFee;
    const finalBalance = subtotal - discount;
    
    console.log('Paid Amount:', paidAmount, 'Final Balance:', finalBalance);
    
    // Prevent paid amount from exceeding total
    if (paidAmount > finalBalance) {
        paidAmount = finalBalance;
        $('#edit_paidAmount').val(paidAmount.toFixed(2));
    }
    
    // Calculate balance (total - paid amount)
    const balance = finalBalance - paidAmount;
    
    // Determine payment status
    let paymentStatus;
    if (paidAmount <= 0) {
        paymentStatus = 'unpaid';
    } else if (paidAmount >= finalBalance) {
        paymentStatus = 'paid';
    } else {
        paymentStatus = 'partial';
    }
    
    console.log('Payment Status:', paymentStatus);
    
    // Update payment status display
    $('#edit_paymentStatus').val(paymentStatus);
    
    // Update payment status styling with CSS classes
    $('#edit_paymentStatus').removeClass('status-paid status-partial status-unpaid');
    if (paymentStatus === 'paid') {
        $('#edit_paymentStatus').addClass('status-paid');
    } else if (paymentStatus === 'partial') {
        $('#edit_paymentStatus').addClass('status-partial');
    } else {
        $('#edit_paymentStatus').addClass('status-unpaid');
    }
    
    if (finalBalance < 0) {
        $('#edit_computedTotal').html('<b>0.00</b>');
        $('#edit_creditAmount').html(Math.abs(finalBalance).toLocaleString(undefined, { minimumFractionDigits: 2 }));
        $('#edit_creditDisplay').show();
        // Balance is same as total when total is negative
        $('#edit_computedBalance').html('<b>' + balance.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
        // Update paid amount display
        $('#edit_computedPaidAmount').html('<b>' + paidAmount.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
    } else {
        $('#edit_computedTotal').html('<b>' + finalBalance.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
        $('#edit_creditDisplay').hide();
        // Show balance (total - paid amount)
        $('#edit_computedBalance').html('<b>' + balance.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
        // Update paid amount display
        $('#edit_computedPaidAmount').html('<b>' + paidAmount.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
    }
}

// Function to populate edit form (called from parent page)
function populateEditForm(booking) {
    // Set hidden fields
    $('#edit_bookingId').val(booking.bookingId);
    $('#edit_guestID').val(booking.CUSTOMER_ID);
    
    // Set form fields
    $('#edit_daterange').val(booking.daterange);
    $('#edit_txtFullNameAdd').val(booking.fullname);
    $('#edit_txtNumber').val(booking.number);
    $('#edit_maxOccupants').val(booking.GUESTS_COUNT);
    $('#edit_paidAmount').val(booking.paidAmount || '');
    $('#edit_paymentStatus').val(booking.PAYMENT_STATUS || 'UNPAID');
    $('#edit_price').val(booking.price);
    $('#edit_baseprice').val(booking.price);
    $('#edit_diffindays').val(booking.diffindays);
    $('#edit_guestType').val(booking.guestType);
    $('#edit_guestLevel').val(booking.guestLevel);
    $('#edit_bookingRoute').val(booking.BOOKING_CHANNEL);
    $('#edit_checkInStatus').val(booking.CHECK_IN_STATUS);
    
    // Set check-out status - handle null/undefined values
    console.log('DEBUG: booking.LATE_CHECKOUT =', booking.LATE_CHECKOUT);
    const checkOutStatus = booking.LATE_CHECKOUT !== null && booking.LATE_CHECKOUT !== undefined 
        ? booking.LATE_CHECKOUT 
        : 0; // Default to 0 (Regular Check Out)
    console.log('DEBUG: Setting checkOutStatus to', checkOutStatus);
    $('#edit_checkOutStatus').val(checkOutStatus);
    console.log('DEBUG: Actual dropdown value after setting:', $('#edit_checkOutStatus').val());
    
    // Set late checkout fee if it exists
    console.log('DEBUG: booking.lateCheckoutFee =', booking.lateCheckoutFee);
    if (booking.lateCheckoutFee && parseFloat(booking.lateCheckoutFee) > 0) {
        $('#edit_lateCheckoutFee').val(parseFloat(booking.lateCheckoutFee));
        $('#edit_lateCheckoutFeeInput').val(parseFloat(booking.lateCheckoutFee));
        $('#edit_lateCheckoutFeeDisplay').show(); // Show the field
    }
    
    // Trigger late checkout fee calculation after setting check-out status
    setTimeout(() => {
        calculateEditLateCheckoutFee();
        console.log('DEBUG: After setTimeout, dropdown value:', $('#edit_checkOutStatus').val());
    }, 300); // Increased delay to ensure form is fully populated
    $('#edit_bookingRemarks').val(booking.REMARKS);
    $('#edit_agencySelect').val(booking.agencyID);
    $('#edit_bedCount').val(booking.ROOM_BED === 1 ? '1' : booking.ROOM_BED === 2 ? '2' : 'N/A');
    $('#edit_room_type').val(booking.ROOM_VIEW === 1 ? 'Condo View' : booking.ROOM_VIEW === 2 ? 'Mountain View' : 'N/A');
    $('#edit_room_type_hidden').val(booking.ROOM_TYPE);
    
    // Set services
    if (parseInt(booking.breakfastAdultQty) > 0) {
        $('#edit_includeBreakfast').prop('checked', true);
        $('#edit_breakfastInputs').show();
        $('#edit_breakfastAdultQty').val(booking.breakfastAdultQty);
        $('#edit_breakfastAdultPrice').val(booking.breakfastAdultPrice);
        $('#edit_breakfastAdultId').val(booking.breakfastAdultId);
    }
    
    if (parseInt(booking.breakfastKidQty) > 0) {
        $('#edit_breakfastKidQty').val(booking.breakfastKidQty);
        $('#edit_breakfastKidPrice').val(booking.breakfastKidPrice);
        $('#edit_breakfastKidId').val(booking.breakfastKidId);
    }
    
    if (parseFloat(booking.pickupPrice) > 0) {
        $('#edit_includePickup').prop('checked', true);
        $('#edit_pickupWrapper').show();
        $('#edit_pickupPrice').val(booking.pickupPrice);
        $('#edit_pickupServiceId').val(booking.pickupServiceId);
    }
    
    if (parseFloat(booking.dropoffPrice) > 0) {
        $('#edit_includeDropoff').prop('checked', true);
        $('#edit_dropoffWrapper').show();
        $('#edit_dropoffPrice').val(booking.dropoffPrice);
        $('#edit_dropoffServiceId').val(booking.dropoffServiceId);
    }
    
    // Set discount
    if (parseFloat(booking.DISCOUNT_AMOUNT) > 0) {
        $('#edit_includeDiscount').prop('checked', true);
        $('#edit_discountWrapper').show();
        $('#edit_discountAmount').val(booking.DISCOUNT_AMOUNT);
    }
    
    // Set room selection if not direct reservation
    if (!booking.IS_DIRECT_RESERVATION && booking.ROOM_ID) {
        populateEditRoomSelection(booking.ROOM_ID, booking.ROOM_FLOOR);
    }
    
    // Recompute total
    computeEditTotal();
}

// Function to populate room selection in edit form
function populateEditRoomSelection(roomId, floorNumber) {
    // Set floor
    $('#edit_addFloor').val(floorNumber);
    
    // Get current dates for filtering
    const daterange = $('#edit_daterange').val();
    if (!daterange) return;
    
    // Parse dates from daterange
    const dateRangeParts = daterange.split(' to ');
    const startDateStr = dateRangeParts[0].trim();
    const endDateStr = dateRangeParts[1].split('(')[0].trim();
    
    // Convert to YYYY-MM-DD format
    const checkInDate = moment(startDateStr, 'MMM DD, YYYY').format('YYYY-MM-DD');
    const checkOutDate = moment(endDateStr, 'MMM DD, YYYY').format('YYYY-MM-DD');
    
    // Fetch available rooms for the selected floor and dates
    fetch('/booking/get_available_rooms_by_floor', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            floor: floorNumber,
            checkInDate: checkInDate,
            checkOutDate: checkOutDate,
            excludeBookingId: $('#edit_bookingId').val()
        })
    })
    .then(response => response.json())
    .then(data => {
        const roomDropdown = $('#edit_addroom');
        roomDropdown.empty().append('<option value="" disabled>Select Room</option>');

        console.log('Available rooms response:', data); // Debug log

        if (data.length === 0) {
            roomDropdown.append('<option value="" disabled>No available rooms for selected dates</option>');
        } else {
            let currentRoomFound = false;
            data.forEach(room => {
                const selected = room.room_id == roomId ? 'selected' : '';
                if (room.room_id == roomId) {
                    currentRoomFound = true;
                }
                roomDropdown.append(`<option value="${room.room_id}" ${selected}>${room.ROOM_NUMBER}</option>`);
            });

            // If current room not found in available rooms, add it manually
            if (!currentRoomFound && roomId) {
                console.log('Current room not found in available rooms, adding manually');
                roomDropdown.append(`<option value="${roomId}" selected>${roomId} (Current)</option>`);
            }
        }
    })
    .catch(error => {
        console.error('Error fetching available rooms:', error);
    });
}

// Function to open edit booking modal (called from parent page)
function editBooking(bookingId) {
    console.log('Editing booking ID:', bookingId);
    
    // Fetch booking details
    fetch(`/booking/edit_booking/${bookingId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                populateEditForm(data.booking);
                $('#modal-editbooking').modal('show');
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: data.message || 'Failed to fetch booking details',
                    confirmButtonText: 'OK'
                });
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: 'An error occurred while fetching booking details',
                confirmButtonText: 'OK'
            });
        });
}

// Guest search functionality for edit form
function searchEditCustomer(query) {
    if (query.length === 0) {
        document.getElementById('edit_searchResults').style.display = 'none';
        return;
    }

    fetch(`/booking/search-customer?query=${encodeURIComponent(query)}`)
        .then(response => response.json())
        .then(data => {
            const resultsDiv = document.getElementById('edit_searchResults');
            if (data.length > 0) {
                resultsDiv.innerHTML = data.map(customer => 
                 `<div style="color: #000; padding: 10px; cursor: pointer; background-color: #f8f9fa; border: 1px solid #dee2e6; margin: 2px 0; border-radius: 4px;" onclick="selectEditCustomer('${customer.NAME}', '${customer.LEVEL}', '${customer.CUSTOMER_ID}', '${customer.CONTACT_NO}', '${customer.TYPE}')">
                        ${customer.NAME} (${customer.LEVEL})
                    </div>`).join('');
                resultsDiv.style.display = 'block';
            } else {
                resultsDiv.style.display = 'none';
            }
        })
        .catch(error => console.error('Error fetching customers:', error));
}

// Hide search results on blur
function hideEditSearchResults() {
    setTimeout(() => {
        document.getElementById('edit_searchResults').style.display = 'none';
    }, 200);
}

// Function to update the edit form inputs based on the selected customer
function selectEditCustomer(name, level, customerId, contactNo, guestType) {
    document.getElementById('edit_txtFullNameAdd').value = name;
    document.getElementById('edit_searchResults').style.display = 'none';

    // Set the Guest Level dropdown value based on the level of the selected customer
    const guestLevelDropdown = document.getElementById('edit_guestLevel');
    for (let i = 0; i < guestLevelDropdown.options.length; i++) {
        if (guestLevelDropdown.options[i].text === level) {
            guestLevelDropdown.selectedIndex = i;
            break;
        }
    }

    // Update the Guest Type dropdown value based on the type of the selected customer
    const guestTypeDropdown = document.getElementById('edit_guestType');
    for (let i = 0; i < guestTypeDropdown.options.length; i++) {
        if (guestTypeDropdown.options[i].text === guestType) {
            guestTypeDropdown.selectedIndex = i;
            break;
        }
    }

    // Set the Contact Number field
    document.getElementById('edit_txtNumber').value = contactNo;

    // Store the Customer ID in the hidden input field
    document.getElementById('edit_guestID').val(customerId);
}

// Add event listener to reset dropdowns when guest name changes
$(document).ready(function() {
    $('#edit_txtFullNameAdd').on('input', function() {
        // Clear the Customer ID and Contact Number fields
        $('#edit_guestID').val('');
        $('#edit_txtNumber').val('');

        // Reset the selected values in the dropdowns
        $('#edit_guestType').prop('selectedIndex', 0);
        $('#edit_guestLevel').prop('selectedIndex', 0);
    });

    // Prevent hiding if clicked inside search results
    $('#edit_searchResults').on('mousedown', function(event) {
        event.preventDefault();
    });
});

// Function to process payment for edit booking
function processEditBookingPayment(bookingId, paymentAmount, paymentMethod, paymentNotes) {
    const paymentData = {
        bookingId: bookingId,
        paymentAmount: parseFloat(paymentAmount),
        paymentMethod: paymentMethod,
        paymentNotes: paymentNotes || 'Payment update'
    };

    $.ajax({
        url: '/booking/process-payment',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(paymentData),
        success: function (response) {
            if (response.success) {
                console.log('Payment processed successfully for booking:', bookingId);
            } else {
                console.error('Payment processing failed:', response.message);
            }
        },
        error: function (xhr, status, error) {
            console.error('Error processing payment:', error);
        }
    });
}
