        // Reset the selected values in the dropdowns
        $('#edit_guestType').prop('selectedIndex', 0);
        $('#edit_guestLevel').prop('selectedIndex', 0);
    });

    // Prevent hiding if clicked inside search results
    $('#edit_searchResults').on('mousedown', function(event) {
        event.preventDefault();
    });
});

// Function to process payment for edit booking
function processEditBookingPayment(bookingId, paymentAmount, paymentMethod, paymentNotes) {
    const paymentData = {
        bookingId: bookingId,
        paymentAmount: parseFloat(paymentAmount),
        paymentMethod: paymentMethod,
        paymentNotes: paymentNotes || 'Payment update'
    };

    $.ajax({
        url: '/booking/process-payment',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(paymentData),
        success: function (response) {
            if (response.success) {
                console.log('Payment processed successfully for booking:', bookingId);
            } else {
                console.error('Payment processing failed:', response.message);
            }
        },
        error: function (xhr, status, error) {
            console.error('Error processing payment:', error);
        }
    });
}

// ================================
// FLIGHT NUMBER LOOKUP (Edit Booking)
// ================================
// Flight Schedule's FLIGHT_NUMBER column holds the airline name (not a flight code) -
// ARRIVAL holds the actual pick-up flight number, DEPARTURE the actual drop-off flight number.
(function(){
    let editFlightScheduleList = null;

    function loadEditFlightScheduleList(callback) {
        if (Array.isArray(editFlightScheduleList)) {
            callback(editFlightScheduleList);
            return;
        }
        $.ajax({
            url: '/flight-schedule/api/flights',
            type: 'GET',
            cache: false,
            success: function(response) {
                editFlightScheduleList = (response.success && Array.isArray(response.data)) ? response.data : [];
                callback(editFlightScheduleList);
            },
            error: function() {
                editFlightScheduleList = [];
                callback(editFlightScheduleList);
            }
        });
    }

    function setupEditFlightLookup(inputId, dropdownId, codeField) {
        function filterList(term) {
            const list = editFlightScheduleList || [];
            const needle = (term || '').trim().toUpperCase();
            if (!needle) return list;
            return list.filter(f =>
                (f[codeField] || '').toUpperCase().includes(needle) ||
                (f.FLIGHT_NUMBER || '').toUpperCase().includes(needle)
            );
        }

        function renderDropdown(list) {
            const $dropdown = $('#' + dropdownId);
            if (!list || list.length === 0) {
                $dropdown.html('<div style="padding: 8px 10px; color: #9aa; font-size: 13px;">No flight in Flight Schedule</div>').show();
                return;
            }
            $dropdown.empty();
            list.forEach(function(f){
                const code = f[codeField] || '';
                const airline = f.FLIGHT_NUMBER || '';
                const $item = $('<div class="flight-number-option"></div>')
                    .css({ padding: '6px 10px', cursor: 'pointer', fontSize: '13px', borderBottom: '1px solid #384249' })
                    .html(`<strong>${code}</strong> <span style="color:#9aa;">— ${airline}</span>`)
                    .on('mouseenter', function(){ $(this).css('background-color', '#374047'); })
                    .on('mouseleave', function(){ $(this).css('background-color', ''); })
                    .on('click', function(){
                        $('#' + inputId).val(code);
                        $dropdown.hide();
                    });
                $dropdown.append($item);
            });
            $dropdown.show();
        }

        $(document).on('input', '#' + inputId, function(){
            renderDropdown(filterList($(this).val()));
        });

        $(document).on('click focus', '#' + inputId, function(){
            loadEditFlightScheduleList(function(){
                renderDropdown(filterList($('#' + inputId).val()));
            });
        });

        $(document).on('click', function(e){
            if (!$(e.target).closest('#' + inputId + ', #' + dropdownId).length) {
                $('#' + dropdownId).hide();
            }
        });
    }

    setupEditFlightLookup('edit_flightNumber', 'edit_flightNumberDropdown', 'ARRIVAL');
    setupEditFlightLookup('edit_dropoffFlightNumber', 'edit_dropoffFlightNumberDropdown', 'DEPARTURE');

    $(document).on('shown.bs.modal', '#modal-editbooking', function(){
        editFlightScheduleList = null;
    });
})();
</script>
