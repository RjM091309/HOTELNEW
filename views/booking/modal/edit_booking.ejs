        $('#edit_breakfastAdultQty').val(booking.breakfastAdultQty);
        $('#edit_breakfastAdultPrice').val(booking.breakfastAdultPrice);
        $('#edit_breakfastAdultId').val(booking.breakfastAdultId);
    } else {
        // Explicitly reset if no breakfast
        $('#edit_includeBreakfast').prop('checked', false);
        $('#edit_breakfastInputs').hide();
        $('#edit_breakfastAdultQty').val('');
        $('#edit_breakfastAdultPrice').val('');
        $('#edit_breakfastAdultId').val('');
    }
    
    if (parseInt(booking.breakfastKidQty) > 0) {
        $('#edit_breakfastKidQty').val(booking.breakfastKidQty);
        $('#edit_breakfastKidPrice').val(booking.breakfastKidPrice);
        $('#edit_breakfastKidId').val(booking.breakfastKidId);
    } else {
        $('#edit_breakfastKidQty').val('');
        $('#edit_breakfastKidPrice').val('');
        $('#edit_breakfastKidId').val('');
    }
    
    if (parseFloat(booking.pickupPrice) > 0) {
        $('#edit_includePickup').prop('checked', true);
        $('#edit_pickupWrapper').show();
        $('#edit_pickupPrice').val(booking.pickupPrice);
        $('#edit_pickupServiceId').val(booking.pickupServiceId);
    } else {
        // Explicitly reset if no pickup
        $('#edit_includePickup').prop('checked', false);
        $('#edit_pickupWrapper').hide();
        $('#edit_pickupPrice').val('');
        $('#edit_pickupServiceId').val('');
    }

    if (parseFloat(booking.dropoffPrice) > 0) {
        $('#edit_includeDropoff').prop('checked', true);
        $('#edit_dropoffWrapper').show();
        $('#edit_dropoffPrice').val(booking.dropoffPrice);
        $('#edit_dropoffServiceId').val(booking.dropoffServiceId);
    } else {
        // Explicitly reset if no dropoff
        $('#edit_includeDropoff').prop('checked', false);
        $('#edit_dropoffWrapper').hide();
        $('#edit_dropoffPrice').val('');
        $('#edit_dropoffServiceId').val('');
    }

    // Flight number / passenger count - only relevant when Pick-up or Drop-off is set
    const editPickupChecked = $('#edit_includePickup').is(':checked');
    const editDropoffChecked = $('#edit_includeDropoff').is(':checked');
    const editNeedsFlightInfo = editPickupChecked || editDropoffChecked;
    $('#edit_pickupDropoffFlightInfo').toggle(editNeedsFlightInfo);
    $('#edit_flightNumberWrapper').toggle(editPickupChecked);
    $('#edit_pickupDateWrapper').toggle(editPickupChecked);
    $('#edit_dropoffFlightNumberWrapper').toggle(editDropoffChecked);

    if (editPickupChecked && booking.flightNumber) {
        $('#edit_flightNumber').val(booking.flightNumber);
    } else {
        $('#edit_flightNumber').val('');
    }

    if (editPickupChecked && booking.pickupDate) {
        const pickupDateObj = new Date(booking.pickupDate);
        $('#edit_pickupDate').val(isNaN(pickupDateObj.getTime()) ? '' : pickupDateObj.toISOString().slice(0, 10));
    } else {
        $('#edit_pickupDate').val('');
    }

    if (editDropoffChecked && booking.dropoffFlightNumber) {
        $('#edit_dropoffFlightNumber').val(booking.dropoffFlightNumber);
    } else {
        $('#edit_dropoffFlightNumber').val('');
    }

    if (editNeedsFlightInfo) {
        $('#edit_passengerCount').val(booking.passengerCount || '');
    } else {
        $('#edit_passengerCount').val('');
    }

    // Set discount (always reset first, then set if exists)
    $('#edit_includeDiscount').prop('checked', false);
    $('#edit_discountWrapper').hide();
    $('#edit_discountAmount').val('');
    
    // Reset Senior/PWD discount
    $('#edit_includeSeniorPwdDiscount').prop('checked', false);
    $('#edit_seniorPwdDiscountDisplay').hide();
    $('#edit_seniorPwdDiscountPercent').val('20'); // Default to 20%
    $('#edit_seniorPwdDiscountAmount').val('');
    $('#edit_seniorPwdDiscount').val('0');
    
    // Separate Senior/PWD discount from Additional discount
    const totalDiscountAmount = parseFloat(booking.DISCOUNT_AMOUNT) || 0;
    const seniorPwdDiscountPercent = parseFloat(booking.SENIOR_PWD_DISCOUNT_PERCENT) || 0;
    
    // Store total discount amount for later separation
    window.editBookingTotalDiscount = totalDiscountAmount;
    
    if (seniorPwdDiscountPercent > 0) {
        // Set Senior/PWD discount percentage first
        $('#edit_includeSeniorPwdDiscount').prop('checked', true);
        $('#edit_seniorPwdDiscountDisplay').show();
        $('#edit_seniorPwdDiscountPercent').val(seniorPwdDiscountPercent);
        
        // The actual Senior/PWD discount amount will be calculated by computeEditTotal
        // After computeEditTotal runs, we'll separate the Additional discount
    }
    
    // Temporarily set all discount to Additional (will be corrected after computeEditTotal)
    if (totalDiscountAmount > 0 && seniorPwdDiscountPercent === 0) {
        // No Senior/PWD discount, all goes to Additional discount
        $('#edit_includeDiscount').prop('checked', true);
        $('#edit_discountWrapper').show();
        $('#edit_discountAmount').val(totalDiscountAmount.toFixed(2));
    }
    
    // Set room selection if not direct reservation
    if (!booking.IS_DIRECT_RESERVATION && booking.ROOM_ID) {
        populateEditRoomSelection(booking.ROOM_ID, booking.ROOM_FLOOR);
        cacheEditRoomDetails(booking.ROOM_ID);
    }
    
    // Handle direct reservation layout (same as add modal)
    if (booking.IS_DIRECT_RESERVATION) {
        const editBookingModalElement = document.getElementById('modal-editbooking');
        
        // Hide only specific room selection fields, not entire rows
        const fieldsToHide = [
            '#edit_addFloor', '#edit_addroom', '#edit_room_type', '#edit_room_type_hidden', 
            '#edit_bedCount', '#edit_price', '#edit_divprice'
        ];
        
        fieldsToHide.forEach(selector => {
            const field = editBookingModalElement.querySelector(selector);
            if (field) {
                field.style.display = 'none';
            }
        });
        
        // Hide specific div containers but keep their parent rows
        const divsToHide = ['#edit_divaddFloor', '#edit_divaddroom', '#edit_divroom_type', '#edit_divbedCount', '#edit_divprice'];
        divsToHide.forEach(selector => {
            const div = editBookingModalElement.querySelector(selector);
            if (div) {
                div.style.display = 'none';
            }
        });
        
        // Change modal title
        const modalTitle = editBookingModalElement.querySelector('.modal-title');
        if (modalTitle) {
            modalTitle.innerHTML = 'Reservation - No Room Assigned';
        }
        
        // Set Bed Count and Booking Resources to col-lg-3 and arrange in same row as Date
        setTimeout(() => {
            const dateRow = editBookingModalElement.querySelector('#edit_daterange')?.closest('.row');
            if (dateRow) {
                // Convert Bed Count to dropdown for direct reservations
                let bedCountDiv = editBookingModalElement.querySelector('#edit_divbedCount');
                if (bedCountDiv) {
                    bedCountDiv.className = 'col-lg-3';
                    bedCountDiv.style.display = 'block';
                    
                    // Convert readonly input to select dropdown
                    const bedCountInput = bedCountDiv.querySelector('#edit_bedCount');
                    if (bedCountInput && bedCountInput.tagName === 'INPUT') {
                        const currentValue = bedCountInput.value || '';
                        const bedCountSelect = document.createElement('select');
                        bedCountSelect.id = 'edit_bedCount';
                        bedCountSelect.name = 'bedCount';
                        bedCountSelect.className = 'form-control';
                        bedCountSelect.required = true;
                        
                        // Add options
                        const bedOptions = [
                            { value: '', text: 'Select Options', selected: currentValue === '', disabled: true },
                            { value: '1', text: '1 Bed', selected: currentValue === '1' },
                            { value: '2', text: '2 Beds', selected: currentValue === '2' }
                        ];
                        
                        bedOptions.forEach(option => {
                            const optionElement = document.createElement('option');
                            optionElement.value = option.value;
                            optionElement.textContent = option.text;
                            if (option.selected) optionElement.selected = true;
                            if (option.disabled) optionElement.disabled = true;
                            bedCountSelect.appendChild(optionElement);
                        });
                        
                        // Replace input with select
                        bedCountInput.replaceWith(bedCountSelect);
                    }
                    
                    // Move to date row if not already there
                    if (!dateRow.contains(bedCountDiv)) {
                        dateRow.appendChild(bedCountDiv);
                    }
                }
                
                // Set Booking Resources to col-lg-3 and move to same row
                const bookingRoutePlaceholder = editBookingModalElement.querySelector('#edit_bookingRouteSinglePlaceholder');
                if (bookingRoutePlaceholder) {
                    bookingRoutePlaceholder.className = 'col-lg-3';
                    bookingRoutePlaceholder.style.display = 'block';
                    // Move to date row if not already there
                    if (!dateRow.contains(bookingRoutePlaceholder)) {
                        dateRow.appendChild(bookingRoutePlaceholder);
                    }
                }
            }
        }, 100);
    } else {
        // For regular bookings, ensure fields are visible
        const editBookingModalElement = document.getElementById('modal-editbooking');
        const modalTitle = editBookingModalElement.querySelector('.modal-title');
        if (modalTitle) {
            modalTitle.innerHTML = 'Edit Booking';
        }
        
        // Show room selection fields
        const fieldsToShow = ['#edit_divaddFloor', '#edit_divaddroom', '#edit_divroom_type', '#edit_divbedCount', '#edit_divprice'];
        fieldsToShow.forEach(selector => {
            const div = editBookingModalElement.querySelector(selector);
            if (div) {
                div.style.display = '';
            }
        });
    }
    
    // Load existing extra services (will call computeEditTotal internally)
    if (booking.bookingId) {
        loadEditExistingServices(booking.bookingId);
    } else {
        // If no bookingId, just compute total without services
        computeEditTotal();
    }
}

// Function to populate room selection in edit form
function populateEditRoomSelection(roomId, floorNumber) {
    // Set floor
    $('#edit_addFloor').val(floorNumber);
    
    // Get current dates for filtering
    const daterange = $('#edit_daterange').val();
    if (!daterange) return;
    
    // Parse dates from daterange
    const dateRangeParts = daterange.split(' to ');
    const startDateStr = dateRangeParts[0].trim();
    const endDateStr = dateRangeParts[1].split('(')[0].trim();
    
    // Convert to YYYY-MM-DD format
    const checkInDate = moment(startDateStr, 'MMM DD, YYYY').format('YYYY-MM-DD');
    const checkOutDate = moment(endDateStr, 'MMM DD, YYYY').format('YYYY-MM-DD');
    
    // Fetch available rooms for the selected floor and dates
    fetch('/booking/get_available_rooms_by_floor', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            floor: floorNumber,
            checkInDate: checkInDate,
            checkOutDate: checkOutDate,
            excludeBookingId: $('#edit_bookingId').val()
        })
    })
    .then(response => response.json())
    .then(data => {
        const roomDropdown = $('#edit_addroom');
        roomDropdown.empty().append('<option value="" disabled>Select Room</option>');

        console.log('Available rooms response:', data); // Debug log

        if (data.length === 0) {
            roomDropdown.append('<option value="" disabled>No available rooms for selected dates</option>');
        } else {
            let currentRoomFound = false;
            data.forEach(room => {
                const selected = room.room_id == roomId ? 'selected' : '';
                if (room.room_id == roomId) {
                    currentRoomFound = true;
                }
                roomDropdown.append(`<option value="${room.room_id}" ${selected}>${room.ROOM_NUMBER}</option>`);
            });

            // If current room not found in available rooms, add it manually
            if (!currentRoomFound && roomId) {
                console.log('Current room not found in available rooms, adding manually');
                roomDropdown.append(`<option value="${roomId}" selected>${roomId} (Current)</option>`);
            }
        }
    })
    .catch(error => {
        console.error('Error fetching available rooms:', error);
    });
}

// Function to open edit booking modal (called from parent page)
function editBooking(bookingId) {
    console.log('Editing booking ID:', bookingId);
    
    // Fetch booking details
    fetch(`/booking/edit_booking/${bookingId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                populateEditForm(data.booking);
                $('#modal-editbooking').modal('show');
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: data.message || 'Failed to fetch booking details',
                    confirmButtonText: 'OK'
                });
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: 'An error occurred while fetching booking details',
                confirmButtonText: 'OK'
            });
        });
}

// Function to open edit booking modal for direct reservations (same as editBooking)
function editDirect(bookingId) {
    console.log('Editing direct reservation ID:', bookingId);
    // Direct reservations use the same edit form, which already handles them
    editBooking(bookingId);
}

