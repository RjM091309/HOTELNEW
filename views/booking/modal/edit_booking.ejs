<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/plugins/flatpicker/flatpickr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
$(document).ready(function() {
    // Initialize flatpickr for edit form
    let editFlatpickrInstance = null;
    
    function initializeEditFlatpickr() {
        if (editFlatpickrInstance) {
            editFlatpickrInstance.destroy();
        }

        editFlatpickrInstance = flatpickr("#edit_daterange", {
            mode: "range",
            dateFormat: "M d, Y",
            showMonths: 2, // Display two months side by side
            minDate: "today",
            onClose: function(selectedDates, dateStr, instance) {
                if (selectedDates.length === 2) {
                    var startDate = selectedDates[0];
                    var endDate = selectedDates[1];
                    var diffInTime = endDate.getTime() - startDate.getTime();
                    var diffInDays = Math.round(diffInTime / (1000 * 3600 * 24));

                    $('#edit_diffindays').val(diffInDays);
                    var formattedDateRange = dateStr + ' (' + diffInDays + ' night/s)';
                    instance.input.value = formattedDateRange;
                    computeEditTotal();
                    
                    // Auto-refresh room selection if floor is already selected
                    const selectedFloor = $('#edit_addFloor').val();
                    if (selectedFloor) {
                        $('#edit_addFloor').trigger('change');
                    }
                }
            }
        });
    }

    // Initialize flatpickr
    initializeEditFlatpickr();

    // Populate Guest Type dropdown
    $.ajax({
        url: '/booking/get_guest_types',
        method: 'GET',
        success: function (data) {
            const dropdown = $('#edit_guestType');
            dropdown.empty().append('<option disabled selected>Guest Type</option>');
            data.forEach(guestType => {
                dropdown.append(`<option value="${guestType.IDNo}">${guestType.TYPE}</option>`);
            });
        },
        error: function (err) {
            console.error('Error fetching guest types:', err);
        }
    });

    // Populate Guest Level dropdown
    $.ajax({
        url: '/booking/get_guest_level',
        method: 'GET',
        success: function (data) {
            const dropdown = $('#edit_guestLevel');
            dropdown.empty().append('<option disabled selected>Guest Level</option>');
            data.forEach(guestLevel => {
                dropdown.append(`<option value="${guestLevel.IDNo}">${guestLevel.TYPE}</option>`);
            });
        },
        error: function (err) {
            console.error('Error fetching guest levels:', err);
        }
    });

    // Populate Floor Dropdown
    $.ajax({
        url: '/booking/get_floors_for_dropdown',
        method: 'GET',
        success: function (data) {
            const floorDropdown = $('#edit_addFloor');
            floorDropdown.empty().append('<option value="" disabled selected>Select Floor</option>');
            data.forEach(floor => {
                floorDropdown.append(`<option value="${floor.floor_number}">${floor.floor_number} Floor</option>`);
            });
        },
        error: function (err) {
            console.error('Error fetching floors:', err);
        }
    });

    // Populate Rooms based on selected floor
    $('#edit_addFloor').change(function () {
        const selectedFloor = $(this).val();
        if (selectedFloor) {
            // Get selected dates for filtering
            const daterange = $('#edit_daterange').val();
            if (!daterange) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Select Dates First',
                    text: 'Please select check-in and check-out dates before selecting a room',
                    confirmButtonText: 'OK'
                });
                return;
            }
            
            // Parse dates from daterange
            const dateRangeParts = daterange.split(' to ');
            const startDateStr = dateRangeParts[0].trim();
            const endDateStr = dateRangeParts[1].split('(')[0].trim();
            
            // Convert to YYYY-MM-DD format
            const checkInDate = moment(startDateStr, 'MMM DD, YYYY').format('YYYY-MM-DD');
            const checkOutDate = moment(endDateStr, 'MMM DD, YYYY').format('YYYY-MM-DD');
            
            // Fetch available rooms for the selected floor and dates
            $.ajax({
                url: '/booking/get_available_rooms_by_floor',
                method: 'POST',
                data: {
                    floor: selectedFloor,
                    checkInDate: checkInDate,
                    checkOutDate: checkOutDate,
                    excludeBookingId: $('#edit_bookingId').val() // Exclude current booking
                },
                success: function (data) {
                    const roomDropdown = $('#edit_addroom');
                    roomDropdown.empty().append('<option value="" disabled selected>Select Room</option>');
                    
                    if (data.length === 0) {
                        roomDropdown.append('<option value="" disabled>No available rooms for selected dates</option>');
                    } else {
                        data.forEach(room => {
                            roomDropdown.append(`<option value="${room.room_id}">${room.ROOM_NUMBER}</option>`);
                        });
                    }
                },
                error: function (err) {
                    console.error('Error fetching available rooms for floor:', err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: 'Failed to fetch available rooms. Please try again.',
                        confirmButtonText: 'OK'
                    });
                }
            });
        }
    });

    // Helper to compute seasonal price for selected room
    function computeEditSeasonalPrice(room) {
        if (!room) return null;
        const seasonalPrices = room.SEASONAL_PRICES || [];
        const daterange = $('#edit_daterange').val() || '';
        const [startDate] = daterange.split(' to ');
        const bookingType = $('#edit_bookingRoute').val();

        function getSeasonIdForDate(checkInDate, seasonal) {
            if (!checkInDate) return null;
            const checkIn = new Date(checkInDate);
            const mmdd = (checkIn.getMonth() + 1).toString().padStart(2, '0') + checkIn.getDate().toString().padStart(2, '0');
            for (const p of (seasonal || [])) {
                const start = new Date(p.startDate);
                const end = new Date(p.endDate);
                const startMMDD = (start.getMonth() + 1).toString().padStart(2, '0') + start.getDate().toString().padStart(2, '0');
                const endMMDD = (end.getMonth() + 1).toString().padStart(2, '0') + end.getDate().toString().padStart(2, '0');
                if ((startMMDD <= endMMDD && mmdd >= startMMDD && mmdd <= endMMDD) ||
                    (startMMDD > endMMDD && (mmdd >= startMMDD || mmdd <= endMMDD))) {
                    return p.seasonId;
                }
            }
            return null;
        }

        const seasonId = getSeasonIdForDate(startDate, seasonalPrices);
        const bedCount = parseInt(room.ROOM_BED);
        const match = seasonalPrices.find(p => parseInt(p.bedCount) === bedCount && p.bookingType === bookingType && parseInt(p.seasonId) === parseInt(seasonId));
        let pricePerNight = match ? parseFloat(match.price) : parseFloat(room.FINAL_PRICE || room.ROOM_PRICE);
        if (!isFinite(pricePerNight)) pricePerNight = 0;
        return pricePerNight;
    }

    // When selecting a room, update room details and price
    $('#edit_addroom').off('change').on('change', function () {
        const roomId = $(this).val();
        if (!roomId) return;

        console.log('Room selected:', roomId);

        fetch('/booking/get-room-details', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ roomId })
        })
        .then(r => r.json())
        .then(data => {
            console.log('Room details response:', data);

            if (!data.success) {
                console.error('Failed to fetch room details:', data.message);
                return;
            }
            const room = data.roomDetails;
            // Save details for later recompute on bookingRoute change
            $('#edit_addroom').data('roomDetails', room);

            // Update view, bed count, max occupants, amenities
            const roomViewText = room.ROOM_VIEW === 1 ? 'Condo View' : (room.ROOM_VIEW === 2 ? 'Mountain View' : 'N/A');
            $('#edit_room_type').val(roomViewText);
            $('#edit_maxOccupants').val(room.ROOM_MAX);
            $('#edit_bedCount').val(room.ROOM_BED === 1 ? '1' : room.ROOM_BED === 2 ? '2' : 'N/A');
            $('#edit_amenities').val(room.AMENITIES || '');
            $('#edit_room_type_hidden').val(room.ROOM_TYPE);

            // Compute seasonal price and set
            const pricePerNight = computeEditSeasonalPrice(room);
            $('#edit_baseprice').val((pricePerNight || 0).toFixed(2));
            $('#edit_price').val((pricePerNight || 0).toFixed(2));
            computeEditTotal();
        })
        .catch(err => console.error('Error fetching room details:', err));
    });

    // Recompute price when booking route changes (if a room is selected)
    $('#edit_bookingRoute').on('change', function(){
        const room = $('#edit_addroom').data('roomDetails');
        if (room) {
            const pricePerNight = computeEditSeasonalPrice(room);
            $('#edit_baseprice').val((pricePerNight || 0).toFixed(2));
            if (!$('#edit_manualPriceToggle').is(':checked')) {
                $('#edit_price').val((pricePerNight || 0).toFixed(2));
            }
            computeEditTotal();
        }
    });

    // Fetch breakfast and transport prices
    fetch('/booking/get-breakfast-prices')
        .then(res => res.json())
        .then(serviceData => {
            if (!Array.isArray(serviceData)) throw new Error('Invalid response format');

            const adult = serviceData.find(s => s.SERVICE_NAME.includes('Adult'));
            const kid = serviceData.find(s => s.SERVICE_NAME.includes('Kids'));

            if (adult) {
                $('#edit_breakfastAdultPrice').val(adult.SERVICE_COST);
                $('#edit_breakfastAdultId').val(adult.IDNo);
            }
            if (kid) {
                $('#edit_breakfastKidPrice').val(kid.SERVICE_COST);
                $('#edit_breakfastKidId').val(kid.IDNo);
            }
        })
        .catch(err => console.error('Failed to load breakfast prices:', err));

    // Fetch transport rates
    fetch('/booking/get-pick-drop')
        .then(res => res.json())
        .then(data => {
            if (!Array.isArray(data)) return console.error("Invalid transport data:", data);

            const pickup = data.find(s => s.SERVICE_NAME.toLowerCase().includes('pick'));
            const dropoff = data.find(s => s.SERVICE_NAME.toLowerCase().includes('drop'));

            if (pickup) {
                $('#edit_pickupPrice').val(pickup.SERVICE_COST);
                $('#edit_pickupServiceId').val(pickup.IDNo);
            }
            if (dropoff) {
                $('#edit_dropoffPrice').val(dropoff.SERVICE_COST);
                $('#edit_dropoffServiceId').val(dropoff.IDNo);
            }
        })
        .catch(err => console.error('Error fetching transport prices:', err));

    // Service checkbox handlers
    $('#edit_includeBreakfast').on('change', function () {
        $('#edit_breakfastInputs').toggle(this.checked);
        if (!this.checked) {
            $('#edit_breakfastAdultQty').val('');
            $('#edit_breakfastAdultPrice').val('');
            $('#edit_breakfastAdultId').val('');
            $('#edit_breakfastKidQty').val('');
            $('#edit_breakfastKidPrice').val('');
            $('#edit_breakfastKidId').val('');
        }
        computeEditTotal();
    });

    $('#edit_includePickup').on('change', function () {
        $('#edit_pickupWrapper').toggle(this.checked);
        if (!this.checked) {
            $('#edit_pickupPrice').val('');
            $('#edit_pickupServiceId').val('');
        }
        computeEditTotal();
    });

    $('#edit_includeDropoff').on('change', function () {
        $('#edit_dropoffWrapper').toggle(this.checked);
        if (!this.checked) {
            $('#edit_dropoffPrice').val('');
            $('#edit_dropoffServiceId').val('');
        }
        computeEditTotal();
    });

    $('#edit_includeReservationFee').on('change', function () {
        $('#edit_reservationFeeWrapper').toggle(this.checked);
        if (!this.checked) {
            $('#edit_reservationFeeAmount').val('');
        }
        computeEditTotal();
    });

    $('#edit_includeDiscount').on('change', function () {
        $('#edit_discountWrapper').toggle(this.checked);
        if (!this.checked) {
            $('#edit_discountAmount').val('');
        }
        computeEditTotal();
    });

    // Booking route change handler
    $('#edit_bookingRoute').on('change', function () {
        const isAgency = this.value === 'agency';
        $('#edit_agencySelectWrapper').toggle(isAgency);
        
        if (isAgency) {
            fetch('/booking/get-agency')
                .then(res => res.json())
                .then(data => {
                    const agencySelect = $('#edit_agencySelect');
                    agencySelect.empty().append(`<option value="" disabled selected>Select Agency</option>`);
                    data.forEach(a => {
                        agencySelect.append(`<option value="${a.IDNo}">${a.NAME}</option>`);
                    });
                });
        } else {
            $('#edit_agencySelect').val('');
        }
    });

    // Payment Status logic: disable reservation fee when paid
    function checkEditPaymentStatus() {
        const status = $('#edit_paymentStatus').val();
        if (status === 'paid') {
            $('#edit_includeReservationFee').prop('checked', false).prop('disabled', true);
            $('#edit_reservationFeeWrapper').hide();
            $('#edit_reservationFeeAmount').val('');
        } else {
            $('#edit_includeReservationFee').prop('disabled', false);
            // do not auto-check; wrapper shown only when user checks
        }
        computeEditTotal();
    }

    $('#edit_paymentStatus').on('change', checkEditPaymentStatus);
    // initial sync on load
    checkEditPaymentStatus();

    // Manual price toggle
    $('#edit_manualPriceToggle').change(function () {
        if ($(this).is(':checked')) {
            $('#edit_price').prop('readonly', false);
        } else {
            $('#edit_price').prop('readonly', true);
            // Restore calculated price
            const basePrice = parseFloat($('#edit_baseprice').val()) || 0;
            $('#edit_price').val(basePrice.toFixed(2));
        }
        computeEditTotal();
    });

    // Input event listeners for total computation
    $('#edit_reservationFeeAmount, #edit_discountAmount, #edit_breakfastAdultQty, #edit_breakfastKidQty').on('input', function() {
        computeEditTotal();
    });

    // Edit form submission
    $('#editbooking').off('submit').on('submit', function (e) {
        e.preventDefault();
        
        const bookingId = $('#edit_bookingId').val();
        
        // Collect form data
        const formData = {
            room_id: $('#edit_addroom').val(),
            fullname: $('#edit_txtFullNameAdd').val(),
            number: $('#edit_txtNumber').val(),
            daterange: $('#edit_daterange').val(),
            maxOccupants: $('#edit_maxOccupants').val(),
            paymentStatus: $('#edit_paymentStatus').val(),
            price: $('#edit_baseprice').val(),
            diffindays: $('#edit_diffindays').val(),
            guestType: $('#edit_guestType').val(),
            guestLevel: $('#edit_guestLevel').val(),
            bookingRoute: $('#edit_bookingRoute').val(),
            checkInStatus: $('#edit_checkInStatus').val(),
            checkOutStatus: $('#edit_checkOutStatus').val(),
            bookingRemarks: $('#edit_bookingRemarks').val(),
            agencyID: $('#edit_agencySelect').val(),
            bedCount: $('#edit_bedCount').val(),
            
            // Services
            breakfastAdultQty: $('#edit_includeBreakfast').prop('checked') ? $('#edit_breakfastAdultQty').val() : '0',
            breakfastAdultPrice: $('#edit_includeBreakfast').prop('checked') ? $('#edit_breakfastAdultPrice').val() : '0',
            breakfastAdultId: $('#edit_includeBreakfast').prop('checked') ? $('#edit_breakfastAdultId').val() : '',
            breakfastKidQty: $('#edit_includeBreakfast').prop('checked') ? $('#edit_breakfastKidQty').val() : '0',
            breakfastKidPrice: $('#edit_includeBreakfast').prop('checked') ? $('#edit_breakfastKidPrice').val() : '0',
            breakfastKidId: $('#edit_includeBreakfast').prop('checked') ? $('#edit_breakfastKidId').val() : '',
            pickupServiceId: $('#edit_includePickup').prop('checked') ? $('#edit_pickupServiceId').val() : '',
            pickupPrice: $('#edit_includePickup').prop('checked') ? $('#edit_pickupPrice').val() : '0',
            dropoffServiceId: $('#edit_includeDropoff').prop('checked') ? $('#edit_dropoffServiceId').val() : '',
            dropoffPrice: $('#edit_includeDropoff').prop('checked') ? $('#edit_dropoffPrice').val() : '0',
            
            // Fees
            reservationFee: $('#edit_includeReservationFee').prop('checked') ? $('#edit_reservationFeeAmount').val() : '0.00',
            discount: $('#edit_includeDiscount').prop('checked') ? $('#edit_discountAmount').val() : '0.00'
        };
        
        // Submit update
        $.ajax({
            url: `/booking/edit_booking/${bookingId}`,
            type: 'POST',
            data: formData,
            success: function (response) {
                if (response.success) {
                    $('#modal-editbooking').modal('hide');
                    Swal.fire({
                        title: 'Success!',
                        text: response.message,
                        icon: 'success',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        title: 'Error!',
                        text: response.message || 'Failed to update booking',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            },
            error: function (err) {
                console.error('Error:', err);
                Swal.fire({
                    title: 'Error!',
                    text: 'An error occurred while updating the booking',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            }
        });
    });
});

// ================================
// STATUS ADJACENCY VALIDATION
// ================================
(function(){
    const bookingsCache = {};

    function toISODateOnly(d) {
        const dd = new Date(d);
        return new Date(dd.getFullYear(), dd.getMonth(), dd.getDate()).toISOString().split('T')[0];
    }

    function parseDateRangeToDates() {
        const dr = $('#edit_daterange').val() || '';
        if (!dr.includes(' to ')) return { checkIn: null, checkOut: null };
        const parts = dr.split(' to ');
        const startStr = parts[0].trim();
        const endStr = (parts[1] || '').split('(')[0].trim();
        if (!startStr || !endStr) return { checkIn: null, checkOut: null };
        const ci = new Date(startStr);
        const co = new Date(endStr);
        if (isNaN(ci.getTime()) || isNaN(co.getTime())) return { checkIn: null, checkOut: null };
        return { checkIn: toISODateOnly(ci), checkOut: toISODateOnly(co) };
    }

    function normalizeCIStatus(b) {
        const v = b.CHECK_IN_STATUS ?? b.check_in_status ?? b.checkInStatus ?? b.checkin_status ?? b.CHECKIN_STATUS ?? b.CHECK_IN;
        if (v === 1 || v === '1' || String(v).toLowerCase() === 'regular') return 1; // regular
        if (v === 0 || v === '0' || String(v).toLowerCase().includes('late')) return 0; // late
        return 1; // default to regular
    }

    function normalizeCOStatus(b) {
        const v = b.CHECK_OUT_STATUS ?? b.check_out_status ?? b.checkOutStatus ?? b.checkout_status ?? b.CHECKOUT_STATUS ?? b.CHECK_OUT ?? b.CHECKOUT ?? b.LATE_CHECKOUT;
        const s = String(v).toLowerCase();
        if (v === 1 || v === '1' || s.includes('late')) return 1; // late
        if (v === 0 || v === '0' || s.includes('regular')) return 0; // regular
        return 0; // default to regular
    }

    async function fetchRoomBookings(roomId) {
        if (!roomId) return [];
        if (bookingsCache[roomId]) return bookingsCache[roomId];
        try {
            const res = await fetch('/calendar/bookings');
            const data = await res.json();
            const arr = Array.isArray(data) ? data : [];
            const filtered = arr.filter(b => String(b.ROOM_ID) === String(roomId));
            bookingsCache[roomId] = filtered;
            return filtered;
        } catch (e) {
            return [];
        }
    }

    async function validateAdjacencyOnDropdown() {
        const roomId = $('#edit_addroom').val();
        const bookingId = $('#edit_bookingId').val();
        const dates = parseDateRangeToDates();
        if (!roomId || !dates.checkIn || !dates.checkOut) return { valid: true };

        const ciStatus = $('#edit_checkInStatus').val(); // '1' regular, '0' late
        const coStatus = $('#edit_checkOutStatus').val(); // '0' regular, '1' late

        const roomBookings = await fetchRoomBookings(roomId);

        // Rule A: If my CO is late (1), the next booking starting on my CO date must NOT be regular CI (1)
        if (String(coStatus) === '1') {
            const conflictA = roomBookings.some(b => {
                if (String(b.BookingID ?? b.bookingId) === String(bookingId)) return false;
                const startStr = toISODateOnly(new Date(b.CHECK_IN_DATE ?? b.check_in_date ?? b.checkInDate));
                if (startStr !== dates.checkOut) return false;
                return normalizeCIStatus(b) === 1; // neighbor is regular CI
            });
            if (conflictA) {
                return { valid: false, reason: 'Late Check-out cannot be adjacent to a Regular Check-in on the same date. Only Late Check-in may follow.' };
            }
        }

        // Rule B: If my CI is regular (1), the previous booking ending on my CI date must NOT be late CO (1)
        if (String(ciStatus) === '1') {
            const conflictB = roomBookings.some(b => {
                if (String(b.BookingID ?? b.bookingId) === String(bookingId)) return false;
                const endStr = toISODateOnly(new Date(b.CHECK_OUT_DATE ?? b.check_out_date ?? b.checkOutDate));
                if (endStr !== dates.checkIn) return false;
                return normalizeCOStatus(b) === 1; // neighbor is late CO
            });
            if (conflictB) {
                return { valid: false, reason: 'Regular Check-in cannot directly follow a Late Check-out on the same date. Only Late Check-in may follow.' };
            }
        }

        return { valid: true };
    }

    // Preserve previous values to revert on invalid selection
    let prevCI = null;
    let prevCO = null;

    $(document).ready(function(){
        prevCI = $('#edit_checkInStatus').val();
        prevCO = $('#edit_checkOutStatus').val();

        $('#edit_checkInStatus').on('focus', function(){ prevCI = $(this).val(); });
        $('#edit_checkOutStatus').on('focus', function(){ prevCO = $(this).val(); });

        $('#edit_checkInStatus').on('change', async function(){
            const result = await validateAdjacencyOnDropdown();
            if (!result.valid) {
                Swal.fire({
                    title: 'Not Allowed',
                    html: result.reason,
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                $(this).val(prevCI);
                return;
            }
            prevCI = $(this).val();
        });

        $('#edit_checkOutStatus').on('change', async function(){
            const result = await validateAdjacencyOnDropdown();
            if (!result.valid) {
                Swal.fire({
                    title: 'Not Allowed',
                    html: result.reason,
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                $(this).val(prevCO);
                return;
            }
            prevCO = $(this).val();
        });

        // Reset previous values when room/date changes
        $('#edit_addroom').on('change', function(){ prevCI = $('#edit_checkInStatus').val(); prevCO = $('#edit_checkOutStatus').val(); });
        $('#edit_daterange').on('change', function(){ prevCI = $('#edit_checkInStatus').val(); prevCO = $('#edit_checkOutStatus').val(); });
    });
})();

// Function to compute total for edit form
function computeEditTotal() {
    const roomRate = parseFloat($('#edit_baseprice').val()) || 0;
    const nights = parseInt($('#edit_diffindays').val()) || 1;
    
    const adultQty = parseInt($('#edit_breakfastAdultQty').val()) || 0;
    const adultPrice = parseFloat($('#edit_breakfastAdultPrice').val()) || 0;
    const kidQty = parseInt($('#edit_breakfastKidQty').val()) || 0;
    const kidPrice = parseFloat($('#edit_breakfastKidPrice').val()) || 0;
    
    const pickupPrice = $('#edit_includePickup').prop('checked') ? parseFloat($('#edit_pickupPrice').val()) || 0 : 0;
    const dropoffPrice = $('#edit_includeDropoff').prop('checked') ? parseFloat($('#edit_dropoffPrice').val()) || 0 : 0;
    
    const reservationFee = $('#edit_includeReservationFee').prop('checked') ? parseFloat($('#edit_reservationFeeAmount').val()) || 0 : 0;
    const discount = $('#edit_includeDiscount').prop('checked') ? parseFloat($('#edit_discountAmount').val()) || 0 : 0;
    
    const subtotal = (roomRate * nights) + (adultQty * adultPrice) + (kidQty * kidPrice) + pickupPrice + dropoffPrice;
    const finalBalance = subtotal - reservationFee - discount;
    
    if (finalBalance < 0) {
        $('#edit_computedTotal').html('<b>0.00</b>');
        $('#edit_creditAmount').html(Math.abs(finalBalance).toLocaleString(undefined, { minimumFractionDigits: 2 }));
        $('#edit_creditDisplay').show();
    } else {
        $('#edit_computedTotal').html('<b>' + finalBalance.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
        $('#edit_creditDisplay').hide();
    }
}

// Function to populate edit form (called from parent page)
function populateEditForm(booking) {
