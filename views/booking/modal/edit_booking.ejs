// Update added services list (global function)
function updateEditAddedServicesList(bookingId) {
    const serviceList = $('#edit_added-services-list');
    if (!serviceList.length) return;

    serviceList.empty();

    const roomServices = editAddedServicesMap[bookingId] || [];
    
    // Filter out hidden services
    const visibleServices = roomServices.filter(service => !service.HIDDEN_FOR_UI);

    if (visibleServices.length === 0) {
        // Hide entire Extra Services section when no services
        $('#edit_extra-services-wrapper').hide();
        $('#edit_extra-services-hr').hide();
        serviceList.hide();
        return;
    }

    // Show Extra Services section when there are services
    $('#edit_extra-services-wrapper').show();
    $('#edit_extra-services-hr').show();
    serviceList.show();

    visibleServices.forEach((service, index) => {

        const serviceCost = parseFloat(service.SERVICE_COST) || 0;
        const quantity = parseInt(service.QUANTITY) || 0;
        const isUpgrade = service.SERVICE_ID === 71 || 
                         service.SERVICE_NAME?.toLowerCase() === 'upgrade';
        const quantityDisplay = isUpgrade ? '-' : quantity;
        const totalCost = serviceCost * quantity;
        const costDisplay = (isNaN(totalCost) || totalCost === 0)
            ? '<span class="badge bg-success">FREE</span>'
            : `₱${totalCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

        let statusDisplay;
        if (service.STATUS === 'unpaid') {
            statusDisplay = '<span class="badge bg-warning">UNPAID</span>';
        } else if (service.STATUS === 'paid') {
            statusDisplay = '<span class="badge bg-success">PAID</span>';
        } else {
            statusDisplay = `<span class="badge bg-secondary">${service.STATUS}</span>`;
        }

        const serviceItem = $(`
            <div class="mb-2" style="background-color: #2a3135; border-radius: 6px; border: 1px solid #5a6268; padding: 10px;">
                <div class="row align-items-center">
                    <div class="col-4">
                        <span style="font-weight: 600; color: #ffffff; font-size: 0.9rem;">${service.SERVICE_NAME}</span>
                    </div>
                    <div class="col-2 text-center">
                        <span style="font-weight: 500; color: #bbbbbb; font-size: 0.9rem;">Qty: ${quantityDisplay}</span>
                    </div>
                    <div class="col-3 text-center">
                        <span style="font-weight: 600; color: #ffc107; font-size: 0.9rem;">${costDisplay}</span>
                    </div>
                    <div class="col-3 text-center">
                        ${statusDisplay}
                    </div>
                </div>
            </div>
        `);

        serviceList.append(serviceItem);
    });
}

// Load existing services for edit form (global function)
function loadEditExistingServices(bookingId) {
    if (!bookingId) {
        console.log('loadEditExistingServices: No bookingId provided');
        return;
    }
    
    console.log('loadEditExistingServices: Loading services for bookingId:', bookingId);
    
    fetch(`/booking/get-booking-services/${bookingId}`)
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(responseData => {
            console.log('loadEditExistingServices: Response data:', responseData);
            
            if (responseData.success && responseData.data && Array.isArray(responseData.data)) {
                // Filter to show only extra services (exclude extensions, transport, and form-managed services)
                // Exclude: 
                // -999 (Extended Stay), -101 (Pick-up), -102 (Drop-off) - from old system
                // 72 (Late Checkout), 74 (Breakfast Adult), 75 (Breakfast Kid), 76 (Pick-up), 77 (Drop-off) - managed by checkboxes
                const excludedServiceIds = [-101, -102, 72, 74, 75, 76, 77];
                
                const extraServicesOnly = responseData.data.filter(service => {
                    const serviceId = parseInt(service.SERVICE_ID);
                    return !excludedServiceIds.includes(serviceId);
                });
                
                console.log('loadEditExistingServices: Filtered extra services:', extraServicesOnly);
                
                editAddedServicesMap[bookingId] = extraServicesOnly.map(service => {
                    const quantity = parseInt(service.QTY || service.QUANTITY || 1);
                    const totalCost = parseFloat(service.TOTAL_COST || 0);
                    
                    // For Extended Stay (SERVICE_ID = -999), the TOTAL_COST from backend is actually cost per unit
                    // For other services, TOTAL_COST is the total, so we need to divide by quantity
                    let costPerUnit;
                    if (service.SERVICE_ID === -999) {
                        // Extended Stay: TOTAL_COST is already cost per unit (cost per day)
                        costPerUnit = totalCost;
                    } else {
                        // Other services: Calculate cost per unit (total cost divided by quantity)
                        costPerUnit = quantity > 0 ? totalCost / quantity : totalCost;
                    }
                    
                    return {
                        SERVICE_ID: service.SERVICE_ID,
                        SERVICE_NAME: service.SERVICE_NAME,
                        SERVICE_COST: costPerUnit,
                        QUANTITY: quantity,
                        STATUS: (service.STATUS || 'unpaid').toLowerCase(),
                        IS_CUSTOM: service.SERVICE_ID === -1,
                        ALREADY_SAVED: true
                    };
                });
                
                console.log('loadEditExistingServices: Mapped services:', editAddedServicesMap[bookingId]);
                updateEditAddedServicesList(bookingId);
                computeEditTotal();
            } else {
                console.log('loadEditExistingServices: No services found or invalid response format');
                // Initialize empty array if no services found
                editAddedServicesMap[bookingId] = [];
                updateEditAddedServicesList(bookingId);
            }
        })
        .catch(error => {
            console.error('Error loading existing services:', error);
            // Initialize empty array on error
            editAddedServicesMap[bookingId] = [];
            updateEditAddedServicesList(bookingId);
        });
}

// ================================
// STATUS ADJACENCY VALIDATION
// ================================
(function(){
    const bookingsCache = {};

    function toISODateOnly(d) {
        const dd = new Date(d);
        return new Date(dd.getFullYear(), dd.getMonth(), dd.getDate()).toISOString().split('T')[0];
    }

    function parseDateRangeToDates() {
        const dr = $('#edit_daterange').val() || '';
        if (!dr.includes(' to ')) return { checkIn: null, checkOut: null };
        const parts = dr.split(' to ');
        const startStr = parts[0].trim();
        const endStr = (parts[1] || '').split('(')[0].trim();
        if (!startStr || !endStr) return { checkIn: null, checkOut: null };
        const ci = new Date(startStr);
        const co = new Date(endStr);
        if (isNaN(ci.getTime()) || isNaN(co.getTime())) return { checkIn: null, checkOut: null };
        return { checkIn: toISODateOnly(ci), checkOut: toISODateOnly(co) };
    }

    function normalizeCIStatus(b) {
        const v = b.CHECK_IN_STATUS ?? b.check_in_status ?? b.checkInStatus ?? b.checkin_status ?? b.CHECKIN_STATUS ?? b.CHECK_IN;
        if (v === 1 || v === '1' || String(v).toLowerCase() === 'regular') return 1; // regular
        if (v === 0 || v === '0' || String(v).toLowerCase().includes('late')) return 0; // late
        return 1; // default to regular
    }

    function normalizeCOStatus(b) {
        const v = b.CHECK_OUT_STATUS ?? b.check_out_status ?? b.checkOutStatus ?? b.checkout_status ?? b.CHECKOUT_STATUS ?? b.CHECK_OUT ?? b.CHECKOUT ?? b.LATE_CHECKOUT;
        const s = String(v).toLowerCase();
        if (v === 1 || v === '1' || s.includes('late')) return 1; // late
        if (v === 0 || v === '0' || s.includes('regular')) return 0; // regular
        return 0; // default to regular
    }

    async function fetchRoomBookings(roomId) {
        if (!roomId) return [];
        if (bookingsCache[roomId]) return bookingsCache[roomId];
        try {
            const res = await fetch('/calendar/bookings');
            const data = await res.json();
            const arr = Array.isArray(data) ? data : [];
            const filtered = arr.filter(b => String(b.ROOM_ID) === String(roomId));
            bookingsCache[roomId] = filtered;
            return filtered;
        } catch (e) {
            return [];
        }
    }

    async function validateAdjacencyOnDropdown() {
        const roomId = $('#edit_addroom').val();
        const bookingId = $('#edit_bookingId').val();
        const dates = parseDateRangeToDates();
        if (!roomId || !dates.checkIn || !dates.checkOut) return { valid: true };

        const ciStatus = $('#edit_checkInStatus').val(); // '1' regular, '0' late
        const coStatus = $('#edit_checkOutStatus').val(); // '0' regular, '1' late

        const roomBookings = await fetchRoomBookings(roomId);

        // Rule A: If my CO is late (1), the next booking starting on my CO date must NOT be regular CI (1)
        if (String(coStatus) === '1') {
            const conflictA = roomBookings.some(b => {
                if (String(b.BookingID ?? b.bookingId) === String(bookingId)) return false;
                const startStr = toISODateOnly(new Date(b.CHECK_IN_DATE ?? b.check_in_date ?? b.checkInDate));
                if (startStr !== dates.checkOut) return false;
                return normalizeCIStatus(b) === 1; // neighbor is regular CI
            });
            if (conflictA) {
                return { valid: false, reason: 'Late Check-out cannot be adjacent to a Regular Check-in on the same date. Only Late Check-in may follow.' };
            }
        }

        // Rule B: If my CI is regular (1), the previous booking ending on my CI date must NOT be late CO (1)
        if (String(ciStatus) === '1') {
            const conflictB = roomBookings.some(b => {
                if (String(b.BookingID ?? b.bookingId) === String(bookingId)) return false;
                const endStr = toISODateOnly(new Date(b.CHECK_OUT_DATE ?? b.check_out_date ?? b.checkOutDate));
                if (endStr !== dates.checkIn) return false;
                return normalizeCOStatus(b) === 1; // neighbor is late CO
            });
            if (conflictB) {
                return { valid: false, reason: 'Regular Check-in cannot directly follow a Late Check-out on the same date. Only Late Check-in may follow.' };
            }
        }

        return { valid: true };
    }

    // Preserve previous values to revert on invalid selection
    let prevCI = null;
    let prevCO = null;

    // Initialize previous values when modal is shown
    $(document).on('shown.bs.modal', '#modal-editbooking', function() {
        prevCI = $('#edit_checkInStatus').val();
        prevCO = $('#edit_checkOutStatus').val();
    });

    $(document).ready(function(){
        $('#edit_checkInStatus').on('focus', function(){ prevCI = $(this).val(); });
        $('#edit_checkOutStatus').on('focus', function(){ prevCO = $(this).val(); });

        $('#edit_checkInStatus').on('change', async function(){
            const result = await validateAdjacencyOnDropdown();
            if (!result.valid) {
                Swal.fire({
                    title: 'Not Allowed',
                    html: result.reason,
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                $(this).val(prevCI);
                return;
            }
            prevCI = $(this).val();
        });

        $('#edit_checkOutStatus').on('change', async function(){
            const result = await validateAdjacencyOnDropdown();
            if (!result.valid) {
                Swal.fire({
                    title: 'Not Allowed',
                    html: result.reason,
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                $(this).val(prevCO);
                return;
            }
            prevCO = $(this).val();
        });

        // Reset previous values when room/date changes
        $('#edit_addroom').on('change', function(){ prevCI = $('#edit_checkInStatus').val(); prevCO = $('#edit_checkOutStatus').val(); });
        $('#edit_daterange').on('change', function(){ prevCI = $('#edit_checkInStatus').val(); prevCO = $('#edit_checkOutStatus').val(); });
    });
})();

// Function to format paid amount to 2 decimal places
function formatEditPaidAmount(input) {
    const value = parseFloat(input.value) || 0;
    input.value = value.toFixed(2);
}

// Function to calculate late check-out fee for edit form
function calculateEditLateCheckoutFee() {
    const checkOutStatus = $('#edit_checkOutStatus').val();
    const existingFee = $('#edit_lateCheckoutFee').val();
    
    // Only calculate if we have valid data
    if (!checkOutStatus) {
        // If no existing fee, set to 0
        if (!existingFee || parseFloat(existingFee) == 0) {
            $('#edit_lateCheckoutFee').val(0);
            $('#edit_lateCheckoutFeeDisplay').hide();
        }
        return;
    }
    
    let lateCheckoutFee = 0;
    
    if (checkOutStatus == 1) { // Late Check Out
        // Only set to 2000 if there's no existing fee
        if (!existingFee || parseFloat(existingFee) == 0) {
            lateCheckoutFee = 2000; // ₱2,000 default fee for Late Check Out
            $('#edit_lateCheckoutFee').val(lateCheckoutFee);
            $('#edit_lateCheckoutFeeInput').val(lateCheckoutFee);
        } else {
            // Keep the existing fee
            lateCheckoutFee = parseFloat(existingFee);
        }
        $('#edit_lateCheckoutFeeDisplay').show();
    } else {
        // Regular Check Out - no fee
        $('#edit_lateCheckoutFee').val(0);
        $('#edit_lateCheckoutFeeInput').val(0);
        $('#edit_lateCheckoutFeeDisplay').hide();
    }
    
    // Recalculate total to include late check-out fee
    computeEditTotal();
}

// Function to compute total for edit form
function computeEditTotal() {
    console.log('computeEditTotal called');
    const roomRate = parseFloat($('#edit_baseprice').val()) || 0;
    const nights = parseInt($('#edit_diffindays').val()) || 1;
    
    const adultQty = parseInt($('#edit_breakfastAdultQty').val()) || 0;
    const adultPrice = parseFloat($('#edit_breakfastAdultPrice').val()) || 0;
    const kidQty = parseInt($('#edit_breakfastKidQty').val()) || 0;
    const kidPrice = parseFloat($('#edit_breakfastKidPrice').val()) || 0;
    
    const pickupPrice = $('#edit_includePickup').prop('checked') ? parseFloat($('#edit_pickupPrice').val()) || 0 : 0;
    const dropoffPrice = $('#edit_includeDropoff').prop('checked') ? parseFloat($('#edit_dropoffPrice').val()) || 0 : 0;
    
    // Get late check-out fee
    const lateCheckoutFee = parseFloat($('#edit_lateCheckoutFee').val()) || 0;
    
    // Calculate extra services total
    const bookingId = $('#edit_bookingId').val();
    let extraServicesTotal = 0;
    if (bookingId && editAddedServicesMap[bookingId]) {
        editAddedServicesMap[bookingId].forEach(service => {
            if (!service.HIDDEN_FOR_UI) {
                const serviceCost = parseFloat(service.SERVICE_COST) || 0;
                const quantity = parseInt(service.QUANTITY) || 0;
                extraServicesTotal += serviceCost * quantity;
            }
        });
    }
    
    // Calculate room charges only (for Senior/PWD discount)
    const roomCharges = roomRate * nights;
    
    // Calculate subtotal (before discounts)
    const subtotal = roomCharges + (adultQty * adultPrice) + (kidQty * kidPrice) + pickupPrice + dropoffPrice + lateCheckoutFee + extraServicesTotal;
    
    // Senior/PWD Discount (percentage-based)
    const seniorPwdDiscountChecked = $('#edit_includeSeniorPwdDiscount').prop('checked');
    let seniorPwdDiscountAmount = 0;
    
    // Calculate Senior/PWD discount (percentage of ROOM CHARGES ONLY, not services)
    if (seniorPwdDiscountChecked && roomCharges > 0) {
        let discountPercent = parseFloat($('#edit_seniorPwdDiscountPercent').val()) || 20; // Default to 20%
        // Enforce maximum of 100%
        if (discountPercent > 100) {
            discountPercent = 100;
            $('#edit_seniorPwdDiscountPercent').val(100);
        }
        if (discountPercent < 0) {
            discountPercent = 0;
            $('#edit_seniorPwdDiscountPercent').val(0);
        }
        const discountDecimal = discountPercent / 100; // Convert percentage to decimal
        seniorPwdDiscountAmount = roomCharges * discountDecimal; // Apply only to room charges
        $('#edit_seniorPwdDiscount').val(seniorPwdDiscountAmount.toFixed(2));
        $('#edit_seniorPwdDiscountAmount').val('₱' + seniorPwdDiscountAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#edit_seniorPwdDiscountDisplay').show();
        
        // If Senior/PWD discount is 100%, automatically disable Additional Discount
        if (discountPercent >= 100) {
            $('#edit_includeDiscount').prop('checked', false);
            $('#edit_discountWrapper').hide();
            $('#edit_discountAmount').val('0');
        }
    } else {
        $('#edit_seniorPwdDiscount').val(0);
        $('#edit_seniorPwdDiscountAmount').val('');
        $('#edit_seniorPwdDiscountDisplay').hide();
    }
    
    // Separate Additional discount from total discount if loading from saved booking
    let discount = 0;
    if (window.editBookingTotalDiscount !== undefined && window.editBookingTotalDiscount > 0) {
        // We're loading from a saved booking - separate the discounts
        const totalDiscount = window.editBookingTotalDiscount;
        if (seniorPwdDiscountChecked && seniorPwdDiscountAmount > 0) {
            // Calculate Additional discount as the difference
            discount = Math.max(0, totalDiscount - seniorPwdDiscountAmount);
            if (discount > 0) {
                $('#edit_includeDiscount').prop('checked', true);
                $('#edit_discountWrapper').show();
                $('#edit_discountAmount').val(discount.toFixed(2));
            } else {
                $('#edit_includeDiscount').prop('checked', false);
                $('#edit_discountWrapper').hide();
                $('#edit_discountAmount').val('');
            }
        } else {
            // No Senior/PWD discount, all goes to Additional
            discount = totalDiscount;
            $('#edit_includeDiscount').prop('checked', true);
            $('#edit_discountWrapper').show();
            $('#edit_discountAmount').val(discount.toFixed(2));
        }
        // Clear the flag after first use
        window.editBookingTotalDiscount = undefined;
    } else {
        // Normal calculation - use value from input
        discount = $('#edit_includeDiscount').prop('checked') ? parseFloat($('#edit_discountAmount').val()) || 0 : 0;
    }
    
    // Calculate final balance (subtotal - senior/pwd discount - additional discount)
    let finalBalance = subtotal - seniorPwdDiscountAmount - discount;
    
    // Ensure finalBalance is not negative
    if (finalBalance < 0) {
        finalBalance = 0;
    }
    
    // Get paid amount and validate it doesn't exceed total
    let paidAmount = parseFloat($('#edit_paidAmount').val()) || 0;
    
    console.log('Paid Amount:', paidAmount, 'Final Balance:', finalBalance);
    
    // Check if this is a direct reservation / unassigned-room scenario
    // (check booking data or case where subtotal is 0 / no room rate yet)
    let isDirectReservation = false;
    
    // Check if booking is marked as direct reservation by checking if room_id is empty
    const roomId = $('#edit_addroom').val();
    if (!roomId || roomId === '' || roomId === '0') {
        isDirectReservation = true;
    }
    
    // Also consider it direct reservation if subtotal is 0 (no room rate yet)
    if (subtotal === 0) {
        isDirectReservation = true;
    }
    
    // Prevent paid amount from exceeding total and ensure it's not negative
    if (!isDirectReservation) {
        if (paidAmount > finalBalance) {
            paidAmount = finalBalance;
            $('#edit_paidAmount').val(paidAmount.toFixed(2));
        }
        // Ensure paid amount is not negative
        if (paidAmount < 0) {
            paidAmount = 0;
            $('#edit_paidAmount').val('0.00');
        }
    }
    
    // Calculate balance (total - paid amount)
    const balance = finalBalance - paidAmount;
    
    // Determine payment status
    let paymentStatus;
    if (paidAmount <= 0) {
        paymentStatus = 'unpaid';
    } else if (paidAmount >= finalBalance) {
        paymentStatus = 'paid';
    } else {
        paymentStatus = 'partial';
    }
    
    console.log('Payment Status:', paymentStatus);
    
    // Update payment status display
    $('#edit_paymentStatus').val(paymentStatus);
    
    // Update payment status styling with CSS classes
    $('#edit_paymentStatus').removeClass('status-paid status-partial status-unpaid');
    if (paymentStatus === 'paid') {
        $('#edit_paymentStatus').addClass('status-paid');
    } else if (paymentStatus === 'partial') {
        $('#edit_paymentStatus').addClass('status-partial');
    } else {
        $('#edit_paymentStatus').addClass('status-unpaid');
    }
    
    if (finalBalance < 0) {
        $('#edit_computedTotal').html('<b>0.00</b>');
        $('#edit_creditAmount').html(Math.abs(finalBalance).toLocaleString(undefined, { minimumFractionDigits: 2 }));
        $('#edit_creditDisplay').show();
        // Balance is same as total when total is negative
        $('#edit_computedBalance').html('<b>' + balance.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
        // Update paid amount display
        $('#edit_computedPaidAmount').html('<b>' + paidAmount.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
    } else {
        $('#edit_computedTotal').html('<b>' + finalBalance.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
        $('#edit_creditDisplay').hide();
        // Show balance (total - paid amount)
        $('#edit_computedBalance').html('<b>' + balance.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
        // Update paid amount display
        $('#edit_computedPaidAmount').html('<b>' + paidAmount.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
    }
}

