    $('#edit_bookingId').val(booking.bookingId);
    $('#edit_guestID').val(booking.CUSTOMER_ID);
    
    // Set form fields
    $('#edit_daterange').val(booking.daterange);
    $('#edit_txtFullNameAdd').val(booking.fullname);
    $('#edit_txtNumber').val(booking.number);
    $('#edit_maxOccupants').val(booking.GUESTS_COUNT);
    $('#edit_paymentStatus').val(booking.PAYMENT_STATUS);
    $('#edit_price').val(booking.price);
    $('#edit_baseprice').val(booking.price);
    $('#edit_diffindays').val(booking.diffindays);
    $('#edit_guestType').val(booking.guestType);
    $('#edit_guestLevel').val(booking.guestLevel);
    $('#edit_bookingRoute').val(booking.BOOKING_CHANNEL);
    $('#edit_checkInStatus').val(booking.CHECK_IN_STATUS);
    $('#edit_checkOutStatus').val(booking.LATE_CHECKOUT);
    $('#edit_bookingRemarks').val(booking.REMARKS);
    $('#edit_agencySelect').val(booking.agencyID);
    $('#edit_bedCount').val(booking.ROOM_BED === 1 ? '1' : booking.ROOM_BED === 2 ? '2' : 'N/A');
    $('#edit_room_type').val(booking.ROOM_VIEW === 1 ? 'Condo View' : booking.ROOM_VIEW === 2 ? 'Mountain View' : 'N/A');
    $('#edit_room_type_hidden').val(booking.ROOM_TYPE);
    
    // Set services
    if (parseInt(booking.breakfastAdultQty) > 0) {
        $('#edit_includeBreakfast').prop('checked', true);
        $('#edit_breakfastInputs').show();
        $('#edit_breakfastAdultQty').val(booking.breakfastAdultQty);
        $('#edit_breakfastAdultPrice').val(booking.breakfastAdultPrice);
        $('#edit_breakfastAdultId').val(booking.breakfastAdultId);
    }
    
    if (parseInt(booking.breakfastKidQty) > 0) {
        $('#edit_breakfastKidQty').val(booking.breakfastKidQty);
        $('#edit_breakfastKidPrice').val(booking.breakfastKidPrice);
        $('#edit_breakfastKidId').val(booking.breakfastKidId);
    }
    
    if (parseFloat(booking.pickupPrice) > 0) {
        $('#edit_includePickup').prop('checked', true);
        $('#edit_pickupWrapper').show();
        $('#edit_pickupPrice').val(booking.pickupPrice);
        $('#edit_pickupServiceId').val(booking.pickupServiceId);
    }
    
    if (parseFloat(booking.dropoffPrice) > 0) {
        $('#edit_includeDropoff').prop('checked', true);
        $('#edit_dropoffWrapper').show();
        $('#edit_dropoffPrice').val(booking.dropoffPrice);
        $('#edit_dropoffServiceId').val(booking.dropoffServiceId);
    }
    
    // Set reservation fee and discount
    if (parseFloat(booking.RESERVATION_FEE) > 0) {
        $('#edit_includeReservationFee').prop('checked', true);
        $('#edit_reservationFeeWrapper').show();
        $('#edit_reservationFeeAmount').val(booking.RESERVATION_FEE);
    }
    
    if (parseFloat(booking.DISCOUNT_AMOUNT) > 0) {
        $('#edit_includeDiscount').prop('checked', true);
        $('#edit_discountWrapper').show();
        $('#edit_discountAmount').val(booking.DISCOUNT_AMOUNT);
    }
    
    // Set room selection if not direct reservation
    if (!booking.IS_DIRECT_RESERVATION && booking.ROOM_ID) {
        populateEditRoomSelection(booking.ROOM_ID, booking.ROOM_FLOOR);
    }
    
    // Recompute total
    computeEditTotal();
}

// Function to populate room selection in edit form
function populateEditRoomSelection(roomId, floorNumber) {
    // Set floor
    $('#edit_addFloor').val(floorNumber);
    
    // Get current dates for filtering
    const daterange = $('#edit_daterange').val();
    if (!daterange) return;
    
    // Parse dates from daterange
    const dateRangeParts = daterange.split(' to ');
    const startDateStr = dateRangeParts[0].trim();
    const endDateStr = dateRangeParts[1].split('(')[0].trim();
    
    // Convert to YYYY-MM-DD format
    const checkInDate = moment(startDateStr, 'MMM DD, YYYY').format('YYYY-MM-DD');
    const checkOutDate = moment(endDateStr, 'MMM DD, YYYY').format('YYYY-MM-DD');
    
    // Fetch available rooms for the selected floor and dates
    fetch('/booking/get_available_rooms_by_floor', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            floor: floorNumber,
            checkInDate: checkInDate,
            checkOutDate: checkOutDate,
            excludeBookingId: $('#edit_bookingId').val()
        })
    })
    .then(response => response.json())
    .then(data => {
        const roomDropdown = $('#edit_addroom');
        roomDropdown.empty().append('<option value="" disabled>Select Room</option>');

        console.log('Available rooms response:', data); // Debug log

        if (data.length === 0) {
            roomDropdown.append('<option value="" disabled>No available rooms for selected dates</option>');
        } else {
            let currentRoomFound = false;
            data.forEach(room => {
                const selected = room.room_id == roomId ? 'selected' : '';
                if (room.room_id == roomId) {
                    currentRoomFound = true;
                }
                roomDropdown.append(`<option value="${room.room_id}" ${selected}>${room.ROOM_NUMBER}</option>`);
            });

            // If current room not found in available rooms, add it manually
            if (!currentRoomFound && roomId) {
                console.log('Current room not found in available rooms, adding manually');
                roomDropdown.append(`<option value="${roomId}" selected>${roomId} (Current)</option>`);
            }
        }
    })
    .catch(error => {
        console.error('Error fetching available rooms:', error);
    });
}

// Function to open edit booking modal (called from parent page)
function editBooking(bookingId) {
    console.log('Editing booking ID:', bookingId);
    
    // Fetch booking details
    fetch(`/booking/edit_booking/${bookingId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                populateEditForm(data.booking);
                $('#modal-editbooking').modal('show');
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: data.message || 'Failed to fetch booking details',
                    confirmButtonText: 'OK'
                });
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: 'An error occurred while fetching booking details',
                confirmButtonText: 'OK'
            });
        });
}

// Guest search functionality for edit form
function searchEditCustomer(query) {
    if (query.length === 0) {
        document.getElementById('edit_searchResults').style.display = 'none';
        return;
    }

    fetch(`/booking/search-customer?query=${encodeURIComponent(query)}`)
        .then(response => response.json())
        .then(data => {
            const resultsDiv = document.getElementById('edit_searchResults');
            if (data.length > 0) {
                resultsDiv.innerHTML = data.map(customer => 
                 `<div style="color: #000; padding: 10px; cursor: pointer; background-color: #f8f9fa; border: 1px solid #dee2e6; margin: 2px 0; border-radius: 4px;" onclick="selectEditCustomer('${customer.NAME}', '${customer.LEVEL}', '${customer.CUSTOMER_ID}', '${customer.CONTACT_NO}', '${customer.TYPE}')">
                        ${customer.NAME} (${customer.LEVEL})
                    </div>`).join('');
                resultsDiv.style.display = 'block';
            } else {
                resultsDiv.style.display = 'none';
            }
        })
        .catch(error => console.error('Error fetching customers:', error));
}

// Hide search results on blur
function hideEditSearchResults() {
    setTimeout(() => {
        document.getElementById('edit_searchResults').style.display = 'none';
    }, 200);
}

// Function to update the edit form inputs based on the selected customer
function selectEditCustomer(name, level, customerId, contactNo, guestType) {
    document.getElementById('edit_txtFullNameAdd').value = name;
    document.getElementById('edit_searchResults').style.display = 'none';

    // Set the Guest Level dropdown value based on the level of the selected customer
    const guestLevelDropdown = document.getElementById('edit_guestLevel');
    for (let i = 0; i < guestLevelDropdown.options.length; i++) {
        if (guestLevelDropdown.options[i].text === level) {
            guestLevelDropdown.selectedIndex = i;
            break;
        }
    }

    // Update the Guest Type dropdown value based on the type of the selected customer
    const guestTypeDropdown = document.getElementById('edit_guestType');
    for (let i = 0; i < guestTypeDropdown.options.length; i++) {
        if (guestTypeDropdown.options[i].text === guestType) {
            guestTypeDropdown.selectedIndex = i;
            break;
        }
    }

    // Set the Contact Number field
    document.getElementById('edit_txtNumber').value = contactNo;

    // Store the Customer ID in the hidden input field
    document.getElementById('edit_guestID').val(customerId);
}

// Add event listener to reset dropdowns when guest name changes
$(document).ready(function() {
    $('#edit_txtFullNameAdd').on('input', function() {
        // Clear the Customer ID and Contact Number fields
        $('#edit_guestID').val('');
        $('#edit_txtNumber').val('');

        // Reset the selected values in the dropdowns
        $('#edit_guestType').prop('selectedIndex', 0);
        $('#edit_guestLevel').prop('selectedIndex', 0);
    });

    // Prevent hiding if clicked inside search results
    $('#edit_searchResults').on('mousedown', function(event) {
        event.preventDefault();
    });
});
</script>
