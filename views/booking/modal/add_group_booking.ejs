                  <option value="" disabled selected>Check-In Status</option>
                  <option value="1" selected>Regular Check In</option>
                  <option value="0" >Late Check In</option>
                </select>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="form-group">
                <label class="form-label">Check-Out Status</label>
                <select class="form-select" id="groupCheckOutStatus" name="groupCheckOutStatus" required>
                  <option value="" disabled selected>Check-Out Status</option>
                  <option value="0" selected>Regular Check Out</option>
                  <option value="1" >Late Check Out</option>
