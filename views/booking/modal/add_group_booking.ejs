  function displayManualRateInputs(selectedRooms) {
    const container = $('#groupManualRateList');
    const section = $('#groupManualRateSection');
    
    if (!selectedRooms || !selectedRooms.length) {
      section.hide();
      return;
    }

    // Check if manual rates checkbox is checked
    const isManualRatesEnabled = $('#groupEnableManualRates').is(':checked');
    if (!isManualRatesEnabled) {
      section.hide();
      return;
    }

    container.empty();
    
    selectedRooms.forEach(room => {
      const roomId = room.IDNo;
      const roomNumber = room.ROOM_NUMBER;
      const bedCount = parseInt(room.ROOM_BED, 10);
      const bedBadge = Number.isFinite(bedCount) && bedCount > 0
        ? `<span class="bed-badge">${bedCount}<i class="fa fa-bed"></i></span>`
        : '';
      
      // Get default rate
      const dates = getSelectedDateRange();
      const bookingType = $('#groupBookingRoute').val();
      const defaultRate = typeof room.RESOLVED_PRICE === 'number'
        ? room.RESOLVED_PRICE
        : (() => {
            const seasonalPrices = room.SEASONAL_PRICES || [];
            const seasonId = getSeasonIdForDate(dates.start, seasonalPrices);
            const match = seasonalPrices.find(price => 
              parseInt(price.bedCount, 10) === bedCount && 
              price.bookingType === bookingType && 
              parseInt(price.seasonId, 10) === parseInt(seasonId, 10)
            );
            return match ? parseFloat(match.price) : 0;
          })();
      
      // Get manual rate if exists
      const manualRate = groupManualRates[roomId] || defaultRate;
      
      const rateItem = `
        <div class="manual-rate-item" data-room-id="${roomId}">
          <div class="room-info">
            <span class="room-number">${roomNumber}</span>
            ${bedBadge}
          </div>
          <div class="rate-input-group">
            <input type="number" 
                   class="form-control manual-rate-input" 
                   data-room-id="${roomId}" 
                   data-default-rate="${defaultRate}"
                   value="${manualRate}" 
                   min="0" 
                   step="0.01"
                   placeholder="Enter rate">
          </div>
        </div>`;
      
      container.append(rateItem);
    });
    
    section.show();
  }

  function displayBedBasedRateInputs(selectedRooms) {
    const container = $('#groupBedBasedRateList');
    const section = $('#bedBasedRateSection');
    
    if (!selectedRooms || !selectedRooms.length) {
      section.hide();
      return;
    }

    // Group rooms by bed count
    const roomsByBed = {};
    selectedRooms.forEach(room => {
      const bedCount = parseInt(room.ROOM_BED, 10);
      if (!roomsByBed[bedCount]) {
        roomsByBed[bedCount] = [];
      }
      roomsByBed[bedCount].push(room);
    });

    container.empty();
    
    // Create bed-based rate inputs
    Object.keys(roomsByBed).sort().forEach(bedCount => {
      const rooms = roomsByBed[bedCount];
      const roomNumbers = rooms.map(r => r.ROOM_NUMBER).join(', ');
      const roomCount = rooms.length;
      
      // Get default rate for this bed type (use first room as reference)
      const firstRoom = rooms[0];
      const dates = getSelectedDateRange();
      const bookingType = $('#groupBookingRoute').val();
      const defaultRate = typeof firstRoom.RESOLVED_PRICE === 'number'
        ? firstRoom.RESOLVED_PRICE
        : (() => {
            const seasonalPrices = firstRoom.SEASONAL_PRICES || [];
            const seasonId = getSeasonIdForDate(dates.start, seasonalPrices);
            const match = seasonalPrices.find(price => 
              parseInt(price.bedCount, 10) === parseInt(bedCount, 10) && 
              price.bookingType === bookingType && 
              parseInt(price.seasonId, 10) === parseInt(seasonId, 10)
            );
            return match ? parseFloat(match.price) : 0;
          })();
      
      // Get bed-based rate if exists
      const bedBasedRate = groupBedBasedRates[bedCount] || defaultRate;
      
       const bedItem = `
         <div class="bed-based-rate-item" data-bed-count="${bedCount}">
           <div class="bed-info">
             <span class="bed-label">${bedCount} Bed Room${bedCount > 1 ? 's' : ''}</span>
             <span class="bed-badge">${bedCount}<i class="fa fa-bed"></i></span>
           </div>
           <div class="rate-input-group">
             <input type="number" 
                    class="form-control bed-based-rate-input" 
                    data-bed-count="${bedCount}" 
                    data-default-rate="${defaultRate}"
                    value="${bedBasedRate}" 
                    min="0" 
                    step="0.01"
                    placeholder="Enter rate">
           </div>
         </div>`;
      
      container.append(bedItem);
    });
    
    section.show();
  }

