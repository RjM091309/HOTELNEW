  function handleSearchRooms() {
    $('#groupSearchRooms').on('click', function() {
      const dates = getSelectedDateRange();
      const neededRooms = $('#groupNumberOfRooms').val();
      const neededRoomsNum = parseInt(neededRooms, 10);
      const bed1Needed = parseInt($('#groupBed1Count').val(), 10) || 0;
      const bed2Needed = parseInt($('#groupBed2Count').val(), 10) || 0;
      const totalBedNeeded = bed1Needed + bed2Needed;
      const bookingRoute = $('#groupBookingRoute').val();

      if (!dates) {
        Swal.fire('Missing Date Range', 'Please select a valid date range.', 'warning');
        return;
      }
      if (!neededRooms) {
        Swal.fire('Missing Room Count', 'Please enter the number of rooms needed.', 'warning');
        return;
      }
      if (!bookingRoute) {
        Swal.fire('Missing Booking Resource', 'Please select a booking resource before searching for rooms.', 'warning');
        return;
      }

      const checkInStatus = $('#groupCheckInStatus').val();
      const checkOutStatus = $('#groupCheckOutStatus').val();

      if (!checkInStatus || checkInStatus === '') {
        Swal.fire('Missing Check-In Status', 'Please select a Check-In Status before searching for rooms.', 'warning');
        return;
      }

      if (!checkOutStatus || checkOutStatus === '') {
        Swal.fire('Missing Check-Out Status', 'Please select a Check-Out Status before searching for rooms.', 'warning');
        return;
      }

      if ((bed1Needed > 0 || bed2Needed > 0) && totalBedNeeded !== neededRoomsNum) {
        Swal.fire('Bed Count Mismatch', 'The sum of bed requirements must equal the total number of rooms needed.', 'warning');
        return;
      }

      if (neededRoomsNum > 0 && totalBedNeeded === 0) {
        Swal.fire('Bed Requirement Missing', 'Please specify how many rooms should have 1 bed or 2 beds before searching.', 'warning');
        return;
      }

      groupRequiredBed1 = bed1Needed;
      groupRequiredBed2 = bed2Needed;

      $.ajax({
        url: '/booking/find_consecutive_rooms',
        type: 'POST',
        data: {
          startDate: dates.start,
          endDate: dates.end,
          neededRooms: neededRooms,
          floorNumber: $('#groupFloorSelect').val() || '',
          bed1Needed: bed1Needed,
          bed2Needed: bed2Needed,
          bookingRoute: bookingRoute,
          checkInStatus: $('#groupCheckInStatus').val(),
          checkOutStatus: $('#groupCheckOutStatus').val()
        },
        success: function(response) {
          if (!response.success) {
            Swal.fire('No Rooms Found', response.message || 'No available rooms for the selected criteria.', 'info');
            // Pass available rooms data even when search fails to show bed counts
            const availableRooms = response.data && response.data.availableRooms ? response.data.availableRooms : [];
            displayGroupRoomResults({ 
              consecutiveBlocks: [], 
              nonConsecutiveBlocks: [], 
              availableRooms: availableRooms,
              unassignedConflicts: response.data && response.data.unassignedConflicts ? response.data.unassignedConflicts : []
            }, null, false);
            if (response.data && response.data.availableBedSummary) {
              showBedSummaryWarning(response.data.availableBedSummary, neededRoomsNum, bed1Needed, bed2Needed, response.data.unassignedConflicts, response.data.availableRooms || []);
            } else if (response.data && response.data.unassignedConflicts) {
              showUnassignedConflictWarning(response.data.unassignedConflicts, response.data.availableRooms || []);
            }
            return;
          }

          const data = response.data || {};
          const availableRooms = data.availableRooms || [];
          const availableCount = availableRooms.length;

          if (neededRoomsNum > availableCount) {
            // Pass available rooms data to show bed counts even when not enough rooms
            displayGroupRoomResults({ 
              consecutiveBlocks: [], 
              nonConsecutiveBlocks: [], 
              availableRooms: availableRooms,
              unassignedConflicts: data.unassignedConflicts || []
            }, null, false);
            setManualSelectionMode(false);
            if (data.unassignedConflicts && data.unassignedConflicts.length) {
              showUnassignedConflictWarning(data.unassignedConflicts, availableRooms);
            } else {
              showBedSummaryWarning({
                bed1: availableRooms.filter(r => parseInt(r.ROOM_BED, 10) === 1).length,
                bed2: availableRooms.filter(r => parseInt(r.ROOM_BED, 10) === 2).length
              }, neededRoomsNum, bed1Needed, bed2Needed, [], availableRooms);
            }
            return;
          }

          groupNonConsecutiveBlocks = data.nonConsecutiveBlocks || [];
          toggleAvailabilityWarning(false);
          displayGroupRoomResults({
            consecutiveBlocks: data.consecutiveBlocks || [],
            nonConsecutiveBlocks: groupNonConsecutiveBlocks,
            availableRooms,
            unassignedConflicts: data.unassignedConflicts || []
          }, null, true);

          if (groupManualMode) {
            refreshManualSelectionDisabledState();
          }
        },
        error: function(err) {
          console.error('Error finding rooms:', err);
          Swal.fire('Error', 'There was a problem searching for rooms. Please try again.', 'error');
        }
      });
    });
  }

