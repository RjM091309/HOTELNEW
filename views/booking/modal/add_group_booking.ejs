  function setManualSelectionMode(enabled) {
    groupManualMode = enabled;
    $('#groupManualSelectToggle').prop('checked', enabled);
    $('#groupRoomsList').toggle(!enabled);
    $('#groupManualRoomsContainer, #groupManualSelectionInfo').toggle(enabled);
    $('#groupAvailabilityWarning').toggle(!enabled); // Toggle availability warning

    if (!enabled) {
      groupManualSelectedRooms = [];
      groupRequiredBed1 = 0;
      groupRequiredBed2 = 0;
      groupUnassignedConflicts = [];
      $('#groupManualRoomsContainer').empty();
      $('#groupManualSelectionInfo').text('');
      toggleAvailabilityWarning(false); // Hide availability warning
      $('#groupSelectedRooms').val('');
      $('#groupSelectedRoomPrices').val('');
      $('#groupSelectedRoomNumbers').val('');
      $('#groupManualSelectToggle').prop('disabled', false);
      computeGroupTotal();
      return;
    }

    // Manual rooms now rendered directly in main container - no need to call renderManualSelectionList
    updateManualSelectionInfo();
  }

  function renderManualSelectionList(rooms) {
    const container = $('#groupManualRoomsContainer');
    container.empty();
    if (!rooms || !rooms.length) {
      container.append('<p class="text-warning">No rooms available for manual selection.</p>');
      return;
    }

    const listHtml = rooms.map(room => {
      const disabled = shouldDisableRoomForManualSelection(room);
      const bedCount = parseInt(room.ROOM_BED, 10);
      const bedBadge = Number.isFinite(bedCount) && bedCount > 0
        ? `<span class="bed-badge">${bedCount}<i class="fa fa-bed"></i></span>`
        : '';
      return `
        <div class="form-check room-option${disabled ? ' disabled-room' : ''}">
          <input class="form-check-input" type="checkbox" data-room-id="${room.IDNo}" ${groupManualSelectedRooms.includes(room.IDNo) ? 'checked' : ''} ${disabled ? 'disabled' : ''}>
          <label class="form-check-label ms-2">
            ${room.ROOM_NUMBER}${bedBadge ? ` ${bedBadge}` : ''}
          </label>
        </div>`;
    }).join('');

    container.append(listHtml);

    container.find('input[type="checkbox"]').each(function() {
      const roomId = parseInt($(this).data('room-id'), 10);
      if (groupManualSelectedRooms.includes(roomId)) {
        $(this).prop('checked', true);
      }
    });
  }

  function formatCurrencyDisplay(value) {
    return `₱${Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  function getManualBedSummary() {
    const bed1 = groupManualSelectedRooms.reduce((count, roomId) => {
      const room = groupAvailableRooms.find(r => r.IDNo === roomId);
      return count + (room && parseInt(room.ROOM_BED, 10) === 1 ? 1 : 0);
    }, 0);
    const bed2 = groupManualSelectedRooms.reduce((count, roomId) => {
      const room = groupAvailableRooms.find(r => r.IDNo === roomId);
      return count + (room && parseInt(room.ROOM_BED, 10) === 2 ? 1 : 0);
    }, 0);
    return { bed1, bed2 };
  }

  function hasReachedManualSelectionLimit() {
    const neededRooms = parseInt($('#groupNumberOfRooms').val(), 10) || 0;
    const selectedCount = groupManualSelectedRooms.length;

    if (groupRequiredBed1 || groupRequiredBed2) {
      const summary = getManualBedSummary();
      if (summary.bed1 >= groupRequiredBed1 && summary.bed2 >= groupRequiredBed2 && selectedCount >= neededRooms) {
        return true;
      }
      return selectedCount >= neededRooms;
    }

    return neededRooms > 0 && selectedCount >= neededRooms;
  }

  function updateManualSelectionInfo() {
    const neededRooms = parseInt($('#groupNumberOfRooms').val(), 10) || 0;
    const selectedCount = groupManualSelectedRooms.length;
    const remaining = Math.max(neededRooms - selectedCount, 0);

    const bedSummary = getManualBedSummary();
    const bedInfoParts = [];
    if (groupRequiredBed1 > 0) {
      bedInfoParts.push(`${bedSummary.bed1}/${groupRequiredBed1} (1 bed)`);
    }
    if (groupRequiredBed2 > 0) {
      bedInfoParts.push(`${bedSummary.bed2}/${groupRequiredBed2} (2 beds)`);
    }

    let info = '';
    if (!neededRooms) {
      info = `Selected ${selectedCount} room(s).`;
    } else if (remaining === 0) {
      info = `Selected ${selectedCount} room(s). Ready to proceed.`;
    } else {
      info = `Selected ${selectedCount} room(s). Need ${remaining} more.`;
    }

    if (bedInfoParts.length) {
      info += ` | Beds: ${bedInfoParts.join(', ')}`;
    }

    $('#groupManualSelectionInfo').text(info).show();
    refreshManualSelectionDisabledState();
  }

  function toggleAvailabilityWarning(show, message) {
    const warning = $('#groupAvailabilityWarning');
    if (show) {
      warning.text(message || '').show();
    } else {
      warning.text('').hide();
    }
  }

  function showBedSummaryWarning(summary, neededCount, bed1Needed = 0, bed2Needed = 0, conflicts = [], availableRooms = []) {
    if (conflicts && conflicts.length) {
      showUnassignedConflictWarning(conflicts, availableRooms);
      return;
    }

    if (!summary) {
      toggleAvailabilityWarning(false);
      return;
    }

    const parts = [];
    if (typeof summary.bed1 === 'number') {
      parts.push(`${summary.bed1} room(s) with 1 bed`);
    }
    if (typeof summary.bed2 === 'number') {
      parts.push(`${summary.bed2} room(s) with 2 beds`);
    }

    const availability = summariseBedAvailability(availableRooms);

    const requirementInfo = (bed1Needed || bed2Needed)
      ? `Needs ${bed1Needed} of 1-bed and ${bed2Needed} of 2-bed rooms.`
      : '';

    const message = [
      `Available rooms (${parts.join(', ')}) do not meet ${neededCount} required rooms.`,
      requirementInfo,
      availability ? `Currently available: ${availability}` : ''
    ].filter(Boolean).join(' ');

    toggleAvailabilityWarning(true, message);
  }

  function showUnassignedConflictWarning(conflicts, availableRooms = []) {
    if (!conflicts || !conflicts.length) {
      toggleAvailabilityWarning(false);
      return;
    }

    const availability = summariseBedAvailability(availableRooms);

    const conflictText = conflicts.map(conflict => {
      return `All ${conflict.bed === 1 ? '1-bed' : '2-bed'} rooms are reserved for unassigned bookings (${conflict.reserved}).`;
    }).join(' ');

    const message = [conflictText, availability ? `Currently available: ${availability}` : ''].filter(Boolean).join(' ');

    toggleAvailabilityWarning(true, message);
  }

  function summariseBedAvailability(rooms) {
    if (!rooms || !rooms.length) return '';
    const bed1 = rooms.filter(room => parseInt(room.ROOM_BED, 10) === 1).length;
    const bed2 = rooms.filter(room => parseInt(room.ROOM_BED, 10) === 2).length;
    const parts = [];
    if (bed1) parts.push(`${bed1} room(s) with 1 bed`);
    if (bed2) parts.push(`${bed2} room(s) with 2 beds`);
    return parts.join(', ');
  }

  function shouldDisableRoomForManualSelection(room) {
    if (!room) return true;
    const bedType = parseInt(room.ROOM_BED, 10);
    if (!groupUnassignedConflicts || !groupUnassignedConflicts.length) return false;
    return groupUnassignedConflicts.some(conf => parseInt(conf.bed, 10) === bedType);
  }

  function refreshManualSelectionDisabledState() {
    const limitReached = hasReachedManualSelectionLimit();
    const summary = getManualBedSummary();
    $('#groupRoomsList .group-manual-checkbox').each(function() {
      const roomId = parseInt($(this).data('room-id'), 10);
      const room = groupAvailableRooms.find(r => r.IDNo === roomId);
      const bedType = room ? parseInt(room.ROOM_BED, 10) : null;

      // REMOVED: shouldDisableRoomForManualSelection check - causing over-disabling

      // Only disable rooms that are NOT needed
      if (groupRequiredBed2 === 0 && bedType === 2) {
        // If 0 2-bed rooms needed, disable all 2-bed rooms only  
        $(this).prop('checked', false).prop('disabled', true);
        groupManualSelectedRooms = groupManualSelectedRooms.filter(id => id !== roomId);
        return;
      }

      if (groupRequiredBed1 || groupRequiredBed2) {
        if (bedType === 1 && summary.bed1 >= groupRequiredBed1 && !groupManualSelectedRooms.includes(roomId)) {
          $(this).prop('disabled', true);
          return;
        }
        if (bedType === 2 && summary.bed2 >= groupRequiredBed2 && !groupManualSelectedRooms.includes(roomId)) {
          $(this).prop('disabled', true);
          return;
        }
      }

      if (limitReached && !groupManualSelectedRooms.includes(roomId)) {
        $(this).prop('disabled', true);
      } else {
        $(this).prop('disabled', false);
      }
    });
  }

  function attachManualSelectionHandlers() {
    $('#groupManualSelectToggle').on('change', function() {
      const enabled = $(this).is(':checked');
      setManualSelectionMode(enabled);
      if (!enabled) {
        $('#groupSelectedRooms').val('');
        $('#groupSelectedRoomPrices').val('');
        $('#groupRoomBreakdown').empty();
      }

      const bed1Needed = parseInt($('#groupBed1Count').val(), 10) || 0;
      const bed2Needed = parseInt($('#groupBed2Count').val(), 10) || 0;
      groupRequiredBed1 = bed1Needed;
      groupRequiredBed2 = bed2Needed;
      if (enabled) {
        refreshManualSelectionDisabledState();
        updateManualSelectionInfo();
      }
      computeGroupTotal();
    });

    $('#groupRoomsList').on('change', '.group-manual-checkbox', function() {
      const roomId = parseInt($(this).data('room-id'), 10);
      if ($(this).is(':checked')) {
        if (hasReachedManualSelectionLimit()) {
          $(this).prop('checked', false);
          Swal.fire('Limit Reached', 'You have already selected the required number of rooms.', 'info');
          return;
        }
        groupManualSelectedRooms.push(roomId);
      } else {
        groupManualSelectedRooms = groupManualSelectedRooms.filter(id => id !== roomId);
      }

      refreshManualSelectionDisabledState();
      updateManualSelectionInfo();
      updateManualSelectedRoomValues();
      computeGroupTotal();
    });

  }

  function updateManualSelectedRoomValues() {
    const selectedRooms = groupAvailableRooms.filter(room => groupManualSelectedRooms.includes(room.IDNo));
    const dates = getSelectedDateRange();
    const bookingType = $('#groupBookingRoute').val();

    const computedBasePrices = selectedRooms.map(room => {
      const basePrice = typeof room.RESOLVED_PRICE === 'number'
        ? room.RESOLVED_PRICE
        : (() => {
            const seasonalPrices = room.SEASONAL_PRICES || [];
            const bedCount = parseInt(room.ROOM_BED, 10);
            const seasonId = dates ? getSeasonIdForDate(dates.start, seasonalPrices) : null;
            const match = seasonalPrices.find(price => parseInt(price.bedCount, 10) === bedCount && price.bookingType === bookingType && parseInt(price.seasonId, 10) === parseInt(seasonId, 10));
            return match ? parseFloat(match.price) : 0;
          })();
      const roomId = room.IDNo;
      return basePrice;
    });

    const nights = parseInt($('#groupNights').val(), 10) || 0;

    $('#groupSelectedRooms').val(selectedRooms.map(room => room.IDNo).join(','));
    $('#groupSelectedRoomPrices').val(computedBasePrices.join(','));

    populateBreakdown(selectedRooms, computedBasePrices);
    updateGroupChargeBreakdown();
  }

  function attachBookingRouteHandler() {
    $('#groupBookingRoute').on('change', function() {
      if (this.value === 'agency') {
        $('#groupAgencyWrapper').show();
        loadGroupAgencies();
      } else {
        $('#groupAgencyWrapper').hide();
        $('#groupAgencySelect').val('');
      }
    });
  }

  function updateGroupChargeBreakdown() {
    const reservationFee = $('#groupIncludeReservationFee').prop('checked') ? (parseFloat($('#groupReservationFee').val()) || 0) : 0;
    const discount = $('#groupIncludeDiscount').prop('checked') ? (parseFloat($('#groupDiscount').val()) || 0) : 0;
    const container = $('#groupRoomBreakdown');
    if (!container.length) return;

    if (!reservationFee && !discount) {
      container.find('.group-fee-discount-summary').remove();
      return;
    }

    let summary = container.find('.group-fee-discount-summary');
    if (!summary.length) {
      summary = $('<div class="group-fee-discount-summary" style="margin-top: 12px;"></div>');
      container.append(summary);
    }

    const lines = [];
    if (reservationFee) {
      lines.push(`<li>Reservation Fee (Group): ${formatCurrency(reservationFee)}</li>`);
    }
    if (discount) {
      lines.push(`<li>Discount (Group): -${formatCurrency(discount)}</li>`);
    }
    summary.html(`<b>Group Adjustments:</b><ul>${lines.join('')}</ul>`);
  }



  function getGroupBookingState() {
    return {
      reservationFee: $('#groupIncludeReservationFee').prop('checked') ? (parseFloat($('#groupReservationFee').val()) || 0) : 0,
      discount: $('#groupIncludeDiscount').prop('checked') ? (parseFloat($('#groupDiscount').val()) || 0) : 0
    };
  }

  window.getGroupBookingState = getGroupBookingState;

  $(document).ready(function() {
    initializeGroupFlatpickr();
    fetchGroupFloors();
    loadGroupGuestTypes();
    loadGroupGuestLevels();
    loadGroupBreakfastPrices();
    loadGroupTransportPrices();
    attachToggles();
    attachRoomSelectionHandler();
    attachManualSelectionHandlers();
    attachBookingRouteHandler();
    handleSearchRooms();

    $('#groupBookingForm').on('input change', computeGroupTotal);

    $('#modal-add-group-booking').on('shown.bs.modal', function() {
      resetGroupForm();
      initializeGroupFlatpickr();
      // Ensure consolidated indicator is properly initialized
      $('#groupConsolidatedBilling').trigger('change');
    });

    // Toggle wrappers and recalc
    $('#groupIncludeReservationFee').on('change', function() {
      $('#groupReservationFeeWrapper').toggle(this.checked);
      if (!this.checked) { $('#groupReservationFee').val('0'); }
      updateGroupChargeBreakdown();
      computeGroupTotal();
    });
    $('#groupIncludeDiscount').on('change', function() {
      $('#groupDiscountWrapper').toggle(this.checked);
      if (!this.checked) { $('#groupDiscount').val('0'); }
      updateGroupChargeBreakdown();
      computeGroupTotal();
    });

    $('#groupReservationFee, #groupDiscount').on('input', function() {
      updateGroupChargeBreakdown();
      computeGroupTotal();
    });

    // Handle consolidated billing checkbox
    $('#groupConsolidatedBilling').on('change', function() {
      const isConsolidated = $(this).is(':checked');
      console.log('🔄 Frontend - Consolidated Billing Checkbox Changed:', isConsolidated ? 'CHECKED (Consolidated)' : 'UNCHECKED (Individual)');

      if (isConsolidated) {
        // Show consolidated billing indicator but keep room breakdown visible
        $('#groupRoomBreakdown').removeClass('d-none');
        // Add consolidated indicator to room breakdown
        const breakdownContainer = $('#groupRoomBreakdown .group-room-breakdown');
        if (breakdownContainer.length && !breakdownContainer.find('.consolidated-indicator').length) {
          breakdownContainer.prepend('<div class="consolidated-indicator text-info mb-2"><i class="fa fa-info-circle"></i> Bulk Billing: All charges will be applied to main booking on save</div>');
        }
      } else {
        // Remove consolidated indicator in normal mode
        $('.consolidated-indicator').remove();
      }

      computeGroupTotal();
      updateGroupChargeBreakdown();
    });

    // Clear selected rooms when Check-in/Check-out status changes
    $('#groupCheckInStatus, #groupCheckOutStatus, #groupBookingRoute').on('change', function() {
      // Uncheck any selected block radios or manual checkboxes
      $('#groupRoomsList input[name="groupBlock"]').prop('checked', false);
      $('#groupRoomsList .group-manual-checkbox').prop('checked', false);

      // Reset selected rooms state and hidden inputs
      groupManualSelectedRooms = [];
      $('#groupSelectedRooms').val('');
      $('#groupSelectedRoomPrices').val('');
      $('#groupSelectedRoomNumbers').val('');

      // Clear breakdown and recompute totals
      $('#groupRoomBreakdown').empty();
      updateManualSelectionInfo();
      computeGroupTotal();

      // Auto-search if rooms were previously searched
      if ($('#groupResultsContainer').is(':visible')) {
        $('#groupSearchRooms').click();
      }
    });
    // Generate voucher no. on open and when dates change
    function generateGroupVoucherNo() {
      const now = new Date();
      const yyyy = now.getFullYear();
      const mm = String(now.getMonth() + 1).padStart(2, '0');
      const dd = String(now.getDate()).padStart(2, '0');
      const hours = String(now.getHours()).padStart(2, '0');
      const minutes = String(now.getMinutes()).padStart(2, '0');
      // Group voucher: GV + yyyymmdd + HHMM
      return `GV${yyyy}${mm}${dd}${hours}${minutes}`;
    }

    $('#groupVoucherNo').val(generateGroupVoucherNo());

    $('#btnGroupVoucherPreview').on('click', function() {
      const vno = $('#groupVoucherNo').val() || generateGroupVoucherNo();
      $('#groupVoucherNo').val(vno);

      const daterange = $('#groupDaterange').val() || '';
      const dateFrom = daterange.includes(' to ') ? daterange.split(' to ')[0] : '';
      const dateTo = daterange.includes(' to ') ? daterange.split(' to ')[1].split('(')[0].trim() : '';
      // Prefer precomputed room numbers from hidden input
      const selectedRoomNumbers = ($('#groupSelectedRoomNumbers').val()||'').split(',').filter(Boolean);
      const roomNumbersForVoucher = selectedRoomNumbers.length
        ? selectedRoomNumbers.join(', ')
        : ($('#groupSelectedRooms').val()||'').split(',').filter(Boolean).join(', ');

      const totalText = $('#groupComputedTotal').text() || '0';
      // Extract numeric value, handling consolidated format
      const numericTotal = totalText.replace(/[^0-9.]/g, '').split(' ')[0] || '0';

      const isConsolidated = $('#groupConsolidatedBilling').is(':checked');
      const bookingData = {
        voucherNo: vno,
        fullname: $('#groupName').val() || 'Group Booking',
        contactNumber: $('#groupContact').val() || '',
        dateFrom: dateFrom,
        dateTo: dateTo,
        bedCount: '',
        roomNumber: isConsolidated ? 'Bulk - ' + roomNumbersForVoucher : roomNumbersForVoucher,
        roomView: '',
        roomType: isConsolidated ? 'Group (Bulk)' : 'Group',
        roomRate: '',
        breakfastAdult: $('#groupBreakfastAdultQty').val() || 0,
        breakfastAdultPrice: $('#groupBreakfastAdultPrice').val() || 0,
        breakfastKid: $('#groupBreakfastKidQty').val() || 0,
        breakfastKidPrice: $('#groupBreakfastKidPrice').val() || 0,
        pickup: $('#groupIncludePickup').is(':checked') ? ($('#groupPickupPrice').val() || 0) : 0,
        dropoff: $('#groupIncludeDropoff').is(':checked') ? ($('#groupDropoffPrice').val() || 0) : 0,
        remarks: $('#groupRemarks').val() || '',
        total: numericTotal,
        checkInStatus: $('#groupCheckInStatus').val(),
        checkOutStatus: $('#groupCheckOutStatus').val(),
        lateCheckoutFee: 0,
        reservationFee: $('#groupIncludeReservationFee').is(':checked') ? ($('#groupReservationFee').val() || 0) : 0,
        discount: $('#groupIncludeDiscount').is(':checked') ? ($('#groupDiscount').val() || 0) : 0,
        directReservationFlag: false
      };

      const form = $('<form>', {
        method: 'POST',
        action: '/booking/generate-voucher',
        target: '_blank'
      });
      for (let key in bookingData) {
        form.append($('<input>', { type: 'hidden', name: key, value: bookingData[key] }));
      }
      $('body').append(form);
      form.submit();
      form.remove();
    });
  });
})();
</script>
<script src="/js/booking/group_booking_submit.js"></script>

