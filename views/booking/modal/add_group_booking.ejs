<link rel="stylesheet" href="/plugins/flatpicker/flatpickr.min.css">

<div class="modal fade" id="modal-add-group-booking" tabindex="-1" role="dialog" aria-labelledby="modalAddGroupBookingLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title" id="modalAddGroupBookingLabel">Add Group Booking</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="groupBookingForm" autocomplete="off">
          <input type="hidden" id="groupVoucherNo" name="groupVoucherNo">
          <input type="hidden" id="groupBookingId" name="groupBookingId">
          <input type="hidden" id="groupSelectedRooms" name="groupSelectedRooms">
          <input type="hidden" id="groupSelectedRoomPrices" name="groupSelectedRoomPrices">
          <input type="hidden" id="groupSelectedRoomNumbers" name="groupSelectedRoomNumbers">
          <input type="hidden" id="groupNights" name="groupNights" value="0">
          <input type="hidden" id="groupPaidAmountHidden" name="groupPaidAmountHidden" value="0">

          <div class="row">
            <div class="col-lg-6">
              <div class="form-group">
                <label class="form-label">Select Date From To</label>
                <input type="text" class="form-control flatpickr-input" id="groupDaterange" name="groupDaterange" required>
              </div>
            </div>
            <div class="col-lg-3">
              <div class="form-group">
                <label class="form-label">Number of Rooms Needed</label>
                <input type="number" class="form-control" id="groupNumberOfRooms" name="groupNumberOfRooms" min="1" required>
              </div>
            </div>
            <div class="col-lg-3">
              <div class="form-group">
                <label class="form-label">Select Floor (Optional)</label>
                <select class="form-select" id="groupFloorSelect" name="groupFloorSelect">
                  <option value="" selected>Select Floor</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-4">
              <div class="form-group">
                <label class="form-label">Check-In Status</label>
                <select class="form-select" id="groupCheckInStatus" name="groupCheckInStatus" required>
                  <option value="" disabled selected>Check-In Status</option>
                  <option value="1" selected>Regular Check In</option>
                  <option value="0" >Late Check In</option>
                </select>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="form-group">
                <label class="form-label">Check-Out Status</label>
                <select class="form-select" id="groupCheckOutStatus" name="groupCheckOutStatus" required>
                  <option value="" disabled selected>Check-Out Status</option>
                  <option value="0" selected>Regular Check Out</option>
                  <option value="1" >Late Check Out</option>
                </select>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="form-group">
                <label class="form-label">Booking Resources</label>
                <select class="form-select" id="groupBookingRoute" name="groupBookingRoute" required>
                  <option value="" disabled>Select Booking Resource</option>
                  <option value="walk-in" selected>Walk-in</option>
                  <option value="agency">Agency</option>
                  <option value="booking-channel">Booking Channel</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row p-t-20">         
            <div class="col-lg-12" id="groupAgencyWrapper" style="display: none;">
              <div class="form-group">
                <label class="form-label">Select Agency</label>
                <select class="form-select" id="groupAgencySelect" name="groupAgencySelect">
                  <option value="" disabled selected>Select Agency</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-12 d-flex align-items-center gap-3 flex-wrap">
              <div class="form-group mb-0">
                <label class="form-label mb-1">Bed Requirements</label>
                <div class="d-flex gap-3 flex-wrap">
                  <div class="bed-requirement-group">
                    <label class="form-label mb-1">1 Bed</label>
                    <input type="number" class="form-control" id="groupBed1Count" name="groupBed1Count" min="0" value="0">
                  </div>
                  <div class="bed-requirement-group">
                    <label class="form-label mb-1">2 Beds</label>
                    <input type="number" class="form-control" id="groupBed2Count" name="groupBed2Count" min="0" value="0">
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-12 d-flex justify-content-start">
              <button type="button" class="btn btn-success" id="groupSearchRooms">Search Rooms</button>
            </div>
          </div>

          <div class="row p-t-20" id="groupResultsContainer" style="display: none;">
            <div class="col-lg-12">
              <!-- Bed Availability Summary Container -->
              <div id="groupBedAvailabilitySummary" class="mb-3"></div>
              
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Available Rooms</h5>
                <!-- REMOVED: Manual selection toggle - now default method -->
              </div>
              <div id="groupRoomsList" class="room-list-container"></div>
              <div id="groupManualRoomsContainer" class="room-list-container" style="display: none;"></div>
              <div class="mt-2 text-warning" id="groupAvailabilityWarning" style="display: none;"></div>
              <div class="mt-2 text-muted" id="groupManualSelectionInfo" style="display: none;"></div>
              <div id="groupRoomBreakdown" class="mt-3"></div>
              
              <!-- Manual Room Rate Section -->
              <div id="groupManualRateSection" class="mt-3" style="display: none;">
                <div class="manual-rate-container">
                  <h6 class="text-info mb-3">
                    <i class="fa fa-edit"></i> Manual Room Rates
                    <small class="text-muted">(Override default rates)</small>
                  </h6>
                  
                  <!-- Rate Type Toggle -->
                  <div class="rate-type-toggle mb-3">
                    <div class="btn-group" role="group">
                      <input type="radio" class="btn-check" name="rateType" id="individualRates" value="individual" checked>
                      <label class="btn btn-outline-success" for="individualRates">Individual Rooms</label>
                      
                      <input type="radio" class="btn-check" name="rateType" id="bedBasedRates" value="bed-based">
                      <label class="btn btn-outline-success" for="bedBasedRates">Bed-Based Pricing</label>
                    </div>
                  </div>
                  
                  <!-- Individual Room Rates -->
                  <div id="individualRateSection">
                    <div id="groupManualRateList" class="manual-rate-list"></div>
                  </div>
                  
                  <!-- Bed-Based Rates -->
                  <div id="bedBasedRateSection" style="display: none;">
                    <div id="groupBedBasedRateList" class="bed-based-rate-list"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-6">
              <div class="form-group">
                <label class="form-label">Group Name</label>
                <input type="text" class="form-control" id="groupName" name="groupName" required>
              </div>
            </div>
            <div class="col-lg-6">
              <div class="form-group">
                <label class="form-label">Group Contact Number</label>
                <input type="text" class="form-control" id="groupContact" name="groupContact" required>
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-3">
              <div class="form-group">
                <label class="form-label">Paid Amount</label>
                <input class="form-control" type="number" id="groupPaidAmount" name="groupPaidAmount" placeholder="Enter paid amount" step="0.01" min="0" max="999999" value="0">
              </div>
            </div>
            
            <div class="col-lg-3">
              <div class="form-group">
                <label class="form-label">Payment Status</label>
                <input class="form-control" type="text" id="groupPaymentStatus" name="groupPaymentStatus" readonly style="background-color: #2a3135; color: #ffffff;">
              </div>
            </div>
            
            <div class="col-lg-3">
              <div class="form-group">
                <label class="form-label">Guest Type</label>
                <select class="form-select" id="groupGuestType" name="groupGuestType" required>
                  <option value="" disabled selected>Guest Type</option>
                </select>
              </div>
            </div>
            <div class="col-lg-3">
              <div class="form-group">
                <label class="form-label">Guest Level</label>
                <select class="form-select" id="groupGuestLevel" name="groupGuestLevel" required>
                  <option value="" disabled selected>Guest Level</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-12">
              <div class="form-group">
                <label class="form-label">Remarks</label>
                <textarea class="form-control" id="groupRemarks" name="groupRemarks" rows="3" placeholder="Enter any additional remarks or notes for this group booking..."></textarea>
              </div>
            </div>
          </div>

          <div class="row p-t-20 align-items-start">
            <div class="col-lg-4">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="groupIncludeBreakfast" name="groupIncludeBreakfast">
                <label class="form-check-label" for="groupIncludeBreakfast">Add Breakfast</label>
              </div>
              <div id="groupBreakfastFields" class="group-breakfast-fields d-none">
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" id="groupBreakfastIndividual">
                  <label class="form-check-label" for="groupBreakfastIndividual">Individual (per room)</label>
                </div>
                <div class="group-quantity-wrapper">
                  <input type="number" class="form-control" id="groupBreakfastAdultQty" name="groupBreakfastAdultQty" placeholder="Adult Qty" style="max-width: 90px;">
                  <input type="number" class="form-control" id="groupBreakfastAdultPrice" name="groupBreakfastAdultPrice" placeholder="Adult Price" min="0" step="0.01">
                  <input type="hidden" id="groupBreakfastAdultId" name="groupBreakfastAdultId">
                </div>
                <div class="group-quantity-wrapper">
                  <input type="number" class="form-control" id="groupBreakfastKidQty" name="groupBreakfastKidQty" placeholder="Kid Qty" style="max-width: 90px;">
                  <input type="number" class="form-control" id="groupBreakfastKidPrice" name="groupBreakfastKidPrice" placeholder="Kid Price" min="0" step="0.01">
                  <input type="hidden" id="groupBreakfastKidId" name="groupBreakfastKidId">
                </div>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="groupIncludePickup" name="groupIncludePickup">
                <label class="form-check-label" for="groupIncludePickup">Add Pick-up</label>
              </div>
              <div id="groupPickupWrapper" class="mt-2" style="display: none;">
                <input type="number" class="form-control" id="groupPickupPrice" name="groupPickupPrice" placeholder="Pick-up Price" min="0" step="0.01">
                <input type="hidden" id="groupPickupServiceId" name="groupPickupServiceId">
              </div>
            </div>
            <div class="col-lg-4">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="groupIncludeDropoff" name="groupIncludeDropoff">
                <label class="form-check-label" for="groupIncludeDropoff">Add Drop-off</label>
              </div>
              <div id="groupDropoffWrapper" class="mt-2" style="display: none;">
                <input type="number" class="form-control" id="groupDropoffPrice" name="groupDropoffPrice" placeholder="Drop-off Price" min="0" step="0.01">
                <input type="hidden" id="groupDropoffServiceId" name="groupDropoffServiceId">
              </div>
            </div>
          </div>

          <div class="row p-t-20">
            <div class="col-lg-4">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="groupIncludeDiscount">
                <label class="form-check-label" for="groupIncludeDiscount">Discount</label>
              </div>
              <div id="groupDiscountWrapper" class="mt-2" style="display: none;">
                <input type="number" class="form-control" id="groupDiscount" name="groupDiscount" min="0" value="0">
              </div>
            </div>
            <div class="col-lg-4">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="groupIndividualBilling">
                <label class="form-check-label" for="groupIndividualBilling">Individual Billing</label>
              </div>
              <div class="form-text">
                <small class="text-muted">If unchecked, all charges go to main booking (Master Billing)</small>
              </div>
            </div>
          </div>

         

          <hr class="my-4">
          <div class="row p-t-20">
            <div class="col-lg-4">
              <h3>Total: <span id="groupComputedTotal">0.00</span></h3>
            </div>
            <div class="col-lg-4">
              <h3>Paid: <span id="groupComputedPaidAmount">0.00</span></h3>
            </div>
            <div class="col-lg-4">
              <h3>Balance: <span id="groupComputedBalance">0.00</span></h3>
            </div>
          </div>
          
          <div class="row p-t-20">
            <div class="col-lg-12">
              <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-success" id="btnGroupVoucherPreview">Voucher</button>
                <button type="submit" class="btn btn-primary">Save Booking</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
