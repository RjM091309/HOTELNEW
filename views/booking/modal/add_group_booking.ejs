  function updateRoomFilterAndCount() {
    const filter = $('input[name="groupRoomFilter"]:checked').val();
    const roomsContainer = $('.manual-rooms-container');
    let visibleCount = 0;
    
    if (!roomsContainer.length) return;
    
    roomsContainer.find('.room-option').each(function() {
      const $room = $(this);
      const $checkbox = $room.find('input[data-room-id]');
      const roomData = $checkbox.data('room-id');
      const room = groupAvailableRooms.find(r => r.IDNo === roomData);
      
      if (!room) {
        $room.hide();
        return;
      }
      
      const bedType = parseInt(room.ROOM_BED, 10);
      const shouldShow = filter === 'all' || 
        (filter === '1B' && bedType === 1) || 
        (filter === '2B' && bedType === 2);
        
      if (shouldShow) {
        $room.show();
        visibleCount++; // Count ALL rooms regardless of disabled state
      } else {
        $room.hide();
      }
    });
    
    // Update count badge
    const filterText = filter === 'all' ? 'rooms' : filter + ' rooms';
    $('#groupRoomCount').text(`Available: ${visibleCount}`);
  }

  function computeGroupTotal() {
    const nights = parseInt($('#groupNights').val(), 10) || 0;
    const pricesRaw = $('#groupSelectedRoomPrices').val();
    const prices = pricesRaw ? pricesRaw.split(',').map(p => parseFloat(p) || 0) : [];
    const baseSubtotal = prices.reduce((sum, price) => sum + price, 0);
    const roomSubtotal = baseSubtotal * nights;

    const reservationFee = $('#groupIncludeReservationFee').prop('checked') ? (parseFloat($('#groupReservationFee').val()) || 0) : 0;
    const discount = $('#groupIncludeDiscount').prop('checked') ? (parseFloat($('#groupDiscount').val()) || 0) : 0;

    const adultQty = $('#groupIncludeBreakfast').is(':checked') ? (parseInt($('#groupBreakfastAdultQty').val(), 10) || 0) : 0;
    const adultPrice = parseFloat($('#groupBreakfastAdultPrice').val()) || 0;
    const kidQty = $('#groupIncludeBreakfast').is(':checked') ? (parseInt($('#groupBreakfastKidQty').val(), 10) || 0) : 0;
    const kidPrice = parseFloat($('#groupBreakfastKidPrice').val()) || 0;

    const pickupPrice = $('#groupIncludePickup').is(':checked') ? parseFloat($('#groupPickupPrice').val()) || 0 : 0;
    const dropoffPrice = $('#groupIncludeDropoff').is(':checked') ? parseFloat($('#groupDropoffPrice').val()) || 0 : 0;

    const servicesTotal = (adultQty * adultPrice) + (kidQty * kidPrice) + pickupPrice + dropoffPrice;

    // Check if consolidated billing is enabled
    const isConsolidated = $('#groupConsolidatedBilling').is(':checked');

    // Always calculate the full total in frontend for user visibility
    const subtotal = roomSubtotal + servicesTotal;
    let finalBalance = subtotal - reservationFee - discount;

    if (isConsolidated) {
      // Show consolidated total with indicator
      if (finalBalance < 0) {
        $('#groupComputedTotal').html(`<span class="text-warning">${formatCurrency(0)} <small>(Master)</small></span>`);
        $('#groupCreditAmount').text(formatCurrency(Math.abs(finalBalance)));
        $('#groupCreditDisplay').show();
      } else {
        $('#groupComputedTotal').html(`<span>${formatCurrency(finalBalance)} <small class="text-info">(Master)</small></span>`);
        $('#groupCreditDisplay').hide();
      }
    } else {
      // Regular billing calculation
      if (finalBalance < 0) {
        $('#groupComputedTotal').text(formatCurrency(0));
        $('#groupCreditAmount').text(formatCurrency(Math.abs(finalBalance)));
        $('#groupCreditDisplay').show();
      } else {
        $('#groupComputedTotal').text(formatCurrency(finalBalance));
        $('#groupCreditDisplay').hide();
      }
    }
  }

  function populateBreakdown(block, computedPrices) {
    const container = $('#groupRoomBreakdown');
    container.empty();
    if (!block || !block.length) {
      return;
    }

    const nights = parseInt($('#groupNights').val(), 10) || 0;
    let html = '<div class="group-room-breakdown"><b>Selected Room Prices:</b><ul>';
    block.forEach((room, idx) => {
      const price = computedPrices[idx] || 0;
      const total = nights > 0 ? price * nights : price;
      html += `<li>Room ${room.ROOM_NUMBER}: ${formatCurrency(price)} per night ${nights > 0 ? `(${formatCurrency(total)} total)` : ''}</li>`;
    });
    html += '</ul></div>';
    container.html(html);
  }

  function attachRoomSelectionHandler() {
    $('#groupRoomsList').on('change', 'input[name="groupBlock"]', function() {
      const groupNameAttr = $(this).data('block-group');
      const blockIndex = parseInt($(this).data('block-index'), 10);

      let sourceBlocks = [];
      if (groupNameAttr === 'consecutive') {
        sourceBlocks = groupBlocks;
      } else if (groupNameAttr === 'non-consecutive') {
        sourceBlocks = groupNonConsecutiveBlocks;
      } else if (groupNameAttr === 'available') {
        sourceBlocks = buildSingleRoomBlocks(groupAvailableRooms);
      }

      const block = sourceBlocks[blockIndex];
      if (!block) return;


      const dates = getSelectedDateRange();
      if (!dates) {
        Swal.fire('Missing Dates', 'Please select a date range first.', 'warning');
        $(this).prop('checked', false);
        return;
      }

      const bookingType = $('#groupBookingRoute').val();
      const computedPrices = [];
      block.forEach(room => {
        const price = typeof room.RESOLVED_PRICE === 'number'
          ? room.RESOLVED_PRICE
          : (() => {
              const seasonalPrices = room.SEASONAL_PRICES || [];
              const bedCount = parseInt(room.ROOM_BED, 10);
              const seasonId = getSeasonIdForDate(dates.start, seasonalPrices);
              const match = seasonalPrices.find(price => parseInt(price.bedCount, 10) === bedCount && price.bookingType === bookingType && parseInt(price.seasonId, 10) === parseInt(seasonId, 10));
              return match ? parseFloat(match.price) : 0;
            })();
        const roomId = room.IDNo;
        computedPrices.push(price);
      });

      const selectedIds = block.map(room => room.IDNo);
      const selectedNumbers = block.map(room => room.ROOM_NUMBER);
      $('#groupSelectedRooms').val(selectedIds.join(','));
      $('#groupSelectedRoomPrices').val(computedPrices.join(','));
      $('#groupSelectedRoomNumbers').val(selectedNumbers.join(','));
      populateBreakdown(block, computedPrices);
      updateGroupChargeBreakdown();
      computeGroupTotal();
    });
  }

  function handleSearchRooms() {
    $('#groupSearchRooms').on('click', function() {
      const dates = getSelectedDateRange();
      const neededRooms = $('#groupNumberOfRooms').val();
      const neededRoomsNum = parseInt(neededRooms, 10);
      const bed1Needed = parseInt($('#groupBed1Count').val(), 10) || 0;
      const bed2Needed = parseInt($('#groupBed2Count').val(), 10) || 0;
      const totalBedNeeded = bed1Needed + bed2Needed;
      const bookingRoute = $('#groupBookingRoute').val();

      if (!dates) {
        Swal.fire('Missing Date Range', 'Please select a valid date range.', 'warning');
        return;
      }
      if (!neededRooms) {
        Swal.fire('Missing Room Count', 'Please enter the number of rooms needed.', 'warning');
        return;
      }
      if (!bookingRoute) {
        Swal.fire('Missing Booking Resource', 'Please select a booking resource before searching for rooms.', 'warning');
        return;
      }

      const checkInStatus = $('#groupCheckInStatus').val();
      const checkOutStatus = $('#groupCheckOutStatus').val();

      if (!checkInStatus || checkInStatus === '') {
        Swal.fire('Missing Check-In Status', 'Please select a Check-In Status before searching for rooms.', 'warning');
        return;
      }

      if (!checkOutStatus || checkOutStatus === '') {
        Swal.fire('Missing Check-Out Status', 'Please select a Check-Out Status before searching for rooms.', 'warning');
        return;
      }

      if ((bed1Needed > 0 || bed2Needed > 0) && totalBedNeeded !== neededRoomsNum) {
        Swal.fire('Bed Count Mismatch', 'The sum of bed requirements must equal the total number of rooms needed.', 'warning');
        return;
      }

      if (neededRoomsNum > 0 && totalBedNeeded === 0) {
        Swal.fire('Bed Requirement Missing', 'Please specify how many rooms should have 1 bed or 2 beds before searching.', 'warning');
        return;
      }

      groupRequiredBed1 = bed1Needed;
      groupRequiredBed2 = bed2Needed;

      $.ajax({
        url: '/booking/find_consecutive_rooms',
        type: 'POST',
        data: {
          startDate: dates.start,
          endDate: dates.end,
          neededRooms: neededRooms,
          floorNumber: $('#groupFloorSelect').val() || '',
          bed1Needed: bed1Needed,
          bed2Needed: bed2Needed,
          bookingRoute: bookingRoute,
          checkInStatus: $('#groupCheckInStatus').val(),
          checkOutStatus: $('#groupCheckOutStatus').val()
        },
        success: function(response) {
          if (!response.success) {
            Swal.fire('No Rooms Found', response.message || 'No available rooms for the selected criteria.', 'info');
            displayGroupRoomResults({ consecutiveBlocks: [], nonConsecutiveBlocks: [], availableRooms: [] });
            if (response.data && response.data.availableBedSummary) {
              showBedSummaryWarning(response.data.availableBedSummary, neededRoomsNum, bed1Needed, bed2Needed, response.data.unassignedConflicts, response.data.availableRooms || []);
            } else if (response.data && response.data.unassignedConflicts) {
              showUnassignedConflictWarning(response.data.unassignedConflicts, response.data.availableRooms || []);
            }
            return;
          }

          const data = response.data || {};
          const availableRooms = data.availableRooms || [];
          const availableCount = availableRooms.length;

          if (neededRoomsNum > availableCount) {
            displayGroupRoomResults({ consecutiveBlocks: [], nonConsecutiveBlocks: [], availableRooms: [] });
            setManualSelectionMode(false);
            if (data.unassignedConflicts && data.unassignedConflicts.length) {
              showUnassignedConflictWarning(data.unassignedConflicts, availableRooms);
            } else {
              showBedSummaryWarning({
                bed1: availableRooms.filter(r => parseInt(r.ROOM_BED, 10) === 1).length,
                bed2: availableRooms.filter(r => parseInt(r.ROOM_BED, 10) === 2).length
              }, neededRoomsNum, bed1Needed, bed2Needed, [], availableRooms);
            }
            return;
          }

          groupNonConsecutiveBlocks = data.nonConsecutiveBlocks || [];
          toggleAvailabilityWarning(false);
          displayGroupRoomResults({
            consecutiveBlocks: data.consecutiveBlocks || [],
            nonConsecutiveBlocks: groupNonConsecutiveBlocks,
            availableRooms,
            unassignedConflicts: data.unassignedConflicts || []
          });

          if (groupManualMode) {
            refreshManualSelectionDisabledState();
          }
        },
        error: function(err) {
          console.error('Error finding rooms:', err);
          Swal.fire('Error', 'There was a problem searching for rooms. Please try again.', 'error');
        }
      });
    });
  }

