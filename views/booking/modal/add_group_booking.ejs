.group-quantity-wrapper {
  display: flex;
  gap: 8px;
}

.group-quantity-wrapper .form-control {
  flex: 1;
  min-width: 0;
}

.group-quantity-wrapper input[type="number"] {
  text-align: right;
}

.group-quantity-wrapper input[type="number"]:focus {
  border-color: #6f9c40;
