<script src="/plugins/flatpicker/flatpickr.min.js"></script>
<script>
(function() {
  let groupFlatpickrInstance = null;
  let groupBlocks = [];
  let groupNonConsecutiveBlocks = [];
  let groupAvailableRooms = [];
  let groupManualMode = false;
  let groupManualSelectedRooms = [];
  let groupPickupBasePrice = '';
  let groupPickupBaseId = '';
  let groupDropoffBasePrice = '';
  let groupDropoffBaseId = '';
  let groupBreakfastAdultBasePrice = '';
  let groupBreakfastAdultBaseId = '';
  let groupBreakfastKidBasePrice = '';
  let groupBreakfastKidBaseId = '';
  let groupRequiredBed1 = 0;
  let groupRequiredBed2 = 0;
  let groupUnassignedConflicts = [];
  let groupManualRates = {}; // Store manual rates for each room
  let groupBedBasedRates = {}; // Store bed-based rates {1: price, 2: price}

  function applyGroupBreakfastDefaults() {
    // Only set service IDs, not prices
    if (groupBreakfastAdultBaseId !== '') {
      $('#groupBreakfastAdultId').val(groupBreakfastAdultBaseId);
    }
    if (groupBreakfastKidBaseId !== '') {
      $('#groupBreakfastKidId').val(groupBreakfastKidBaseId);
    }
  }

  function resetGroupForm() {
    $('#groupBookingForm')[0].reset();
    $('#groupSelectedRooms').val('');
    $('#groupSelectedRoomPrices').val('');
    $('#groupNights').val('0');
    groupBlocks = [];
    groupNonConsecutiveBlocks = [];
    groupAvailableRooms = [];
    groupManualMode = false;
    groupManualSelectedRooms = [];
    groupRequiredBed1 = 0;
    groupRequiredBed2 = 0;
    groupUnassignedConflicts = [];
    groupManualRates = {}; // Clear manual rates
    groupBedBasedRates = {}; // Clear bed-based rates
    setManualSelectionMode(false);
    $('#groupManualSelectToggle').prop('disabled', false);
    $('#groupAgencyWrapper').hide();
    $('#groupRoomsList').empty();
    $('#groupManualRoomsContainer').hide();
    $('#groupManualSelectionInfo').hide();
    $('#groupRoomBreakdown').empty();
    $('#groupResultsContainer').hide();
    $('#groupManualRateSection').hide(); // Hide manual rate section
    $('#groupEnableManualRates').prop('checked', false); // Reset manual rates checkbox
    $('#groupComputedTotal').html('0.00');
    $('#groupComputedPaidAmount').html('0.00');
    $('#groupComputedBalance').html('0.00');
    $('#groupCreditDisplay').hide();
    $('#groupCreditAmount').text('₱0.00');
    $('#groupBreakfastFields').addClass('d-none');
    $('#groupIncludeBreakfast, #groupIncludePickup, #groupIncludeDropoff, #groupIndividualBilling').prop('checked', false); // Default to Master Billing (unchecked)
    $('#groupBreakfastIndividual').prop('checked', false); // Default breakfast to group (not individual)
    $('#groupBreakfastAdultQty, #groupBreakfastKidQty').val('');
    $('#groupPickupWrapper, #groupDropoffWrapper').hide();
    $('#groupPickupPrice, #groupDropoffPrice').val('');
    $('#groupPickupServiceId, #groupDropoffServiceId').val('');
    $('#groupRoomBreakdown').removeClass('d-none');
    $('.consolidated-indicator').remove();
    
    applyGroupBreakfastDefaults();
  }

  function initializeGroupFlatpickr() {
    if (groupFlatpickrInstance) {
      groupFlatpickrInstance.destroy();
    }

    groupFlatpickrInstance = flatpickr('#groupDaterange', {
      mode: 'range',
      dateFormat: 'M d, Y',
      showMonths: 2,
      minDate: 'today',
      onClose: function(selectedDates, dateStr, instance) {
        if (selectedDates.length === 2) {
          const startDate = selectedDates[0];
          const endDate = selectedDates[1];
          const diffMs = endDate.getTime() - startDate.getTime();
          const nights = Math.max(1, Math.round(diffMs / (1000 * 3600 * 24)));
          $('#groupNights').val(nights);
          instance.input.value = `${dateStr} (${nights} night/s)`;
          computeGroupTotal();
        }
      }
    });
  }

  function formatCurrency(value) {
    return `₱${Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  function formatPaidAmount(input) {
    const value = parseFloat(input.value) || 0;
    input.value = value.toFixed(2);
    // Sync with hidden field
    $('#groupPaidAmountHidden').val(value.toFixed(2));
  }

  function getSelectedDateRange() {
    const raw = $('#groupDaterange').val();
    if (!raw) return null;
    const parts = raw.split(' to ');
    if (parts.length < 2) return null;
    const start = parts[0].trim();
    const end = parts[1].split('(')[0].trim();
    return { start, end };
  }

  function getSeasonIdForDate(checkInDate, seasonalPrices) {
    if (!seasonalPrices || !seasonalPrices.length) return null;
    const checkIn = new Date(checkInDate);
    const mmdd = `${(checkIn.getMonth() + 1).toString().padStart(2, '0')}${checkIn.getDate().toString().padStart(2, '0')}`;

    for (const price of seasonalPrices) {
      const start = new Date(price.startDate);
      const end = new Date(price.endDate);
      const startKey = `${(start.getMonth() + 1).toString().padStart(2, '0')}${start.getDate().toString().padStart(2, '0')}`;
      const endKey = `${(end.getMonth() + 1).toString().padStart(2, '0')}${end.getDate().toString().padStart(2, '0')}`;

      const isWithinSameYear = startKey <= endKey && mmdd >= startKey && mmdd <= endKey;
      const crossesYear = startKey > endKey && (mmdd >= startKey || mmdd <= endKey);

      if (isWithinSameYear || crossesYear) {
        return price.seasonId;
      }
    }
    return null;
  }

  function displayGroupRooms(blocks, title, groupNameAttr) {
    const list = $('#groupRoomsList');
    const section = $(`div[data-group-name="${groupNameAttr}"]`);

    if (!section.length) {
      const sectionHtml = `
        <div class="group-rooms-section" data-group-name="${groupNameAttr}">
          <h6 class="text-info mb-2">${title}</h6>
          <div class="group-rooms-options"></div>
        </div>`;
      list.append(sectionHtml);
    }

    const targetContainer = list.find(`div[data-group-name="${groupNameAttr}"] .group-rooms-options`);
    targetContainer.empty();

    if (!blocks || !blocks.length) {
      targetContainer.append('<p class="text-warning mb-0">No rooms found.</p>');
      return;
    }

    blocks.forEach((block, index) => {
      const blockKey = `${groupNameAttr}-${index}`;
      const roomNumbers = block.map(room => `${room.ROOM_NUMBER}`).join(', ');
      const roomIds = block.map(room => room.IDNo).join(',');
      const option = `
        <div class="form-check room-option">
          <div class="room-option-header">
            <input class="form-check-input" type="radio" name="groupBlock" id="groupBlock${blockKey}" data-block-group="${groupNameAttr}" data-block-index="${index}" value="${roomIds}">
            <label class="form-check-label" for="groupBlock${blockKey}">
              ${roomNumbers}
            </label>
          </div>
        </div>`;
      targetContainer.append(option);
    });
  }

  function displayGroupRoomResults({ consecutiveBlocks, nonConsecutiveBlocks, availableRooms, unassignedConflicts }, priority, hasEnoughRooms = true) {
    // REMOVED: Auto-suggested blocks logic - manual selection only
    const list = $('#groupRoomsList');
    const summaryContainer = $('#groupBedAvailabilitySummary');
    list.empty();
    summaryContainer.empty();
    $('#groupManualRoomsContainer').empty();
    $('#groupManualSelectionInfo').hide();
    $('#groupRoomBreakdown').empty();
    $('#groupAvailabilityWarning').hide();
    
    groupUnassignedConflicts = (unassignedConflicts && unassignedConflicts.length) ? unassignedConflicts : [];
    groupAvailableRooms = availableRooms || [];

    // Show unassigned conflicts warning if any
    if (groupUnassignedConflicts.length) {
      const conflictText = groupUnassignedConflicts.map(conf => 
        `${conf.reserved} ${conf.bed} bed rooms reserved for unassigned bookings`
      ).join(', ');
      $('#groupRoomsList').prepend(`
        <div class="alert alert-warning mb-3">
          <strong>Unassigned Rooms Notice:</strong> Some rooms may be reserved for unassigned bookings: ${conflictText}
        </div>
      `);
    }

    if (!groupAvailableRooms || !groupAvailableRooms.length) {
      list.append('<p class="text-danger">No rooms available for the selected dates.</p>');
      $('#groupResultsContainer').show();
      $('#groupSelectedRooms').val('');
      $('#groupSelectedRoomPrices').val('');
      computeGroupTotal();
      return;
    }

    // Only show bed availability summary when there are not enough rooms
    if (!hasEnoughRooms) {
      // Calculate and display bed availability counts prominently
      const bed1Count = groupAvailableRooms.filter(r => parseInt(r.ROOM_BED, 10) === 1).length;
      const bed2Count = groupAvailableRooms.filter(r => parseInt(r.ROOM_BED, 10) === 2).length;
      const totalAvailable = groupAvailableRooms.length;
      
      // Show bed availability summary at the top
      let bedAvailabilityHtml = `
        <div class="bed-availability-summary mb-1 p-1" style="background-color: rgba(255, 255, 255, 0.05); border-radius: 3px; border: 1px solid rgba(255, 255, 255, 0.1);">
          <h6 class="text-info mb-0" style="font-size: 12px; line-height: 1.2;">
            <i class="fa fa-info-circle"></i> Available Rooms Summary
          </h6>
          <div class="row mt-1">
            <div class="col-md-4">
              <div class="text-center">
                <div class="h6 mb-0 text-success" style="font-size: 16px; line-height: 1;">${bed1Count}</div>
                <div class="text-muted" style="font-size: 10px; line-height: 1;">1-Bed Rooms</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="text-center">
                <div class="h6 mb-0 text-success" style="font-size: 16px; line-height: 1;">${bed2Count}</div>
                <div class="text-muted" style="font-size: 10px; line-height: 1;">2-Bed Rooms</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="text-center">
                <div class="h6 mb-0 text-primary" style="font-size: 16px; line-height: 1;">${totalAvailable}</div>
                <div class="text-muted" style="font-size: 10px; line-height: 1;">Total Available</div>
              </div>
            </div>
          </div>
        </div>
      `;
      
      summaryContainer.append(bedAvailabilityHtml);
    }

    // Only show room listings if there are enough rooms
    if (hasEnoughRooms) {
      // Show filter and room count
      $('#groupRoomsList').append(`
        <div class="room-filter-section mb-3">
          <div class="d-flex align-items-center w-100" style="display:flex; justify-content: space-between; width:100%;">
            <div class="d-flex align-items-center">
              <label class="text-white mb-0 me-3">Filter:</label>
              <div class="filter-radio-group">
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="groupRoomFilter" id="filterAll" value="all" checked>
                  <label class="form-check-label" for="filterAll">All</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="groupRoomFilter" id="filter1B" value="1B">
                  <label class="form-check-label" for="filter1B">1B</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="groupRoomFilter" id="filter2B" value="2B">
                  <label class="form-check-label" for="filter2B">2B</label>
                </div>
              </div>
            </div>
            <div class="text-white">
              <span id="groupRoomCount" style="margin-left: 24px;">&nbsp;&nbsp;&nbsp;&nbsp;Available: 0</span>
            </div>
          </div>
        </div>
      `);
      
      // Render rooms directly in the main list container, not in the hidden manual container
      if (!groupAvailableRooms || !groupAvailableRooms.length) {
        $('#groupRoomsList').append('<p class="text-warning">No rooms available for manual selection.</p>');
      } else {
        const roomsHtml = groupAvailableRooms.map(room => {
          const disabled = false; // REMOVED: Disable logic - allow all rooms to be selectable
          const bedCount = parseInt(room.ROOM_BED, 10);
          const bedBadge = Number.isFinite(bedCount) && bedCount > 0
            ? `<span class="bed-badge">${bedCount}<i class="fa fa-bed"></i></span>`
            : '';
          return `
            <div class="form-check room-option${disabled ? ' disabled-room' : ''}">
              <input class="form-check-input group-manual-checkbox" type="checkbox" data-room-id="${room.IDNo}" ${groupManualSelectedRooms.includes(room.IDNo) ? 'checked' : ''} ${disabled ? 'disabled' : ''}>
              <label class="form-check-label ms-2">
                ${room.ROOM_NUMBER}${bedBadge ? ` ${bedBadge}` : ''}
              </label>
            </div>`;
        }).join('');
        $('#groupRoomsList').append(`<div class="manual-rooms-container">${roomsHtml}</div>`);
      }
      
      // Initialize filter and count
      updateRoomFilterAndCount();
      
      // Add filter change handler
      $('input[name="groupRoomFilter"]').on('change', function() {
        updateRoomFilterAndCount();
      });
      
      updateManualSelectionInfo();
    }
    
    $('#groupResultsContainer').show();
  }

  function buildSingleRoomBlocks(rooms) {
    return rooms.map(room => [room]);
  }

  function updateRoomFilterAndCount() {
    const filter = $('input[name="groupRoomFilter"]:checked').val();
    const roomsContainer = $('.manual-rooms-container');
    let visibleCount = 0;
    
    if (!roomsContainer.length) return;
    
    roomsContainer.find('.room-option').each(function() {
      const $room = $(this);
      const $checkbox = $room.find('input[data-room-id]');
      const roomData = $checkbox.data('room-id');
      const room = groupAvailableRooms.find(r => r.IDNo === roomData);
      
      if (!room) {
        $room.hide();
        return;
      }
      
      const bedType = parseInt(room.ROOM_BED, 10);
      const shouldShow = filter === 'all' || 
        (filter === '1B' && bedType === 1) || 
        (filter === '2B' && bedType === 2);
        
      if (shouldShow) {
        $room.show();
        visibleCount++; // Count ALL rooms regardless of disabled state
      } else {
        $room.hide();
      }
    });
    
    // Update count badge
    const filterText = filter === 'all' ? 'rooms' : filter + ' rooms';
    $('#groupRoomCount').text(`Available: ${visibleCount}`);
  }

  function computeGroupTotal() {
    const nights = parseInt($('#groupNights').val(), 10) || 0;
    const pricesRaw = $('#groupSelectedRoomPrices').val();
    const prices = pricesRaw ? pricesRaw.split(',').map(p => parseFloat(p) || 0) : [];
    const baseSubtotal = prices.reduce((sum, price) => sum + price, 0);
    const roomSubtotal = baseSubtotal * nights;

    const discount = $('#groupIncludeDiscount').prop('checked') ? (parseFloat($('#groupDiscount').val()) || 0) : 0;

    const adultQty = $('#groupIncludeBreakfast').is(':checked') ? (parseInt($('#groupBreakfastAdultQty').val(), 10) || 0) : 0;
    const adultPrice = parseFloat($('#groupBreakfastAdultPrice').val()) || 0;
    const kidQty = $('#groupIncludeBreakfast').is(':checked') ? (parseInt($('#groupBreakfastKidQty').val(), 10) || 0) : 0;
    const kidPrice = parseFloat($('#groupBreakfastKidPrice').val()) || 0;
    const breakfastIndividual = $('#groupBreakfastIndividual').is(':checked');

    const pickupPrice = $('#groupIncludePickup').is(':checked') ? parseFloat($('#groupPickupPrice').val()) || 0 : 0;
    const dropoffPrice = $('#groupIncludeDropoff').is(':checked') ? parseFloat($('#groupDropoffPrice').val()) || 0 : 0;

    // Get number of rooms for individual service calculations
    const selectedRooms = $('#groupSelectedRooms').val();
    const numRooms = selectedRooms ? selectedRooms.split(',').length : 1;

    const breakfastTotal = (adultQty * adultPrice) + (kidQty * kidPrice);
    const breakfastTotalWithIndividual = breakfastIndividual ? breakfastTotal * numRooms : breakfastTotal;

    const servicesTotal = breakfastTotalWithIndividual + pickupPrice + dropoffPrice;

    // Check if individual billing is enabled (inverted logic)
    const isConsolidated = !$('#groupIndividualBilling').is(':checked');

    // Always calculate the full total in frontend for user visibility
    const subtotal = roomSubtotal + servicesTotal;
    let finalBalance = subtotal - discount;

    // Get paid amount and validate it doesn't exceed total
    let paidAmount = parseFloat($('#groupPaidAmount').val()) || 0;
    
    // Prevent paid amount from exceeding total
    if (paidAmount > finalBalance) {
      paidAmount = finalBalance;
      $('#groupPaidAmount').val(paidAmount.toFixed(2));
      $('#groupPaidAmountHidden').val(paidAmount.toFixed(2));
    }
    
    // Calculate balance (total - paid amount)
    const balance = finalBalance - paidAmount;
    
    // Determine payment status
    let paymentStatus;
    if (paidAmount <= 0) {
      paymentStatus = 'unpaid';
    } else if (paidAmount >= finalBalance) {
      paymentStatus = 'paid';
    } else {
      paymentStatus = 'partial';
    }
    
    // Update payment status field
    $('#groupPaymentStatus').val(paymentStatus);
    
    // Update payment status styling with CSS classes
    $('#groupPaymentStatus').removeClass('status-paid status-partial status-unpaid');
    if (paymentStatus === 'paid') {
      $('#groupPaymentStatus').addClass('status-paid');
    } else if (paymentStatus === 'partial') {
      $('#groupPaymentStatus').addClass('status-partial');
    } else {
      $('#groupPaymentStatus').addClass('status-unpaid');
    }

    // Update paid amount display (format without currency symbol)
    $('#groupComputedPaidAmount').html('<b>' + paidAmount.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
    
    // Update balance display (format without currency symbol)
    $('#groupComputedBalance').html('<b>' + balance.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');

    if (isConsolidated) {
      // Show consolidated total with indicator
      if (finalBalance < 0) {
        $('#groupComputedTotal').html(`<b class="text-warning">0.00 <small>(Master)</small></b>`);
      } else {
        $('#groupComputedTotal').html(`<b>${finalBalance.toLocaleString(undefined, { minimumFractionDigits: 2 })} <small class="text-info">(Master)</small></b>`);
      }
    } else {
      // Regular billing calculation
      if (finalBalance < 0) {
        $('#groupComputedTotal').html('<b class="text-warning">0.00</b>');
      } else {
        $('#groupComputedTotal').html('<b>' + finalBalance.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');
      }
    }
  }

  function populateBreakdown(block, computedPrices) {
    const container = $('#groupRoomBreakdown');
    
    // Get the current state of the checkbox BEFORE emptying the container
    const isManualRatesChecked = $('#groupEnableManualRates').is(':checked');
    
    container.empty();
    if (!block || !block.length) {
      return;
    }

    const nights = parseInt($('#groupNights').val(), 10) || 0;
    let html = `
      <div class="group-room-breakdown">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <b>Selected Room Prices:</b>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="groupEnableManualRates" name="groupEnableManualRates" ${isManualRatesChecked ? 'checked' : ''}>
            <label class="form-check-label" for="groupEnableManualRates">
              Manual Room Rates
            </label>
          </div>
        </div>
        <ul>`;
    
    block.forEach((room, idx) => {
      const price = computedPrices[idx] || 0;
      const total = nights > 0 ? price * nights : price;
      html += `<li>Room ${room.ROOM_NUMBER}: ${formatCurrency(price)} per night ${nights > 0 ? `(${formatCurrency(total)} total)` : ''}</li>`;
