}

#modal-add-group-booking .group-room-breakdown ul {
  padding-left: 20px;
  margin: 0;
}

#modal-add-group-booking .group-room-breakdown li {
  font-size: 0.95em;
  margin-bottom: 4px;
}

#modal-add-group-booking .form-check-input:focus {
  box-shadow: 0 0 0 0.2rem rgba(111, 156, 64, 0.25);
  border-color: #6f9c40;
}

#modal-add-group-booking .form-check-input:checked {
  background-color: #6f9c40;
  border-color: #6f9c40;
}

.swal2-container {
  z-index: 99999 !important;
}

.swal2-container.swal2-shown {
  z-index: 99999 !important;
}

.swal2-popup {
