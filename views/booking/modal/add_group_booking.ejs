        }
      } else {
        $('#groupManualRateSection').hide();
        // Clear manual rates when disabled
        groupManualRates = {};
        groupBedBasedRates = {};
        updateManualSelectedRoomValuesWithoutRecreating();
        computeGroupTotal();
      }
    });
    
    // Handle rate type toggle
    $(document).on('change', 'input[name="rateType"]', function() {
      const selectedRooms = groupAvailableRooms.filter(room => groupManualSelectedRooms.includes(room.IDNo));
      const rateType = $(this).val();
      
      if (rateType === 'individual') {
        $('#individualRateSection').show();
        $('#bedBasedRateSection').hide();
