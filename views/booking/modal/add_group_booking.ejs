    // Handle bed-based rate input changes
    $(document).on('input', '.bed-based-rate-input', function() {
      const bedCount = parseInt($(this).data('bed-count'), 10);
      const newRate = parseFloat($(this).val()) || 0;
      
      if (newRate >= 0) {
        groupBedBasedRates[bedCount] = newRate;
        updateManualSelectedRoomValuesWithoutRecreating();
        computeGroupTotal();
      }
    });
