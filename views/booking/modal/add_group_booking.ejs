    // Handle manual rates checkbox toggle
    $(document).on('change', '#groupEnableManualRates', function() {
      const isChecked = $(this).is(':checked');
      const selectedRooms = groupAvailableRooms.filter(room => groupManualSelectedRooms.includes(room.IDNo));
      
      if (isChecked && selectedRooms.length > 0) {
