<div class="modal fade" id="modal-payment" tabindex="-1" role="dialog" aria-labelledby="paymentModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" style="z-index: 1080 !important;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentModalLabel">Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="paymentForm">
                    <div class="mb-3">
                        <label for="paymentAmount" class="form-label">Amount to Pay</label>
                        <input type="text" class="form-control" id="paymentAmount" readonly>
                    </div>
                    
                    <div class="mb-3">
                        <label for="paymentMethod" class="form-label">Payment Method</label>
                        <select class="form-select" name="paymentMethod" id="paymentMethod" required>
                            <option value="" selected disabled>Select Payment Method</option>
                            <option value="cash">Cash</option>
                            <option value="credit_card">Credit Card</option>
                            <!-- <option value="paypal">PayPal</option> -->
                            
                        </select>
                    </div>
                    <div id="paymentDetails">
                        <!-- Dynamic payment details will appear here -->
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmPaymentButton" class="btn btn-success">Confirm Payment</button>
            </div>
        </div>
       
    </div>
</div>

<style>
/* Ensure payment modal appears above billing modal */
#modal-payment {
    z-index: 1080 !important;
}

#modal-payment .modal-backdrop {
    z-index: 1075 !important;
}

/* Ensure payment modal content is properly positioned */
#modal-payment .modal-dialog {
    z-index: 1085 !important;
}

/* Fix any potential overlay issues */
.modal-backdrop + .modal-backdrop {
    z-index: 1074 !important;
}

/* Payment Modal Input Styling - Default Black Text */
#modal-payment .form-control {
    background: #ffffff !important;
    border: 1px solid #ced4da !important;
    color: #000000 !important;
    font-weight: 500 !important;
}

#modal-payment .form-control:focus {
    background: #ffffff !important;
    border-color: #3498db !important;
    color: #000000 !important;
    box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25) !important;
}

#modal-payment .form-control:read-only {
    background: #f8f9fa !important;
    color: #000000 !important;
    border-color: #ced4da !important;
}

#modal-payment .form-select {
    background: #ffffff !important;
    border: 1px solid #ced4da !important;
    color: #000000 !important;
    font-weight: 500 !important;
}

#modal-payment .form-select:focus {
    background: #ffffff !important;
    border-color: #3498db !important;
    color: #000000 !important;
    box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25) !important;
}

#modal-payment .form-select option {
    background: #ffffff !important;
    color: #000000 !important;
}

#modal-payment .form-select option:hover {
    background: #f8f9fa !important;
    color: #000000 !important;
}

#modal-payment .form-select option:checked {
    background: #3498db !important;
    color: #ffffff !important;
}

/* Force select text to be black */
#modal-payment select.form-select {
    color: #000000 !important;
}

#modal-payment select.form-select option {
    color: #000000 !important;
}

/* Additional specificity for select elements */
#modal-payment .form-select,
#modal-payment select,
#modal-payment select option {
    color: #000000 !important;
}

/* Label styling */
#modal-payment .form-label {
    color: #ffffff !important;
    font-weight: 500 !important;
    margin-bottom: 8px !important;
}

/* Placeholder styling */
#modal-payment .form-control::placeholder {
    color: #6c757d !important;
}

#modal-payment .form-select:invalid {
    color: #6c757d !important;
}

/* Force select dropdown text to be black with higher specificity */
#modal-payment select.form-select,
#modal-payment .form-select,
#modal-payment select {
    color: #000000 !important;
    background-color: #ffffff !important;
}

#modal-payment select.form-select option,
#modal-payment .form-select option,
#modal-payment select option {
    color: #000000 !important;
    background-color: #ffffff !important;
}

/* Override any Bootstrap default colors */
#modal-payment .form-select:not([size]):not([multiple]) {
    color: #000000 !important;
}

/* Hover effects */
#modal-payment .form-control:hover,
#modal-payment .form-select:hover {
    background: #ffffff !important;
    border-color: #adb5bd !important;
    color: #000000 !important;
}


</style>



<!-- Include external JavaScript files -->
<script>
	document.addEventListener('DOMContentLoaded', function() {
		
		// Load add_booking.js immediately - this is critical for booking functionality
		var bookingPaymentScript = document.createElement('script');
		bookingPaymentScript.src = '/js/booking/payment.js';
		document.body.appendChild(bookingPaymentScript);
	});
</script>