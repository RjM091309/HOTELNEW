<!-- Enhanced Payment Modal -->
<div class="modal fade" id="modal-payment" tabindex="-1" role="dialog" aria-labelledby="paymentModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content payment-modal-content">
            <!-- Enhanced Header -->
            <div class="modal-header payment-modal-header">
                <div class="header-content">
                    <div class="header-text">
                <h5 class="modal-title" id="paymentModalLabel">Payment</h5>
                    </div>
                </div>
                <div class="payment-header-room" id="paymentRoomNumberBadge" style="display: none;">
                    Room <span id="paymentRoomNumber">-</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Enhanced Body -->
            <div class="modal-body payment-modal-body">
                <!-- Payment Summary Card -->
                <div class="payment-summary-card">
                    <div class="summary-header">
                        <h6><i class="fa fa-receipt"></i> Payment Summary</h6>
                    </div>
                    <div class="summary-content">
                        <!-- Room Charges -->
                        <div class="summary-row" id="roomRow" style="display: none;">
                            <span class="summary-label">Room Charges:</span>
                            <span class="summary-value" id="roomAmount">0.00</span>
                        </div>
                        
                        <!-- Extensions -->
                        <div class="summary-row" id="extensionRow" style="display: none;">
                            <span class="summary-label">Extensions:</span>
                            <span class="summary-value" id="extensionAmount">0.00</span>
                        </div>
                        
                        <!-- Services -->
                        <div class="summary-row" id="serviceRow" style="display: none;">
                            <span class="summary-label">Services:</span>
                            <span class="summary-value" id="serviceAmount">0.00</span>
                        </div>
                        
                        <!-- Reservation Fee -->
                        <div class="summary-row" id="paymentReservationFeeRow" style="display: none;">
                            <span class="summary-label">Reservation Fee:</span>
                            <span class="summary-value" id="paymentReservationFeeAmount">0.00</span>
                        </div>
                        
                        <!-- Discount -->
                        <div class="summary-row" id="paymentDiscountRow" style="display: none;">
                            <span class="summary-label">Discount:</span>
                            <span class="summary-value" id="paymentDiscountAmount">0.00</span>
                        </div>
                        
                        <!-- Subtotal -->
                        <div class="summary-row" id="subtotalRow" style="display: none;">
                            <span class="summary-label">Subtotal:</span>
                            <span class="summary-value subtotal-amount" id="subtotalAmount">0.00</span>
                        </div>
                        
                        <!-- Amount Paid -->
                        <div class="summary-row" id="amountPaidRow" style="display: none;">
                            <span class="summary-label">Amount Paid:</span>
                            <span class="summary-value amount-paid" id="amountPaid">0.00</span>
                        </div>
                        
                        <!-- Total Amount to Pay -->
                        <div class="summary-row">
                            <span class="summary-label">Total Amount to Pay:</span>
                            <span class="summary-value total-amount" id="paymentTotalAmount">0.00</span>
                        </div>
                        
                        <!-- Remaining Balance -->
                        <div class="summary-row balance-row" id="balanceRow" style="display: none;">
                            <span class="summary-label">Remaining Balance:</span>
                            <span class="summary-value balance-amount" id="remainingBalance">0.00</span>
                        </div>
                    </div>
                </div>

                <!-- Security Deposit Section (populated only when checking out a booking with a held deposit) -->
                <div id="pdepDepositSection" class="payment-summary-card" style="display: none;">
                    <div class="summary-header">
                        <h6><i class="fa fa-hand-holding-usd"></i> Security Deposit</h6>
                    </div>
                    <input type="hidden" id="pdepBookingId" value="">
                    <p class="text-muted mb-1" style="font-size: 0.85rem;" id="pdepRoomInfo">Process security deposit before checking out.</p>
                    <p class="fw-semibold mb-3" id="pdepDepositQuestion" style="color: #0c2a42;">
                        Refund security deposit of <span id="pdepDepositAmount" style="color: #198754; font-weight: 700;">₱0.00</span>?
                    </p>

                    <div class="mb-2">
                        <label class="pdep-option pdep-option-selected" id="pdepOptionFull">
                            <input type="radio" name="pdepAction" id="pdepActionFull" value="full_refund" checked>
                            <span class="pdep-option-label">
                                <strong>Full Refund</strong>
                                <span class="pdep-option-desc">Return the entire deposit to the guest.</span>
                            </span>
                        </label>

                        <label class="pdep-option" id="pdepOptionPartial">
                            <input type="radio" name="pdepAction" id="pdepActionPartial" value="partial_deduct">
                            <span class="pdep-option-label">
                                <strong>Partial / Deduct</strong>
                                <span class="pdep-option-desc">Deduct for damages or charges; apply the remainder to balance.</span>
                            </span>
                        </label>

                        <div id="pdepPartialWrap" style="display: none;">
                            <label for="pdepDeductAmount" class="form-label small fw-semibold mb-1">Deduction Amount</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">₱</span>
                                <input type="text" class="form-control" id="pdepDeductAmount" inputmode="decimal" placeholder="0" autocomplete="off">
                            </div>
                            <div id="pdepApplyRemainderWrap" style="display: none;">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="pdepApplyRemainderToBalance">
                                    <label class="form-check-label" for="pdepApplyRemainderToBalance">
                                        Apply remainder to outstanding balance
                                    </label>
                                </div>
                            </div>
                            <div class="pdep-partial-breakdown" id="pdepPartialBreakdown">
                                <div id="pdepPartialAppliedRow" style="display: none;">Applied to balance: <strong id="pdepPartialAppliedPreview" class="text-primary">₱0.00</strong></div>
                                <div>Cash refund: <strong id="pdepPartialRefundPreview">₱0.00</strong></div>
                            </div>
                        </div>

                        <label class="pdep-option" id="pdepOptionApply" style="display: none;">
                            <input type="radio" name="pdepAction" id="pdepActionApply" value="apply_to_balance">
                            <span class="pdep-option-label">
                                <strong>Apply to Balance</strong>
                                <span class="pdep-option-desc">Use deposit toward outstanding room balance; refund any excess.</span>
                            </span>
                        </label>
                    </div>

                    <div class="mb-1">
                        <label for="pdepRemarks" class="form-label fw-semibold small mb-1">
                            <i class="fa fa-sticky-note me-1"></i>Remarks <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <input type="text" class="form-control form-control-sm" id="pdepRemarks" placeholder="e.g. damage charge, key not returned">
                    </div>

                    <div id="pdepErrorMsg" class="alert alert-danger py-2 mt-2 mb-0" style="display: none;"></div>
                </div>

                <!-- Payment Form -->
                <form id="paymentForm" class="payment-form">
                    <!-- Hidden Input for Booking ID -->
                    <input type="hidden" id="bookingID" name="bookingID">
                    <input type="hidden" id="paymentAmount" name="paymentAmount">
                    <input type="hidden" id="paymentMethod" name="paymentMethod">

                    <!-- Payment Amount Input -->
                    <div class="form-group payment-amount-group">
                        <label for="paymentAmountInput" class="form-label">
                            <i class="fa fa-money"></i> Amount to Pay
                        </label>
                        <div class="input-group">
                            <input type="number" 
                                   class="form-control" 
                                   id="paymentAmountInput" 
                                   name="paymentAmountInput"
                                   step="0.01"
                                   min="0"
                                   placeholder="Enter amount to pay"
                                   >
                        </div>
                    </div>
                    
                    <!-- Payment Method Selection -->
                    <div class="form-group payment-method-group">
                        <label for="paymentMethod" class="form-label">
                            <i class="fa fa-credit-card"></i> Payment Method
                        </label>
                        <div class="payment-method-options">
                            <div class="payment-option" data-method="cash">
                                <div class="option-icon">
                                    <i class="fa fa-money"></i>
                                </div>
                                <div class="option-content">
                                    <div class="option-title">Cash</div>
                                </div>
                                <div class="option-radio">
                                    <input type="radio" name="paymentMethod" value="cash" id="cashPayment">
                                    <label for="cashPayment"></label>
                                </div>
                    </div>

                            <div class="payment-option" data-method="bank_transfer">
                                <div class="option-icon">
                                    <i class="fa fa-university"></i>
                                </div>
                                <div class="option-content">
                                    <div class="option-title">Bank Transfer</div>
                                </div>
                                <div class="option-radio">
                                    <input type="radio" name="paymentMethod" value="bank_transfer" id="bankTransferPayment">
                                    <label for="bankTransferPayment"></label>
                                </div>
                            </div>

                            <div class="payment-option" data-method="agoda">
                                <div class="option-icon">
                                    <i class="fa fa-globe"></i>
                                </div>
                                <div class="option-content">
                                    <div class="option-title">AGODA</div>
                                </div>
                                <div class="option-radio">
                                    <input type="radio" name="paymentMethod" value="agoda" id="agodaPayment">
                                    <label for="agodaPayment"></label>
                                </div>
                            </div>

                            <div class="payment-option" data-method="expedia">
                                <div class="option-icon">
                                    <i class="fa fa-plane"></i>
                                </div>
                                <div class="option-content">
                                    <div class="option-title">EXPEDIA</div>
                                </div>
                                <div class="option-radio">
                                    <input type="radio" name="paymentMethod" value="expedia" id="expediaPayment">
                                    <label for="expediaPayment"></label>
                                </div>
                            </div>

                            <div class="payment-option" data-method="credit">
                                <div class="option-icon">
                                    <i class="fa fa-flag"></i>
                                </div>
                                <div class="option-content">
                                    <div class="option-title">Credit</div>
                                </div>
                                <div class="option-radio">
                                    <input type="radio" name="paymentMethod" value="credit" id="creditPayment">
                                    <label for="creditPayment"></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic Payment Details -->
                    <div id="paymentDetails" class="payment-details-section">
                        <!-- Payment method specific details will appear here -->
                    </div>

                    <!-- Payment Notes -->
                    <div class="form-group payment-notes-group">
                        <label for="paymentNotes" class="form-label">
                            <i class="fa fa-sticky-note"></i> Payment Notes (Optional)
                        </label>
                        <textarea class="form-control" 
                                  id="paymentNotes" 
                                  name="paymentNotes" 
                                  rows="3" 
                                  placeholder="Add any additional notes about this payment..."></textarea>
                    </div>
                </form>

                <!-- Payment Status Messages -->
                <div id="paymentStatusMessages" class="payment-status-messages" style="display: none;">
                    <!-- Status messages will appear here -->
                </div>
            </div>

            <!-- Enhanced Footer -->
            <div class="modal-footer payment-modal-footer">
                <div class="footer-actions">
                    <button type="button" class="btn btn-secondary btn-cancel" data-bs-dismiss="modal">
                        <i class="fa fa-times"></i> Cancel
                    </button>
                    <button type="button" id="confirmPaymentButton" class="btn btn-success btn-confirm-payment">
                        <i class="fa fa-check"></i> 
                        <span class="btn-text">Confirm Payment</span>
                        <span class="btn-loading" style="display: none;">
                            <i class="fa fa-spinner fa-spin"></i> Processing...
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

