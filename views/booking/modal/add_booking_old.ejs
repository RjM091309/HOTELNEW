            }
        });

        // Fetch Pending Bookings and Show in Modal if Available, BUT NOT if triggered from calendar
        if (!isCalendarAction) {
            $.ajax({
                url: `/booking/get_pending_bookings?room_id=${roomId}`,
                method: 'GET',
                success: function (data) {
                    if (data.length > 0) {
                        let rows = '';
