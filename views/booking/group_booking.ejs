<script>
    // Initialize Flatpickr for date range picker on Group booking page
    $(document).ready(function() {
        // Determine scope for Group page
        const scope = 'group';
        
        // Check for highlight parameter in URL (for filtering to specific group)
        const urlParams = new URLSearchParams(window.location.search);
        const highlightGroupId = urlParams.get('highlight');
        
        // Initialize Flatpickr for date range picker with error handling
        let dateRangePicker;
        try {
            dateRangePicker = flatpickr("#dateRangePicker", {
            mode: "range",
            dateFormat: "Y-m-d",
            allowInput: false,
            clickOpens: true,
            placeholder: "Select date range",
            showMonths: 2,
            static: false,
            monthSelectorType: "static",
            prevArrow: '<i class="fa fa-chevron-left"></i>',
            nextArrow: '<i class="fa fa-chevron-right"></i>',
            locale: {
                firstDayOfWeek: 1, // Monday
                weekdays: {
                    shorthand: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
                    longhand: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
                },
                months: {
                    shorthand: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                    longhand: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
                }
            },
            onReady: function(selectedDates, dateStr, instance) {
                // Add custom classes for styling
                instance.calendarContainer.classList.add('flatpickr-range-mode');
            },
            onClose: function(selectedDates, dateStr, instance) {
                // Prevent immediate reopening
                instance.input.blur();
            },
            onChange: function(selectedDates, dateStr, instance) {
                // Update input display when dates are selected
                if (selectedDates.length === 2) {
                    const startDate = selectedDates[0];
                    const endDate = selectedDates[1];
                    const formattedStart = startDate.toLocaleDateString('en-US', { 
                        month: 'short', 
                        day: 'numeric', 
                        year: 'numeric' 
                    });
                    const formattedEnd = endDate.toLocaleDateString('en-US', { 
                        month: 'short', 
                        day: 'numeric', 
                        year: 'numeric' 
                    });
                    instance.input.value = `${formattedStart} to ${formattedEnd}`;
                    
                    // Auto-apply filter when both dates are selected
                    // Use local date formatting to avoid timezone issues
                    const dateFrom = startDate.getFullYear() + '-' + 
                        String(startDate.getMonth() + 1).padStart(2, '0') + '-' + 
                        String(startDate.getDate()).padStart(2, '0');
                    const dateTo = endDate.getFullYear() + '-' + 
                        String(endDate.getMonth() + 1).padStart(2, '0') + '-' + 
                        String(endDate.getDate()).padStart(2, '0');
                    
                    // Remove active class from all predefined filter buttons
                    $('.filter-btn').removeClass('active');
                    
                    // Build URL with highlight parameter if present
                    let url = `/booking/group_booking_data?filter=custom&scope=${scope}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                    if (highlightGroupId && String(highlightGroupId) !== '0' && String(highlightGroupId) !== '') {
                        url += `&groupId=${highlightGroupId}`;
                    }
                    
                    // Update the DataTable's AJAX URL with custom date range
                    const table = $('#group_booking_tbl').DataTable();
                    if (table) {
                        table.ajax.url(url).load();
                    }
                    
                    // Close the calendar after applying filter with a small delay
                    setTimeout(() => {
                        instance.close();
                    }, 100);
                    
                    // Show success message
                    Swal.fire({
                        icon: 'success',
                        title: 'Filter Applied',
                        text: `Showing group bookings from ${formattedStart} to ${formattedEnd}`,
                        timer: 1500,
                        showConfirmButton: false
                    });
                }
            }
            });
        } catch (error) {
            console.error('Failed to initialize date range picker:', error);
            Swal.fire({
                icon: 'error',
                title: 'Date Picker Error',
                text: 'Failed to initialize date range picker. Please refresh the page.',
                confirmButtonText: 'OK'
            });
        }
        
        // Handle filter button clicks (works independently of dateRangePicker)
        $('.filter-btn').on('click', function() {
            // Remove active class from all filter buttons
            $('.filter-btn').removeClass('active');
            // Add active class to clicked button
            $(this).addClass('active');
            
            // Clear custom date picker when using predefined filters (only if initialized)
            if (dateRangePicker) {
                dateRangePicker.clear();
            }
            
            // Get the filter value
            let filter = $(this).data('filter');
            
            // Build URL with highlight parameter if present
            let url = `/booking/group_booking_data?filter=${filter}&scope=${scope}`;
            if (highlightGroupId && String(highlightGroupId) !== '0' && String(highlightGroupId) !== '') {
                url += `&groupId=${highlightGroupId}`;
            }
            
            // Update the DataTable's AJAX URL
            const table = $('#group_booking_tbl').DataTable();
            if (table) {
                table.ajax.url(url).load();
            }
        });
        
        // Handle clear date filter (works independently of dateRangePicker)
        $('#clearDateFilter').on('click', function() {
            // Clear date picker if initialized
            if (dateRangePicker) {
                dateRangePicker.clear();
            }
            
            // Reset to "All" filter (default for Group page)
            $('.filter-btn').removeClass('active');
            $('.filter-btn[data-filter="all"]').addClass('active');
            
            // Build URL with highlight parameter if present
            let url = `/booking/group_booking_data?filter=all&scope=${scope}`;
            if (highlightGroupId && String(highlightGroupId) !== '0' && String(highlightGroupId) !== '') {
                url += `&groupId=${highlightGroupId}`;
            }
            
            // Update the DataTable's AJAX URL
            const table = $('#group_booking_tbl').DataTable();
            if (table) {
                table.ajax.url(url).load();
            }
        });
    });
</script>

