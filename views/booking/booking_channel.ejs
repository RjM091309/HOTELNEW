<!-- BOOKING CHANNEL MODALS -->
<!-- ======================================== -->

<!-- Add Channel Modal -->
<div class="modal fade" id="addChannelModal" tabindex="-1" role="dialog" aria-labelledby="addChannelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addChannelModalLabel">Add New Channel</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="addChannelForm">
                <div class="modal-body">
                    <!-- Channel Information -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="channelName">Channel Name *</label>
                                <input type="text" class="form-control" id="channelName" name="channelName" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="channelApiKey">API Key *</label>
                                <input type="text" class="form-control" id="channelApiKey" name="channelApiKey" required>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Channel Details -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="channelStatus">Status *</label>
                                <select class="form-control" id="channelStatus" name="channelStatus" required>
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="channelImg">Channel Logo</label>
                                <input type="file" class="form-control" id="channelImg" name="channelImg" accept="image/*">
                                <small class="form-text text-muted">Upload channel logo (PNG, JPG, JPEG)</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Channel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Channel Modal -->
<div class="modal fade" id="editChannelModal" tabindex="-1" role="dialog" aria-labelledby="editChannelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editChannelModalLabel">Edit Channel</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="editChannelForm">
                <div class="modal-body">
                    <input type="hidden" id="editChannelId" name="channelId">
                    <!-- Channel Information -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editChannelName">Channel Name *</label>
                                <input type="text" class="form-control" id="editChannelName" name="channelName" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editChannelApiKey">API Key *</label>
                                <input type="text" class="form-control" id="editChannelApiKey" name="channelApiKey" required>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Channel Details -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editChannelStatus">Status *</label>
                                <select class="form-control" id="editChannelStatus" name="channelStatus" required>
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editChannelImg">Channel Logo</label>
                                <input type="file" class="form-control" id="editChannelImg" name="channelImg" accept="image/*">
                                <small class="form-text text-muted">Leave empty to keep current logo</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Channel</button>
                </div>
            </form>
        </div>
    </div>
</div>

