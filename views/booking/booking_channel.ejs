    transition: all 0.3s ease;
    height: 100%;
}

.info-section:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.2);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.2);
}

/* Info Icon Styling */
.info-icon {
    background: linear-gradient(135deg, #6f9c40, #5a7a33);
    border-radius: 50%;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 15px rgba(111, 156, 64, 0.3);
    border: 1px solid rgba(255,255,255,0.2);
}

.info-icon i {
    color: #ffffff;
    font-size: 20px;
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
}

/* Info Content Styling */
.info-content {
