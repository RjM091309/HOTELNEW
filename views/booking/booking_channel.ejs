    }
    
    .info-icon i {
        font-size: 14px;
    }
    
    .info-value {
        font-size: 14px;
    }
    
    .btn-action {
        padding: 0.3rem 0.6rem;
        font-size: 10px;
    }
}

/* Animation for page load */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.hotel-info-card {
    animation: fadeInUp 0.6s ease-out;
}

.info-section:nth-child(1) { animation-delay: 0.1s; }
.info-section:nth-child(2) { animation-delay: 0.2s; }
.info-section:nth-child(3) { animation-delay: 0.3s; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Load scripts with proper timing
        setTimeout(function() {
            var bookingChannelScript = document.createElement('script');
            bookingChannelScript.src = '/js/booking_channel/booking_channel_data.js';
            document.body.appendChild(bookingChannelScript);
        }, 300);
    });
</script>
