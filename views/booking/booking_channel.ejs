<style>
/* Enhanced Dark Theme Styling for Booking Channel */

/* Hotel Info Card Styling */
.hotel-info-card {
    background: linear-gradient(145deg, #2a3135, #1f2528);
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 8px 32px rgba(0,0,0,0.3), 
                0 4px 16px rgba(0,0,0,0.2),
                inset 0 1px 0 rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.1);
    position: relative;
    overflow: hidden;
}

.hotel-info-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #4CAF50, #8BC34A, #CDDC39);
    opacity: 0;
