<style>
/* Fix modal z-index stacking for nested modals */
.modal-backdrop {
    z-index: 9997 !important;
}

.modal-backdrop + .modal-backdrop {
    z-index: 9998 !important;
}

/* Ensure add/edit modals appear on top */
#addVehicleModal,
#editVehicleModal {
    z-index: 9999 !important;
}

/* Force modal backdrop to be behind all modals */
.modal-backdrop.show {
    z-index: 9997 !important;
}

/* Vehicle photo styling */
.vehicle-photo {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 50%;
    cursor: pointer;
}

.vehicle-photo:hover {
    transform: scale(1.1);
    transition: transform 0.2s;
}

/* ======================================== */
/* ENHANCED FILE UPLOAD STYLING */
/* ======================================== */

.vehicle-photo-upload-container {
    width: 100%;
    margin-bottom: 20px;
}

.upload-label {
    display: block;
    font-size: 12px !important;
    font-weight: 500;
    color: #aaaaaa !important;
    margin-bottom: 12px;
    font-family: 'Poppins', sans-serif;
}

.file-upload-wrapper {
    position: relative;
    width: 100%;
}

.file-upload-area {
    position: relative;
    border: 2px dashed #555;
    border-radius: 8px;
    padding: 20px 15px;
    text-align: center;
    background: #2a3135;
    cursor: pointer;
    transition: all 0.3s ease;
    overflow: hidden;
}

.file-upload-area:hover {
    border-color: #2196F3;
    background: #2a3135;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(33, 150, 243, 0.3);
}

.file-upload-area.dragover {
    border-color: #2196F3;
    background: #1e3a5f;
    transform: scale(1.02);
}

.file-upload-area.has-file {
    border-color: #4CAF50;
    background: #1a2e1a;
}

.upload-icon {
    margin-bottom: 10px;
}

.upload-icon i {
    font-size: 36px;
    color: #2196F3;
    transition: all 0.3s ease;
}

.file-upload-area:hover .upload-icon i {
    color: #1976D2;
    transform: scale(1.1);
}

.upload-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.primary-text {
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
}

.secondary-text {
    font-size: 13px;
    color: #cccccc;
    font-family: 'Poppins', sans-serif;
}

.file-types {
    font-size: 11px;
    color: #999;
    font-family: 'Poppins', sans-serif;
    margin-top: 3px;
}

.file-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
}

.file-info {
    margin-top: 12px;
    padding: 12px;
    background: #1a2e1a;
    border: 1px solid #2d5a2d;
    border-radius: 6px;
    display: none;
}

.file-details {
    display: flex;
    align-items: center;
    gap: 12px;
}

.file-icon {
    color: #4CAF50;
}

.file-icon i {
    font-size: 24px;
}

.file-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.file-name {
    font-weight: 600;
    color: #4CAF50;
    font-size: 13px;
    font-family: 'Poppins', sans-serif;
}

.file-size {
    font-size: 11px;
    color: #cccccc;
    font-family: 'Poppins', sans-serif;
}

.remove-file-btn {
    background: #ff5722;
    color: white;
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 16px;
}

.remove-file-btn:hover {
    background: #d84315;
    transform: scale(1.1);
}

.photo-preview-container {
    margin-top: 15px;
    border: 1px solid #555;
    border-radius: 6px;
    overflow: hidden;
    background: #2a2a2a;
}

.preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    background: #3a3a3a;
    border-bottom: 1px solid #555;
}

.preview-header span {
    font-weight: 600;
    color: #ffffff;
    font-size: 13px;
    font-family: 'Poppins', sans-serif;
}

.preview-actions {
    background: none;
    border: none;
    color: #2196F3;
    cursor: pointer;
    padding: 5px;
    border-radius: 4px;
    transition: all 0.3s ease;
}

.preview-actions:hover {
    background: #e3f2fd;
    color: #1976D2;
}

.preview-image-wrapper {
    padding: 12px;
    text-align: center;
}

.preview-image {
    max-width: 100%;
    max-height: 180px;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
}

.preview-image:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
}

.upload-error {
    margin-top: 15px;
    padding: 12px 15px;
    background: #ffebee;
    border: 1px solid #ffcdd2;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    display: none;
}

.error-icon {
    color: #f44336;
    font-size: 20px;
}

.error-text {
    color: #c62828;
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
}

/* Drag and drop animations */
@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
}

.file-upload-area.dragover {
    animation: pulse 0.6s ease-in-out;
}

/* Responsive design */
@media (max-width: 768px) {
    .file-upload-area {
        padding: 20px 15px;
    }
    
    .upload-icon i {
        font-size: 36px;
    }
    
    .primary-text {
        font-size: 16px;
    }
    
    .secondary-text {
        font-size: 13px;
    }
    
    .file-types {
        font-size: 11px;
    }
}

/* Loading state */
.file-upload-area.loading {
    pointer-events: none;
    opacity: 0.7;
}

.file-upload-area.loading .upload-icon i {
    animation: spin 1s linear infinite;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* Modal-specific styling */
.modal .vehicle-photo-upload-container {
    margin-bottom: 15px;
}

.modal .file-upload-area {
    padding: 25px 15px;
}

.modal .upload-icon i {
    font-size: 40px;
}

.modal .primary-text {
    font-size: 16px;
}

.modal .secondary-text {
    font-size: 13px;
}

.modal .file-types {
    font-size: 11px;
}

/* Ensure proper spacing in modal rows */
.modal .row .col-lg-6 {
    margin-bottom: 10px;
}

/* File upload area focus states */
.file-upload-area:focus-within {
    border-color: #1976D2;
    box-shadow: 0 0 0 3px rgba(33, 150, 243, 0.1);
}

/* Smooth transitions for all interactive elements */
.file-upload-area *,
.file-info *,
.preview-actions,
.remove-file-btn {
    transition: all 0.3s ease;
}

/* Hover effects for preview image */
.preview-image-wrapper:hover .preview-image {
    transform: scale(1.08);
}

/* Enhanced button hover effects */
.preview-actions:hover,
.remove-file-btn:hover {
    transform: translateY(-1px);
