<!-- Guest Types Management Modal -->
<div class="modal fade" id="guestTypesManagementModal" tabindex="-1" role="dialog" aria-labelledby="guestTypesManagementModalLabel" aria-hidden="true" data-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="guestTypesManagementModalLabel">Guest Types Management</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6>Manage Guest Types</h6>
                    <button class="btn btn-primary-10 btn-sm" id="addGuestTypeBtn" title="Add New Guest Type">
                        <i class="fa fa-plus"></i> Add New Guest Type
                    </button>
                </div>
                <div class="table-scrollable">
                    <table id="guestTypeTable" class="table table-hover table-bordered full-width">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data loaded dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Guest Type Modal -->
<div class="modal fade" id="addGuestTypeModal" tabindex="-1" role="dialog" aria-labelledby="addGuestTypeModalLabel" aria-hidden="true" data-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="addGuestTypeModalLabel">Add New Guest Type</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addGuestTypeForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addGuestTypeName" name="txtTypeGuest" required>
                                <label class="mdl-textfield__label">Guest Type Name</label>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addGuestTypeActive" name="ACTIVE" value="" readonly tabIndex="-1" required>
                                <label for="addGuestTypeActive" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="addGuestTypeActive" class="mdl-textfield__label">Status</label>
                                <ul data-mdl-for="addGuestTypeActive" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="1">Active</li>
                                    <li class="mdl-menu__item" data-val="0">Inactive</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-10">Add Guest Type</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Guest Type Modal -->
<div class="modal fade" id="editGuestTypeModal" tabindex="-1" role="dialog" aria-labelledby="editGuestTypeModalLabel" aria-hidden="true" data-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="editGuestTypeModalLabel">Edit Guest Type</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editGuestTypeForm">
                <div class="modal-body">
                    <input type="hidden" id="editGuestTypeId" name="id">
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editGuestTypeName" name="TYPE" required>
                                <label class="mdl-textfield__label">Guest Type Name</label>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editGuestTypeActive" name="ACTIVE" value="" readonly tabIndex="-1" required>
                                <label for="editGuestTypeActive" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="editGuestTypeActive" class="mdl-textfield__label">Status</label>
                                <ul data-mdl-for="editGuestTypeActive" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="1">Active</li>
                                    <li class="mdl-menu__item" data-val="0">Inactive</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-10">Update Guest Type</button>
                </div>
            </form>
        </div>
    </div>
</div>

