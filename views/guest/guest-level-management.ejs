<!-- Add Guest Level Modal -->
<div class="modal fade" id="addGuestLevelModal" tabindex="-1" role="dialog" aria-labelledby="addGuestLevelModalLabel" aria-hidden="true" data-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="addGuestLevelModalLabel">Add New Guest Level</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addGuestLevelForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addGuestLevelName" name="TYPE" required>
                                <label class="mdl-textfield__label">Guest Level Name</label>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addGuestLevelActive" name="ACTIVE" value="" readonly tabIndex="-1" required>
                                <label for="addGuestLevelActive" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="addGuestLevelActive" class="mdl-textfield__label">Status</label>
                                <ul data-mdl-for="addGuestLevelActive" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="1">Active</li>
                                    <li class="mdl-menu__item" data-val="0">Inactive</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-10">Add Guest Level</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Guest Level Modal -->
<div class="modal fade" id="editGuestLevelModal" tabindex="-1" role="dialog" aria-labelledby="editGuestLevelModalLabel" aria-hidden="true" data-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="editGuestLevelModalLabel">Edit Guest Level</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editGuestLevelForm">
                <div class="modal-body">
                    <input type="hidden" id="editGuestLevelId" name="id">
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editGuestLevelName" name="TYPE" required>
                                <label class="mdl-textfield__label">Guest Level Name</label>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editGuestLevelActive" name="ACTIVE" value="" readonly tabIndex="-1" required>
                                <label for="editGuestLevelActive" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="editGuestLevelActive" class="mdl-textfield__label">Status</label>
                                <ul data-mdl-for="editGuestLevelActive" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="1">Active</li>
                                    <li class="mdl-menu__item" data-val="0">Inactive</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-10">Update Guest Level</button>
                </div>
            </form>
        </div>
    </div>
</div>

