<div class="row">
  <div class="col-xl-12 col-md-12 col-12">
    <div class="dashboard-card">
      <div class="dashboard-card-header">
        <header>Pick Up & Drop</header>
      </div>
      <div class="dashboard-card-body pickup-drop-table-wrap">
        <div class="table-scrollable">
          <table id="pickupDropTable" class="table table-hover table-bordered full-width">
            <thead>
              <tr>
                <th>Name</th>
                <th>Flight No.</th>
                <th>No. of Persons</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="printTypeMenu" class="print-type-menu" style="display: none;">
  <button type="button" class="print-type-option" data-type="pickup">Pick up</button>
  <button type="button" class="print-type-option" data-type="dropoff">Drop off</button>
</div>

<div class="modal fade" id="editPickupDropModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Pick Up & Drop</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editPickupDropForm">
        <input type="hidden" id="editPickupDropId">
        <div class="modal-body">
          <div class="mb-3">
            <label for="editName" class="form-label">Name</label>
            <input type="text" class="form-control" id="editName" readonly>
          </div>
          <div class="mb-3 pickup-drop-flight-field">
            <label for="editFlightNumber" class="form-label">Pick-up Flight No.</label>
            <input type="text" class="form-control" id="editFlightNumber" placeholder="e.g. 5J538" autocomplete="off">
            <div id="editPickupFlightDropdown" class="pickup-drop-flight-dropdown"></div>
          </div>
          <div class="mb-3 pickup-drop-flight-field">
            <label for="editDropoffFlightNumber" class="form-label">Drop-off Flight No.</label>
            <input type="text" class="form-control" id="editDropoffFlightNumber" placeholder="e.g. 5J537" autocomplete="off">
            <div id="editDropoffFlightDropdown" class="pickup-drop-flight-dropdown"></div>
          </div>
          <div class="mb-3">
            <label for="editPersonCount" class="form-label">No. of Persons</label>
            <input type="number" class="form-control" id="editPersonCount" min="1" placeholder="e.g. 2">
          </div>
          <div class="mb-3">
            <label for="editSpecialNotes" class="form-label">Special Notes</label>
            <textarea class="form-control" id="editSpecialNotes" rows="3" placeholder="Notes for pick-up / drop-off printout"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Update</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    setTimeout(function () {
      const script = document.createElement('script');
      script.src = '/js/pickup_drop/pickup_drop.js';
      document.body.appendChild(script);
    }, 300);
  });
</script>

