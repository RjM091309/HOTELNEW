<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title></title>
  <% const isDropoff = printType === 'dropoff'; %>
  <style>
    @page {
      size: <%= isDropoff ? 'A4 portrait' : 'A4 landscape' %>;
      margin: 0;
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      background: #fff;
      color: #000;
      font-family: Arial, Helvetica, sans-serif;
      overflow: visible;
    }

    <% if (!isDropoff) { %>
    .print-sheet {
      width: 297mm;
      height: 210mm;
      padding: 5mm 3mm 6mm;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .print-logo {
      text-align: center;
      flex-shrink: 0;
    }

    .print-logo img {
      width: 38mm;
      height: auto;
      display: block;
      margin: 0 auto;
    }

    .print-guest-name-wrap {
      flex: 1;
      width: 100%;
      min-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      overflow: visible;
    }

    .print-guest-name {
      width: 100%;
      max-width: 100%;
      text-align: center;
      font-weight: 700;
      line-height: 1.08;
      letter-spacing: -0.02em;
      white-space: nowrap;
      word-break: normal;
      overflow-wrap: normal;
      overflow: visible;
      font-size: 28px;
    }

    .print-guest-name .name-line {
      display: block;
      white-space: nowrap;
    }

    .print-guest-name .name-line + .name-line {
      margin-top: 0.06em;
    }

    .print-footer {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 12mm;
      font-size: 24px;
      line-height: 1.45;
      margin-top: auto;
      padding: 0 14mm;
      flex-shrink: 0;
    }

    .print-footer-left,
    .print-footer-right {
      display: flex;
      flex-direction: column;
    }

    .print-footer-right {
      text-align: right;
      margin-left: auto;
    }

    .print-footer-left div + div,
    .print-footer-right div + div {
      margin-top: 4px;
    }
    <% } else { %>
    .print-sheet {
      width: 210mm;
      height: 297mm;
      padding: 12mm 14mm 10mm;
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    .print-logo {
      text-align: center;
      flex-shrink: 0;
      margin-bottom: 20mm;
    }

    .print-logo img {
      width: 48mm;
      height: auto;
      display: block;
      margin: 0 auto;
    }

    .dropoff-details {
      display: grid;
      grid-template-columns: max-content 1fr;
      column-gap: 14mm;
      row-gap: 5mm;
      align-items: baseline;
      text-align: left;
      font-weight: 700;
      font-size: 30px;
      line-height: 1.35;
    }

    .dropoff-label {
      white-space: nowrap;
    }

    .dropoff-value {
      word-break: break-word;
      overflow-wrap: break-word;
    }

    .dropoff-special-notes {
      margin-top: 38mm;
      font-size: 30px;
      font-weight: 700;
      text-align: left;
    }

    .dropoff-notes-area {
      margin-top: 5mm;
      min-height: 0;
      font-size: 30px;
      font-weight: 700;
      line-height: 1.35;
      text-align: left;
      white-space: pre-wrap;
      word-break: break-word;
      overflow-wrap: break-word;
    }
    <% } %>

    @media print {
      @page {
        size: <%= isDropoff ? 'A4 portrait' : 'A4 landscape' %>;
        margin: 0;
      }

      html, body {
        margin: 0 !important;
        padding: 0 !important;
        overflow: visible !important;
      }

      .print-sheet {
        position: relative;
        top: auto;
        left: auto;
        margin: 0;
        page-break-after: always;
        break-after: page;
        page-break-inside: avoid;
        break-inside: avoid;
      }

      .print-sheet:last-child {
        page-break-after: auto;
        break-after: auto;
      }
    }
  </style>
</head>
<body>
  <% records.forEach(function (record, index) { %>
  <div class="print-sheet" data-sheet-index="<%= index %>">
    <div class="print-logo">
      <img src="/img/Logo-Black.png" alt="Main Stay Hotel">
    </div>

    <% if (isDropoff) { %>
    <div class="dropoff-details">
      <span class="dropoff-label">Name</span>
      <span class="dropoff-value print-guest-name" id="printGuestName-<%= index %>"><%= record.guestName %></span>
      <span class="dropoff-label">Flight No.</span>
      <span class="dropoff-value"><%= record.flightNo %></span>
      <span class="dropoff-label">No. Persons</span>
      <span class="dropoff-value"><%= record.personCount %></span>
      <% if (typeof vehicleName !== 'undefined' && vehicleName) { %>
      <span class="dropoff-label">Vehicle</span>
      <span class="dropoff-value"><%= vehicleName %><% if (plateNumber) { %> (<%= plateNumber %>)<% } %></span>
      <% } %>
      <% if (typeof driverName !== 'undefined' && driverName) { %>
      <span class="dropoff-label">Driver</span>
      <span class="dropoff-value"><%= driverName %></span>
      <% } %>
    </div>
    <div class="dropoff-special-notes">Special Notes</div>
    <div class="dropoff-notes-area"><%= record.specialNotes %></div>
    <% } else { %>
    <div class="print-guest-name-wrap">
      <div class="print-guest-name" id="printGuestName-<%= index %>" data-name="<%= record.guestName %>"><%= record.guestName %></div>
    </div>
    <div class="print-footer">
      <div class="print-footer-left">
        <% if (typeof vehicleName !== 'undefined' && vehicleName) { %>
        <div>Vehicle: <%= vehicleName %><% if (plateNumber) { %> (<%= plateNumber %>)<% } %></div>
        <% } %>
        <% if (typeof driverName !== 'undefined' && driverName) { %>
        <div>Driver: <%= driverName %></div>
        <% } %>
      </div>
      <div class="print-footer-right">
        <div>No. of Persons: <%= record.personCount %></div>
        <div>Flight no.: <%= record.flightNo %></div>
      </div>
    </div>
    <% } %>
  </div>
  <% }); %>
  <script src="/js/pickup_drop/roman-to-hangul.js"></script>
  <script>
    document.title = '';

    const isDropoffPrint = <%= isDropoff ? 'true' : 'false' %>;

    // Split "김민지 (TINA HWANG)" -> ["김민지", "TINA HWANG"] (Korean line first).
    function splitGuestName(raw) {
      var s = (raw || '').trim();
      var korean = (s.match(/[가-힣㄰-㆏ᄀ-ᇿ][가-힣㄰-㆏ᄀ-ᇿ\s]*/g) || [])
        .join(' ').replace(/\s+/g, ' ').trim();
      var english = s.replace(/[가-힣㄰-㆏ᄀ-ᇿ]+/g, ' ')
        .replace(/[()\[\]]/g, ' ')
        .replace(/\s+/g, ' ').trim();
      var lines = [];
      if (korean) lines.push(korean);
      if (english) lines.push(english);
      if (!lines.length) lines.push(s);
      return lines;
    }

    function esc(t) {
      return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // Korean line first, English below. Transliterate a Korean line from the
    // romanization when only a romanized name exists (approximate).
    function buildNameLines(raw) {
      var lines = splitGuestName(raw);
      if (lines.length === 1 && /[A-Za-z]/.test(lines[0]) && window.RomanToHangul) {
        var kr = window.RomanToHangul.name(lines[0]);
        if (kr) lines = [kr, lines[0]];
      }
      return lines.map(function (t) {
        return '<div class="name-line">' + esc(t) + '</div>';
      }).join('');
    }

    function fitGuestNameForSheet(sheet) {
      if (!sheet || isDropoffPrint) return;

      var el = sheet.querySelector('.print-guest-name');
      var wrap = sheet.querySelector('.print-guest-name-wrap');
      if (!el || !wrap) return;

      el.innerHTML = buildNameLines(el.getAttribute('data-name') || el.textContent);

      var maxW = wrap.clientWidth;
      var maxH = wrap.clientHeight;
      var lo = 12, hi = 460, best = 12;

      while (lo <= hi) {
        var mid = (lo + hi) >> 1;
        el.style.fontSize = mid + 'px';
        var widest = 0;
        el.querySelectorAll('.name-line').forEach(function (n) { widest = Math.max(widest, n.scrollWidth); });
        if (widest <= maxW + 1 && el.scrollHeight <= maxH + 2) { best = mid; lo = mid + 1; }
        else { hi = mid - 1; }
      }
      el.style.fontSize = best + 'px';
    }

    function fitGuestName() {
      document.querySelectorAll('.print-sheet').forEach(fitGuestNameForSheet);
    }

    window.fitGuestName = fitGuestName;

    function runPrintSetup() {
      fitGuestName();

      <% if (!embed) { %>
      setTimeout(function () {
        window.focus();
        window.print();
      }, 200);
      <% } %>
    }

    window.addEventListener('load', runPrintSetup);
    window.addEventListener('resize', fitGuestName);

    <% if (!embed) { %>
    window.addEventListener('afterprint', function () {
      window.close();
    });
    <% } %>
  </script>
</body>
</html>
