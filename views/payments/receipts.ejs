<div class="row">
  <div class="col-xl-12 col-md-12 col-12">
    <div class="dashboard-card">
      <div class="dashboard-card-header">
        <header>Receipt</header>
        <div class="tools">
          <button type="button" class="btn btn-secondary btn-sm" id="printSelectedReceiptsBtn" title="Print selected receipts" style="display: none;">
            <i class="fa fa-print"></i> Print
          </button>
          <button type="button" class="btn btn-primary-10 btn-sm" id="addReceiptBtn">
            <i class="fa fa-plus"></i> Add Receipt
          </button>
        </div>
      </div>
      <div class="dashboard-card-body">
        <div class="table-scrollable">
          <table id="receiptsTable" class="table table-hover table-bordered full-width">
            <thead>
              <tr>
                <th class="receipt-select-col text-center">
                  <input type="checkbox" id="receiptSelectAll" title="Select all" aria-label="Select all receipts">
                </th>
                <th>Received From</th>
                <th>Room No.</th>
                <th>Date</th>
                <th>Amount</th>
                <th>Payment Method</th>
                <th>Received By</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="addReceiptModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Receipt</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="addReceiptForm">
        <div class="modal-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="addReceivedFrom" class="form-label">Received From</label>
              <div class="receipt-guest-search-wrap">
                <input type="text" class="form-control" id="addReceivedFrom" autocomplete="off" required>
                <div id="addReceivedFromResults" class="receipt-guest-search-results"></div>
              </div>
              <small class="text-muted">Search booked guests — room no. auto-fills when assigned</small>
            </div>
            <div class="col-md-6 mb-3">
              <label for="addRoomNo" class="form-label">Room No.</label>
              <input type="text" class="form-control" id="addRoomNo" placeholder="e.g. 324" required>
            </div>
            <div class="col-md-6 mb-3">
              <label for="addReceiptDate" class="form-label">Date</label>
              <div class="receipt-date-wrap">
                <input type="text" class="form-control receipt-date-input" id="addReceiptDate" placeholder="Select date" required autocomplete="off">
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <label for="addAmountPaid" class="form-label">Amount Paid (PHP)</label>
              <input type="number" class="form-control" id="addAmountPaid" min="0" step="0.01" required>
            </div>
            <div class="col-md-6 mb-3">
              <label for="addPaymentMethod" class="form-label">Payment Method</label>
              <select class="form-control" id="addPaymentMethod" required>
                <option value="cash">Cash</option>
                <option value="credit">Credit</option>
                <option value="other">Others</option>
              </select>
            </div>
            <div class="col-md-6 mb-3" id="addPaymentMethodOtherWrap" style="display:none;">
              <label for="addPaymentMethodOther" class="form-label">Other Payment Method</label>
              <input type="text" class="form-control" id="addPaymentMethodOther" placeholder="e.g. GCash">
            </div>
            <div class="col-md-6 mb-3">
              <label for="addReceivedBy" class="form-label">Received By</label>
              <input type="text" class="form-control" id="addReceivedBy" placeholder="Staff name">
            </div>
            <div class="col-md-12 mb-3">
              <label for="addPurpose" class="form-label">Purpose of Payment</label>
              <textarea class="form-control" id="addPurpose" rows="3" placeholder="e.g. Room payment, deposit, etc."></textarea>
            </div>
            <div class="col-md-12">
              <small class="text-muted"><i class="fa fa-pencil"></i> Signature is not entered digitally — it will be left blank on print for handwritten signing.</small>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="editReceiptModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Receipt</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editReceiptForm">
        <input type="hidden" id="editReceiptId">
        <div class="modal-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="editReceivedFrom" class="form-label">Received From</label>
              <div class="receipt-guest-search-wrap">
                <input type="text" class="form-control" id="editReceivedFrom" autocomplete="off" required>
                <div id="editReceivedFromResults" class="receipt-guest-search-results"></div>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <label for="editRoomNo" class="form-label">Room No.</label>
              <input type="text" class="form-control" id="editRoomNo" required>
            </div>
            <div class="col-md-6 mb-3">
              <label for="editReceiptDate" class="form-label">Date</label>
              <div class="receipt-date-wrap">
                <input type="text" class="form-control receipt-date-input" id="editReceiptDate" placeholder="Select date" required autocomplete="off">
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <label for="editAmountPaid" class="form-label">Amount Paid (PHP)</label>
              <input type="number" class="form-control" id="editAmountPaid" min="0" step="0.01" required>
            </div>
            <div class="col-md-6 mb-3">
              <label for="editPaymentMethod" class="form-label">Payment Method</label>
              <select class="form-control" id="editPaymentMethod" required>
                <option value="cash">Cash</option>
                <option value="credit">Credit</option>
                <option value="other">Others</option>
              </select>
            </div>
            <div class="col-md-6 mb-3" id="editPaymentMethodOtherWrap" style="display:none;">
              <label for="editPaymentMethodOther" class="form-label">Other Payment Method</label>
              <input type="text" class="form-control" id="editPaymentMethodOther">
            </div>
            <div class="col-md-6 mb-3">
              <label for="editReceivedBy" class="form-label">Received By</label>
              <input type="text" class="form-control" id="editReceivedBy">
            </div>
            <div class="col-md-12 mb-3">
              <label for="editPurpose" class="form-label">Purpose of Payment</label>
              <textarea class="form-control" id="editPurpose" rows="3"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Update</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  window.defaultReceiptReceivedBy = '<%= (defaultReceivedBy || "").replace(/'/g, "\\'") %>';
  document.addEventListener('DOMContentLoaded', function () {
    setTimeout(function () {
      const script = document.createElement('script');
      script.src = '/js/payments/receipts.js';
      document.body.appendChild(script);
    }, 300);
  });
</script>

