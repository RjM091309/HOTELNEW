  .pm-bank_transfer { background: rgba(120,144,156,.20); color: #b0bec5; border-color: rgba(120,144,156,.5); }
  .pm-agoda         { background: rgba(171,71,188,.18);  color: #ce93d8; border-color: rgba(171,71,188,.5); }
  .pm-expedia       { background: rgba(236,64,122,.18);  color: #f48fb1; border-color: rgba(236,64,122,.5); }
