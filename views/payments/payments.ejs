<!-- Payment Management -->
<div class="dashboard-card">
  <div class="dashboard-card-header">
    <div style="display:flex;justify-content:space-between;align-items:center;width:100%">
        <div class="tab-bar">
          <header style="display:inline-block; white-space: nowrap;">Payment Management</header> 
      </div>
      <div style="display:flex; align-items:center; justify-content: center; width:100%; margin-bottom: 12px;">
        <div class="filter-btn-group">
          <button type="button" class="filter-btn active" data-filter="all">All</button>
          <button type="button" class="filter-btn" data-filter="today">Today</button>
          <button type="button" class="filter-btn" data-filter="last3days">Last 3 Days</button>
          <button type="button" class="filter-btn" data-filter="thisWeek">This Week</button>
          <button type="button" class="filter-btn" data-filter="thisMonth">This Month</button>
        </div>
      </div>
    </div>
  </div>
  <div class="dashboard-card-body">
   
    <!-- Sales Summary Cards -->
    <div class="payment-sales-summary-grid">
      <div class="payment-sales-card payment-sales-card--daily">
        <div class="payment-sales-card__title"><i class="fas fa-calendar-day"></i> Daily Sales</div>
        <div class="payment-sales-card__stats">
          <div>
            <div class="payment-sales-card__value payment-sales-card__value--total" id="daily-total">0</div>
            <div class="payment-sales-card__label">Total</div>
          </div>
          <div>
            <div class="payment-sales-card__value payment-sales-card__value--paid sales-paid-clickable" id="daily-paid" role="button" title="View today's paid payments">0</div>
            <div class="payment-sales-card__label">Paid</div>
          </div>
          <div>
            <div class="payment-sales-card__value payment-sales-card__value--unpaid" id="daily-unpaid">0</div>
            <div class="payment-sales-card__label">Unpaid</div>
          </div>
        </div>
        <div class="payment-sales-card__footer" id="daily-sales-breakdown"></div>
      </div>

      <div class="payment-sales-card payment-sales-card--weekly">
        <div class="payment-sales-card__title"><i class="fas fa-calendar-week"></i> Weekly Sales</div>
        <div class="payment-sales-card__stats">
          <div>
            <div class="payment-sales-card__value payment-sales-card__value--total" id="weekly-total">0</div>
            <div class="payment-sales-card__label">Total</div>
          </div>
          <div>
            <div class="payment-sales-card__value payment-sales-card__value--paid" id="weekly-paid">0</div>
            <div class="payment-sales-card__label">Paid</div>
          </div>
          <div>
            <div class="payment-sales-card__value payment-sales-card__value--unpaid" id="weekly-unpaid">0</div>
            <div class="payment-sales-card__label">Unpaid</div>
          </div>
        </div>
        <div class="payment-sales-card__footer" aria-hidden="true">&nbsp;</div>
      </div>

      <div class="payment-sales-card payment-sales-card--monthly">
        <div class="payment-sales-card__title"><i class="fas fa-calendar-alt"></i> Monthly Sales</div>
        <div class="payment-sales-card__stats">
          <div>
            <div class="payment-sales-card__value payment-sales-card__value--total" id="monthly-total">0</div>
            <div class="payment-sales-card__label">Total</div>
          </div>
          <div>
            <div class="payment-sales-card__value payment-sales-card__value--paid" id="monthly-paid">0</div>
            <div class="payment-sales-card__label">Paid</div>
          </div>
          <div>
            <div class="payment-sales-card__value payment-sales-card__value--unpaid" id="monthly-unpaid">0</div>
            <div class="payment-sales-card__label">Unpaid</div>
          </div>
        </div>
        <div class="payment-sales-card__footer" aria-hidden="true">&nbsp;</div>
      </div>
    </div>

    <div class="table-scrollable">
      <table id="payments_tbl" class="table table-hover table-bordered full-width">
        <thead>
          <tr>
            <th style="display:none"></th>
            <th style="display:none"></th>
            <th style="text-align: center;">#</th>
            <th style="text-align: center;">GUEST NAME</th>
            <th style="text-align: center;">ROOM NUMBER</th>
            <th style="text-align: center;">CONFIRMATION NUMBER</th>
            <th style="text-align: center;">TOTAL AMOUNT</th>
            <th style="text-align: center;">PAID</th>
            <th style="text-align: center;">AMOUNT PAID</th>
            <th style="text-align: center;">BALANCE</th>
            <th style="text-align: center;">PAYMENT STATUS</th>
            <th style="text-align: center;">PAYMENT METHOD</th>
            <th style="text-align: center;">PAYMENT DATE</th>
            <th style="text-align: center;">PROCESSED BY</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<!-- Breakdown Modal -->
<div class="modal fade" id="breakdownModal" tabindex="-1" role="dialog" aria-labelledby="breakdownModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="breakdownModalLabel">Payment Breakdown</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body"><div id="breakdownContent" class="p-2"></div></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" id="printBreakdownBtn" style="display:none;" onclick="printBreakdownReceipt()">
          <i class="fa fa-print"></i> Print Receipt
        </button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Today's Paid Payments Modal -->
<div class="modal fade" id="todayPaidModal" tabindex="-1" role="dialog" aria-labelledby="todayPaidModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <div class="d-flex align-items-start justify-content-between w-100 flex-wrap gap-2">
          <h5 class="modal-title mb-0" id="todayPaidModalLabel">Paid Payments</h5>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="todayPaidContent" class="p-2"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    let currentFilter = 'all';
    let table = $('#payments_tbl').DataTable({
      rowId: 'BOOKING_ID',
      processing: true,
      serverSide: true,
      ajax: { 
        url: '/payments/payments_data', 
        type: 'GET',
        data: function(d){ d.filter = currentFilter; },
        error: function (_xhr, status, err) {
          console.error('Payments table load failed:', status, err);
        }
      },
      columns: [
        { data: 'BOOKING_ID', visible: false },
        { data: 'LAST_PAYMENT_ID', visible: false },
        { data: null, orderable: false, searchable: false, className: 'center' },
        { data: 'GUEST_NAME', className: 'center' },
        { data: 'ROOM_NUMBER', className: 'center' },
        { data: 'CONFIRMATION_NUMBER', className: 'center', render: function(data, type, row){
            return `<a href="#" class="confirmation-link" data-booking-id="${row.BOOKING_ID}" style="color:#007bff;text-decoration:underline;cursor:pointer;">${data}</a>`;
          }
        },
        { data: 'TOTAL_AMOUNT', className: 'center', render: d => '' + Number(d||0).toLocaleString('en-US', { maximumFractionDigits: 0 }) },
        { data: 'TOTAL_PAID', className: 'center', render: d => '' + Number(d||0).toLocaleString('en-US', { maximumFractionDigits: 0 }) },
        { data: 'LAST_PAYMENT_AMOUNT', className: 'center', render: d => '' + Number(d || 0).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) },
        { data: 'BALANCE', className: 'center', render: d => '' + Number(d||0).toLocaleString('en-US', { maximumFractionDigits: 0 }) },
        { data: null, className: 'center', render: function(_d,_t,row){
            const balance = parseFloat(row.BALANCE)||0;
            const method = (row.PAYMENT_METHOD || '').toLowerCase();
            const isOnCredit = (method === 'credit' || method === 'marker') && !!row.HAS_UNSETTLED_CREDIT;
            if (balance <= 0 && isOnCredit) return '<span class="label label-info">Credit</span>';
            if (balance <= 0) return '<span class="label label-success">Paid</span>';
            if (balance < parseFloat(row.TOTAL_AMOUNT)) return '<span class="label label-warning">Partial</span>';
            return '<span class="label label-danger">Unpaid</span>';
          }
        },
        { data: null, className: 'center', render: function(_d,_t,row){
            const methodLabels = { cash: 'Cash', credit_card: 'Credit Card', credit: 'Credit', marker: 'Credit', bank_transfer: 'Bank Transfer', korean_bank: 'Korean Bank', agoda: 'AGODA', expedia: 'EXPEDIA' };
            const method = (row.PAYMENT_METHOD || '').toLowerCase();
            const label = methodLabels[method] || row.PAYMENT_METHOD || 'N/A';
            const key = (method === 'marker') ? 'credit' : (methodLabels[method] ? method : 'other');
            return `<span class="pm-badge pm-${key}">${label}</span>`;
          }
        },
        { 
          data: 'LAST_PAYMENT_DATE', 
          className: 'center', 
          render: d => d ? new Date(d).toLocaleString('en-US') : '' 
        },
        { 
          data: 'PROCESSED_BY_NAME', 
          className: 'center',
          render: d => d || ''
        }
      ],
      order: [[1, 'desc']],
      language: { emptyTable: 'No data available in the table.' }
    });

    table.on('draw.dt', function(){
      table.column(2, { search: 'applied', order: 'applied' }).nodes().each(function(cell, i){ cell.innerHTML = i + 1; });
    });

    $('.dashboard-card .filter-btn-group .filter-btn').on('click', function(){
      $('.dashboard-card .filter-btn-group .filter-btn').removeClass('active');
      $(this).addClass('active');
      currentFilter = $(this).data('filter');
      table.ajax.reload();
      if (typeof updateSummaryCardsForFilter === 'function') {
        updateSummaryCardsForFilter(currentFilter);
      }
    });
  });

  function loadSalesSummary(){
    fetch('/payments/sales-summary')
      .then(r => r.json())
      .then(data => {
        if(!data.success) return;
        document.getElementById('daily-total').textContent = '' + Number(data.dailyTotal||0).toLocaleString('en-US');
        document.getElementById('daily-paid').textContent = '' + Number(data.dailyPaid||0).toLocaleString('en-US');
        document.getElementById('daily-unpaid').textContent = '' + Number(data.dailyUnpaid||0).toLocaleString('en-US');
        const bookingPaid = Number(data.dailyBookingPaid || 0).toLocaleString('en-US');
        const receiptPaid = Number(data.dailyReceiptPaid || 0).toLocaleString('en-US');
        document.getElementById('daily-sales-breakdown').textContent =
          `Bookings: ${bookingPaid} · Receipts: ${receiptPaid}`;
        document.getElementById('weekly-total').textContent = '' + Number(data.weeklyTotal||0).toLocaleString('en-US');
        document.getElementById('weekly-paid').textContent = '' + Number(data.weeklyPaid||0).toLocaleString('en-US');
        document.getElementById('weekly-unpaid').textContent = '' + Number(data.weeklyUnpaid||0).toLocaleString('en-US');
        document.getElementById('monthly-total').textContent = '' + Number(data.monthlyTotal||0).toLocaleString('en-US');
        document.getElementById('monthly-paid').textContent = '' + Number(data.monthlyPaid||0).toLocaleString('en-US');
        document.getElementById('monthly-unpaid').textContent = '' + Number(data.monthlyUnpaid||0).toLocaleString('en-US');
      })
      .catch(err => console.error('Error loading sales summary:', err));
  }
  loadSalesSummary();

  /* ----------------------------------------------------------------------
   * Shift view for the summary cards.
   * When the top "Today" filter is active the 3 summary cards switch from
   * Daily / Weekly / Monthly sales to Shift 1 / Shift 2 / Shift 3, each
   * showing that shift's collected sales for today (Total / Cash / Non-cash).
   * Shift windows are gapless so the three cards always sum to the day total:
   *   Shift 1  7AM – 1PM   (hour 7..12)
   *   Shift 2  1PM – 10PM  (hour 13..21)
   *   Shift 3  10PM – 7AM  (hour 22..23, 0..6)
   * -------------------------------------------------------------------- */
  const SUMMARY_CARDS = [
    { sel: '.payment-sales-card--daily',   shift: 1, title: 'Shift 1 (7AM–1PM)',  icon: 'fa-sun',          ids: ['daily-total', 'daily-paid', 'daily-unpaid'] },
    { sel: '.payment-sales-card--weekly',  shift: 2, title: 'Shift 2 (1PM–10PM)', icon: 'fa-cloud-sun',    ids: ['weekly-total', 'weekly-paid', 'weekly-unpaid'] },
    { sel: '.payment-sales-card--monthly', shift: 3, title: 'Shift 3 (10PM–7AM)', icon: 'fa-moon',         ids: ['monthly-total', 'monthly-paid', 'monthly-unpaid'] }
  ];
  const SHIFT_STAT_LABELS = ['Total', 'Cash', 'Non-cash'];
  let summaryMode = 'default';
  let originalCardMarkup = null;

  function shiftOfHour(h) {
    if (h >= 7 && h < 13) return 1;
    if (h >= 13 && h < 22) return 2;
    return 3; // 22..23 and 0..6
  }

  function formatShiftMoney(val) {
    return Number(val || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function captureOriginalCardMarkup() {
    if (originalCardMarkup) return;
    originalCardMarkup = {};
    SUMMARY_CARDS.forEach(function (c) {
      const card = document.querySelector(c.sel);
      if (!card) return;
      const footer = card.querySelector('.payment-sales-card__footer');
      originalCardMarkup[c.sel] = {
        title: card.querySelector('.payment-sales-card__title').innerHTML,
        labels: Array.prototype.map.call(card.querySelectorAll('.payment-sales-card__label'), function (l) { return l.innerHTML; }),
        footer: footer ? footer.innerHTML : null
      };
    });
  }

  function restoreDefaultSummaryCards() {
    SUMMARY_CARDS.forEach(function (c) {
      const card = document.querySelector(c.sel);
      const orig = originalCardMarkup && originalCardMarkup[c.sel];
      if (!card || !orig) return;
      card.querySelector('.payment-sales-card__title').innerHTML = orig.title;
      const labels = card.querySelectorAll('.payment-sales-card__label');
      Array.prototype.forEach.call(labels, function (l, i) {
        if (orig.labels[i] !== undefined) l.innerHTML = orig.labels[i];
      });
      const footer = card.querySelector('.payment-sales-card__footer');
      if (footer && orig.footer !== null) footer.innerHTML = orig.footer;
      card.classList.remove('payment-sales-card--shift');
      delete card.dataset.shift;
    });
    summaryMode = 'default';
    loadSalesSummary();
  }

  function applyShiftSummaryCards() {
    summaryMode = 'shift';
    SUMMARY_CARDS.forEach(function (c) {
      const card = document.querySelector(c.sel);
      if (!card) return;
      card.querySelector('.payment-sales-card__title').innerHTML =
        '<i class="fas ' + c.icon + '"></i> ' + c.title;
      const labels = card.querySelectorAll('.payment-sales-card__label');
      Array.prototype.forEach.call(labels, function (l, i) {
        if (SHIFT_STAT_LABELS[i]) l.textContent = SHIFT_STAT_LABELS[i];
      });
      const footer = card.querySelector('.payment-sales-card__footer');
      if (footer) footer.textContent = '';
      card.classList.add('payment-sales-card--shift');
      card.dataset.shift = String(c.shift);
      c.ids.forEach(function (id) {
        const el = document.getElementById(id);
        if (el) el.textContent = '…';
      });
    });
    loadShiftSummary();
  }

  function updateSummaryCardsForFilter(filter) {
    captureOriginalCardMarkup();
    if (filter === 'today') {
      applyShiftSummaryCards();
    } else if (summaryMode === 'shift') {
      restoreDefaultSummaryCards();
    }
  }
  window.updateSummaryCardsForFilter = updateSummaryCardsForFilter;

  function loadShiftSummary() {
    fetch('/payments/today-paid?range=today')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data || !data.success || summaryMode !== 'shift') return;
        const rows = [].concat(data.payments || [], data.receipts || []);
        const buckets = { 1: { total: 0, cash: 0, noncash: 0 }, 2: { total: 0, cash: 0, noncash: 0 }, 3: { total: 0, cash: 0, noncash: 0 } };
        rows.forEach(function (row) {
          if (!row.PAYMENT_DATE) return;
          const amt = Number(row.AMOUNT_PAID || 0);
          if (!amt) return;
          const bucket = buckets[shiftOfHour(new Date(row.PAYMENT_DATE).getHours())];
          const isCash = String(row.PAYMENT_METHOD || '').trim().toLowerCase() === 'cash';
          bucket.total += amt;
          if (isCash) bucket.cash += amt; else bucket.noncash += amt;
        });
        SUMMARY_CARDS.forEach(function (c) {
          const b = buckets[c.shift];
          const vals = [b.total, b.cash, b.noncash];
          c.ids.forEach(function (id, i) {
            const el = document.getElementById(id);
            if (el) el.textContent = formatShiftMoney(vals[i]);
          });
        });
      })
      .catch(function (err) { console.error('Error loading shift summary:', err); });
  }

  let currentPaidRange = 'today';
  let currentPaidShift = 'all';
  let loadedPaidData = null;
  let currentBreakdownBookingId = null;

  function resetPaidShift() {
    currentPaidShift = 'all';
  }

  // The whole Daily Sales card opens the collected-sales modal (all of today).
  $(document).on('click', '.payment-sales-card--daily', function () {
    if (summaryMode === 'shift') return; // handled by the shift-card handler below
    currentPaidRange = 'today';
    resetPaidShift();
    showTodayPaidModal('today');
  });

  // In "Today" (shift) mode each card opens the Collected Sales modal scoped to its shift.
  $(document).on('click', '.payment-sales-card--shift', function () {
    const shift = String(this.dataset.shift || '');
    if (!shift) return;
    currentPaidRange = 'today';
    currentPaidShift = shift;
    showTodayPaidModal('today');
  });

  $(document).on('click', '.confirmation-link', function(e){
    e.preventDefault();
    const bookingId = $(this).data('booking-id');
    showBreakdownModal(bookingId);
  });

  function showBreakdownModal(bookingId){
    currentBreakdownBookingId = bookingId;
    $('#printBreakdownBtn').hide();
    $('#breakdownModal').modal('show');
    $('#breakdownContent').html('<div class="text-center"><div class="spinner-border" role="status"><span class="sr-only">Loading...</span></div></div>');
    fetch(`/payments/breakdown/${bookingId}`)
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          displayBreakdown(data);
          $('#printBreakdownBtn').show();
        } else {
          $('#breakdownContent').html(`<div class="alert alert-danger"><strong>Error:</strong> ${data.message}</div>`);
        }
      })
      .catch(() => $('#breakdownContent').html('<div class="alert alert-danger"><strong>Error:</strong> Failed to load breakdown data</div>'));
  }

  function displayBreakdown(data){
    const booking = data.booking;
    const services = data.services;
    const extensions = data.extensions;
    const payments = data.payments;

    let html = `
      <div class="row mb-3">
        <div class="col-md-6">
          <h6><strong>Guest:</strong> ${booking.GUEST_NAME}</h6>
          <h6><strong>Room:</strong> ${booking.ROOM_NUMBER} (${booking.ROOM_TYPE})</h6>
        </div>
        <div class="col-md-6">
          <h6><strong>Confirmation:</strong> ${booking.CONFIRMATION_NUMBER}</h6>
          <h6><strong>Booking ID:</strong> ${booking.BOOKING_ID}</h6>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-bordered">
          <thead class="table-dark"><tr><th>Item</th><th class="text-right">Amount</th></tr></thead>
          <tbody>
            <tr>
              <td><strong>Room Charges</strong><br><small class="text-muted">${booking.ROOM_TYPE} × ${booking.QTY} days @ ${Number(booking.ROOM_CHARGE||0).toLocaleString()}</small></td>
              <td class="text-right"><strong>${Number(booking.ROOM_TOTAL||0).toLocaleString()}</strong></td>
            </tr>`;

    if (booking.AMENITIES_CHARGE > 0) html += `<tr><td><strong>Amenities Charge</strong></td><td class="text-right">${Number(booking.AMENITIES_CHARGE).toLocaleString()}</td></tr>`;
    
    // Only show SERVICES_CHARGE if there are no services in booking_service table (to avoid double counting)
    if (booking.SERVICES_CHARGE > 0 && services.length === 0) {
      html += `<tr><td><strong>Services Charge</strong></td><td class="text-right">${Number(booking.SERVICES_CHARGE).toLocaleString()}</td></tr>`;
    }
    
    if (booking.LATE_CHECKOUT_CHARGE > 0) html += `<tr><td><strong>Late Checkout Charge</strong></td><td class="text-right">${Number(booking.LATE_CHECKOUT_CHARGE).toLocaleString()}</td></tr>`;
    
    // Check if there's a cancellation fee service in the services list
    const hasCancellationFeeService = services.some(s => {
      const serviceName = (s.SERVICE_NAME || '').toLowerCase();
      return serviceName.includes('cancellation') || serviceName.includes('cancel');
    });
    
    // Only show CANCELLATION_PENALTY if there's no cancellation fee service already in services
    if (booking.CANCELLATION_PENALTY > 0 && !hasCancellationFeeService) {
      html += `<tr><td><strong>Cancellation Penalty</strong></td><td class="text-right">${Number(booking.CANCELLATION_PENALTY).toLocaleString()}</td></tr>`;
    }

    if (services.length > 0) {
      html += `<tr><td colspan="2"><strong>Additional Services:</strong></td></tr>`;
      services.forEach(s => { html += `<tr><td style="padding-left:30px;"><small>${s.SERVICE_NAME} × ${s.QTY}</small></td><td class="text-right">${Number(s.TOTAL_COST).toLocaleString()}</td></tr>`; });
    }

    if (extensions.length > 0) {
      html += `<tr><td colspan="2"><strong>Room Extensions:</strong></td></tr>`;
      extensions.forEach(x => { html += `<tr><td style="padding-left:30px;"><small>Extension on ${new Date(x.EXTEND_DATE).toLocaleDateString()} × ${x.QTY} days</small></td><td class="text-right">${Number(x.COST).toLocaleString()}</td></tr>`; });
    }

    html += `<tr class="table-info"><td><strong>SUBTOTAL</strong></td><td class="text-right"><strong>${Number(booking.TOTAL_AMOUNT).toLocaleString()}</strong></td></tr>`;
    if (booking.RESERVATION_FEE > 0) html += `<tr><td><strong>Reservation Fee</strong></td><td class="text-right">${Number(booking.RESERVATION_FEE).toLocaleString()}</td></tr>`;
    if (booking.DISCOUNT_AMOUNT > 0) html += `<tr class="table-success"><td><strong>Discount Applied</strong></td><td class="text-right"><strong>-${Number(booking.DISCOUNT_AMOUNT).toLocaleString()}</strong></td></tr>`;
    html += `<tr class="table-warning"><td><strong>TOTAL PAID</strong></td><td class="text-right"><strong>${Number(booking.TOTAL_PAID).toLocaleString()}</strong></td></tr>`;
    html += `<tr class="table-danger"><td><strong>BALANCE</strong></td><td class="text-right"><strong>${Number(booking.BALANCE).toLocaleString()}</strong></td></tr>`;
    html += `</tbody></table></div>`;

    if (payments.length > 0) {
      html += `
        <h6 class="mt-4"><strong>Payment History:</strong></h6>
        <div class="table-responsive">
          <table class="table table-sm" id="breakdownPaymentHistoryTable">
            <thead>
              <tr>
                <th class="text-center" style="width:40px;">
                  <input type="checkbox" id="breakdownSelectAllPayments" checked title="Select all">
                </th>
                <th>Date</th>
                <th>Type</th>
                <th>Method</th>
                <th class="text-right">Amount</th>
                <th>Processed by</th>
              </tr>
            </thead>
            <tbody>`;
      const methodLabels = { cash: 'Cash', credit_card: 'Credit Card', credit: 'Credit', marker: 'Credit', bank_transfer: 'Bank Transfer', korean_bank: 'Korean Bank', agoda: 'AGODA', expedia: 'EXPEDIA' };
      payments.forEach(p => {
        const methodLabel = methodLabels[(p.PAYMENT_METHOD || '').toLowerCase()] || p.PAYMENT_METHOD;
        const paymentId = p.IDNo;
        html += `
          <tr>
            <td class="text-center">
              <input type="checkbox" class="breakdown-payment-check" value="${paymentId}" checked>
            </td>
            <td>${new Date(p.PAYMENT_DATE).toLocaleString()}</td>
            <td>${p.PAYMENT_TYPE}</td>
            <td>${methodLabel}</td>
            <td class="text-right">${Number(p.AMOUNT_PAID).toLocaleString()}</td>
            <td>${p.NAME || '-'}</td>
          </tr>`;
      });
      html += `</tbody></table></div>`;
    }

    $('#breakdownContent').html(html);

    $('#breakdownSelectAllPayments').on('change', function () {
      const isChecked = $(this).is(':checked');
      $('.breakdown-payment-check').prop('checked', isChecked);
    });

    $(document).off('change.breakdownPaymentCheck').on('change.breakdownPaymentCheck', '.breakdown-payment-check', function () {
      const total = $('.breakdown-payment-check').length;
      const checked = $('.breakdown-payment-check:checked').length;
      $('#breakdownSelectAllPayments').prop('checked', total > 0 && checked === total);
    });
  }

  function getSelectedBreakdownPaymentIds() {
    return $('.breakdown-payment-check:checked').map(function () {
      return $(this).val();
    }).get();
  }

  function printBreakdownReceipt() {
    if (!currentBreakdownBookingId) return;

    const selectedPaymentIds = getSelectedBreakdownPaymentIds();
    if ($('.breakdown-payment-check').length > 0 && selectedPaymentIds.length === 0) {
      Swal.fire('No selection', 'Please select at least one payment to print.', 'warning');
      return;
    }

    let printUrl = `/payments/breakdown-receipt/${currentBreakdownBookingId}?embed=1`;
    if (selectedPaymentIds.length > 0) {
      printUrl += `&paymentIds=${encodeURIComponent(selectedPaymentIds.join(','))}`;
    }

    if (typeof printPaymentReceipt === 'function') {
      printPaymentReceipt(printUrl);
      return;
    }

    window.open(printUrl.replace('embed=1', ''), '_blank');
  }

  function showTodayPaidModal(range = 'today') {
    currentPaidRange = range;
    $('#todayPaidModal').modal('show');
    loadTodayPaidPayments(range);
  }

  function loadTodayPaidPayments(range = 'today') {
    $('#todayPaidContent').html('<div class="text-center"><div class="spinner-border" role="status"><span class="sr-only">Loading...</span></div></div>');

    fetch(`/payments/today-paid?range=${encodeURIComponent(range)}`)
      .then(r => r.json())
      .then(data => {
        if (!data.success) {
          loadedPaidData = null;
          $('#todayPaidContent').html(`<div class="alert alert-danger"><strong>Error:</strong> ${data.message || 'Failed to load payments'}</div>`);
          return;
        }
        loadedPaidData = data;
        renderPaidCollections();
      })
      .catch(() => {
        loadedPaidData = null;
        $('#todayPaidContent').html('<div class="alert alert-danger"><strong>Error:</strong> Failed to load paid payments</div>');
      });
  }

  // Shift windows keyed by the hour of PAYMENT_DATE. Shift 3 wraps past midnight.
  const PAID_SHIFT_LABELS = {
    '1': 'Shift 1 (7AM–1PM)',
    '2': 'Shift 2 (1PM–10PM)',
    '3': 'Shift 3 (10PM–7AM)'
  };

  // Gapless windows: every payment hour lands in exactly one shift.
  function paidShiftPredicate(shift) {
    if (shift === '1') return h => h >= 7 && h < 13;
    if (shift === '2') return h => h >= 13 && h < 22;
    if (shift === '3') return h => h >= 22 || h < 7;
    return null; // 'all'
  }

  function filterPaidRowsByShift(rows, shift) {
    const pred = paidShiftPredicate(shift);
    if (!pred) return rows.slice();
    return rows.filter(row => {
      if (!row.PAYMENT_DATE) return false;
      const hour = new Date(row.PAYMENT_DATE).getHours();
      return pred(hour);
    });
  }

  function renderPaidCollections() {
    const data = loadedPaidData;
    if (!data) return;

    const range = data.range || 'today';
    const applyShift = range === 'today' && currentPaidShift !== 'all';

    let payments = (data.payments || []).slice().sort((a, b) => Number(b.IDNo || 0) - Number(a.IDNo || 0));
    let receipts = (data.receipts || []).slice().sort((a, b) => Number(b.IDNo || 0) - Number(a.IDNo || 0));

    if (applyShift) {
      payments = filterPaidRowsByShift(payments, currentPaidShift);
      receipts = filterPaidRowsByShift(receipts, currentPaidShift);
    }

    const paymentsTotal = payments.reduce((sum, row) => sum + Number(row.AMOUNT_PAID || 0), 0);
    const receiptsTotal = receipts.reduce((sum, row) => sum + Number(row.AMOUNT_PAID || 0), 0);
    const combinedTotal = paymentsTotal + receiptsTotal;

    const rangeLabel = range === 'last7days' ? 'Last 7 Days' : 'Today';
    const shiftLabel = applyShift ? ` – ${PAID_SHIFT_LABELS[currentPaidShift]}` : '';
    $('#todayPaidModalLabel').text(`${rangeLabel} Collected Sales${shiftLabel}`);

    if (!payments.length && !receipts.length) {
      let emptyMessage;
      if (applyShift) {
        emptyMessage = `No collections recorded for ${PAID_SHIFT_LABELS[currentPaidShift]} today.`;
      } else {
        emptyMessage = range === 'last7days'
          ? 'No collections recorded in the last 7 days.'
          : 'No collections recorded for today.';
      }
      $('#todayPaidContent').html(`<div class="alert alert-info mb-0">${emptyMessage}</div>`);
      return;
    }

    const methodLabels = { cash: 'Cash', credit_card: 'Credit Card', credit: 'Credit', marker: 'Credit', other: 'Others', bank_transfer: 'Bank Transfer', korean_bank: 'Korean Bank', agoda: 'AGODA', expedia: 'EXPEDIA' };
    let html = '';

    if (payments.length) {
      html += `<h6 class="mb-2"><strong>Booking Payments</strong> <span class="text-muted">(guest balance / billing)</span></h6>`;
      html += buildPaidCollectionTable(payments, methodLabels);
      html += `<div class="text-end mb-3"><strong>Booking Total: ${paymentsTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></div>`;
    }

    if (receipts.length) {
      html += `<h6 class="mb-2 mt-3"><strong>Standalone Receipts</strong> <span class="text-muted">(not in guest payment history)</span></h6>`;
      html += buildReceiptCollectionTable(receipts, methodLabels);
      html += `<div class="text-end mb-3"><strong>Receipt Total: ${receiptsTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></div>`;
    }

    html += `
      <div class="alert alert-success text-end mb-0">
        <strong>Combined Total: ${combinedTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong>
      </div>`;

    $('#todayPaidContent').html(html);
  }

  function buildPaidCollectionTable(payments, methodLabels) {
    const colgroup = `
      <colgroup>
        <col class="col-index">
        <col class="col-guest">
        <col class="col-room">
        <col class="col-confirmation">
        <col class="col-type">
        <col class="col-method">
        <col class="col-amount">
        <col class="col-date">
        <col class="col-processed">
      </colgroup>`;
    const headRow = `
      <tr>
        <th class="text-center">#</th>
        <th>Guest Name</th>
        <th class="text-center">Room</th>
        <th class="text-center">Confirmation</th>
        <th class="text-center">Type</th>
        <th class="text-center">Method</th>
        <th class="text-end">Amount</th>
        <th class="text-center">Payment Date</th>
        <th class="text-center">Processed By</th>
      </tr>`;

    let bodyRows = '';
    payments.forEach((payment, index) => {
      const methodLabel = methodLabels[(payment.PAYMENT_METHOD || '').toLowerCase()] || payment.PAYMENT_METHOD || 'N/A';
      bodyRows += `
        <tr>
          <td class="text-center">${index + 1}</td>
          <td>${payment.GUEST_NAME || 'N/A'}</td>
          <td class="text-center">${payment.ROOM_NUMBER || '-'}</td>
          <td class="text-center">${payment.CONFIRMATION_NUMBER || '-'}</td>
          <td class="text-center">${payment.PAYMENT_TYPE || '-'}</td>
          <td class="text-center">${methodLabel}</td>
          <td class="text-end">${Number(payment.AMOUNT_PAID || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
          <td class="text-center">${payment.PAYMENT_DATE ? new Date(payment.PAYMENT_DATE).toLocaleString('en-US') : '-'}</td>
          <td class="text-center">${payment.PROCESSED_BY_NAME || '-'}</td>
        </tr>`;
    });

    return `
      <div class="paid-payments-table-wrap mb-2">
        <table class="table table-bordered paid-payments-table paid-payments-table-head mb-0">
          ${colgroup}
          <thead class="table-dark">${headRow}</thead>
        </table>
        <div class="paid-payments-scroll">
          <table class="table table-bordered table-hover paid-payments-table paid-payments-table-body mb-0">
            ${colgroup}
            <tbody>${bodyRows}</tbody>
          </table>
        </div>
      </div>`;
  }

  function buildReceiptCollectionTable(receipts, methodLabels) {
    let bodyRows = '';
    receipts.forEach((receipt, index) => {
      const methodLabel = methodLabels[(receipt.PAYMENT_METHOD || '').toLowerCase()] || receipt.PAYMENT_METHOD || 'N/A';
      bodyRows += `
        <tr>
          <td class="text-center">${index + 1}</td>
          <td>${receipt.GUEST_NAME || 'N/A'}</td>
          <td class="text-center">${receipt.ROOM_NUMBER || '-'}</td>
          <td class="text-center">${receipt.RECEIPT_NO || '-'}</td>
          <td class="text-end">${Number(receipt.AMOUNT_PAID || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
          <td class="text-center">${methodLabel}</td>
          <td class="text-center">${receipt.PAYMENT_DATE ? new Date(receipt.PAYMENT_DATE).toLocaleString('en-US') : '-'}</td>
          <td class="text-center">${receipt.PROCESSED_BY_NAME || '-'}</td>
        </tr>`;
    });

    return `
      <div class="paid-payments-table-wrap mb-2">
        <table class="table table-bordered paid-payments-table mb-0">
          <thead class="table-secondary">
            <tr>
              <th class="text-center">#</th>
              <th>Received From</th>
              <th class="text-center">Room</th>
              <th class="text-center">Receipt No.</th>
              <th class="text-end">Amount</th>
              <th class="text-center">Method</th>
              <th class="text-center">Receipt Date</th>
              <th class="text-center">Received By</th>
            </tr>
          </thead>
          <tbody>${bodyRows}</tbody>
        </table>
      </div>`;
  }

  function syncPaidPaymentsTableLayout() {
    const wrap = document.querySelector('.paid-payments-table-wrap');
    const scroll = document.querySelector('.paid-payments-scroll');
    const headTable = document.querySelector('.paid-payments-table-head');
    const footTable = document.querySelector('.paid-payments-table-foot');
    if (!wrap || !scroll || !headTable || !footTable) return;

    const scrollbarWidth = scroll.offsetWidth - scroll.clientWidth;
    const adjustedWidth = scrollbarWidth > 0 ? `calc(100% - ${scrollbarWidth}px)` : '100%';
    headTable.style.width = adjustedWidth;
    footTable.style.width = adjustedWidth;
  }
</script>

