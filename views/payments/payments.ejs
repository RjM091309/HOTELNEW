  }

  .sales-paid-clickable {
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .sales-paid-clickable:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* Whole Daily Sales card is clickable */
  .payment-sales-card--daily {
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .payment-sales-card--daily:hover {
    border-color: #64b5f6;
    box-shadow: 0 0 0 1px #64b5f6;
  }

  /* Shift view (top "Today" filter): all three cards are clickable and share one accent */
  .payment-sales-card.payment-sales-card--shift {
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .payment-sales-card.payment-sales-card--shift:hover {
    border-color: #ce93d8;
    box-shadow: 0 0 0 1px #ce93d8;
  }

  .payment-sales-card.payment-sales-card--shift .payment-sales-card__title {
    color: #ce93d8;
  }

  /* Re-purpose the third stat slot (normally "Unpaid"/red) as "Non-cash" */
  .payment-sales-card.payment-sales-card--shift .payment-sales-card__value--unpaid {
    color: #4dd0e1;
  }

  #todayPaidModal .modal-body {
    overflow: hidden;
  }

  .paid-payments-table-wrap {
    max-height: 65vh;
    display: flex;
    flex-direction: column;
  }

  .paid-payments-table {
    width: 100%;
    table-layout: fixed;
    margin-bottom: 0;
    border-collapse: collapse;
  }

  .paid-payments-table .col-index { width: 4%; }
  .paid-payments-table .col-guest { width: 14%; }
  .paid-payments-table .col-room { width: 6%; }
  .paid-payments-table .col-confirmation { width: 13%; }
  .paid-payments-table .col-type { width: 7%; }
  .paid-payments-table .col-method { width: 7%; }
  .paid-payments-table .col-amount { width: 9%; }
  .paid-payments-table .col-date { width: 22%; }
  .paid-payments-table .col-processed { width: 8%; }

  .paid-payments-scroll {
    flex: 1;
    min-height: 0;
    max-height: calc(65vh - 96px);
    overflow-y: auto;
    overflow-x: hidden;
  }

  .paid-payments-table-head,
  .paid-payments-table-foot {
    flex-shrink: 0;
  }

  .paid-payments-table-head {
    border-bottom: 0;
  }

  .paid-payments-table-body {
    border-top: 0;
    border-bottom: 0;
  }

  .paid-payments-table-foot {
    border-top: 0;
  }

  .paid-payments-table-head th,
  .paid-payments-table-body td,
  .paid-payments-table-foot th {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .paid-payments-table-body td:nth-child(2),
  .paid-payments-table-head th:nth-child(2) {
    white-space: normal;
    word-break: break-word;
  }

  /* Payment-method pills - one colour per method so Credit / Credit Card / Korean
     Bank read as clearly distinct at a glance (they were plain grey text before). */
  .pm-badge {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 11px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3px;
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .pm-cash          { background: rgba(111,156,64,.18);  color: #9ccc65; border-color: rgba(111,156,64,.45); }
