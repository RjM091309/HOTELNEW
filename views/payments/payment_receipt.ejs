<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Payment Receipt</title>
  <style>
    @page {
      size: A4 portrait;
      margin: 4mm;
    }

    * { box-sizing: border-box; }

    html, body {
      font-family: Arial, Helvetica, sans-serif;
      color: #333;
      margin: 0;
      padding: 0;
      background: #fff;
      font-size: 8.5pt;
      line-height: 1.15;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .page {
      width: 100%;
      height: 289mm;
      max-height: 289mm;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .receipt-copy {
      flex: 1 1 0;
      min-height: 0;
      padding: 2mm 4mm 1mm;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .page-cut {
      border-top: 1px dashed #bbb;
      margin: 0 8mm;
      flex-shrink: 0;
    }

    .receipt-header {
      text-align: center;
      margin-bottom: 3px;
      flex-shrink: 0;
    }

    .receipt-logo {
      height: 36px;
      object-fit: contain;
      display: block;
      margin: 0 auto 1px;
    }

    .hotel-name {
      font-size: 9pt;
      font-weight: 600;
      letter-spacing: 1.5px;
      color: #222;
      margin-bottom: 2px;
    }

    .title-divider {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin: 0 auto 2px;
      max-width: 220px;
    }

    .title-divider .line {
      flex: 1;
      height: 1px;
      background: #ccc;
    }

    .title-divider .diamond {
      width: 4px;
      height: 4px;
      background: #bbb;
      transform: rotate(45deg);
      flex-shrink: 0;
    }

    .receipt-title {
      font-size: 10pt;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #444;
      margin-bottom: 4px;
    }

    .receipt-body {
      display: flex;
      gap: 0;
      flex: 1 1 auto;
      min-height: 0;
      align-items: stretch;
    }

    .receipt-col {
      flex: 1;
      min-width: 0;
    }

    .receipt-col.left {
      padding-right: 6px;
    }

    .receipt-col.right {
      padding-left: 6px;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .col-divider {
      width: 1px;
      background: #ddd;
      position: relative;
      flex-shrink: 0;
      align-self: stretch;
    }

    .col-divider .divider-icon {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 14px;
      height: 14px;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .col-divider .divider-icon svg {
      width: 11px;
      height: 11px;
      opacity: 0.45;
    }

    .field {
      margin-bottom: 3px;
      flex-shrink: 0;
    }

    .field-label {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 7pt;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.2px;
      color: #888;
      margin-bottom: 1px;
    }

    .field-icon {
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: #f0f0f0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .field-icon svg {
      width: 7px;
      height: 7px;
      stroke: #777;
      fill: none;
      stroke-width: 1.6;
    }

    .field-value {
      font-size: 8.5pt;
      color: #222;
      min-height: 13px;
      line-height: 1.2;
      padding-left: 17px;
    }

    .field-value.blank {
      border-bottom: 1px solid #ccc;
      min-height: 15px;
    }

    .field-value.amount {
      font-size: 9.5pt;
      font-weight: 600;
    }

    .method-options {
      display: flex;
      flex-wrap: wrap;
      gap: 3px 8px;
      padding-left: 17px;
    }

    .method-option {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      font-size: 7.5pt;
      color: #444;
    }

    .checkbox {
      width: 9px;
      height: 9px;
      border: 1px solid #999;
      border-radius: 2px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 6px;
      flex-shrink: 0;
    }

    .checkbox.checked {
      background: #333;
      border-color: #333;
      color: #fff;
    }

    .checkbox.checked::after {
      content: '✓';
    }

    .other-line {
      display: inline-block;
      border-bottom: 1px solid #ccc;
      min-width: 50px;
      vertical-align: bottom;
      min-height: 12px;
    }

    .signature-field {
      margin-top: 2px;
    }

    .signature-field .field-value.blank {
      min-height: 38px;
      margin-top: 2px;
    }

    .purpose-field {
      flex: 1 1 auto;
      min-height: 0;
      margin-bottom: 2px;
      display: flex;
      flex-direction: column;
    }

    .receipt-col.right .purpose-field {
      min-height: 48px;
    }

    .purpose-box {
      border: 1px solid #ddd;
      border-radius: 2px;
      min-height: 0;
      flex: 1 1 auto;
      width: 100%;
      padding: 3px 4px;
      font-size: 7.5pt;
      line-height: 1.1;
      color: #222;
      background: #fafafa;
      overflow: hidden;
      margin-top: 1px;
      display: block;
    }

    .purpose-box.purpose-plain {
      white-space: pre-wrap;
      font-size: 11pt;
      line-height: 1.3;
      padding: 6px 8px;
    }

    /* Standalone receipts (short purpose text) — larger readable text */
    .page.receipt-simple {
      font-size: 10pt;
      line-height: 1.2;
    }

    .page.receipt-simple .receipt-logo {
      height: 44px;
    }

    .page.receipt-simple .hotel-name {
      font-size: 11pt;
    }

    .page.receipt-simple .receipt-title {
      font-size: 12pt;
      margin-bottom: 6px;
    }

    .page.receipt-simple .field {
      margin-bottom: 5px;
    }

    .page.receipt-simple .field-label {
      font-size: 8.5pt;
    }

    .page.receipt-simple .field-value {
      font-size: 10.5pt;
      min-height: 16px;
      padding-left: 18px;
    }

    .page.receipt-simple .field-value.amount {
      font-size: 12pt;
    }

    .page.receipt-simple .method-option {
      font-size: 9pt;
    }

    .page.receipt-simple .purpose-box.purpose-plain {
      font-size: 12pt;
      line-height: 1.35;
    }

    .page.receipt-simple .ack-text {
      font-size: 7.5pt;
    }

    .page.receipt-simple .signature-field .field-value.blank {
      min-height: 42px;
    }

    .purpose-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .purpose-table td {
      padding: 1px 1px;
      vertical-align: top;
    }

    .purpose-table tr.purpose-info td {
      padding-bottom: 2px;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    .purpose-table .col-purpose-type {
      width: 15%;
      text-align: left;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    .purpose-table .col-purpose-method {
      width: 11%;
      text-align: left;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    .purpose-table .col-purpose-amount {
      width: 30%;
      text-align: right;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      padding-right: 3px;
      padding-left: 0;
    }

    .purpose-table .col-purpose-date {
      width: 22%;
      text-align: right;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      padding-left: 2px;
    }

    .purpose-table .col-purpose-time {
      width: 22%;
      text-align: right;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      padding-left: 2px;
    }

    .purpose-table tr.purpose-total td {
      padding-top: 3px;
      font-weight: 600;
    }

    .purpose-table tr.purpose-total .col-purpose-amount {
      font-weight: 700;
    }

    .purpose-box.blank {
      background: #fff;
      min-height: 28px;
    }

    .ack-box {
      flex-shrink: 0;
      background: #f5f5f5;
      border-radius: 3px;
      padding: 4px 6px;
      text-align: center;
    }

    .ack-icon {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      border: 1px solid #bbb;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 2px;
      font-size: 8px;
      color: #888;
    }

    .ack-text {
      font-size: 6.5pt;
      font-style: italic;
      color: #777;
      line-height: 1.2;
    }

    @media print {
      html, body {
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
      }
      .page {
        height: 289mm !important;
        max-height: 289mm !important;
        page-break-after: avoid !important;
        break-after: avoid !important;
      }
      .receipt-copy {
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
    }
  </style>
</head>
<body>
  <% const formatMoney = (value) => {
    if (value === null || value === undefined || value === '') return '';
    return Number(value).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }; %>
  <% const formatDate = (value) => {
    if (!value) return '';
    return new Date(value).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  }; %>
  <% const methodKey = (paymentMethod || '').toLowerCase(); %>
  <% const isCash = methodKey === 'cash'; %>
  <% const isCredit = ['credit', 'credit_card', 'marker', 'bank_transfer'].includes(methodKey); %>
  <% const isOther = !isBlank && !isCash && !isCredit && (methodKey === 'other' || methodKey === 'check' || !!methodKey); %>
  <% const otherLabel = isOther ? (paymentMethodLabel || paymentMethod || '') : ''; %>
  <% const purposeLinesSafe = (typeof purposeLines !== 'undefined' && purposeLines) ? purposeLines : []; %>

  <div class="page payment-print-fit<%= (!isBlank && !purposeLinesSafe.length) ? ' receipt-simple' : '' %>">
    <% for (let copyIndex = 0; copyIndex < 2; copyIndex++) { %>
      <% if (copyIndex === 1) { %><div class="page-cut"></div><% } %>
      <div class="receipt-copy">
        <div class="receipt-header">
          <% if (logoUrl) { %>
            <img class="receipt-logo" src="<%= logoUrl %>" alt="Main Stay Hotel">
          <% } %>
          <div class="hotel-name"><%= hotelName || 'MAIN STAY HOTEL' %></div>
          <div class="title-divider">
            <span class="line"></span>
            <span class="diamond"></span>
            <span class="line"></span>
          </div>
          <div class="receipt-title"><%= receiptTitle || 'Payment Receipt' %></div>
        </div>

        <div class="receipt-body">
          <div class="receipt-col left">
            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M5 20c0-4 3-6 7-6s7 2 7 6"/></svg></span>
                Received From
              </div>
              <div class="field-value <%= isBlank ? 'blank' : '' %>"><%= isBlank ? '' : (receivedFrom || '') %></div>
            </div>

            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><path d="M7 3h10v4H7zM5 7h14v12H5z"/></svg></span>
                Room No.
              </div>
              <div class="field-value <%= isBlank ? 'blank' : '' %>"><%= isBlank ? '' : (roomNo || '') %></div>
            </div>

            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="1"/><path d="M8 3v4M16 3v4M4 10h16"/></svg></span>
                Date
              </div>
              <div class="field-value <%= isBlank ? 'blank' : '' %>"><%= isBlank ? '' : formatDate(receiptDate) %></div>
            </div>

            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M3 11h18"/></svg></span>
                Amount Paid
              </div>
              <div class="field-value <%= isBlank ? 'blank' : 'amount' %>">
                <% if (!isBlank && amountPaid !== '' && amountPaid !== null && amountPaid !== undefined) { %>PHP <%= formatMoney(amountPaid) %><% } %>
              </div>
            </div>

            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="13" rx="2"/><path d="M2 10h20"/></svg></span>
                Payment Method
              </div>
              <div class="method-options">
                <span class="method-option"><span class="checkbox <%= !isBlank && isCash ? 'checked' : '' %>"></span> Cash</span>
                <span class="method-option"><span class="checkbox <%= !isBlank && isCredit ? 'checked' : '' %>"></span> Credit</span>
                <span class="method-option">
                  <span class="checkbox <%= !isBlank && isOther ? 'checked' : '' %>"></span>
                  Other<% if (!isBlank && otherLabel && methodKey === 'other') { %>: <%= otherLabel %><% } else if (isBlank) { %>: <span class="other-line"></span><% } %>
                </span>
              </div>
            </div>

            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M5 20c0-4 3-6 7-6s7 2 7 6"/></svg></span>
                Received By
              </div>
              <div class="field-value <%= isBlank ? 'blank' : '' %>"><%= isBlank ? '' : (receivedBy || '') %></div>
            </div>

            <div class="field signature-field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><path d="M4 18l4-8 4 4 4-6 4 10"/><path d="M4 20h16"/></svg></span>
                Signature <span style="font-weight:400;font-size:6.5pt;color:#999;">(handwritten)</span>
              </div>
              <div class="field-value blank"></div>
            </div>
          </div>

          <div class="col-divider">
            <div class="divider-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5">
                <path d="M12 3c-2 4-6 6-6 10a6 6 0 0 0 12 0c0-4-4-6-6-10z"/>
              </svg>
            </div>
          </div>

          <div class="receipt-col right">
            <div class="field purpose-field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><path d="M5 4h14v16H5z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span>
                Purpose of Payment
              </div>
              <div class="purpose-box <%= isBlank ? 'blank' : (purposeLinesSafe.length ? 'purpose-structured' : 'purpose-plain') %>">
                <% if (!isBlank && purposeLinesSafe.length) { %>
                  <table class="purpose-table">
                    <tbody>
                      <% purposeLinesSafe.forEach(function (line) {
                        if (line.type === 'info') { %>
                          <tr class="purpose-info">
                            <td colspan="5"><%= line.text %></td>
                          </tr>
                        <% } else if (line.type === 'payment') { %>
                          <tr class="purpose-row">
                            <td class="col-purpose-type"><%= line.paymentType %></td>
                            <td class="col-purpose-method"><%= line.method %></td>
                            <td class="col-purpose-amount">PHP <%= line.amount %></td>
                            <td class="col-purpose-date"><%= line.date || '' %></td>
                            <td class="col-purpose-time"><%= line.time || '' %></td>
                          </tr>
                        <% } else if (line.type === 'total') { %>
                          <tr class="purpose-total">
                            <td class="col-purpose-type" colspan="2"><%= line.label %></td>
                            <td class="col-purpose-amount">PHP <%= line.amount %></td>
                            <td class="col-purpose-date" colspan="2"></td>
                          </tr>
                        <% }
                      }); %>
                    </tbody>
                  </table>
                <% } else if (!isBlank) { %>
                  <%= purpose || '' %>
                <% } %>
              </div>
            </div>

            <div class="ack-box">
              <div class="ack-icon">✓</div>
              <div class="ack-text"><%= acknowledgmentText || 'This receipt acknowledges that the payment described above has been received.' %></div>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <script>
    function fitPurposeBoxFonts(root) {
      const doc = root || document;
      const boxes = doc.querySelectorAll('.purpose-box:not(.blank)');
      const defaultMinFontPt = 6;
      const defaultMaxFontPt = 8.5;
      const plainMinFontPt = 9;
      const plainMaxFontPt = 14;
      const minLineHeight = 1.05;
      const defaultMaxLineHeight = 1.2;
      const plainMaxLineHeight = 1.45;

      boxes.forEach(function (box) {
        const field = box.closest('.purpose-field');
        const rightCol = box.closest('.receipt-col.right');
        if (!field || !rightCol) return;

        const isPlainPurpose = box.classList.contains('purpose-plain');
        const minFontPt = isPlainPurpose ? plainMinFontPt : defaultMinFontPt;
        const maxFontPt = isPlainPurpose ? plainMaxFontPt : defaultMaxFontPt;
        const maxLineHeight = isPlainPurpose ? plainMaxLineHeight : defaultMaxLineHeight;

        const label = field.querySelector('.field-label');
        const ackBox = rightCol.querySelector('.ack-box');

        box.style.display = 'block';
        box.style.overflow = 'hidden';
        box.style.width = '100%';

        const rightHeight = rightCol.offsetHeight;
        const labelHeight = (label ? label.offsetHeight : 0) + 2;
        const ackHeight = (ackBox ? ackBox.offsetHeight : 0) + 3;
        const available = rightHeight - labelHeight - ackHeight;
        if (available <= 16) return;

        box.style.height = available + 'px';
        box.style.maxHeight = available + 'px';
        box.style.minHeight = available + 'px';

        let fontSize = maxFontPt;
        box.style.fontSize = fontSize + 'pt';
        box.style.lineHeight = String(minLineHeight);

        while (fontSize > minFontPt && box.scrollHeight > box.clientHeight + 1) {
          fontSize -= 0.2;
          box.style.fontSize = fontSize + 'pt';
        }

        const fillRatio = box.scrollHeight / box.clientHeight;
        if (fillRatio < 0.75) {
          let lineHeight = minLineHeight;
          while (lineHeight < maxLineHeight) {
            const nextLh = lineHeight + 0.05;
            box.style.lineHeight = String(nextLh);
            if (box.scrollHeight > box.clientHeight + 1) {
              box.style.lineHeight = String(lineHeight);
              break;
            }
            lineHeight = nextLh;
          }
        }

        if (box.scrollHeight / box.clientHeight < 0.7 && fontSize < maxFontPt) {
          while (fontSize < maxFontPt) {
            const nextSize = fontSize + 0.2;
            box.style.fontSize = nextSize + 'pt';
            if (box.scrollHeight > box.clientHeight + 1) {
              box.style.fontSize = fontSize + 'pt';
              break;
            }
            fontSize = nextSize;
          }
        }
      });
    }

    <% if (!embed) { %>
    window.addEventListener('load', function () {
      setTimeout(function () {
        fitPurposeBoxFonts(document);
        window.focus();
        window.print();
      }, 250);
    });
    window.addEventListener('afterprint', function () {
      window.close();
    });
    <% } %>
  </script>
</body>
</html>
