<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Payment Receipt</title>
  <style>
    @page {
      size: A4 portrait;
      margin: 10mm 12mm;
    }

    * { box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Arial, Helvetica, sans-serif;
      color: #333;
      margin: 0;
      padding: 0;
      background: #fff;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .page {
      width: 100%;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .receipt-copy {
      flex: 1;
      padding: 14px 20px 10px;
      display: flex;
      flex-direction: column;
    }

    .page-cut {
      border-top: 1px dashed #bbb;
      margin: 0 16px;
      flex-shrink: 0;
    }

    .receipt-header {
      text-align: center;
      margin-bottom: 10px;
    }

    .receipt-logo {
      height: 56px;
      object-fit: contain;
      display: block;
      margin: 0 auto 4px;
    }

    .hotel-name {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 2px;
      color: #222;
      margin-bottom: 6px;
    }

    .title-divider {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin: 0 auto 8px;
      max-width: 280px;
    }

    .title-divider .line {
      flex: 1;
      height: 1px;
      background: #ccc;
    }

    .title-divider .diamond {
      width: 5px;
      height: 5px;
      background: #bbb;
      transform: rotate(45deg);
      flex-shrink: 0;
    }

    .receipt-title {
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: #444;
      margin-bottom: 14px;
    }

    .receipt-body {
      display: flex;
      gap: 0;
      flex: 1;
      align-items: stretch;
    }

    .receipt-col {
      flex: 1;
      min-width: 0;
    }

    .receipt-col.left {
      padding-right: 16px;
    }

    .receipt-col.right {
      padding-left: 16px;
      display: flex;
      flex-direction: column;
    }

    .col-divider {
      width: 1px;
      background: #ddd;
      position: relative;
      flex-shrink: 0;
      align-self: stretch;
    }

    .col-divider .divider-icon {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 18px;
      height: 18px;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .col-divider .divider-icon svg {
      width: 14px;
      height: 14px;
      opacity: 0.45;
    }

    .field {
      margin-bottom: 10px;
    }

    .field-label {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      color: #888;
      margin-bottom: 3px;
    }

    .field-icon {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #f0f0f0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .field-icon svg {
      width: 10px;
      height: 10px;
      stroke: #777;
      fill: none;
      stroke-width: 1.6;
    }

    .field-value {
      font-size: 12px;
      color: #222;
      min-height: 18px;
      line-height: 1.35;
      padding-left: 24px;
    }

    .field-value.blank {
      border-bottom: 1px solid #ccc;
      min-height: 20px;
    }

    .field-value.amount {
      font-size: 13px;
      font-weight: 600;
    }

    .method-options {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      padding-left: 24px;
      margin-top: 2px;
    }

    .method-option {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      color: #444;
    }

    .checkbox {
      width: 11px;
      height: 11px;
      border: 1px solid #999;
      border-radius: 2px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 8px;
      flex-shrink: 0;
    }

    .checkbox.checked {
      background: #333;
      border-color: #333;
      color: #fff;
    }

    .checkbox.checked::after {
      content: '✓';
    }

    .other-line {
      display: inline-block;
      border-bottom: 1px solid #ccc;
      min-width: 60px;
      vertical-align: bottom;
      min-height: 14px;
    }

    .purpose-box {
      margin-left: 24px;
      border: 1px solid #ddd;
      border-radius: 3px;
      min-height: 52px;
      padding: 6px 8px;
      font-size: 11px;
      line-height: 1.45;
      white-space: pre-wrap;
      color: #222;
      background: #fafafa;
    }

    .purpose-box.blank {
      background: #fff;
    }

    .ack-box {
      margin-top: auto;
      background: #f5f5f5;
      border-radius: 4px;
      padding: 10px 12px;
      text-align: center;
    }

    .ack-icon {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1.5px solid #bbb;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 6px;
      font-size: 11px;
      color: #888;
    }

    .ack-text {
      font-size: 9px;
      font-style: italic;
      color: #777;
      line-height: 1.45;
    }

    @media print {
      body { margin: 0; }
      .page { min-height: auto; }
      .receipt-copy { page-break-inside: avoid; }
    }
  </style>
</head>
<body>
  <% const formatMoney = (value) => {
    if (value === null || value === undefined || value === '') return '';
    return Number(value).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }; %>
  <% const formatDate = (value) => {
    if (!value) return '';
    return new Date(value).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  }; %>
  <% const methodKey = (paymentMethod || '').toLowerCase(); %>
  <% const isCash = methodKey === 'cash'; %>
  <% const isCredit = ['credit', 'credit_card', 'marker', 'bank_transfer'].includes(methodKey); %>
  <% const isOther = !isBlank && !isCash && !isCredit && (methodKey === 'other' || methodKey === 'check' || !!methodKey); %>
  <% const otherLabel = isOther ? (paymentMethodLabel || paymentMethod || '') : ''; %>

  <div class="page">
    <% for (let copyIndex = 0; copyIndex < 2; copyIndex++) { %>
      <% if (copyIndex === 1) { %><div class="page-cut"></div><% } %>
      <div class="receipt-copy">
        <div class="receipt-header">
          <% if (logoUrl) { %>
            <img class="receipt-logo" src="<%= logoUrl %>" alt="Main Stay Hotel">
          <% } %>
          <div class="hotel-name"><%= hotelName || 'MAIN STAY HOTEL' %></div>
          <div class="title-divider">
            <span class="line"></span>
            <span class="diamond"></span>
            <span class="line"></span>
          </div>
          <div class="receipt-title"><%= receiptTitle || 'Payment Receipt' %></div>
        </div>

        <div class="receipt-body">
          <div class="receipt-col left">
            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M5 20c0-4 3-6 7-6s7 2 7 6"/></svg></span>
                Received From
              </div>
              <div class="field-value <%= isBlank ? 'blank' : '' %>"><%= isBlank ? '' : (receivedFrom || '') %></div>
            </div>

            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><path d="M7 3h10v4H7zM5 7h14v12H5z"/></svg></span>
                Room No.
              </div>
              <div class="field-value <%= isBlank ? 'blank' : '' %>"><%= isBlank ? '' : (roomNo || '') %></div>
            </div>

            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="1"/><path d="M8 3v4M16 3v4M4 10h16"/></svg></span>
                Date
              </div>
              <div class="field-value <%= isBlank ? 'blank' : '' %>"><%= isBlank ? '' : formatDate(receiptDate) %></div>
            </div>

            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M3 11h18"/></svg></span>
                Amount Paid
              </div>
              <div class="field-value <%= isBlank ? 'blank' : 'amount' %>">
                <% if (!isBlank && amountPaid !== '' && amountPaid !== null && amountPaid !== undefined) { %>PHP <%= formatMoney(amountPaid) %><% } %>
              </div>
            </div>

            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="13" rx="2"/><path d="M2 10h20"/></svg></span>
                Payment Method
              </div>
              <div class="method-options">
                <span class="method-option"><span class="checkbox <%= !isBlank && isCash ? 'checked' : '' %>"></span> Cash</span>
                <span class="method-option"><span class="checkbox <%= !isBlank && isCredit ? 'checked' : '' %>"></span> Credit</span>
                <span class="method-option">
                  <span class="checkbox <%= !isBlank && isOther ? 'checked' : '' %>"></span>
                  Other<% if (!isBlank && otherLabel && methodKey === 'other') { %>: <%= otherLabel %><% } else if (isBlank) { %>: <span class="other-line"></span><% } %>
                </span>
              </div>
            </div>

            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><path d="M5 4h14v16H5z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span>
                Purpose of Payment
              </div>
              <div class="purpose-box <%= isBlank ? 'blank' : '' %>"><%= isBlank ? '' : (purpose || '') %></div>
            </div>
          </div>

          <div class="col-divider">
            <div class="divider-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5">
                <path d="M12 3c-2 4-6 6-6 10a6 6 0 0 0 12 0c0-4-4-6-6-10z"/>
              </svg>
            </div>
          </div>

          <div class="receipt-col right">
            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M5 20c0-4 3-6 7-6s7 2 7 6"/></svg></span>
                Received By
              </div>
              <div class="field-value <%= isBlank ? 'blank' : '' %>"><%= isBlank ? '' : (receivedBy || '') %></div>
            </div>

            <div class="field">
              <div class="field-label">
                <span class="field-icon"><svg viewBox="0 0 24 24"><path d="M4 18l4-8 4 4 4-6 4 10"/><path d="M4 20h16"/></svg></span>
                Signature <span style="font-weight:400;font-size:9px;color:#999;">(handwritten)</span>
              </div>
              <div class="field-value blank" style="min-height:36px;"></div>
            </div>

            <div class="ack-box">
              <div class="ack-icon">✓</div>
              <div class="ack-text"><%= acknowledgmentText || 'This receipt acknowledges that the payment described above has been received.' %></div>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <% if (!embed) { %>
  <script>
    window.addEventListener('load', function () {
      setTimeout(function () {
        window.focus();
        window.print();
      }, 250);
    });
    window.addEventListener('afterprint', function () {
      window.close();
    });
  </script>
  <% } %>
</body>
</html>
