<!-- ======================================== -->
<!-- USER INFO MANAGEMENT PAGE -->
<!-- ======================================== -->

<!-- Main Content Area -->
<div class="row">
    <div class="col-xl-12 col-md-12 col-12">
        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <header>User Information Management</header>
                <div class="tools">
                    <button class="btn btn-primary-10" id="addUserBtn" title="Add New User">
                        <i class="fa fa-plus"></i> Add New User
                    </button>
                                         <button class="btn btn-warning" id="viewRoomUsersBtn" title="View Room-Assigned Users" style="margin-left: 10px;">
                         <i class="fa fa-bed"></i> Room Users
                     </button>
                </div>
            </div>
            <div class="dashboard-card-body">
                
                <!-- Main Users Table -->
                <div class="table-scrollable">
                    <table id="usersTable" class="table table-hover table-bordered full-width">
                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Username</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data loaded dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ======================================== -->
<!-- USER INFO MODALS -->
<!-- ======================================== -->

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" role="dialog" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="addUserModalLabel">Add New User</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addUserForm" autocomplete="off">
                <div class="modal-body">
                    <!-- Basic Information -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addFullName" name="fullName" autocomplete="off" required>
                                <label class="mdl-textfield__label">Full Name</label>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addUsername" name="new-username" autocomplete="off" autocapitalize="none" spellcheck="false" required>
                                <label class="mdl-textfield__label">Username</label>
                            </div>
                            <div id="usernameCheck" class="form-text" style="margin-top: 5px; font-size: 12px;"></div>
                        </div>
                    </div>
                    
                    <!-- Role and Password -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addRole" name="role" value="" autocomplete="off" readonly tabIndex="-1" required>
                                <label for="addRole" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="addRole" class="mdl-textfield__label">Role</label>
                                                                 <ul data-mdl-for="addRole" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                     <li class="mdl-menu__item" data-val="1">Admin</li>
                                     <li class="mdl-menu__item" data-val="2">Frontdesk</li>
                                     <li class="mdl-menu__item" data-val="3">Manager</li>
                                     <li class="mdl-menu__item" data-val="4">Housekeeping</li>
                                     <li class="mdl-menu__item" data-val="5">GuestRoom</li>
                                     <li class="mdl-menu__item" data-val="6">GuestApp</li>
                                     <li class="mdl-menu__item" data-val="7">DriverApp</li>
                                     <li class="mdl-menu__item" data-val="8">SalesRoom</li>
                                     <li class="mdl-menu__item" data-val="9">Guest Room Controller</li>
                                 </ul>
                            </div>
                        </div>
                                                 <!-- Guest Room Controller: Room selector (shown only when role is Guest Room Controller) -->
                         <div class="col-lg-6 p-t-20" id="addRoomContainer" style="display:none;">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addRoom" name="room" value="" autocomplete="off" readonly tabIndex="-1">
                                <label for="addRoom" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="addRoom" class="mdl-textfield__label">Room</label>
                                <ul data-mdl-for="addRoom" class="mdl-menu mdl-menu--bottom-left mdl-js-menu" id="addRoomList">
                                    <!-- populated dynamically -->
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="password" id="addPassword" name="new-password" autocomplete="new-password" required>
                                <label class="mdl-textfield__label">Password</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Confirm Password -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="password" id="addConfirmPassword" name="confirm-new-password" autocomplete="new-password" required>
                                <label class="mdl-textfield__label">Confirm Password</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" role="dialog" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="editUserModalLabel">Edit User</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editUserForm">
                <div class="modal-body">
                    <input type="hidden" id="editUserId" name="userId">
                    
                    <!-- Basic Information -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editFullName" name="fullName" required>
                                <label class="mdl-textfield__label">Full Name</label>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editUsername" name="username" required>
                                <label class="mdl-textfield__label">Username</label>
                            </div>
                            <div id="editUsernameCheck" class="form-text" style="margin-top: 5px; font-size: 12px;"></div>
                        </div>
                    </div>
                    
                    <!-- Role and Password -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editRole" name="role" value="" readonly tabIndex="-1" required>
                                <label for="editRole" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="editRole" class="mdl-textfield__label">Role</label>
                                                                 <ul data-mdl-for="editRole" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                     <li class="mdl-menu__item" data-val="1">Admin</li>
                                     <li class="mdl-menu__item" data-val="2">Frontdesk</li>
                                     <li class="mdl-menu__item" data-val="3">Manager</li>
                                     <li class="mdl-menu__item" data-val="4">Housekeeping</li>
                                     <li class="mdl-menu__item" data-val="5">GuestRoom</li>
                                     <li class="mdl-menu__item" data-val="6">GuestApp</li>
                                     <li class="mdl-menu__item" data-val="7">DriverApp</li>
                                     <li class="mdl-menu__item" data-val="8">SalesRoom</li>
                                     <li class="mdl-menu__item" data-val="9">Guest Room Controller</li>
                                 </ul>
                            </div>
                        </div>
                                                 <!-- Guest Room Controller: Room selector (shown only when role is Guest Room Controller) -->
                         <div class="col-lg-6 p-t-20" id="editRoomContainer" style="display:none;">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editRoom" name="room" value="" readonly tabIndex="-1">
                                <label for="editRoom" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="editRoom" class="mdl-textfield__label">Room</label>
                                <ul data-mdl-for="editRoom" class="mdl-menu mdl-menu--bottom-left mdl-js-menu" id="editRoomList">
                                    <!-- populated dynamically -->
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="password" id="editPassword" name="password">
                                <label class="mdl-textfield__label">New Password (leave blank to keep current)</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Confirm Password -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="password" id="editConfirmPassword" name="confirmPassword">
                                <label class="mdl-textfield__label">Confirm New Password</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Room Users Modal -->
<div class="modal fade" id="roomUsersModal" tabindex="-1" role="dialog" aria-labelledby="roomUsersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                                 <h4 class="modal-title" id="roomUsersModalLabel">Room-Assigned Users</h4>
                 <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-scrollable">
                    <table id="roomUsersTable" class="table table-hover table-bordered full-width">
                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Username</th>
                                <th>Role</th>
                                <th>Room Number</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data loaded dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Ensure MDL dropdown menus can overflow outside Bootstrap modals */
    #addUserModal .modal-dialog,
    #addUserModal .modal-content,
    #addUserModal .modal-body,
    #editUserModal .modal-dialog,
    #editUserModal .modal-content,
    #editUserModal .modal-body {
        overflow: visible !important;
    }

    /* Keep the MDL menu above the modal content/backdrop */
    .mdl-menu__container.is-visible {
        z-index: 2000 !important; /* Bootstrap modal backdrop ~1050, modal ~1055 */
    }
</style>
<!-- ======================================== -->
<!-- SCRIPT LOADING -->
<!-- ======================================== -->



<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Load scripts with proper timing
        setTimeout(function() {
            var usersScript = document.createElement('script');
            usersScript.src = '/js/user_info/users_data.js';
            document.body.appendChild(usersScript);
        }, 300);
    });
</script> 