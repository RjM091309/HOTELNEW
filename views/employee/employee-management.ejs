<!-- ======================================== -->
<!-- EMPLOYEE MANAGEMENT PAGE -->
<!-- ======================================== -->

<!-- Main Content Area -->
<div class="row">
    <div class="col-xl-12 col-md-12 col-12">
        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <header>Employee Management</header>
                <div class="tools">
                    <button type="button" class="btn btn-primary-10 btn-sm" id="addEmployeeBtn">
                            <i class="fa fa-plus"></i> Add New Employee
                        </button>
                    </div>
                </div>
            <div class="dashboard-card-body">
                
                <!-- Main Employee Table -->
                <div class="table-scrollable">
                    <table id="employeeTable" class="table table-hover table-bordered full-width">
                        <thead>
                            <tr>
                                <th>Photo</th>
                                <th>Full Name</th>
                                <th>Department</th>
                                <th>Contact No</th>
                                <th>Address</th>
                                <th>Date Started</th>
                                <th>Username</th>
                                <th>Role</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data loaded dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

