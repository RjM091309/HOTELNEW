<style>
/* Fix modal z-index stacking for nested modals */
.modal-backdrop {
    z-index: 9997 !important;
}

.modal-backdrop + .modal-backdrop {
    z-index: 9998 !important;
}

/* Ensure add/edit modals appear on top */
#addEmployeeModal,
#editEmployeeModal {
    z-index: 9999 !important;
}

/* Ensure MDL dropdown menus can overflow outside Bootstrap modals */
#addEmployeeModal .modal-dialog,
#addEmployeeModal .modal-content,
#addEmployeeModal .modal-body,
#editEmployeeModal .modal-dialog,
#editEmployeeModal .modal-content,
#editEmployeeModal .modal-body {
    overflow: visible !important;
}

/* Keep the MDL menu above the modal content/backdrop */
.mdl-menu__container.is-visible {
    z-index: 2000 !important; /* Bootstrap modal backdrop ~1050, modal ~1055 */
}

/* Force modal backdrop to be behind all modals */
.modal-backdrop.show {
    z-index: 9997 !important;
}

/* ======================================== */
/* EMPLOYEE PHOTO UPLOAD STYLES */
/* ======================================== */

.employee-photo-upload-container {
    width: 100%;
}

.upload-label {
    display: block;
    margin-bottom: 8px;
    color: #aaaaaa !important;
    font-size: 12px !important;
    font-weight: 500;
}

.file-upload-wrapper {
    position: relative;
    width: 100%;
}

.file-upload-area {
    position: relative;
    border: 2px dashed #555;
    border-radius: 8px;
    padding: 20px 15px;
    text-align: center;
    background: #2a3135;
    cursor: pointer;
    transition: all 0.3s ease;
    overflow: hidden;
}

.file-upload-area:hover {
    border-color: #2196F3;
    background: #3a3a3a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(33, 150, 243, 0.3);
}

.file-upload-area.dragover {
    border-color: #2196F3;
    background: #1e3a5f;
    transform: scale(1.02);
}

.file-upload-area.has-file {
    border-color: #4CAF50;
    background: #1a2e1a;
}

.file-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
}

.upload-icon {
    margin-bottom: 10px;
}

.upload-icon .material-icons {
    font-size: 32px;
    color: #666;
}

.upload-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.primary-text {
    font-size: 14px;
    font-weight: 500;
    color: #ccc;
}

.secondary-text {
    font-size: 12px;
    color: #888;
}

.file-types {
    font-size: 11px;
    color: #666;
    margin-top: 4px;
}

.file-info {
    margin-top: 10px;
    padding: 10px;
    background: #1a2e1a;
