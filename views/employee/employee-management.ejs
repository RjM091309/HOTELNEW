                                    <li class="mdl-menu__item" data-val="1">Admin</li>
                                    <li class="mdl-menu__item" data-val="2">Frontdesk</li>
                                    <li class="mdl-menu__item" data-val="3">Manager</li>
                                    <li class="mdl-menu__item" data-val="4">Housekeeping</li>
                                    <li class="mdl-menu__item" data-val="5">GuestRoom</li>
                                    <li class="mdl-menu__item" data-val="6">GuestApp</li>
                                    <li class="mdl-menu__item" data-val="7">DriverApp</li>
                                    <li class="mdl-menu__item" data-val="8">SalesRoom</li>
                                    <li class="mdl-menu__item" data-val="9">Guest Room Controller</li>
                                </ul>
                            </div>
