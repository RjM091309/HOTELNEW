<!-- Add Employee Modal -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1" role="dialog" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="addEmployeeModalLabel">Add New Employee</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addEmployeeForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <!-- Basic Information -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addFullName" name="fullName" required>
                                <label class="mdl-textfield__label">Full Name</label>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addDepartment" name="department" value="" readonly tabIndex="-1" required>
                                <label for="addDepartment" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="addDepartment" class="mdl-textfield__label">Department</label>
                                <ul data-mdl-for="addDepartment" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="Manager">Manager</li>
                                    <li class="mdl-menu__item" data-val="Supervisor">Supervisor</li>
                                    <li class="mdl-menu__item" data-val="Admin">Admin</li>
                                    <li class="mdl-menu__item" data-val="Front Desk">Front Desk</li>
                                    <li class="mdl-menu__item" data-val="Driver">Driver</li>
                                    <li class="mdl-menu__item" data-val="Housekeeping">Housekeeping</li>
                                    <li class="mdl-menu__item" data-val="Maintenance">Maintenance</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Contact Information -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addContactNo" name="contactNo" required>
                                <label class="mdl-textfield__label">Contact Number</label>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="date-field txt-full-width">
                                <label class="date-field__label">Date Started</label>
                                <div class="date-field__control">
                                    <input type="text" class="date-field__input" id="addDateStarted" name="dateStarted" placeholder="YYYY-MM-DD" autocomplete="off" required>
                                    <i class="material-icons date-field__icon">event</i>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Address -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addAddress" name="address" required>
                                <label class="mdl-textfield__label">Address</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- User Account Information -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <h5 style="color: #aaa; margin-bottom: 15px; border-bottom: 1px solid #444; padding-bottom: 8px;">User Account Information (Optional)</h5>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
