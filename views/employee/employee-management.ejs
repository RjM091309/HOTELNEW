                                    <!-- populated dynamically -->
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="password" id="addPassword" name="password" autocomplete="new-password">
                                <label class="mdl-textfield__label">Password</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Confirm Password -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="password" id="addConfirmPassword" name="confirmPassword" autocomplete="new-password">
                                <label class="mdl-textfield__label">Confirm Password</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Photo Upload -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="employee-photo-upload-container">
                                <label class="upload-label">Employee Photo</label>
                                <div class="file-upload-wrapper">
                                    <div class="file-upload-area" id="addFileUploadArea">
                                        <div class="upload-icon">
                                            <i class="material-icons">cloud_upload</i>
                                        </div>
                                        <div class="upload-text">
                                            <span class="primary-text">Click to upload</span>
                                            <span class="secondary-text">or drag and drop</span>
                                            <span class="file-types">PNG, JPG, JPEG up to 5MB</span>
                                        </div>
                                        <input class="file-input" type="file" id="addPhoto" name="photo" accept="image/*" data-max-size="5">
                                    </div>
                                    <div class="file-info" id="addFileInfo" style="display: none;">
                                        <div class="file-details">
                                            <div class="file-icon">
                                                <i class="material-icons">image</i>
                                            </div>
                                            <div class="file-text">
                                                <span class="file-name" id="addFileName"></span>
                                                <span class="file-size" id="addFileSize"></span>
                                            </div>
                                            <button type="button" class="remove-file-btn" id="addRemoveFileBtn">
                                                <i class="material-icons">close</i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="photo-preview-container" id="addPhotoPreviewContainer" style="display: none;">
                                    <div class="preview-header">
                                        <span>Photo Preview</span>
                                        <button type="button" class="preview-actions">
                                            <i class="material-icons" onclick="previewFullImage(document.getElementById('addPhotoPreview').src)">fullscreen</i>
                                        </button>
                                    </div>
                                    <div class="preview-image">
                                        <img id="addPhotoPreview" src="#" alt="Photo Preview">
                                    </div>
                                </div>
                                <div class="upload-error" id="addUploadError" style="display: none;">
                                    <span class="error-text" id="addUploadErrorText"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>

