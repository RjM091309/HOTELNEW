<!-- ======================================== -->
<!-- SERVICES MANAGEMENT PAGE -->
<!-- ======================================== -->

<!-- Main Content Area -->
<div class="row">
    <div class="col-xl-12 col-md-12 col-12">
        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <header>Services Management</header>
                
            </div>
            <div class="dashboard-card-body">
                <!-- Action Buttons -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="btn-group" role="group">
                        <button class="btn btn-primary btn-sm" id="addServiceBtn" title="Add New Service">
                            <i class="fa fa-plus"></i> Add New Service
                        </button>
                    </div>
                </div>
                
                <!-- Main Services Table -->
                <div class="table-scrollable">
                    <table id="servicesTable" class="table table-hover table-bordered full-width">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Service Name</th>
                                <th>Description</th>
                                <th>Cost</th>
                                <th>Availability</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data loaded dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ======================================== -->
<!-- SERVICES MODALS -->
<!-- ======================================== -->

<!-- Add Service Modal -->
<div class="modal fade" id="addServiceModal" tabindex="-1" role="dialog" aria-labelledby="addServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addServiceModalLabel">Add New Service</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="addServiceForm">
                <div class="modal-body">
                    <!-- Service Information -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="addServiceCategory">Category *</label>
                                <select class="form-control" id="addServiceCategory" name="serviceCategory" required>
                                    <option value="" selected disabled>Select Category</option>
                                    <option value="Food & Beverage">Food & Beverage</option>
                                    <option value="Housekeeping">Housekeeping & Room Requests</option>
                                    <option value="Spa & Wellness Services">Spa & Wellness Services</option>
                                    <option value="Transportation & Tours">Transportation & Tours</option>
                                    <option value="Entertainment & Convenience Services">Entertainment & Convenience Services</option>
                                    <option value="Event & Business Services">Event & Business Services</option>
                                    <option value="Special Requests">Special Requests</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="addServiceName">Service Name *</label>
                                <input type="text" class="form-control" id="addServiceName" name="serviceName" required>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Service Details -->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="addServiceDescription">Description *</label>
                                <textarea class="form-control" id="addServiceDescription" name="serviceDescription" rows="3" required></textarea>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Cost and Availability -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="addServiceCost">Cost *</label>
                                <input type="number" class="form-control" id="addServiceCost" name="serviceCost" step="0.01" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="addServiceAvailability">Availability *</label>
                                <select class="form-control" id="addServiceAvailability" name="serviceAvailability" required>
                                    <option value="" selected disabled>Select Availability</option>
                                    <option value="Available">Available</option>
                                    <option value="Unavailable">Unavailable</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Service Modal -->
<div class="modal fade" id="editServiceModal" tabindex="-1" role="dialog" aria-labelledby="editServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editServiceModalLabel">Edit Service</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="editServiceForm">
                <div class="modal-body">
                    <input type="hidden" id="editServiceId" name="serviceId">
                    
                    <!-- Service Information -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editServiceCategory">Category *</label>
                                <select class="form-control" id="editServiceCategory" name="serviceCategory" required>
                                    <option value="" selected disabled>Select Category</option>
                                    <option value="Food & Beverage">Food & Beverage</option>
                                    <option value="Housekeeping">Housekeeping & Room Requests</option>
                                    <option value="Spa & Wellness Services">Spa & Wellness Services</option>
                                    <option value="Transportation & Tours">Transportation & Tours</option>
                                    <option value="Entertainment & Convenience Services">Entertainment & Convenience Services</option>
                                    <option value="Event & Business Services">Event & Business Services</option>
                                    <option value="Special Requests">Special Requests</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editServiceName">Service Name *</label>
                                <input type="text" class="form-control" id="editServiceName" name="serviceName" required>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Service Details -->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="editServiceDescription">Description *</label>
                                <textarea class="form-control" id="editServiceDescription" name="serviceDescription" rows="3" required></textarea>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Cost and Availability -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editServiceCost">Cost *</label>
                                <input type="number" class="form-control" id="editServiceCost" name="serviceCost" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editServiceAvailability">Availability *</label>
                                <select class="form-control" id="editServiceAvailability" name="serviceAvailability" required>
                                    <option value="" selected disabled>Select Availability</option>
                                    <option value="Available">Available</option>
                                    <option value="Unavailable">Unavailable</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================== -->
<!-- SCRIPT LOADING -->
<!-- ======================================== -->

<style>
/* Fix modal z-index stacking for nested modals */
.modal-backdrop {
    z-index: 9997 !important;
}

.modal-backdrop + .modal-backdrop {
    z-index: 9998 !important;
}

/* Ensure add/edit modals appear on top */
#addServiceModal,
#editServiceModal {
    z-index: 9999 !important;
}

/* Force modal backdrop to be behind all modals */
.modal-backdrop.show {
    z-index: 9997 !important;
}
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Load scripts with proper timing
        setTimeout(function() {
            var servicesScript = document.createElement('script');
            servicesScript.src = '/js/services/services_data.js';
            document.body.appendChild(servicesScript);
        }, 300);
    });
</script> 