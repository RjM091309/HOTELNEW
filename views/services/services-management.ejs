<!-- ======================================== -->
<!-- SERVICES MANAGEMENT PAGE -->
<!-- ======================================== -->

<!-- Main Content Area -->
<div class="row">
    <div class="col-xl-12 col-md-12 col-12">
        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <header>Services Management</header>
                <div class="tools">
                    <button type="button" class="btn btn-primary-10 btn-sm" id="addServiceBtn">
                        <i class="fa fa-plus"></i> Add New Service
                    </button>
                </div>
            </div>
            <div class="dashboard-card-body">
                
                <!-- Main Services Table -->
                <div class="table-scrollable">
                    <table id="servicesTable" class="table table-hover table-bordered full-width">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Service Name</th>
                                <th>Description</th>
                                <th>Cost</th>
                                <th>Availability</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data loaded dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ======================================== -->
<!-- SERVICES MODALS -->
<!-- ======================================== -->

<!-- Add Service Modal -->
<div class="modal fade" id="addServiceModal" tabindex="-1" role="dialog" aria-labelledby="addServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addServiceModalLabel">Add New Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addServiceForm">
                <div class="modal-body">
                    <!-- Service Information -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addServiceCategory" name="serviceCategory" value="" readonly tabIndex="-1" required>
                                <label for="addServiceCategory" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="addServiceCategory" class="mdl-textfield__label">Category</label>
                                <ul data-mdl-for="addServiceCategory" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="Food & Beverage">Food & Beverage</li>
                                    <li class="mdl-menu__item" data-val="Housekeeping">Housekeeping & Room Requests</li>
                                    <li class="mdl-menu__item" data-val="Spa & Wellness Services">Spa & Wellness Services</li>
                                    <li class="mdl-menu__item" data-val="Transportation & Tours">Transportation & Tours</li>
                                    <li class="mdl-menu__item" data-val="Entertainment & Convenience Services">Entertainment & Convenience Services</li>
                                    <li class="mdl-menu__item" data-val="Event & Business Services">Event & Business Services</li>
                                    <li class="mdl-menu__item" data-val="Special Requests">Special Requests</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addServiceName" name="serviceName" required>
                                <label class="mdl-textfield__label">Service Name</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Service Details -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <textarea class="mdl-textfield__input" type="text" id="addServiceDescription" name="serviceDescription" rows="3" required></textarea>
                                <label class="mdl-textfield__label">Description</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Cost and Availability -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="number" id="addServiceCost" name="serviceCost" step="0.01" required>
                                <label class="mdl-textfield__label">Cost</label>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addServiceAvailability" name="serviceAvailability" value="" readonly tabIndex="-1" required>
                                <label for="addServiceAvailability" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="addServiceAvailability" class="mdl-textfield__label">Availability</label>
                                <ul data-mdl-for="addServiceAvailability" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="Available">Available</li>
                                    <li class="mdl-menu__item" data-val="Unavailable">Unavailable</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Service Modal -->
<div class="modal fade" id="editServiceModal" tabindex="-1" role="dialog" aria-labelledby="editServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editServiceModalLabel">Edit Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editServiceForm">
                <div class="modal-body">
                    <input type="hidden" id="editServiceId" name="serviceId">
                    
                    <!-- Service Information -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editServiceCategory" name="serviceCategory" value="" readonly tabIndex="-1" required>
                                <label for="editServiceCategory" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="editServiceCategory" class="mdl-textfield__label">Category</label>
                                <ul data-mdl-for="editServiceCategory" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="Food & Beverage">Food & Beverage</li>
                                    <li class="mdl-menu__item" data-val="Housekeeping">Housekeeping & Room Requests</li>
                                    <li class="mdl-menu__item" data-val="Spa & Wellness Services">Spa & Wellness Services</li>
                                    <li class="mdl-menu__item" data-val="Transportation & Tours">Transportation & Tours</li>
                                    <li class="mdl-menu__item" data-val="Entertainment & Convenience Services">Entertainment & Convenience Services</li>
                                    <li class="mdl-menu__item" data-val="Event & Business Services">Event & Business Services</li>
                                    <li class="mdl-menu__item" data-val="Special Requests">Special Requests</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editServiceName" name="serviceName" required>
                                <label class="mdl-textfield__label">Service Name</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Service Details -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <textarea class="mdl-textfield__input" type="text" id="editServiceDescription" name="serviceDescription" rows="3" required></textarea>
                                <label class="mdl-textfield__label">Description</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Cost and Availability -->
                    <div class="row">
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="number" id="editServiceCost" name="serviceCost" step="0.01" required>
                                <label class="mdl-textfield__label">Cost</label>
                            </div>
                        </div>
                        <div class="col-lg-6 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editServiceAvailability" name="serviceAvailability" value="" readonly tabIndex="-1" required>
                                <label for="editServiceAvailability" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="editServiceAvailability" class="mdl-textfield__label">Availability</label>
                                <ul data-mdl-for="editServiceAvailability" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="Available">Available</li>
                                    <li class="mdl-menu__item" data-val="Unavailable">Unavailable</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================== -->
<!-- SCRIPT LOADING -->
<!-- ======================================== -->

<style>
/* Fix modal z-index stacking for nested modals */
.modal-backdrop {
    z-index: 9997 !important;
}

.modal-backdrop + .modal-backdrop {
    z-index: 9998 !important;
}

/* Ensure add/edit modals appear on top */
#addServiceModal,
#editServiceModal {
    z-index: 9999 !important;
}

/* Force modal backdrop to be behind all modals */
.modal-backdrop.show {
    z-index: 9997 !important;
}
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Load scripts with proper timing
        setTimeout(function() {
            var servicesScript = document.createElement('script');
            servicesScript.src = '/js/services/services_data.js';
            document.body.appendChild(servicesScript);
        }, 300);
    });
</script> 
<style>
/* Allow MDL dropdown menus to overflow outside Bootstrap modals for Services */
#addServiceModal .modal-dialog,
#addServiceModal .modal-content,
#addServiceModal .modal-body,
#editServiceModal .modal-dialog,
#editServiceModal .modal-content,
#editServiceModal .modal-body {
    overflow: visible !important;
}

.mdl-menu__container.is-visible {
    z-index: 2000 !important;
}
</style>