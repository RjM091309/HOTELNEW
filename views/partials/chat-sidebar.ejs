<!-- start chat sidebar -->
<div class="chat-sidebar-container" data-close-on-body-click="false">
	<div class="chat-sidebar">
		<ul class="nav nav-tabs">
			<li class="nav-item">
				<a href="#quick_sidebar_tab_1" class="nav-link active tab-icon" data-toggle="tab">Theme
				</a>
			</li>
		</ul>
		<div class="tab-content">
			<div class="tab-pane fade in show active chat-sidebar-settings animated shake" role="tabpanel"
				id="quick_sidebar_tab_1">
				<div class="slimscroll-style">
					<div class="theme-light-dark">
						<h6>Theme</h6>
						<button type="button" data-theme="white"
							class="btn lightColor btn-outline btn-circle m-b-10 theme-button">Light</button>
						<button type="button" data-theme="dark"
							class="btn dark btn-outline btn-circle m-b-10 theme-button">Dark</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end chat sidebar -->

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize chat sidebar tabs
    const chatTabs = document.querySelectorAll('.chat-sidebar .nav-tabs .nav-link');
    const chatTabPanes = document.querySelectorAll('.chat-sidebar .tab-pane');



    // Hide all tab panes initially except the first one
    chatTabPanes.forEach((pane, index) => {
        if (index === 0) {
            pane.style.display = 'block';
            pane.style.visibility = 'visible';
            pane.style.opacity = '1';
        } else {
            pane.style.display = 'none';
            pane.style.visibility = 'hidden';
            pane.style.opacity = '0';
        }
    });

    chatTabs.forEach(tab => {
        tab.addEventListener('click', function(e) {
            e.preventDefault();

            // Remove active class from all tabs and panes
            chatTabs.forEach(t => t.classList.remove('active'));
            chatTabPanes.forEach(pane => {
                pane.classList.remove('show', 'active');
                pane.style.display = 'none';
                pane.style.visibility = 'hidden';
                pane.style.opacity = '0';
            });

            // Add active class to clicked tab
            this.classList.add('active');

            // Show corresponding tab pane
            const targetId = this.getAttribute('href');
            const targetPane = document.querySelector(targetId);
            if (targetPane) {
                targetPane.classList.add('show', 'active');
                targetPane.style.display = 'block';
                targetPane.style.visibility = 'visible';
                targetPane.style.opacity = '1';

            }
        });
    });

    // Ensure first tab is active by default
    const firstTab = document.querySelector('.chat-sidebar .nav-tabs .nav-link.active');
    const firstPane = document.querySelector('.chat-sidebar .tab-pane.show.active');

    if (firstTab && firstPane) {
        firstPane.style.display = 'block';
        firstPane.style.visibility = 'visible';
        firstPane.style.opacity = '1';

    }
});
</script>
