<!-- start sidebar menu -->
<% if (typeof activePage === 'undefined') { activePage = 'dashboard'; } %>
<style>
	/* Bold the current active menu item (works for both main and submenus) */
	.sidebar-container .sidemenu .nav-item.active > .nav-link,
	.sidebar-container .sidemenu .nav-link.active,
	.sidebar-container .sidemenu .sub-menu .nav-link.active {
		font-weight: 800;
		color: #ffffff;
		background: #495057;
		border-radius: 6px;
	}
	/* Reduce highlight height for top-level items (e.g., Dashboard, Calendar) */
	.sidebar-container .sidemenu > .nav-item > .nav-link {
		padding: 16px 20px;
		line-height: 26px;
	}

</style>
<div class="sidebar-container">
	<div class="sidemenu-container navbar-collapse collapse fixed-menu">
		<div id="remove-scroll">
			<ul class="sidemenu page-header-fixed p-t-20" data-keep-expanded="false" data-auto-scroll="true"
				data-slide-speed="200">
				<li class="sidebar-toggler-wrapper hide">
					<div class="sidebar-toggler">
						<span></span>
					</div>
				</li>
				<li class="sidebar-user-panel">
					<div class="user-panel">
						<div class="row">
							<div class="sidebar-userpic">
								<img src="/img/dp.png" class="img-responsive" alt=""> </div>
						</div>
						<div class="profile-usertitle">
							<div class="sidebar-userpic-name"> <%= user ? user.FULLNAME : 'Guest' %> </div>
							<div class="profile-usertitle-job"> 
								<% if (user && user.PERMISSIONS) { %>
									<% if (user.PERMISSIONS == 1) { %>
										Admin
									<% } else { %>
										User
									<% } %>
								<% } else { %>
									Guest
								<% } %>
							</div>
						</div>
						<div class="sidebar-userpic-btn">
							<a class="tooltips" href="#" data-placement="top"
								data-original-title="Profile">
								<i class="material-icons">person_outline</i>
							</a>
							<a class="tooltips" href="#" data-placement="top"
								data-original-title="Mail">
								<i class="material-icons">mail_outline</i>
							</a>
							<a class="tooltips" href="#" data-placement="top"
								data-original-title="Chat">
								<i class="material-icons">chat</i>
							</a>
							<a class="tooltips" href="#" data-placement="top"
								data-original-title="Logout">
								<i class="material-icons">input</i>
							</a>
						</div>
					</div>
				</li>
				<li class="menu-heading" >
					<span>Front Desk</span>
				</li>
				<li class="nav-item <%= !activePage || activePage === 'dashboard' ? 'active' : '' %>">
					<a href="/" class="nav-link <%= !activePage || activePage === 'dashboard' ? 'active' : '' %>">
						<span class="title">Dashboard </span>
						<i class="material-icons">dashboard</i>
						<span class="selected"></span>
					</a>
				</li>

				<li class="nav-item <%= activePage === 'calendar' ? 'active' : '' %>">
					<a href="/calendar" class="nav-link <%= activePage === 'calendar' ? 'active' : '' %>" target="_blank">
						<i class="material-icons">event</i>
						<span class="title">Calendar</span>
					</a>
				</li>

				<% const bookingPages = ['booking', 'unassigned-rooms']; %>
				<li class="nav-item <%= bookingPages.includes(activePage) ? 'open' : '' %>">
					<a class="nav-link nav-toggle nav-main-link-submenu <%= bookingPages.includes(activePage) ? 'active' : '' %>" data-toggle="submenu" aria-haspopup="true"
						aria-expanded="<%= bookingPages.includes(activePage) ? 'true' : 'false' %>" href="#">
						<i class="material-icons">business_center</i>
						<span class="title">Booking</span>
						<span class="arrow <%= bookingPages.includes(activePage) ? 'open' : '' %>"></span>
					</a>
					<ul class="sub-menu <%= bookingPages.includes(activePage) ? 'show' : '' %>" <% if (bookingPages.includes(activePage)) { %>style="display: block;"<% } %>>
						<li class="nav-item">
							<a href="/booking" class="nav-link <%= activePage === 'booking' ? 'active' : '' %>">
								<i class="fa fa-genderless"></i>
								<span class="title">Booking</span>
							</a>
						</li>
						<li class="nav-item">
							<a href="/calendar/unassigned-rooms" class="nav-link <%= activePage === 'unassigned-rooms' ? 'active' : '' %>">
								<i class="fa fa-genderless"></i>
								<span class="title">Unassigned Rooms</span>
							</a>
						</li>
						<!-- Rooms and Guest moved to Management -->
					</ul>
				</li>

				<% const paymentPages = ['daily_settlement', 'payments', 'credit']; %>
				<li class="nav-item <%= paymentPages.includes(activePage) ? 'open' : '' %>" data-section="payment-management">
					<a class="nav-link nav-toggle nav-main-link-submenu <%= paymentPages.includes(activePage) ? 'active' : '' %>" data-toggle="submenu" aria-haspopup="true"
						aria-expanded="<%= paymentPages.includes(activePage) ? 'true' : 'false' %>" href="#">
						<i class="material-icons">payment</i>
						<span class="title">Payment<br>Management</span>
						<span class="arrow <%= paymentPages.includes(activePage) ? 'open' : '' %>"></span>
					</a>
					<ul class="sub-menu <%= paymentPages.includes(activePage) ? 'show' : '' %>" <% if (paymentPages.includes(activePage)) { %>style="display: block;"<% } %>>
						<li class="nav-item">
							<a href="/telegram/settlement" class="nav-link <%= activePage === 'daily_settlement' ? 'active' : '' %>">
								<i class="fa fa-genderless"></i>
								<span class="title">Daily Settlement</span>
							</a>
						</li>
						<li class="nav-item">
							<a href="/payments" class="nav-link <%= activePage === 'payments' ? 'active' : '' %>">
								<i class="fa fa-genderless"></i>
								<span class="title">Payment</span>
							</a>
						</li>
						<li class="nav-item">
							<a href="/credit" class="nav-link <%= activePage === 'credit' ? 'active' : '' %>">
								<i class="fa fa-genderless"></i>
								<span class="title">Credit</span>
							</a>
						</li>
						<li class="nav-item">
							<a href="/agency" class="nav-link <%= activePage === 'agency' ? 'active' : '' %>" onclick="localStorage.setItem('agencySection','payment')">
								<i class="fa fa-genderless"></i>
								<span class="title">Agency</span>
							</a>
						</li>
					</ul>
				</li>


				<% const managementPages = ['expenses', 'guest', 'room_clearance', 'employee', 'user_info', 'vehicle_monitoring']; %>
				<li class="nav-item <%= managementPages.includes(activePage) ? 'open' : '' %>">
					<a class="nav-link nav-toggle nav-main-link-submenu <%= managementPages.includes(activePage) ? 'active' : '' %>" data-toggle="submenu" aria-haspopup="true"
						aria-expanded="<%= managementPages.includes(activePage) ? 'true' : 'false' %>" href="#">
						<i class="material-icons">assessment</i>
						<span class="title">Management</span>
						<span class="arrow <%= managementPages.includes(activePage) ? 'open' : '' %>"></span>
					</a>
					<ul class="sub-menu <%= managementPages.includes(activePage) ? 'show' : '' %>" <% if (managementPages.includes(activePage)) { %>style="display: block;"<% } %>>
						<li class="nav-item">
							<a href="/expenses" class="nav-link <%= activePage === 'expenses' ? 'active' : '' %>">
								<i class="fa fa-genderless"></i>
								<span class="title">Expenses</span>
							</a>
						</li>
					
						<li class="nav-item">
							<a href="/guest" class="nav-link <%= activePage === 'guest' ? 'active' : '' %>">
								<i class="fa fa-genderless"></i>
								<span class="title">Guest Profile</span>
							</a>
						</li>
						<li class="nav-item">
							<a href="/room_clearance" class="nav-link <%= activePage === 'room_clearance' ? 'active' : '' %>">
								<i class="fa fa-genderless"></i>
								<span class="title">Room Clearance</span>
							</a>
						</li>
						<li class="nav-item">
							<a href="/employee" class="nav-link <%= activePage === 'employee' ? 'active' : '' %>">
								<i class="fa fa-genderless"></i>
								<span class="title">Employee</span>
							</a>
						</li>
						<li class="nav-item">
							<a href="/vehicle/monitoring" class="nav-link <%= activePage === 'vehicle_monitoring' ? 'active' : '' %>">
								<i class="fa fa-genderless"></i>
								<span class="title">Vehicle Monitoring</span>
							</a>
						</li>
					
						<li class="nav-item">
							<a href="/user_info" class="nav-link <%= activePage === 'user_info' ? 'active' : '' %>">
								<i class="fa fa-genderless"></i>
								<span class="title">User Info</span>
							</a>
						</li>
					</ul>
				</li>

				<!-- Settings Section -->
				<% const settingsPages = ['integration', 'card_writer', 'telegram_settings', 'booking_channel', 'vehicle', 'room', 'services']; %>
				<li class="nav-item <%= settingsPages.includes(activePage) ? 'open' : '' %>" data-section="settings">
					<a class="nav-link nav-toggle nav-main-link-submenu <%= settingsPages.includes(activePage) ? 'active' : '' %>" data-toggle="submenu" aria-haspopup="true"
						aria-expanded="<%= settingsPages.includes(activePage) ? 'true' : 'false' %>" href="#">
						<i class="material-icons">settings</i>
						<span class="title">Settings</span>
						<span class="arrow <%= settingsPages.includes(activePage) ? 'open' : '' %>"></span>
					</a>
					<ul class="sub-menu <%= settingsPages.includes(activePage) ? 'show' : '' %>" <% if (settingsPages.includes(activePage)) { %>style="display: block;"<% } %>>
						<li class="nav-item">
							<a class="nav-link <%= activePage === 'agency' ? 'active' : '' %>" href="/agency" onclick="localStorage.setItem('agencySection','settings')">
								<i class="fa fa-genderless"></i>
								<span class="title">Agency</span>
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link <%= activePage === 'booking_channel' ? 'active' : '' %>" href="/booking_channel">
								<i class="fa fa-genderless"></i>
								<span class="title">Booking Channel</span>
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link <%= activePage === 'vehicle' ? 'active' : '' %>" href="/vehicle">
								<i class="fa fa-genderless"></i>
								<span class="title">Vehicle Management</span>
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link <%= activePage === 'room' ? 'active' : '' %>" href="/room">
								<i class="fa fa-genderless"></i>
								<span class="title">Rooms</span>
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link <%= activePage === 'services' ? 'active' : '' %>" href="/services">
								<i class="fa fa-genderless"></i>
								<span class="title">Services</span>
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link <%= activePage === 'integration' ? 'active' : '' %>" href="/integration">
								<i class="fa fa-genderless"></i>
								<span class="title">Integration</span>
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link <%= activePage === 'card_writer' ? 'active' : '' %>" href="/integration/card-writer">
								<i class="fa fa-genderless"></i>
								<span class="title">Card Writer</span>
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link <%= activePage === 'telegram_settings' ? 'active' : '' %>" href="/telegram/settings">
								<i class="fa fa-genderless"></i>
								<span class="title">Telegram | Kakao</span>
							</a>
						</li>
					</ul>
				</li>
				<% if (user && user.PERMISSIONS == 1) { %>
				<li class="nav-item">
					<a href="#" id="navDeleteTestData" class="nav-link">
						<i class="material-icons">delete_forever</i>
						<span class="title">Delete Data</span>
					</a>
				</li>
				<% } %>

				<script>
					(function() {
						try {
							var activePage = '<%= activePage %>';
							if (activePage !== 'agency') return;
							var pref = localStorage.getItem('agencySection') || 'payment';
							var paymentLi = document.querySelector('[data-section="payment-management"]');
							var settingsLi = document.querySelector('[data-section="settings"]');
							var targets = [paymentLi, settingsLi];
							targets.forEach(function(li) {
								if (!li) return;
								li.classList.remove('open', 'active');
								var link = li.querySelector('.nav-link');
								if (link) link.classList.remove('active');
								var sub = li.querySelector('.sub-menu');
								if (sub) {
									sub.classList.remove('show');
									sub.style.display = '';
								}
							});
							var targetLi = pref === 'settings' ? settingsLi : paymentLi;
							if (targetLi) {
								targetLi.classList.add('open');
								var tlink = targetLi.querySelector('.nav-link');
								if (tlink) tlink.classList.add('active');
								var tsub = targetLi.querySelector('.sub-menu');
								if (tsub) {
									tsub.classList.add('show');
									tsub.style.display = 'block';
								}
							}
						} catch (e) {
							// fail silently
						}
					})();
				</script>
			</ul>
		</div>
	</div>
</div>
<!-- end sidebar menu -->
