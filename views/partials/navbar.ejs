                        icon: 'success',
                        confirmButtonText: 'OK',
                        didOpen: () => {
                        const form = $('<form>', {
                            method: 'POST',
                            action: '/booking/generate-voucher?download=1',
                            // target: '_blank'
                        });

        // Check if this is a direct reservation for voucher formatting
        const isDirectReservationForVoucher = isDirectReservation;
        
        // Calculate room charges and services for voucher
        const priceValue = formData.price || '0.00';
        const roomRateStr = priceValue ? priceValue.toString().replace(/[,\s₱₹$]/g, '') : '0';
        const roomRate = parseFloat(roomRateStr) || 0;
        const nights = parseInt(formData.diffindays) || 1;
        const roomCharges = Math.round((roomRate * nights) * 100) / 100; // Round to 2 decimals
        
        const breakfastAdultQty = parseInt(formData.breakfastAdultQty) || 0;
        const breakfastAdultPrice = parseFloat(formData.breakfastAdultPrice || 0);
        const breakfastKidQty = parseInt(formData.breakfastKidQty) || 0;
        const breakfastKidPrice = parseFloat(formData.breakfastKidPrice || 0);
        const breakfastTotal = parseFloat(((breakfastAdultQty * breakfastAdultPrice) + (breakfastKidQty * breakfastKidPrice)).toFixed(2));
        
        const pickup = parseFloat(formData.pickupPrice || 0);
        const dropoff = parseFloat(formData.dropoffPrice || 0);
        const lateCheckoutFee = parseFloat(formData.lateCheckoutFee || 0);
        const servicesTotal = parseFloat((breakfastTotal + pickup + dropoff).toFixed(2));
        
        // Get computed values (remove commas)
        let computedTotalRaw = $('#computedTotal').text().trim().replace(/,/g, '');
        let computedBalanceRaw = $('#computedBalance').text().trim().replace(/,/g, '');
        let computedPaidAmountRaw = $('#computedPaidAmount').text().trim().replace(/,/g, '');
        
        // Fallback if values are empty
        if (!computedPaidAmountRaw || computedPaidAmountRaw === '0.00') {
            computedPaidAmountRaw = parseFloat(formData.paidAmount || 0).toFixed(2);
        }
        if (!computedTotalRaw || computedTotalRaw === '0.00') {
            computedTotalRaw = (roomCharges + servicesTotal + lateCheckoutFee + parseFloat(formData.reservationFee || 0) - parseFloat(formData.discount || 0)).toFixed(2);
        }
        
        // Recalculate balance
        const totalValue = parseFloat(computedTotalRaw.replace(/,/g, '')) || 0;
        const paidValue = parseFloat(computedPaidAmountRaw.replace(/,/g, '')) || 0;
        computedBalanceRaw = Math.max(0, (totalValue - paidValue)).toFixed(2);
        
        const voucherData = {
          voucherNo: response.confirmationNumber, // ✅ Use the actual confirmation number from database
            fullname: formData.fullname,
            dateFrom: formData.daterange.split(' to ')[0],
            dateTo: formData.daterange.split(' to ')[1].split('(')[0].trim(),
            bedCount: formData.bedCount || formData.bedCountDirect || window.selectedBedCount || 1,
            // Use "NO ROOM ASSIGNED" for direct reservations, same as voucher button
            roomNumber: isDirectReservationForVoucher ? 'NO ROOM ASSIGNED' : ($('#addroom option:selected').text() || ''),
            roomType: isDirectReservationForVoucher ? 'NO ROOM ASSIGNED' : ($('#room_type_hidden').val() || ''),
            roomView: isDirectReservationForVoucher ? 'N/A' : ($('#room_type').val() || ''),
            roomRate: formData.price,
            breakfastAdult: formData.breakfastAdultQty,
            breakfastAdultPrice: formData.breakfastAdultPrice,
            breakfastKid: formData.breakfastKidQty,
            breakfastKidPrice: formData.breakfastKidPrice,
            pickup: formData.pickupPrice || 0,
            dropoff: formData.dropoffPrice || 0,
            reservationFee: formData.reservationFee || 0,
            discount: formData.discount || 0,
            remarks: formData.bookingRemarks,
            total: computedTotalRaw,
            balance: computedBalanceRaw,
            paidAmount: computedPaidAmountRaw,
            checkInStatus: formData.checkInStatus,
            checkOutStatus: formData.checkOutStatus,
            lateCheckoutFee: formData.lateCheckoutFee,
            roomCharges: roomCharges.toFixed(2),
            servicesTotal: servicesTotal.toFixed(2),
            directReservationFlag: isDirectReservationForVoucher ? 'true' : 'false'
        };

        for (let key in voucherData) {
            form.append($('<input>', {
                type: 'hidden',
                name: key,
                value: voucherData[key]
            }));
        }

        $('body').append(form);
        form.submit();
        form.remove();

        // Only redirect to calendar if NOT a direct reservation (unassigned room)
        if (!isDirectReservation) {
          setTimeout(() => {
            Swal.close();
            window.location.replace('/calendar');
          }, 10000);
        } else {
          // For unassigned rooms, just close the modal and stay on current page
          setTimeout(() => {
            Swal.close();
          }, 10000);
        }
    }
