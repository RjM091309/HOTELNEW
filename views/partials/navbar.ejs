// Function to initialize the Add Booking form handler
function initializeAddBookingHandler() {
    $('#addbooking').off('submit').on('submit', function (e) {
        e.preventDefault();
       
        // Check if this is a direct reservation
        const isDirectReservation = $('#directReservationFlag').val() === 'true';
        
        // Reverting to manual data collection as it was more reliable.
        const formData = {
            room_id: isDirectReservation ? 0 : $('#addroom').val(), // 0 for direct reservations (backend can handle this)
            fullname: $('#txtFullNameAdd').val(),
            number: (window.ContactChannel
                ? window.ContactChannel.getValue('#contactChannel', '#txtNumber')
                : $('#txtNumber').val()),
            address: $('#txtAddress').val() || '',
            daterange: $('#daterange').val(),
            maxOccupants: isDirectReservation ? 1 : $('#maxOccupants').val(), // Default to 1 for direct reservations
            paymentStatus: $('#paymentStatus').val(),
            // Use hidden paidAmount value when available to ensure exact amount is sent to backend
            paidAmount: $('#paidAmountHidden').val() || $('#paidAmount').val() || '0.00',
            price: isDirectReservation ? ($('#baseprice').val() || $('#price').val() || '0.00') : $('#baseprice').val(), // Use calculated price for direct reservations based on bed count
            diffindays: $('#diffindays').val(),
            nationality: ($('#nationality').val() || '').trim(),
            guestID: $('#guestID').val(),
            bookingRoute: isDirectReservation ? 'direct-reservation' : $('#bookingRoute').val(),
            checkInStatus: $('#checkInStatus').val(),
            checkOutStatus: $('#checkOutStatus').val(),
            holdPending: $('#holdPendingCheckbox').is(':checked') ? 'true' : 'false',
            bookingRemarks: $('#bookingRemarks').val(),
            agencyID: $('#agencySelect').val(),
            agencyPayer: $('#bookingRoute').val() === 'agency'
                ? ($('input[name="agencyPayer"]:checked').val() || 'agency')
                : null,
            channelBookingId: ($('#channelBookingId').val() || '').trim(),
            voucherNo: $('#voucherNo').val(),
            
            // ✅ Include services and transport
            breakfastAdultQty: $('#breakfastAdultQty').val(),
            breakfastAdultPrice: $('#breakfastAdultPrice').val(),
            breakfastAdultId: $('#breakfastAdultId').val(),
            breakfastKidQty: $('#breakfastKidQty').val(),
            breakfastKidPrice: $('#breakfastKidPrice').val(),
            breakfastKidId: $('#breakfastKidId').val(),
            pickupServiceId: $('#pickupServiceId').val(),
            pickupPrice: $('#pickupPrice').val(),
            dropoffServiceId: $('#dropoffServiceId').val(),
            dropoffPrice: $('#dropoffPrice').val(),
            flightNumber: $('#flightNumber').val(),
