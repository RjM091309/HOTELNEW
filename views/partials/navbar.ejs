            const existingBedCount = addBookingModalElement.querySelector('#bedCountDirect');
            const existingBedCountDiv = addBookingModalElement.querySelector('#divBedCount');
            
            // Find the target row first to check if Bed Count is already in the correct position
            const dateFromField = addBookingModalElement.querySelector('#daterange');
            let targetRow = null;
            if (dateFromField) {
                let dateColumn = dateFromField.parentNode.parentNode; // Go up to col-lg-6 or col-lg-4
                let dateRow = dateColumn.parentNode; // Go up to the row
                
                // Check if this row contains date-related fields
                if (dateRow && (dateRow.querySelector('#daterange') || dateRow.querySelector('#diffindays'))) {
                    targetRow = dateRow;
                }
            }
            
            // Check if Bed Count already exists in the correct position (inside targetRow)
            const bedCountInCorrectPosition = existingBedCountDiv && targetRow && targetRow.contains(existingBedCountDiv);
            
            // Only remove if it exists but is NOT in the correct position, or if we can't find targetRow
            if (existingBedCount && !bedCountInCorrectPosition) {
                // If it's inside a form-group (fallback case), remove the whole form-group
                const parentFormGroup = existingBedCount.closest('.form-group');
                if (parentFormGroup) {
                    parentFormGroup.remove();
                } else {
                    existingBedCount.remove();
                }
            }
            if (existingBedCountDiv && !bedCountInCorrectPosition) {
                existingBedCountDiv.remove();
            }
            
            // If Bed Count already exists in correct position, just update it and skip recreation
            if (bedCountInCorrectPosition && existingBedCount && targetRow) {
                // Ensure column classes are still correct
                const guestColumn = addBookingModalElement.querySelector('#divtxtFullNameAdd');
                const contactColumn = addBookingModalElement.querySelector('#divtxtNumber');
                if (guestColumn) {
                    guestColumn.className = 'col-lg-6';
                }
                if (contactColumn) {
                    contactColumn.className = 'col-lg-6';
                }
                
                // Ensure Booking Resources is in the correct position
                const bookingRoutePlaceholder = addBookingModalElement.querySelector('#bookingRouteSinglePlaceholder');
                if (bookingRoutePlaceholder) {
                    bookingRoutePlaceholder.className = 'col-lg-3';
                    if (!targetRow.contains(bookingRoutePlaceholder)) {
                        targetRow.appendChild(bookingRoutePlaceholder);
                    }
                }
                
                // Update the options if needed (refresh disabled states)
                try {
                    const map = window.fullyReservedBedTypes || {};
                    const opt1 = Array.from(existingBedCount.options).find(o => o.value === '1');
                    const opt2 = Array.from(existingBedCount.options).find(o => o.value === '2');
                    if (opt1) opt1.disabled = !!map['1'];
                    if (opt2) opt2.disabled = !!map['2'];
                } catch (e) { /* no-op */ }
                
                // Ensure event listener is attached (remove old one first to prevent duplicates)
                const oldHandler = existingBedCount._bedCountHandler;
                if (oldHandler) {
                    existingBedCount.removeEventListener('change', oldHandler);
                }
                const newHandler = function() {
                    window.selectedBedCount = this.value;
                    // Update price based on selected bed count
                    updatePriceForBedCount(this.value);
                };
                existingBedCount._bedCountHandler = newHandler;
                existingBedCount.addEventListener('change', newHandler);
            } else {
                // Create new Bed Count if it doesn't exist or is in wrong position
                const contactNumberField = addBookingModalElement.querySelector('#txtNumber');
                if (contactNumberField) {
                    if (targetRow && targetRow.classList.contains('row')) {
                    // First, update Guest and Contact Number columns to col-lg-6
                    const guestColumn = addBookingModalElement.querySelector('#divtxtFullNameAdd');
                    const contactColumn = addBookingModalElement.querySelector('#divtxtNumber');
                    
                    if (guestColumn) {
                        guestColumn.className = 'col-lg-6';
                    }
                    if (contactColumn) {
                        contactColumn.className = 'col-lg-6';
                    }
                    
                     // Create bed count column (col-lg-3 for proper alignment)
                    const bedCountColumn = document.createElement('div');
                    bedCountColumn.className = 'col-lg-3';
                    bedCountColumn.id = 'divBedCount';
                    
                    // Create bed count container
                    const bedCountContainer = document.createElement('div');
                    bedCountContainer.className = 'form-group';
                    
                    // Create bed count label
                    const bedCountLabel = document.createElement('label');
                    bedCountLabel.htmlFor = 'bedCountDirect';
                    bedCountLabel.textContent = 'Bed Count:';
                   
                   
                    // Create bed count select
                    const bedCountSelect = document.createElement('select');
                    bedCountSelect.id = 'bedCountDirect';
                    bedCountSelect.name = 'bedCountDirect';
                    bedCountSelect.className = 'form-control';
                    bedCountSelect.required = true;
                   
                    
                    // Add bed count options
                    const bedOptions = [
                        { value: '', text: 'Select Options', selected: true, disabled: true },
                        { value: '1', text: 'King Bedroom' },
                        { value: '2', text: 'Queen Bedroom' }
                
                    ];
                    
                    bedOptions.forEach(option => {
                        const optionElement = document.createElement('option');
                        optionElement.value = option.value;
                        optionElement.textContent = option.text;
                        if (option.selected) optionElement.selected = true;
                        if (option.disabled) optionElement.disabled = true;
                        bedCountSelect.appendChild(optionElement);
                    });

                    // Disable fully reserved bed options (e.g., 1 Bed) using global map from the modal
                    try {
                        const map = window.fullyReservedBedTypes || {};
                        // Keys in map are numeric-like strings: '1', '2', ...
                        if (map['1']) {
                            const opt1 = Array.from(bedCountSelect.options).find(o => o.value === '1');
                            if (opt1) { opt1.disabled = true; }
                        }
                        if (map['2']) {
                            const opt2 = Array.from(bedCountSelect.options).find(o => o.value === '2');
                            if (opt2) { opt2.disabled = true; }
                        }
                    } catch (e) { /* no-op */ }
                    
                    // Don't set default value - let the "Select" option be selected by default
                    // bedCountSelect.value = '1';
                    
                    // Append label and select to container
                    bedCountContainer.appendChild(bedCountLabel);
                    bedCountContainer.appendChild(bedCountSelect);
                    
                    // Add bed count container to the column
                    bedCountColumn.appendChild(bedCountContainer);
                    
                    // Add the new column to the same row
                    targetRow.appendChild(bedCountColumn);
                    
                    // Set Booking Resources to col-lg-3 and move to same row as Date and Bed Count
                    const bookingRoutePlaceholder = addBookingModalElement.querySelector('#bookingRouteSinglePlaceholder');
                    if (bookingRoutePlaceholder) {
                        bookingRoutePlaceholder.className = 'col-lg-3';
                        // Move Booking Resources to the same row as Date and Bed Count
                        if (!targetRow.contains(bookingRoutePlaceholder)) {
                            targetRow.appendChild(bookingRoutePlaceholder);
                        }
                    }
                    
                    // Add event listener to capture Bed Count value and update price
                    const bedCountSelectElement = document.getElementById('bedCountDirect');
                    if (bedCountSelectElement) {
                        bedCountSelectElement.addEventListener('change', function() {
                            // Store the selected bed count value for later use
                            window.selectedBedCount = this.value;
                            
                            // Update price based on selected bed count
                            updatePriceForBedCount(this.value);
                        });
                    }
                } else {
                    // Fallback: create simple form group if row structure not found
                    const bedCountContainer = document.createElement('div');
                    bedCountContainer.className = 'form-group';
                    bedCountContainer.style.marginTop = '15px';
                    
                    const bedCountLabel = document.createElement('label');
                    bedCountLabel.htmlFor = 'bedCountDirect';
                    bedCountLabel.textContent = 'Bed Count:';
                    bedCountLabel.style.fontWeight = 'bold';
                    bedCountLabel.style.color = '#333';
                    
                    const bedCountSelect = document.createElement('select');
                    bedCountSelect.id = 'bedCountDirect';
                    bedCountSelect.name = 'bedCountDirect';
                    bedCountSelect.className = 'form-control';
                    bedCountSelect.style.width = '100%';
                    
                    const bedOptions = [
                        { value: '1', text: 'King Bedroom' },
                        { value: '2', text: 'Queen Bedroom' }
                    ];
                    
                    bedOptions.forEach(option => {
                        const optionElement = document.createElement('option');
                        optionElement.value = option.value;
                        optionElement.textContent = option.text;
                        bedCountSelect.appendChild(optionElement);
                    });

                    // Disable fully reserved bed options based on global map
                    try {
                        const map = window.fullyReservedBedTypes || {};
                        if (map['1']) {
                            const opt1 = Array.from(bedCountSelect.options).find(o => o.value === '1');
                            if (opt1) { opt1.disabled = true; }
                        }
                        if (map['2']) {
                            const opt2 = Array.from(bedCountSelect.options).find(o => o.value === '2');
                            if (opt2) { opt2.disabled = true; }
                        }
                    } catch (e) { /* no-op */ }
                    
                    bedCountSelect.value = '1';
                    bedCountContainer.appendChild(bedCountLabel);
                    bedCountContainer.appendChild(bedCountSelect);
                    
                    // Insert after contact number
                    contactNumberField.parentNode.insertBefore(bedCountContainer, contactNumberField.nextSibling);
                    
                    // Add event listener to capture Bed Count value and update price for fallback case
                    const bedCountSelectFallback = document.getElementById('bedCountDirect');
                    if (bedCountSelectFallback) {
                        bedCountSelectFallback.addEventListener('change', function() {
                            // Store the selected bed count value for later use
                            window.selectedBedCount = this.value;
                            
                            // Update price based on selected bed count
                            updatePriceForBedCount(this.value);
                        });
                    }
                    }
                }
            }

            // Add event listener to booking route to update price when booking type changes
            const bookingRouteField = addBookingModalElement.querySelector('#bookingRoute');
            if (bookingRouteField) {
                bookingRouteField.addEventListener('change', function() {
                    const bedCountField = addBookingModalElement.querySelector('#bedCountDirect');
                    if (bedCountField && bedCountField.value) {
                        updatePriceForBedCount(bedCountField.value);
                    }
                });
            }
            
            // Re-bind AJAX submit handler to guarantee interception for this flow
            try {
                initializeAddBookingHandler();
            } catch (e) { /* no-op */ }
        } else {
            console.error('Modal element not found in the DOM');
        }
    }, 100); // Close the setTimeout
}

// Function to update warning message based on bed filter
function updateWarningMessage(selectedBedFilter) {
    const warningElement = document.getElementById('unassignedWarning');
    const warningContentElement = document.getElementById('warningContent');
    
    if (!warningElement || !warningContentElement || !window.originalBedConflicts) {
        return;
    }
    
    let filteredConflicts = [];
    
    if (selectedBedFilter === 'all') {
        // Show all conflicts
        filteredConflicts = window.originalBedConflicts;
    } else {
        // Filter conflicts by bed type
        const bedType = selectedBedFilter === '1B' ? '1' : '2';
        filteredConflicts = window.originalBedConflicts.filter(conflict => 
            conflict.bedCount == bedType
        );
    }
    
    if (filteredConflicts.length > 0) {
        // Update warning content
        warningContentElement.innerHTML = filteredConflicts.map(conflict => 
            `<div style="margin-bottom: 4px;">
                • <strong>${conflict.bedCount} bed:</strong> ${conflict.reserved} out of ${conflict.available} are reserved for unassigned bookings
            </div>`
        ).join('');
        
        // Show warning if it was hidden
        warningElement.style.display = 'block';
    } else {
        // Hide warning if no conflicts for this bed type
        warningElement.style.display = 'none';
    }
}
        
    // Toggle filter function
    function toggleFilter(button) {
        const filter = button.getAttribute('data-filter');
        const value = button.getAttribute('data-value');
        
        // Toggle the button's active state
        button.classList.toggle('active');
        
        // If this button is now active, deactivate others in the same group
        if (button.classList.contains('active')) {
            const sameGroupButtons = document.querySelectorAll(`[data-filter="${filter}"]`);
            sameGroupButtons.forEach(btn => {
                if (btn !== button) {
                    btn.classList.remove('active');
                }
            });
        }
        
        // Apply filters
        filterRooms();
}
        
    function filterRooms() {
    const input = document.getElementById('roomSearchInput').value.toLowerCase();
    const selectedBedFilter = document.querySelector('input[name="bedFilter"]:checked').value;
        
        // Get active toggle buttons
        const activeCheckinButton = document.querySelector('.filter-toggle[data-filter="checkin"].active');
        const activeCheckoutButton = document.querySelector('.filter-toggle[data-filter="checkout"].active');
        
        const selectedCheckinFilter = activeCheckinButton ? activeCheckinButton.getAttribute('data-value') : '';
        const selectedCheckoutFilter = activeCheckoutButton ? activeCheckoutButton.getAttribute('data-value') : '';
        
    

        // Get all room items from the original data, not from DOM
        const allRooms = window.currentRoomsData ? window.currentRoomsData.rooms : [];
        
        // Filter rooms based on bed count first
        let filteredRooms = allRooms;
        if (selectedBedFilter !== 'all') {
            const bedCount = selectedBedFilter === '1B' ? '1' : '2';
            filteredRooms = allRooms.filter(room => room.ROOM_BED == bedCount);
        }
        
        // Filter by search input
        if (input) {
            filteredRooms = filteredRooms.filter(room => 
                String(room.ROOM_NUMBER || '').toLowerCase().includes(input)
            );
        }
        
       

        // Clear all containers
        const checkinContainer = document.getElementById('checkinResultsContainer');
        const checkoutContainer = document.getElementById('checkoutResultsContainer');
        const bothFiltersContainer = document.getElementById('bothFiltersContainer');
        const bothFiltersSection = document.getElementById('bothFiltersSection');
        const otherContainer = document.getElementById('otherRoomsContainer');
        
        checkinContainer.innerHTML = '';
        checkoutContainer.innerHTML = '';
        bothFiltersContainer.innerHTML = '';
        otherContainer.innerHTML = '';

        // Arrays to hold rooms for different sections
        const checkinRooms = [];
        const checkoutRooms = [];
        const bothFiltersRooms = [];
        const otherRooms = [];

            // Categorize filtered rooms
        filteredRooms.forEach(room => {
            const checkoutType = room.checkoutType || '';
            const checkinType = room.checkinType || '';
            const isDisabled = window.fullyReservedBedTypes && window.fullyReservedBedTypes[room.ROOM_BED];
        
        // Check-in filter logic - LEFT section
            let belongsToCheckin = false;
            let checkinPriority = 0; // For sorting within check-in section
        if (selectedCheckinFilter === 'R/I') {
                // R/I: Only compatible with R/O checkout
            if (checkoutType === 'R/O') {
                belongsToCheckin = true;
                    checkinPriority = 1; // Red priority
            }
        } else if (selectedCheckinFilter === 'L/I') {
                // L/I: Compatible with BOTH R/O and L/O checkout
            if (checkoutType === 'R/O') {
                belongsToCheckin = true;
                    checkinPriority = 1; // Red priority
            } else if (checkoutType === 'L/O') {
                belongsToCheckin = true;
                    checkinPriority = 2; // Yellow priority (higher = first)
            }
        }
        
        // Check-out filter logic - RIGHT section
            let belongsToCheckout = false;
            let checkoutPriority = 0; // For sorting within check-out section
        if (selectedCheckoutFilter === 'R/O') {
                // R/O: Compatible with BOTH R/I and L/I checkin
            if (checkinType === 'R/I') {
                belongsToCheckout = true;
                    checkoutPriority = 2; // Red priority (higher = first)
            } else if (checkinType === 'L/I') {
                belongsToCheckout = true;
                    checkoutPriority = 1; // Yellow priority
            }
        } else if (selectedCheckoutFilter === 'L/O') {
                // L/O: Only compatible with L/I checkin
            if (checkinType === 'L/I') {
                belongsToCheckout = true;
                    checkoutPriority = 1; // Yellow priority
                }
            }

            // Check if room matches BOTH filters
            const matchesBothFilters = belongsToCheckin && belongsToCheckout && selectedCheckinFilter && selectedCheckoutFilter;
            
            // Check if room is incompatible with selected filters
            if (selectedCheckinFilter && selectedCheckoutFilter) {
                // Both filters selected - check if room is incompatible
                if ((selectedCheckinFilter === 'R/I' && checkoutType === 'L/O') || 
                    (selectedCheckoutFilter === 'L/O' && checkinType === 'R/I')) {
                    // Room is incompatible - don't add to any container
                    return;
                }
            } else if (selectedCheckinFilter) {
                // Only check-in filter selected - check if room is incompatible
                if (selectedCheckinFilter === 'R/I' && checkoutType === 'L/O') {
                    // Room is incompatible - don't add to any container
                    return;
                }
            } else if (selectedCheckoutFilter) {
                // Only check-out filter selected - check if room is incompatible
                if (selectedCheckoutFilter === 'L/O' && checkinType === 'R/I') {
                    // Room is incompatible - don't add to any container
                    return;
                }
            }
            
            // Add room to appropriate section with priority
            if (matchesBothFilters) {
                // Room matches both filters - add to special section
                room.bothFiltersPriority = Math.max(checkinPriority, checkoutPriority); // Use higher priority
                bothFiltersRooms.push(room);
            } else if (belongsToCheckin && selectedCheckinFilter) {
                room.checkinPriority = checkinPriority; // Store priority for sorting
                checkinRooms.push(room);
            } else if (belongsToCheckout && selectedCheckoutFilter) {
                room.checkoutPriority = checkoutPriority; // Store priority for sorting
                checkoutRooms.push(room);
            } else {
                // Add to other rooms if it doesn't match check-in/check-out filters
                // or if no check-in/check-out filters are selected
                otherRooms.push(room);
            }
        });



        // Generate HTML for each section
        const generateRoomHTML = (rooms, sectionType = 'other') => {
            if (rooms.length === 0) return '';
            
            // Sort rooms by priority first (if it's check-in, check-out, or both filters section)
            let sortedRooms = rooms;
            if (sectionType === 'checkin') {
                sortedRooms = rooms.sort((a, b) => {
                    const priorityA = a.checkinPriority || 0;
                    const priorityB = b.checkinPriority || 0;
                    return priorityB - priorityA; // Higher priority first (Yellow before Red)
                });
            } else if (sectionType === 'checkout') {
                sortedRooms = rooms.sort((a, b) => {
                    const priorityA = a.checkoutPriority || 0;
                    const priorityB = b.checkoutPriority || 0;
                    return priorityB - priorityA; // Higher priority first (Red before Yellow)
                });
            } else if (sectionType === 'bothFilters') {
                sortedRooms = rooms.sort((a, b) => {
                    const priorityA = a.bothFiltersPriority || 0;
                    const priorityB = b.bothFiltersPriority || 0;
            return priorityB - priorityA; // Higher priority first
        });
            }
            
            // Group rooms by floor
            const roomsByFloor = sortedRooms.reduce((floors, room) => {
                if (!floors[room.ROOM_FLOOR]) {
                    floors[room.ROOM_FLOOR] = [];
                }
                floors[room.ROOM_FLOOR].push(room);
                return floors;
            }, {});

            let html = '';
            Object.keys(roomsByFloor).sort((a, b) => a - b).forEach(floor => {
                const floorRooms = roomsByFloor[floor];
                html += '<div class="room-row">';
                floorRooms.forEach(room => {
                    let roomStyle = "";
                    let isDisabled = false;

                    // Check if this room type is fully reserved for unassigned bookings
                    if (window.fullyReservedBedTypes && window.fullyReservedBedTypes[room.ROOM_BED]) {
                        isDisabled = true;
                        roomStyle += "opacity: 0.5; cursor: not-allowed; background-color: #f5f5f5 !important; border: 2px dashed #ccc !important;";
                    }

                    // Assign styles based on the floor number
                    if (floor == 3) {
                        roomStyle += "color: #4CAF50; border-top: 2px solid #4CAF50;";
                    } else if (floor == 4) {
                        roomStyle += "color: #1e1bd6; border-top: 2px solid #1e1bd6;";
                    } else if (floor == 5) {
                        roomStyle += "color: #df1818; border-top: 2px solid #df1818;";
                    } else if (floor == 6) {
                        roomStyle += "color: #8A2BE2; border-top: 2px solid #8A2BE2;";
                    }

                    // Build background colors for mixed statuses (only if not disabled)
                    if (!isDisabled) {
                        let checkoutColor = '';
                        let checkinColor = '';
                        
                        // If the room has checkoutToday == true, check the checkout type
                        if (room.checkoutToday) {
                            if (room.checkoutType === 'L/O') {
                                checkoutColor = '#FFF700'; // Bold Pastel Yellow for late check-out
                            } else if (room.checkoutType === 'R/O') {
                                checkoutColor = '#FF7F7F'; // Bold Pastel Pink for regular check-out
                            }
                        }
                        
                        // Additional styling for check-in types (for check-out filters)
                        if (room.checkinType === 'R/I') {
                            checkinColor = '#FF7F7F'; // Bold Pastel Pink for regular check-in
                        } else if (room.checkinType === 'L/I') {
                            checkinColor = '#FFF700'; // Bold Pastel Yellow for late check-in
                        }
                        
                        // Apply background colors - gradient if both colors exist, solid if single
                        if (checkoutColor && checkinColor) {
                            // Both colors exist - create gradient (checkout left, checkin right)
                            const gradient = `linear-gradient(90deg, ${checkoutColor}, ${checkinColor})`;
                            roomStyle += `background: ${gradient};`;
                        } else if (checkoutColor) {
                            // Only checkout color
                            roomStyle += `background-color: ${checkoutColor};`;
                        } else if (checkinColor) {
                            // Only checkin color
                            roomStyle += `background-color: ${checkinColor};`;
                        }
                    }

                    // Add special styling for "both filters" section
                    let bothFiltersStyle = "";
                    let bothFiltersIndicator = "";
                    if (sectionType === 'bothFilters') {
                        bothFiltersStyle += "border: 3px solid #4CAF50 !important; box-shadow: 0 0 10px rgba(76, 175, 80, 0.5) !important;";
                        bothFiltersIndicator = '<br><small style="font-size: 8px; color: #4CAF50; font-weight: bold;">⚡ BOTH</small>';
                    }

                    // Add room item with specific styles
                    html += `<div class="room-item" 
                        style="${roomStyle}${bothFiltersStyle}"
                        data-bed="${room.ROOM_BED}" 
                        data-view="${room.ROOM_VIEW}" 
                        data-category="${room.ROOM_BED}B"
                        data-checkout-type="${room.checkoutType || ''}"
                        data-checkin-type="${room.checkinType || ''}"
                        data-disabled="${isDisabled}">
                        
                        <a href="#" class="room-link ${isDisabled ? 'disabled-room' : ''}" 
                           data-room-id="${room.IDNo}" 
                           data-room-number="${room.ROOM_NUMBER}" 
                           data-floor="${room.ROOM_FLOOR}"
                           data-bed="${room.ROOM_BED}"
                           data-disabled="${isDisabled}"
                           ${isDisabled ? 'onclick="return false;"' : ''}>
                           ${room.ROOM_NUMBER}
                           ${isDisabled ? '<br><small style="font-size: 8px; color: #999;">Reserved</small>' : ''}
                           ${bothFiltersIndicator}
                        </a>
                    </div>`;
                });
                html += '</div><br>';
            });
            return html;
        };

        // Populate Check-in section (with priority sorting)
        if (checkinRooms.length > 0) {
            checkinContainer.innerHTML = generateRoomHTML(checkinRooms, 'checkin'); // checkin section
    } else {
        checkinContainer.innerHTML = '<div style="text-align: center; color: #666; font-style: italic; padding: 20px;">No rooms match Check-in filter</div>';
    }

        // Populate Check-out section (with priority sorting)
    if (checkoutRooms.length > 0) {
            checkoutContainer.innerHTML = generateRoomHTML(checkoutRooms, 'checkout'); // checkout section
    } else {
        checkoutContainer.innerHTML = '<div style="text-align: center; color: #666; font-style: italic; padding: 20px;">No rooms match Check-out filter</div>';
    }

        // Populate Both Filters section (with priority sorting)
        if (bothFiltersRooms.length > 0) {
            bothFiltersContainer.innerHTML = generateRoomHTML(bothFiltersRooms, 'bothFilters'); // both filters section
            bothFiltersSection.style.display = 'block'; // Show the section
        } else {
            bothFiltersSection.style.display = 'none'; // Hide the section
        }

    // Populate Other Available Rooms section
    if (otherRooms.length > 0) {
            otherContainer.innerHTML = generateRoomHTML(otherRooms, 'other'); // other section
    } else {
        otherContainer.innerHTML = '<div style="text-align: center; color: #666; font-style: italic; padding: 20px;">No other available rooms</div>';
    }

   // Set the counts - count all rooms that are actually displayed (compatible rooms only)
   const displayedRooms = [...checkinRooms, ...checkoutRooms, ...bothFiltersRooms, ...otherRooms];
        const availableCount = displayedRooms.filter(room => !window.fullyReservedBedTypes || !window.fullyReservedBedTypes[room.ROOM_BED]).length;
        document.getElementById('availableRoomCount').textContent = availableCount;
    
    // Filter unassigned bookings by bed type and set count
    let filteredUnassignedCount = 0;
    if (window.currentUnassignedBookings) {
        if (selectedBedFilter === 'all') {
            filteredUnassignedCount = window.currentUnassignedBookings.length;
        } else {
            // Filter unassigned bookings by bed type
            const bedType = selectedBedFilter === '1B' ? '1' : '2';
            filteredUnassignedCount = window.currentUnassignedBookings.filter(booking => 
                booking.BED_COUNT == bedType
            ).length;
        }
    }
    document.getElementById('unassignedBookingCount').textContent = filteredUnassignedCount;
    
    // Update warning message based on current filter
    updateWarningMessage(selectedBedFilter);

}




		function generateRoomListHTML(rooms) {
    if (rooms.length === 0) {
        return '<p>No available rooms for the selected date range.</p>';
    }

    // Check for bed conflicts to determine which rooms should be disabled
    const unassignedBookings = window.currentUnassignedBookings || [];
    const bedsNeeded = {};
    unassignedBookings.forEach(booking => {
        const bedCount = booking.BED_COUNT || 1;
        bedsNeeded[bedCount] = (bedsNeeded[bedCount] || 0) + 1;
    });
    
    const bedsAvailable = {};
    rooms.forEach(room => {
        const bedCount = room.ROOM_BED;
        bedsAvailable[bedCount] = (bedsAvailable[bedCount] || 0) + 1;
    });
    
    // Determine which bed types are fully reserved
    const fullyReservedBedTypes = {};
    Object.keys(bedsNeeded).forEach(bedCount => {
        const needed = bedsNeeded[bedCount];
        const available = bedsAvailable[bedCount] || 0;
        if (needed > 0 && available > 0 && needed >= available) {
            fullyReservedBedTypes[bedCount] = true;
        }
    });

    // Group rooms by floor
    const roomsByFloor = rooms.reduce((floors, room) => {
        if (!floors[room.ROOM_FLOOR]) {
            floors[room.ROOM_FLOOR] = [];
        }
        floors[room.ROOM_FLOOR].push(room);
        return floors;
    }, {});

    let html = '';

   // Iterate through floors and create rows
Object.keys(roomsByFloor).sort((a, b) => a - b).forEach(floor => {
    const rooms = roomsByFloor[floor];
    html += '<div class="room-row">';
    rooms.forEach(room => {
        let roomStyle = ""; // Define styles for each room dynamically
        let isDisabled = false;

        // Check if this room type is fully reserved for unassigned bookings
        if (fullyReservedBedTypes[room.ROOM_BED]) {
            isDisabled = true;
            roomStyle += "opacity: 0.5; cursor: not-allowed; background-color: #f5f5f5 !important; border: 2px dashed #ccc !important;";
        }

        // Assign styles based on the floor number
        if (floor == 3) {
        roomStyle += "color: #4CAF50; border-top: 2px solid #4CAF50;";
    } else if (floor == 4) {
        roomStyle += "color: #1e1bd6; border-top: 2px solid #1e1bd6;";
    } else if (floor == 5) {
        roomStyle += "color: #df1818; border-top: 2px solid #df1818;";
    } else if (floor == 6) {
        roomStyle += "color: #8A2BE2; border-top: 2px solid #8A2BE2;";
    }

    // Build background colors for mixed statuses (only if not disabled)
    if (!isDisabled) {
                        let checkoutColor = '';
                        let checkinColor = '';
        
        // If the room has checkoutToday == true, check the checkout type
        if (room.checkoutToday) {
            if (room.checkoutType === 'L/O') {
                                checkoutColor = '#FFF700'; // Bold Pastel Yellow for late check-out
            } else if (room.checkoutType === 'R/O') {
                                checkoutColor = '#FF7F7F'; // Bold Pastel Pink for regular check-out
            }
        }
        
        // Additional styling for check-in types (for check-out filters)
        if (room.checkinType === 'R/I') {
                            checkinColor = '#FF7F7F'; // Bold Pastel Pink for regular check-in
        } else if (room.checkinType === 'L/I') {
                            checkinColor = '#FFF700'; // Bold Pastel Yellow for late check-in
                        }
                        
                        // Apply background colors - gradient if both colors exist, solid if single
                        if (checkoutColor && checkinColor) {
                            // Both colors exist - create gradient (checkout left, checkin right)
                            const gradient = `linear-gradient(90deg, ${checkoutColor}, ${checkinColor})`;
                roomStyle += `background: ${gradient};`;
                        } else if (checkoutColor) {
                            // Only checkout color
                            roomStyle += `background-color: ${checkoutColor};`;
                        } else if (checkinColor) {
                            // Only checkin color
                            roomStyle += `background-color: ${checkinColor};`;
        }
    }
        // Add room item with specific styles
        html += `<div class="room-item" 
    style="${roomStyle}"
    data-bed="${room.ROOM_BED}" 
    data-view="${room.ROOM_VIEW}" 
    data-category="${room.ROOM_BED}B"
    data-checkout-type="${room.checkoutType || ''}"
    data-checkin-type="${room.checkinType || ''}"
    data-disabled="${isDisabled}">
    
    <a href="#" class="room-link ${isDisabled ? 'disabled-room' : ''}" 
       data-room-id="${room.IDNo}" 
       data-room-number="${room.ROOM_NUMBER}" 
       data-floor="${room.ROOM_FLOOR}"
       data-bed="${room.ROOM_BED}"
       data-disabled="${isDisabled}"
       ${isDisabled ? 'onclick="return false;"' : ''}>
       ${room.ROOM_NUMBER}
       ${isDisabled ? '<br><small style="font-size: 8px; color: #999;">Reserved</small>' : ''}
    </a>
</div>`;

    });
    html += '</div><br>'; // Add spacing between floors
});

return html;
}

		function generateUnassignedBookingsHTML(unassignedBookings) {
    if (!unassignedBookings || unassignedBookings.length === 0) {
        return '<p style="text-align: center; color: #666; font-style: italic; margin: 20px 0;">No unassigned bookings found.</p>';
    }

    let html = '<div class="unassigned-bookings-container" style="margin-top: 20px;">';
    html += '<h4 style="color: #333; margin-bottom: 15px; border-bottom: 1px solid #ddd; padding-bottom: 5px;">📋 Unassigned Rooms</h4>';
    html += '<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">';
    
    unassignedBookings.forEach(booking => {
        const checkInDate = new Date(booking.CHECK_IN_DATE).toLocaleDateString('en-US', { 
            month: 'short', 
            day: 'numeric', 
            year: 'numeric' 
        });
        const checkOutDate = new Date(booking.CHECK_OUT_DATE).toLocaleDateString('en-US', { 
            month: 'short', 
            day: 'numeric', 
            year: 'numeric' 
        });
        
        html += `
            <div class="unassigned-booking-item" 
                 style="background: #f8f9fa; 
                        border: 1px solid #dee2e6; 
                        border-radius: 6px; 
                        padding: 10px;">
                <div style="font-size: 13px; color: #333;">
                    <strong>${booking.customerName || 'Unknown Guest'}</strong> 
                    <span style="color: #666;">(#${booking.CONFIRMATION_NUMBER})</span>
                    <br>
                    📅 ${checkInDate} - ${checkOutDate} 
                    ${booking.BED_COUNT ? `• 🛏️ ${booking.BED_COUNT} bed${booking.BED_COUNT > 1 ? 's' : ''}` : ''}
                </div>
            </div>
        `;
    });
    
    html += '</div></div>';
    return html;
}



function getSeasonalPrice(seasonalPrices, bedCount, bookingType) {
  return seasonalPrices.find(p =>
    parseInt(p.bedCount) === parseInt(bedCount) &&
    p.bookingType === bookingType
  );
}

