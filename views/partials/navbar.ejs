//logout
function logout() {
    // Show loading state
    const logoutBtn = event.target.closest('a');
    const originalText = logoutBtn.innerHTML;
    logoutBtn.innerHTML = '<i class="zmdi zmdi-spinner zmdi-hc-spin"></i> Logging out...';
    logoutBtn.style.pointerEvents = 'none';
    
    // Make AJAX request to logout
    $.ajax({
        url: '/logout',
        method: 'POST',
        contentType: 'application/json',
        success: function(response) {
            if (response.success) {
                // Redirect directly to login page
                window.location.href = response.redirectUrl || '/login';
            } else {
                // Show error message only
                alert(response.message || 'Logout failed');
                // Restore button state
                logoutBtn.innerHTML = originalText;
                logoutBtn.style.pointerEvents = 'auto';
            }
        },
        error: function(xhr) {
            let errorMessage = 'An error occurred during logout';
            
            if (xhr.responseJSON && xhr.responseJSON.message) {
                errorMessage = xhr.responseJSON.message;
            }
            
            alert(errorMessage);
            // Restore button state
            logoutBtn.innerHTML = originalText;
            logoutBtn.style.pointerEvents = 'auto';
        }
    });
}
