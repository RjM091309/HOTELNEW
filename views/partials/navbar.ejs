    function filterRooms() {
    const input = document.getElementById('roomSearchInput').value.toLowerCase();
    const selectedBedFilter = document.querySelector('input[name="bedFilter"]:checked').value;
    const checkedCheckinEl = document.querySelector('input[name="checkinFilter"]:checked');
    const checkedCheckoutEl = document.querySelector('input[name="checkoutFilter"]:checked');
    const selectedCheckinFilter = checkedCheckinEl ? checkedCheckinEl.value : '';
    const selectedCheckoutFilter = checkedCheckoutEl ? checkedCheckoutEl.value : '';
    const rooms = document.querySelectorAll('.room-item');
    let visibleCount = 0;

    rooms.forEach(room => {
        const roomNumber = room.querySelector('.room-link').textContent.toLowerCase();
        const category = room.getAttribute('data-category');
        const checkoutType = room.getAttribute('data-checkout-type');
        const checkinType = room.getAttribute('data-checkin-type');

        const matchesSearch = roomNumber.includes(input);
        
        // Check bed filter
        let matchesBedFilter = false;
        if (selectedBedFilter === 'all') {
            matchesBedFilter = true;
        } else {
            matchesBedFilter = category === selectedBedFilter;
        }
        
        // Check check-in filter
        let matchesCheckinFilter = true; // Default to true to show all rooms
        let priority = 0; // Priority for sorting (higher = shown first)
        
        if (selectedCheckinFilter === 'R/I') {
            // R/I: Show Regular Check-out rooms (R/O) + rooms with no check-out
            matchesCheckinFilter = checkoutType === 'R/O' || checkoutType === null || checkoutType === '';
            if (checkoutType === 'R/O') {
                priority = 4; // Highest priority for R/I rooms
            } else if (checkoutType === null || checkoutType === '') {
                priority = 3; // High priority for rooms with no check-out
            }
        } else if (selectedCheckinFilter === 'L/I') {
            // L/I: Show all Check-out rooms (both R/O and L/O) + rooms with no check-out
            matchesCheckinFilter = checkoutType === 'R/O' || checkoutType === 'L/O' || checkoutType === null || checkoutType === '';
            if (checkoutType === 'L/O') {
                priority = 4; // Highest priority for L/I rooms
            } else if (checkoutType === 'R/O') {
                priority = 3; // High priority for R/O rooms
            } else if (checkoutType === null || checkoutType === '') {
                priority = 2; // Medium priority for rooms with no check-out
            }
        }
        
        // Check check-out filter
        let matchesCheckoutFilter = true; // Default to true to show all rooms
        
        if (selectedCheckoutFilter === 'R/O') {
            // R/O: Show all check-in rooms + other available rooms
            matchesCheckoutFilter = checkinType === 'R/I' || checkinType === 'L/I' || checkinType === null || checkinType === '';
            if (checkinType === 'R/I') {
                priority = 5; // Highest priority for Regular check-in (R/O)
            } else if (checkinType === 'L/I') {
                priority = 4; // High priority for Late check-in (R/O)
            } else if (checkinType === null || checkinType === '') {
                priority = Math.max(priority, 2); // Medium priority for other available rooms
            }
        } else if (selectedCheckoutFilter === 'L/O') {
            // L/O: Show Late check-in rooms + other available rooms
            matchesCheckoutFilter = checkinType === 'L/I' || checkinType === null || checkinType === '';
            if (checkinType === 'L/I') {
                priority = 5; // Highest priority for Late check-in (L/O)
            } else if (checkinType === null || checkinType === '') {
                priority = Math.max(priority, 2); // Medium priority for other available rooms
            }
        }
        
        // Store priority for sorting
        room.setAttribute('data-priority', priority);

        const shouldShow = matchesSearch && matchesBedFilter && matchesCheckinFilter && matchesCheckoutFilter;
        room.style.display = shouldShow ? 'flex' : 'none';

        // Count all rooms that match bed filter and search (regardless of other filters)
        const shouldCount = matchesSearch && matchesBedFilter;
        if (shouldCount) visibleCount++;
    });

    // Sort rooms by priority and create separate sections at the top
    const containerElement = document.querySelector('.scrollable-containers');
    const allRoomItems = Array.from(document.querySelectorAll('.room-item'));
    const priorityGroups = {};
    
    // Group all rooms by priority
    allRoomItems.forEach(item => {
        const priority = parseInt(item.getAttribute('data-priority') || '0');
        if (!priorityGroups[priority]) {
            priorityGroups[priority] = [];
        }
        priorityGroups[priority].push(item);
    });
    
    // Clear the scrollable containers
    containerElement.innerHTML = '';
    
    // Add rooms by priority (highest priority first)
    const priorities = Object.keys(priorityGroups).sort((a, b) => b - a);
    priorities.forEach(priority => {
        if (priorityGroups[priority].length > 0) {
            // Create a new section for this priority level
            const prioritySection = document.createElement('div');
            prioritySection.className = 'priority-section';
            prioritySection.style.marginBottom = '20px';
            
            // Add priority label
            const priorityLabel = document.createElement('div');
            priorityLabel.style.cssText = 'font-weight: bold; color: #333; margin-bottom: 10px; font-size: 14px; text-align: center; background-color: #f0f0f0; padding: 8px; border-radius: 5px;';
            
            if (priority === 5) {
                if (selectedCheckoutFilter === 'R/O') {
                    priorityLabel.textContent = 'R/O Priority Rooms';
                } else if (selectedCheckoutFilter === 'L/O') {
                    priorityLabel.textContent = 'L/O Priority Rooms';
                } else {
                    priorityLabel.textContent = 'Highest Priority Rooms';
                }
            } else if (priority === 4) {
                if (selectedCheckinFilter === 'R/I') {
                    priorityLabel.textContent = 'R/I Priority Rooms';
                } else if (selectedCheckinFilter === 'L/I') {
                    priorityLabel.textContent = 'L/I Priority Rooms';
                } else if (selectedCheckoutFilter === 'R/O') {
                    priorityLabel.textContent = 'R/O Secondary Rooms';
                } else {
                    priorityLabel.textContent = 'High Priority Rooms';
                }
            } else if (priority === 3) {
                priorityLabel.textContent = 'Secondary Priority Rooms';
            } else if (priority === 2) {
                priorityLabel.textContent = 'Available Rooms';
            } else if (priority === 1) {
                priorityLabel.textContent = 'Other Rooms';
            } else if (priority === 0) {
                priorityLabel.textContent = 'Standard Rooms';
            }
            prioritySection.appendChild(priorityLabel);
            
            // Create room row for this priority
            const priorityRow = document.createElement('div');
            priorityRow.className = 'room-row';
            
            // Add rooms to this priority row
            priorityGroups[priority].forEach(item => {
                priorityRow.appendChild(item);
            });
            
            prioritySection.appendChild(priorityRow);
            containerElement.appendChild(prioritySection);
        }
    });

    // Set the counts
    document.getElementById('availableRoomCount').textContent = visibleCount;
    
    // Set unassigned booking count
    const unassignedCount = window.currentUnassignedBookings ? window.currentUnassignedBookings.length : 0;
    document.getElementById('unassignedBookingCount').textContent = unassignedCount;
    
    // Show "No available rooms" message if no rooms match the filters
    const scrollableContainers = document.querySelector('.scrollable-containers');
    const noRoomsMessage = scrollableContainers.querySelector('.no-rooms-message');
    
    if (visibleCount === 0) {
        if (!noRoomsMessage) {
            const message = document.createElement('div');
            message.className = 'no-rooms-message';
            message.style.cssText = 'position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #666; font-style: italic; z-index: 10;';
            scrollableContainers.style.position = 'relative';
            scrollableContainers.style.minHeight = '200px';
            message.textContent = 'No available rooms match your selected filters.';
            scrollableContainers.appendChild(message);
        }
    } else {
        if (noRoomsMessage) {
            noRoomsMessage.remove();
        }
    }
}




