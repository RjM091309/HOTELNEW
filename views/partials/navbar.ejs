      function getSeasonIdForDate(checkInDate, seasonalPrices) {
  const checkIn = new Date(checkInDate);
  const mmdd = (checkIn.getMonth() + 1).toString().padStart(2, '0') + checkIn.getDate().toString().padStart(2, '0');

  const seen = new Set();

  for (const p of seasonalPrices) {
    if (!p.startDate || !p.endDate || seen.has(p.seasonId)) continue;
    seen.add(p.seasonId);

    const start = new Date(p.startDate);
    const end = new Date(p.endDate);

    const startMMDD = (start.getMonth() + 1).toString().padStart(2, '0') + start.getDate().toString().padStart(2, '0');
    const endMMDD = (end.getMonth() + 1).toString().padStart(2, '0') + end.getDate().toString().padStart(2, '0');

    if (startMMDD <= endMMDD) {
      if (mmdd >= startMMDD && mmdd <= endMMDD) return p.seasonId;
    } else {
      if (mmdd >= startMMDD || mmdd <= endMMDD) return p.seasonId;
    }
  }

  return null;
}




      // 🧠 Function to calculate seasonal price and update DOM
      function updateSeasonalPrice() {
  const selectedBedCount = bedCountField.value;
  const selectedBookingType = document.querySelector('#bookingRoute').value;
  const currentSeasonId = getSeasonIdForDate(startDate, seasonalPrices); // from "const [startDate, endDate] = ..."


  const match = seasonalPrices.find(p =>
    parseInt(p.bedCount) === parseInt(selectedBedCount) &&
    p.bookingType === selectedBookingType &&
    parseInt(p.seasonId) === parseInt(currentSeasonId)
  );

  const nights = parseFloat(diffInDaysField.value || 0);
  let pricePerNight = 0;

  if (match) {
    pricePerNight = parseFloat(match.price);
  } else {
    console.warn('No match for seasonal price — fallback to default ROOM_PRICE');
    pricePerNight = parseFloat(roomDetails.ROOM_PRICE);
  }

  // roomPriceField.value = (pricePerNight * nights).toFixed(2);
  roomPriceField.value = pricePerNight.toFixed(2);
  basePriceField.value = pricePerNight.toFixed(2);
}

function computeTotal() {
  const roomRate = $('#manualPriceToggle').prop('checked')
    ? parseFloat($('#price').val()) || 0
    : parseFloat($('#baseprice').val()) || 0;

  const nights = parseInt($('#diffindays').val()) || 1;

  const adultQty = parseInt($('#breakfastAdultQty').val()) || 0;
  const adultPrice = parseFloat($('#breakfastAdultPrice').val()) || 0;
  const kidQty = parseInt($('#breakfastKidQty').val()) || 0;
  const kidPrice = parseFloat($('#breakfastKidPrice').val()) || 0;

  const pickupChecked = $('#includePickup').prop('checked');
  const dropoffChecked = $('#includeDropoff').prop('checked');

  const pickupPrice = pickupChecked ? parseFloat($('#pickupPrice').val()) || 0 : 0;
  const dropoffPrice = dropoffChecked ? parseFloat($('#dropoffPrice').val()) || 0 : 0;

  const total =
    (roomRate * nights) +
    (adultQty * adultPrice) +
    (kidQty * kidPrice) +
    pickupPrice +
    dropoffPrice;

    $('#computedTotal').html('<b>' + total.toLocaleString(undefined, { minimumFractionDigits: 2 }) + '</b>');

}
      // 🔁 Initial trigger
      updateSeasonalPrice();

      // 🔁 Bind update when booking type changes
      document.querySelector('#bookingRoute').addEventListener('change', updateSeasonalPrice);
      $(document).on('input change', '#bookingRoute, #price, #baseprice, #diffindays, #breakfastAdultQty, #breakfastAdultPrice, #breakfastKidQty, #breakfastKidPrice, #pickupPrice, #dropoffPrice, #pickupLocation, #dropoffLocation, #includePickup, #includeDropoff', function () {
    computeTotal();
});

      // ✅ Show modal
      const addBookingModalElement = document.getElementById('modal-addbooking');
      if (addBookingModalElement) {
        Swal.close();
        document.body.classList.add('custom-booking-layout'); // 👈 add this
        addBookingModalElement.classList.add('from-datepicker'); // Add class for datePicker styling
        const addBookingModal = new bootstrap.Modal(addBookingModalElement);
        addBookingModal.show();
        computeTotal()

        document.getElementById('daterange').disabled = true;
        document.getElementById('addFloor').disabled = true;
        document.getElementById('addroom').disabled = true;
        document.getElementById('groupBookingCheckbox').parentElement.style.display = 'none';
      } else {
        console.error('Modal element not found in the DOM');
      }
    })
    .catch(error => console.error('Error fetching room details:', error));
  }
});



