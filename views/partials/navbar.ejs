            }
            
            // Validate price is set (not 0.00)
            const priceValue = parseFloat($('#baseprice').val() || $('#price').val() || '0.00');
            if (priceValue <= 0) {
                Swal.fire({
                    title: 'Price Not Set',
                    text: 'Please select a Bed Count to automatically calculate the room price.',
                    icon: 'warning',
                    confirmButtonText: 'OK'
                });
                return;
            }
        }

        // Perform AJAX request to save booking
        $.ajax({
            url: '/booking/add_booking',
            type: 'POST',
            data: formData,
            success: function (response) {
                $('#modal-addbooking').modal('hide');
                if (response.success) {
                    const qrCodeImg = `<img src="https://api.qrserver.com/v1/create-qr-code/?data=${encodeURIComponent(response.confirmationNumber)}&size=150x150" alt="QR Code" />`;
                   
                    Swal.fire({
                        title: 'Booking Successful!',
