// Function to update price based on bed count for unassigned rooms
function updatePriceForBedCount(bedCount) {
    if (!bedCount || bedCount === '') {
        // Reset price if no bed count selected
        const priceField = document.querySelector('#price');
        const basePriceField = document.querySelector('#baseprice');
        if (priceField) priceField.value = '0.00';
        if (basePriceField) basePriceField.value = '0.00';
        
        // Recalculate total
        if (typeof computeTotal === 'function') {
            computeTotal();
        }
        return;
    }
    
    try {
        // Get booking type from booking route select
        const bookingRouteField = document.querySelector('#bookingRoute');
        const bookingType = (typeof window.getPriceBookingType === 'function')
            ? window.getPriceBookingType()
            : (bookingRouteField ? bookingRouteField.value : 'walk-in');
        
        // Get check-in date from date range field
        const dateRangeField = document.querySelector('#daterange');
        if (!dateRangeField || !dateRangeField.value) {
            console.warn('Date range not available');
            return;
        }
        
        const dateRange = dateRangeField.value;
        const [startDateStr] = dateRange.split(' to ');
        const startDate = new Date(startDateStr.trim());
        
        if (isNaN(startDate.getTime())) {
            console.warn('Invalid check-in date');
            return;
        }
        
        // Get available rooms data (already loaded from modal)
        const availableRooms = window.currentRoomsData ? (window.currentRoomsData.rooms || []) : [];
        
        // Find a room with matching bed count to get seasonal prices
        let matchingRoom = availableRooms.find(room => String(room.ROOM_BED) === String(bedCount));
        
        // If no room found or no seasonal prices, fetch from API
        if (!matchingRoom || !matchingRoom.SEASONAL_PRICES || matchingRoom.SEASONAL_PRICES.length === 0) {
            // Try to get room details from API using first available room with matching bed count
            const anyRoomWithBedCount = availableRooms.find(room => String(room.ROOM_BED) === String(bedCount));
            
            if (anyRoomWithBedCount && anyRoomWithBedCount.IDNo) {
                // Fetch room details with seasonal prices from API
                fetch('/booking/get-room-details', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roomId: anyRoomWithBedCount.IDNo })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.roomDetails) {
                        // Use the fetched room details
                        matchingRoom = {
                            ...anyRoomWithBedCount,
                            SEASONAL_PRICES: data.roomDetails.SEASONAL_PRICES || [],
                            ROOM_PRICE: data.roomDetails.ROOM_PRICE
                        };
                        calculateAndUpdatePrice(matchingRoom, bedCount, bookingType, startDate);
                    } else {
                        // Fallback to default price
                        useDefaultPrice(anyRoomWithBedCount);
                    }
                })
                .catch(error => {
                    console.error('Error fetching room details:', error);
                    // Fallback to default price
                    if (anyRoomWithBedCount) {
                        useDefaultPrice(anyRoomWithBedCount);
                    }
                });
                return; // Exit early, will continue in fetch callback
            } else {
                // No room found, use default or zero
                const priceField = document.querySelector('#price');
                const basePriceField = document.querySelector('#baseprice');
                if (priceField) priceField.value = '0.00';
                if (basePriceField) basePriceField.value = '0.00';
                if (typeof computeTotal === 'function') computeTotal();
                return;
            }
        }
        
        // If we have matching room with seasonal prices, calculate price
        calculateAndUpdatePrice(matchingRoom, bedCount, bookingType, startDate);
    } catch (error) {
        console.error('Error updating price for bed count:', error);
    }
}

// Helper function to calculate and update price
function calculateAndUpdatePrice(matchingRoom, bedCount, bookingType, startDate) {
    try {
        const seasonalPrices = matchingRoom.SEASONAL_PRICES || [];
        
        if (seasonalPrices.length === 0) {
            // Use default room price
            useDefaultPrice(matchingRoom);
            return;
        }
        
        // Function to get season ID for check-in date
        function getSeasonIdForDate(checkInDate, seasonalPrices) {
            const checkIn = new Date(checkInDate);
            const mmdd = (checkIn.getMonth() + 1).toString().padStart(2, '0') + checkIn.getDate().toString().padStart(2, '0');
            
            const seen = new Set();
            for (const p of seasonalPrices) {
                if (!p.startDate || !p.endDate || seen.has(p.seasonId)) continue;
                seen.add(p.seasonId);
                
                const start = new Date(p.startDate);
                const end = new Date(p.endDate);
                
                const startMMDD = (start.getMonth() + 1).toString().padStart(2, '0') + start.getDate().toString().padStart(2, '0');
                const endMMDD = (end.getMonth() + 1).toString().padStart(2, '0') + end.getDate().toString().padStart(2, '0');
                
                if (startMMDD <= endMMDD) {
                    if (mmdd >= startMMDD && mmdd <= endMMDD) return p.seasonId;
                } else {
                    if (mmdd >= startMMDD || mmdd <= endMMDD) return p.seasonId;
                }
            }
            return null;
        }
        
        // Find matching seasonal price
        const currentSeasonId = getSeasonIdForDate(startDate, seasonalPrices);
        const match = seasonalPrices.find(p =>
            parseInt(p.bedCount) === parseInt(bedCount) &&
            p.bookingType === bookingType &&
            parseInt(p.seasonId) === parseInt(currentSeasonId)
        );
        
        let pricePerNight = 0;
        
        if (match) {
            pricePerNight = parseFloat(match.price) || 0;
        } else {
            // Fallback: try to find price with same bed count and booking type (any season)
            const fallbackMatch = seasonalPrices.find(p =>
                parseInt(p.bedCount) === parseInt(bedCount) &&
                p.bookingType === bookingType
            );
            
            if (fallbackMatch) {
                pricePerNight = parseFloat(fallbackMatch.price) || 0;
            } else {
                // Last fallback: use room default price
                pricePerNight = parseFloat(matchingRoom.ROOM_PRICE) || 0;
                console.warn('Using default room price as fallback');
            }
        }
        
        // Update price fields
        const priceField = document.querySelector('#price');
        const basePriceField = document.querySelector('#baseprice');
        
        if (priceField) {
            priceField.value = pricePerNight.toFixed(2);
        }
        if (basePriceField) {
            basePriceField.value = pricePerNight.toFixed(2);
        }
        
        // Recalculate total
        if (typeof computeTotal === 'function') {
            computeTotal();
        }
        
        console.log('Price updated for bed count:', bedCount, 'Price:', pricePerNight);
    } catch (error) {
        console.error('Error calculating price:', error);
        useDefaultPrice(matchingRoom);
    }
}

// Helper function to use default room price
function useDefaultPrice(room) {
    const priceField = document.querySelector('#price');
    const basePriceField = document.querySelector('#baseprice');
    const defaultPrice = parseFloat(room.ROOM_PRICE) || 0;
    
    if (priceField) priceField.value = defaultPrice.toFixed(2);
    if (basePriceField) basePriceField.value = defaultPrice.toFixed(2);
    
    if (typeof computeTotal === 'function') {
        computeTotal();
    }
}

