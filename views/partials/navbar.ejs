            // ✅ Include reservation fee and discount
            reservationFee: $('#includeReservationFee').prop('checked') ? $('#reservationFeeAmount').val() : '0.00',
            discount: $('#includeDiscount').prop('checked') ? $('#discountAmount').val() : '0.00',
