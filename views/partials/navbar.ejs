<script>

flatpickr("#datePicker", {
    altInput: true, // Enables a separate input field for display
    showMonths: 2, // Display two months side by side
    altFormat: "M d, Y", // Format shown to the user (e.g., "Jan 6, 2025")
    dateFormat: "Y-m-d", // Format sent to the backend (e.g., "2025-01-06")
    mode: "range", // Allow range selection
    minDate: "today", // Disable past dates
    locale: { firstDayOfWeek: 1 }, // start week on Monday
    onClose: function (selectedDates, dateStr, instance) {
        if (selectedDates.length === 2) {
            // Get the start and end dates
            const startDate = selectedDates[0];
            const endDate = selectedDates[1];

            // Calculate the number of nights
            const diffInTime = endDate.getTime() - startDate.getTime();
            const nights = diffInTime / (1000 * 3600 * 24); // Convert time difference to days

            // Format the display string
            const formattedStartDate = flatpickr.formatDate(startDate, "M d, Y");
            const formattedEndDate = flatpickr.formatDate(endDate, "M d, Y");
            const formattedDateRange = `${formattedStartDate} to ${formattedEndDate} (${nights} night/s)`;

            // Update the Flatpickr input value
            instance.input.value = formattedDateRange;

            // Set the value in the Add Booking modal date range field
            const dateRangeField = document.querySelector("#daterange");
            if (dateRangeField) {
                dateRangeField.value = formattedDateRange;
            }

            // Set the value in the #diffindays field
            const diffInDaysField = document.querySelector("#diffindays");
            if (diffInDaysField) {
                diffInDaysField.value = nights; // Set the calculated nights
            }

            // Fetch available rooms using backend-compatible format
            fetchAvailableRooms(dateStr);
        } else {
            console.error("Please select both start and end dates.");
        }
    },
});

	
		function fetchAvailableRooms(dateRange) {

			console.log("Date Range passed to fetchAvailableRooms:", dateRange);

// Remove any extra text like `(1 night/s)`
const cleanDateRange = dateRange.split(' (')[0]; // Keep only the date range before `(`

// Split the cleaned date range into start and end dates
if (!cleanDateRange || !cleanDateRange.includes(" to ")) {
	console.error("Invalid date range format:", cleanDateRange);
	return;
}

			// Split the date range into start and end dates
			const [startDate, endDate] = cleanDateRange.split(" to ");
	
			// Perform an AJAX call to your server
			fetch('/booking/available-rooms', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({ startDate, endDate }),
			})
				.then(response => response.json())
				.then(data => {
					if (data.success) {
						// Check if available rooms = unassigned bookings (critical situation)
						const availableRoomsCount = data.rooms ? data.rooms.length : 0;
						const unassignedCount = data.unassignedBookings ? data.unassignedBookings.length : 0;
						
						// if (unassignedCount > 0 && availableRoomsCount <= unassignedCount) {
						// 	const bookingNames = data.unassignedBookings.map(b => b.customerName || 'Unknown Guest').join(', ');
							
						// 	Swal.fire({
						// 		title: 'No Room Available',
						// 		html: `
						// 			<div style="text-align: left;">
						// 				<p><strong>Current Status:</strong></p>
						// 				<p>Available Rooms: <strong style="color: #28a745;">${availableRoomsCount}</strong></p>
						// 				<p>Unassigned Bookings: <strong style="color: #dc3545;">${unassignedCount}</strong></p>
						// 				${availableRoomsCount === unassignedCount ? 
						// 					'<p style="margin: 15px 0;"><strong>You have exactly enough rooms for unassigned bookings:</strong></p>' :
						// 					'<p style="margin: 15px 0;"><strong>You have more unassigned bookings than available rooms:</strong></p>'
						// 				}
						// 				<p style="color: #666; margin: 10px 0;">${bookingNames}</p>
						// 				<p style="color: #dc3545; font-weight: bold;">Please assign rooms to these bookings before making new reservations.</p>
						// 			</div>
						// 		`,
						// 		icon: 'warning',
						// 		confirmButtonText: 'Understood',
						// 		confirmButtonColor: '#dc3545',
						// 		allowOutsideClick: false
						// 	}).then(() => {
						// 		// After user acknowledges, DO NOT show room selection modal
						// 		// User should go assign rooms to unassigned bookings first
						// 		Swal.fire({
						// 			title: 'Action Required',
						// 			text: 'Please go to the booking management to assign rooms to unassigned bookings first.',
						// 			icon: 'info',
						// 			confirmButtonText: 'OK'
						// 		});
						// 	});
						// } else {
							// Normal situation - show room selection modal directly
							showRoomSelectionModal(data, startDate, endDate);
						// }
					}
				})
				.catch(error => {
					console.error('Error:', error);
					Swal.fire({
						title: 'Error',
						text: 'An unexpected error occurred.',
						icon: 'error',
						confirmButtonText: 'Close',
					});
				});
		}

		function showRoomSelectionModal(data, startDate, endDate) {
			// Store unassigned bookings data globally for filterRooms function
			window.currentUnassignedBookings = data.unassignedBookings || [];
			
			// Check for bed count conflicts
			const availableRooms = data.rooms || [];
			const unassignedBookings = data.unassignedBookings || [];
			
			// Count beds needed by unassigned bookings
			const bedsNeeded = {};
			unassignedBookings.forEach(booking => {
				const bedCount = booking.BED_COUNT || 1;
				bedsNeeded[bedCount] = (bedsNeeded[bedCount] || 0) + 1;
			});
			
			// Count available beds by type
			const bedsAvailable = {};
			availableRooms.forEach(room => {
				const bedCount = room.ROOM_BED;
				bedsAvailable[bedCount] = (bedsAvailable[bedCount] || 0) + 1;
			});
			
			// Check for conflicts
			const bedConflicts = [];
			Object.keys(bedsNeeded).forEach(bedCount => {
				const needed = bedsNeeded[bedCount];
				const available = bedsAvailable[bedCount] || 0;
				if (needed > 0 && available > 0) {
					bedConflicts.push({
						bedCount: bedCount,
						needed: needed,
						available: available,
						reserved: Math.min(needed, available)
					});
				}
			});
			
			// Format startDate and endDate with worded month
			const formattedStartDate = flatpickr.formatDate(new Date(startDate), "F d, Y"); // e.g., "January 10, 2025"
			const formattedEndDate = flatpickr.formatDate(new Date(endDate), "F d, Y"); // e.g., "January 11, 2025"
			// Show the available rooms in a SweetAlert
						Swal.fire({
    title: '', // Leave title empty since we're using a custom header
    html: `
        <header class="panel-heading panel-heading-blue mb-3"><strong>
            Available Rooms<br> (${formattedStartDate} to ${formattedEndDate})</strong>
        </header>
        
        ${bedConflicts.length > 0 ? `
        <div style="background: #fff3cd; border: 1px solid #ffeaa7; border-radius: 6px; padding: 12px; margin-bottom: 15px;">
            <div style="display: flex; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 18px; margin-right: 8px;">⚠️</span>
                <strong style="color: #856404;">Unassigned Rooms Warning</strong>
            </div>
            <div style="color: #856404; font-size: 13px;">
                ${bedConflicts.map(conflict => 
                    `<div style="margin-bottom: 4px;">
                        • <strong>${conflict.bedCount} bedrooms:</strong> ${conflict.reserved} out of ${conflict.available} are reserved for unassigned bookings
                    </div>`
                ).join('')}
                <div style="margin-top: 8px; font-style: italic;">
                    These rooms should be assigned to unassigned bookings first.
                </div>
            </div>
        </div>
        ` : ''}
        
       <!-- FIRST ROW -->
       <div style="display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 10px;">
        <div class="filter-options" style="display: flex; gap: 20px;">
            <!-- Bed Count Filter -->
            <div style="display: flex; gap: 10px; align-items: center;">
                <span style="font-weight: bold; margin-right: 5px;">Bed:</span>
                <label><input type="radio" name="bedFilter" value="all" checked onchange="filterRooms()"> All</label>
