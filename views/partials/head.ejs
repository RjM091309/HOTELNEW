	<title><%= typeof title !== 'undefined' ? title : '3CORE PMS' %></title>
	<!-- Prevent white flash: set immediate dark paint before CSS loads -->
	<style>
		html[data-theme="dark"],
		html[data-theme="dark"] body { background:#0b0e11; color-scheme: dark; }
		html { background:#0b0e11; }
		@media (prefers-color-scheme: dark) {
			html { background:#0b0e11; }
		}
	</style>
	<meta name="theme-color" content="#0b0e11" />
	<!-- data-property-theme records which property is active, purely for
	     public/css/theme-color.css's [data-property-theme="pool_villa"]
	     rules to recolor specific elements (the Real-Time Booking Monitor/
	     Room Status header gradient) - it does NOT override the viewer's
	     own dark/light theme choice. An earlier version of this forced
	     light theme on for Pool Villa; that was reverted per explicit
	     request - Pool Villa must stay in whichever theme the viewer
	     already has, with only the header color changing, same as it
	     already does for a light-theme viewer. -->
	<script>(function(){
		var propertyCode = '<%= typeof currentProperty !== "undefined" && currentProperty ? currentProperty.CODE : "main" %>';
		try { document.documentElement.setAttribute('data-theme', localStorage.getItem('ui_data_theme') || 'dark'); } catch(e) { document.documentElement.setAttribute('data-theme', 'dark'); }
		document.documentElement.setAttribute('data-property-theme', propertyCode);
	})();</script>
	<!-- The reload after a property switch (views/partials/navbar.ejs's
	     propertyToggleBtn handler) briefly shows raw unstyled HTML before
	     every stylesheet/script finishes loading - more noticeable
	     switching to whichever property has more data to render (e.g.
	     Main Hotel's much larger room/booking grid vs Pool Villa's 4
	     rooms). Rather than chase render timing, just hide the page until
	     it's actually ready and fade it in - this runs as early as
	     possible (before anything paints) so there's nothing to flash.
	     Only engages right after a property switch (sessionStorage flag
	     set by navbar.ejs immediately before reload, cleared below once
	     used) - a normal page load/navigation is unaffected. -->
	<script>(function(){
		var revealed = false;
		function reveal() {
			if (revealed) return;
			revealed = true;
			try { sessionStorage.removeItem('property_switching'); } catch (e) {}
			document.documentElement.style.transition = 'opacity 0.2s ease';
			document.documentElement.style.opacity = '0';
			document.documentElement.style.visibility = 'visible';
			requestAnimationFrame(function () {
				document.documentElement.style.opacity = '1';
			});
		}
		try {
			if (sessionStorage.getItem('property_switching') === '1') {
				document.documentElement.style.visibility = 'hidden';
				window.addEventListener('load', reveal);
				// Safety net - never leave the page stuck hidden if "load"
				// is somehow delayed or never fires (a hung request, etc.).
				setTimeout(reveal, 2000);
			}
		} catch (e) {
			document.documentElement.style.visibility = 'visible';
		}
	})();</script>
