<script>
document.addEventListener('DOMContentLoaded', function() {
    let settlementData = null;

    // Load settlement data
    function loadSettlement() {
        document.getElementById('loadingIndicator').style.display = 'block';
        document.getElementById('settlementContent').style.display = 'none';
        document.getElementById('errorMessage').style.display = 'none';

        fetch('/telegram/settlement/data', {
            credentials: 'include'
        })
        .then(response => response.json())
        .then(data => {
            document.getElementById('loadingIndicator').style.display = 'none';
            
            if (data.success) {
                settlementData = data.data;
                displaySettlement(data.data);
                document.getElementById('settlementContent').style.display = 'block';
            } else {
                showError(data.message || 'Failed to load settlement data');
            }
        })
        .catch(error => {
            document.getElementById('loadingIndicator').style.display = 'none';
            showError('Error loading settlement data: ' + error.message);
        });
    }

    function displaySettlement(data) {
        // Period
        const periodText = `${data.period.startFormatted} to ${data.period.endFormatted}`;
        document.getElementById('reportPeriod').textContent = periodText;
        document.getElementById('reportPeriodSales').textContent = periodText;

        // Check-Ins
        document.getElementById('checkInCount').textContent = data.checkIns.count;
        const checkInsBody = document.getElementById('checkInsTableBody');
        if (data.checkIns.count > 0) {
            checkInsBody.innerHTML = data.checkIns.data.map(item => `
                <tr style="color: #b4b6bd;">
                    <td style="color: #b4b6bd; text-align: center;">${item.ROOM_NUMBER || 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CUSTOMER_NAME || 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CHECK_IN_DATE ? moment(item.CHECK_IN_DATE).format('MMM DD, YYYY') : 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CHECK_IN_TYPE}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CONFIRMATION_NUMBER || 'N/A'}</td>
                </tr>
            `).join('');
        } else {
            checkInsBody.innerHTML = '<tr style="color: #b4b6bd;"><td colspan="5" class="text-center" style="color: #b4b6bd;">No check-ins during this period</td></tr>';
        }

        // Check-Outs
        document.getElementById('checkOutCount').textContent = data.checkOuts.count;
        const checkOutsBody = document.getElementById('checkOutsTableBody');
        if (data.checkOuts.count > 0) {
            checkOutsBody.innerHTML = data.checkOuts.data.map(item => `
                <tr style="color: #b4b6bd;">
                    <td style="color: #b4b6bd; text-align: center;">${item.ROOM_NUMBER || 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CUSTOMER_NAME || 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CHECK_OUT_DATE ? moment(item.CHECK_OUT_DATE).format('MMM DD, YYYY') : 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CHECK_OUT_TYPE}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.STAY_DAYS} day(s)</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CONFIRMATION_NUMBER || 'N/A'}</td>
                </tr>
            `).join('');
        } else {
            checkOutsBody.innerHTML = '<tr style="color: #b4b6bd;"><td colspan="6" class="text-center" style="color: #b4b6bd;">No check-outs during this period</td></tr>';
        }

        // Pending
        document.getElementById('pendingCount').textContent = data.pending.count;
        const pendingBody = document.getElementById('pendingTableBody');
        if (data.pending.count > 0) {
            pendingBody.innerHTML = data.pending.data.map(item => `
                <tr style="color: #b4b6bd;">
                    <td style="color: #b4b6bd; text-align: center;">${item.ROOM_NUMBER || 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CUSTOMER_NAME || 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CHECK_IN_DATE ? moment(item.CHECK_IN_DATE).format('MMM DD, YYYY') : 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CHECK_OUT_DATE ? moment(item.CHECK_OUT_DATE).format('MMM DD, YYYY') : 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.STAY_DAYS} day(s)</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CONFIRMATION_NUMBER || 'N/A'}</td>
                </tr>
            `).join('');
        } else {
            pendingBody.innerHTML = '<tr style="color: #b4b6bd;"><td colspan="6" class="text-center" style="color: #b4b6bd;">No pending bookings during this period</td></tr>';
        }

        // Check-Ins Today
        const expectedCheckInsToday = data.expectedCheckInsToday || { count: 0, data: [] };
        document.getElementById('expectedCheckInsTodayCount').textContent = expectedCheckInsToday.count;
        const expectedCheckInsTodayBody = document.getElementById('expectedCheckInsTodayTableBody');
        if (expectedCheckInsToday.count > 0) {
            expectedCheckInsTodayBody.innerHTML = expectedCheckInsToday.data.map(item => `
                <tr style="color: #b4b6bd;">
                    <td style="color: #b4b6bd; text-align: center;">${item.ROOM_NUMBER || 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CUSTOMER_NAME || 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CHECK_IN_DATE ? moment(item.CHECK_IN_DATE).format('MMM DD, YYYY') : 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CONFIRMATION_NUMBER || 'N/A'}</td>
                </tr>
            `).join('');
        } else {
            expectedCheckInsTodayBody.innerHTML = '<tr style="color: #b4b6bd;"><td colspan="4" class="text-center" style="color: #b4b6bd;">No check-ins scheduled for today</td></tr>';
        }

        // Total Bookings Today
        const totalBookingsToday = data.totalBookingsToday || { count: 0, data: [] };
        document.getElementById('totalBookingsTodayCount').textContent = totalBookingsToday.count;
        const totalBookingsTodayBody = document.getElementById('totalBookingsTodayTableBody');
        if (totalBookingsToday.count > 0) {
            totalBookingsTodayBody.innerHTML = totalBookingsToday.data.map(item => `
                <tr style="color: #b4b6bd;">
                    <td style="color: #b4b6bd; text-align: center;">${item.ROOM_NUMBER || 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CUSTOMER_NAME || 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CHECK_IN_DATE ? moment(item.CHECK_IN_DATE).format('MMM DD, YYYY') : 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CHECK_OUT_DATE ? moment(item.CHECK_OUT_DATE).format('MMM DD, YYYY') : 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CONFIRMATION_NUMBER || 'N/A'}</td>
                </tr>
            `).join('');
        } else {
            totalBookingsTodayBody.innerHTML = '<tr style="color: #b4b6bd;"><td colspan="5" class="text-center" style="color: #b4b6bd;">No bookings for today</td></tr>';
        }

        // Total Booked Rooms Today
        const totalBookedRoomsToday = data.totalBookedRoomsToday || { count: 0, data: [] };
        document.getElementById('totalBookedRoomsTodayCount').textContent = totalBookedRoomsToday.count;
        const totalBookedRoomsTodayBody = document.getElementById('totalBookedRoomsTodayTableBody');
        if (totalBookedRoomsToday.count > 0) {
            totalBookedRoomsTodayBody.innerHTML = totalBookedRoomsToday.data.map(item => `
                <tr style="color: #b4b6bd;">
                    <td style="color: #b4b6bd; text-align: center;">${item.ROOM_NUMBER || 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CUSTOMER_NAME || 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CHECK_IN_DATE ? moment(item.CHECK_IN_DATE).format('MMM DD, YYYY') : 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CHECK_OUT_DATE ? moment(item.CHECK_OUT_DATE).format('MMM DD, YYYY') : 'N/A'}</td>
                    <td style="color: #b4b6bd; text-align: center;">${item.CONFIRMATION_NUMBER || 'N/A'}</td>
                </tr>
            `).join('');
        } else {
            totalBookedRoomsTodayBody.innerHTML = '<tr style="color: #b4b6bd;"><td colspan="5" class="text-center" style="color: #b4b6bd;">No rooms booked for today</td></tr>';
        }

        // Room Availability
        const availability = data.roomAvailability;
        document.getElementById('totalRooms').textContent = availability.totalRooms;
        document.getElementById('availableRooms').textContent = availability.availableRooms;
        document.getElementById('occupiedRooms').textContent = availability.occupiedRooms;
        document.getElementById('cleaningRooms').textContent = availability.cleaningRooms;
        document.getElementById('maintenanceRooms').textContent = availability.maintenanceRooms;
        document.getElementById('occupancyRate').textContent = availability.occupancyRate + '%';
        document.getElementById('expectedCheckIns').textContent = availability.expectedCheckIns;
        document.getElementById('expectedCheckOuts').textContent = availability.expectedCheckOuts;

        // Occupancy Rate of Month
        const occupancyRateOfMonth = data.occupancyRateOfMonth || '0';
        document.getElementById('occupancyRateOfMonth').textContent = occupancyRateOfMonth + '%';

        // Expected Occupancy Rate of Month
        const expectedOccupancyRateOfMonth = data.expectedOccupancyRateOfMonth || '0';
        document.getElementById('expectedOccupancyRateOfMonth').textContent = expectedOccupancyRateOfMonth + '%';

        // Services Revenue
        const sales = data.sales || { roomRevenue: '0.00', servicesRevenue: '0.00', totalRevenue: '0.00' };
        document.getElementById('roomRevenue').textContent = '₱' + parseFloat(sales.roomRevenue).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('servicesRevenue').textContent = '₱' + parseFloat(sales.servicesRevenue).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('totalRevenue').textContent = '₱' + parseFloat(sales.totalRevenue).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        
        // Monthly Services Revenue
        const monthlySales = data.monthlySales || { roomRevenue: '0.00', servicesRevenue: '0.00', totalRevenue: '0.00' };
        document.getElementById('monthlyRoomRevenue').textContent = '₱' + parseFloat(monthlySales.roomRevenue).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('monthlyServicesRevenue').textContent = '₱' + parseFloat(monthlySales.servicesRevenue).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('monthlyTotalRevenue').textContent = '₱' + parseFloat(monthlySales.totalRevenue).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function showError(message) {
        document.getElementById('errorMessage').textContent = message;
        document.getElementById('errorMessage').style.display = 'block';
    }

    // Load saved chat IDs
    let hasChatIds = false;
    let kakaoConfigured = false;
    function loadBotConfig() {
        fetch('/telegram/config', {
            credentials: 'include'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.data) {
                // Check for CHAT_IDS array (new format) or CHAT_ID (old format for backward compatibility)
                const chatIds = data.data.CHAT_IDS || (data.data.CHAT_ID ? [data.data.CHAT_ID] : []);
                hasChatIds = chatIds.length > 0;
                
                if (hasChatIds) {
                    // Enable all send buttons
                    document.querySelectorAll('.btnSendTelegram').forEach(btn => {
                        btn.disabled = false;
                    });
                } else {
                    // Disable all send buttons
                    document.querySelectorAll('.btnSendTelegram').forEach(btn => {
                        btn.disabled = true;
                    });
                }
            } else {
                // Disable all send buttons if no config
                document.querySelectorAll('.btnSendTelegram').forEach(btn => {
                    btn.disabled = true;
                });
            }
        })
        .catch(error => {
            console.error('Error loading bot config:', error);
            // Disable all send buttons on error
            document.querySelectorAll('.btnSendTelegram').forEach(btn => {
                btn.disabled = true;
            });
        });
    }

    function loadKakaoConfig() {
        fetch('/telegram/kakao/config', {
            credentials: 'include'
        })
        .then(response => response.json())
        .then(data => {
            const hasAccessToken = data.success && data.data && data.data.hasAccessToken;
            kakaoConfigured = hasAccessToken;
            document.querySelectorAll('.btnSendKakao').forEach(btn => {
                btn.disabled = !hasAccessToken;
            });
        })
        .catch(error => {
            console.error('Error loading Kakao config:', error);
            kakaoConfigured = false;
            document.querySelectorAll('.btnSendKakao').forEach(btn => {
                btn.disabled = true;
            });
        });
    }

    // Send via Telegram buttons (for each section)
    document.querySelectorAll('.btnSendTelegram').forEach(button => {
        button.addEventListener('click', function() {
            if (!hasChatIds) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Chat ID Not Configured',
                    text: 'Please configure at least one Chat ID in Telegram settings first.',
                    confirmButtonColor: '#3085d6'
                });
                return;
            }
            const section = this.getAttribute('data-section');
            sendReport(section, this);
        });
    });

    function sendReport(section, btn) {
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="material-icons">hourglass_empty</i> Sending...';

        fetch('/telegram/settlement/send', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ section: section }),
            credentials: 'include'
        })
        .then(response => response.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = originalText;
            
            if (data.success) {
                // Check if message contains info about multiple Chat IDs
                const message = data.message || 'Report sent successfully to Telegram!';
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: message,
                    confirmButtonColor: '#3085d6',
                    timer: 3000,
                    showConfirmButton: true
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || 'Failed to send report',
                    confirmButtonColor: '#3085d6'
                });
            }
        })
        .catch(error => {
            btn.disabled = false;
            btn.innerHTML = originalText;
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Error sending report: ' + error.message,
                confirmButtonColor: '#3085d6'
            });
        });
    }

    // Send via Kakao buttons
    document.querySelectorAll('.btnSendKakao').forEach(button => {
        button.addEventListener('click', function() {
            if (!kakaoConfigured) {
                Swal.fire({
                    icon: 'warning',
                    title: 'KakaoTalk Not Configured',
                    text: 'Please authenticate KakaoTalk in settings first.',
                    confirmButtonColor: '#f1c40f'
                });
                return;
            }
            const section = this.getAttribute('data-section');
            sendReportKakao(section, this);
        });
    });

    function sendReportKakao(section, btn) {
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="material-icons">hourglass_empty</i> Sending...';

        fetch('/telegram/settlement/send/kakaotalk', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ section: section }),
            credentials: 'include'
        })
        .then(response => response.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = originalText;

            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: 'Report sent successfully to KakaoTalk!',
                    confirmButtonColor: '#f1c40f',
                    timer: 2000,
                    showConfirmButton: true
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || 'Failed to send report via KakaoTalk',
                    confirmButtonColor: '#f1c40f'
                });
            }
        })
        .catch(error => {
            btn.disabled = false;
            btn.innerHTML = originalText;
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Error sending KakaoTalk report: ' + error.message,
                confirmButtonColor: '#f1c40f'
            });
        });
    }

    // Initial load - disable buttons until config is loaded
    document.querySelectorAll('.btnSendTelegram').forEach(btn => {
        btn.disabled = true;
    });
    document.querySelectorAll('.btnSendKakao').forEach(btn => {
        btn.disabled = true;
    });
    
    loadSettlement();
    loadBotConfig();
    loadKakaoConfig();
});
</script>

