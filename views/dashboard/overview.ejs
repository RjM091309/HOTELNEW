<!-- ============================================================
     DASHBOARD - one card per property (Main Hotel, Clark Central, Pool Villa...)
     Numbers come from models/overviewModel.js; the page refreshes itself (every 30 s and on socket updates).
     "Expand Full Dashboard" switches to that property and opens its operations dashboard (/dashboard/full).
     ============================================================ -->
<style>
  .ov-page {
    --ov-bg-1: #0d1424; --ov-bg-2: #131c33; --ov-line: rgba(255,255,255,.08); --ov-line-strong: rgba(255,255,255,.14);
    --ov-text: #eef2ff; --ov-muted: #8b97b8; --ov-tile: rgba(255,255,255,.045); --ov-tile-hover: rgba(255,255,255,.08);
    --ov-good: #34d399; --ov-warn: #fbbf24; --ov-bad: #fb7185; --ov-info: #60a5fa;
    padding: 0 0 6px;
  }
  [data-theme="white"] .ov-page {
    --ov-bg-1: #ffffff; --ov-bg-2: #f3f6fd; --ov-line: rgba(15,23,42,.08); --ov-line-strong: rgba(15,23,42,.16);
    --ov-text: #0f172a; --ov-muted: #64748b; --ov-tile: rgba(15,23,42,.035); --ov-tile-hover: rgba(15,23,42,.07);
    --ov-good: #059669; --ov-warn: #d97706; --ov-bad: #e11d48; --ov-info: #2563eb;
  }
  .ov-head { display: flex; align-items: center; justify-content: flex-end; gap: 16px; flex-wrap: wrap; margin: 0 4px 6px; line-height: 1; }
  .ov-title { margin: 0; font-size: 22px; font-weight: 700; color: var(--ov-text); letter-spacing: .2px; }
  .ov-sub { margin: 4px 0 0; font-size: 13px; color: var(--ov-muted); }
  .ov-live { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; color: var(--ov-muted); }
  .ov-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ov-good); box-shadow: 0 0 0 0 rgba(52,211,153,.6); animation: ovPulse 2s infinite; }
  @keyframes ovPulse { 0% { box-shadow: 0 0 0 0 rgba(52,211,153,.55); } 70% { box-shadow: 0 0 0 9px rgba(52,211,153,0); } 100% { box-shadow: 0 0 0 0 rgba(52,211,153,0); } }

  .ov-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); grid-auto-rows: 1fr; gap: 10px; align-items: stretch; min-height: max(660px, calc(100vh - 132px)); }

  .ov-card {
    --accent: #4361ee;
    position: relative; display: flex; flex-direction: column; gap: 16px; padding: 22px 20px 20px; border-radius: 26px; color: var(--ov-text);
    background:
      radial-gradient(120% 70% at 50% -10%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%),
      linear-gradient(165deg, var(--ov-bg-2), var(--ov-bg-1));
    border: 1px solid var(--ov-line); box-shadow: 0 18px 40px -18px rgba(0,0,0,.55);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    overflow: hidden;
  }
  .ov-card::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: .9; }
  .ov-card { cursor: pointer; outline: none; }
  .ov-card::after { content: "35d"; font-family: "Font Awesome 5 Free", "Font Awesome 6 Free", FontAwesome; font-weight: 900; position: absolute; top: 14px; right: 16px; width: 30px; height: 30px; display: grid; place-items: center; font-size: 12px; border-radius: 10px;
    color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); opacity: 0; transform: translate(-4px, 4px); transition: opacity .2s ease, transform .2s ease; }
  .ov-card:hover::after, .ov-card:focus-visible::after { opacity: 1; transform: none; }
  .ov-card:focus-visible { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent); }
  .ov-card.is-opening { opacity: .72; transform: scale(.99); }
  .ov-card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 55%, transparent); box-shadow: 0 26px 50px -18px color-mix(in srgb, var(--accent) 45%, rgba(0,0,0,.6)); }
  .ov-card.is-current { border-color: color-mix(in srgb, var(--accent) 70%, transparent); box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 50%, transparent), 0 22px 48px -18px color-mix(in srgb, var(--accent) 50%, rgba(0,0,0,.6)); }

  .ov-card-top { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  /* the property's emblem: same box for every property, glowing in its own colour */
  .ov-logo { position: relative; display: grid; place-items: center; width: 100%; height: 84px; margin-top: 2px; }
  .ov-logo::before { content: ""; position: absolute; width: 150px; height: 150px; top: 50%; left: 50%; transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 38%, transparent), transparent 72%); filter: blur(6px); opacity: .9; pointer-events: none; }
  .ov-logo img { position: relative; max-height: 76px; max-width: 170px; width: auto; height: auto; object-fit: contain;
    filter: drop-shadow(0 6px 16px color-mix(in srgb, var(--accent) 45%, transparent)); transition: transform .35s ease; }
  .ov-card:hover .ov-logo img { transform: scale(1.06); }
  /* light theme: the gold logos keep their colors (a little darker shadow so they read on white); the Main Stay logo is a WHITE M with a blue stripe
     (made for dark), so it is inverted to a dark M and the hue turned back, which keeps the blue stripe blue */
  [data-theme="white"] .ov-logo img { filter: drop-shadow(0 1px 2px rgba(70,45,0,.45)) drop-shadow(0 4px 10px rgba(15,23,42,.18)); }
  [data-theme="white"] .ov-card[data-code="main"] .ov-logo img { filter: invert(1) hue-rotate(180deg) drop-shadow(0 4px 10px rgba(15,23,42,.18)); }
  .ov-badge { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; font-size: 22px; color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 0 24px -4px color-mix(in srgb, var(--accent) 60%, transparent), inset 0 0 14px -6px color-mix(in srgb, var(--accent) 70%, transparent); }
  .ov-name { margin: 0; font-size: 21px; font-weight: 700; letter-spacing: .3px; color: var(--ov-text); }
  .ov-tags { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .ov-tag { font-size: 10.5px; letter-spacing: .8px; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); }
  .ov-tag.is-here { color: var(--ov-good); background: color-mix(in srgb, var(--ov-good) 12%, transparent); border-color: color-mix(in srgb, var(--ov-good) 40%, transparent); }

  .ov-section { display: flex; flex-direction: column; gap: 9px; }
  .ov-section-title { display: flex; line-height: 1.2; align-items: center; gap: 8px; margin: 0; font-size: 11px; font-weight: 700; letter-spacing: 1.1px; text-transform: uppercase; color: var(--ov-muted); }
  .ov-section-title::after { content: ""; flex: 1; height: 1px; background: var(--ov-line); }
  .ov-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; }
  .ov-tile { position: relative; padding: 11px 11px 10px; border-radius: 14px; background: var(--ov-tile); border: 1px solid var(--ov-line); transition: background .2s ease, border-color .2s ease; min-width: 0; }
  .ov-tile:hover { background: var(--ov-tile-hover); border-color: var(--ov-line-strong); }
  .ov-tile.is-link { cursor: pointer; } .ov-tile.is-link:hover { border-color: var(--tone, var(--ov-line-strong)); transform: translateY(-1px); }
  .ov-tile-label { display: flex; align-items: center; justify-content: space-between; gap: 6px; font-size: 11px; color: var(--ov-muted); white-space: nowrap; }
  .ov-tile-label i { font-size: 12px; color: var(--tone, var(--ov-muted)); }
  .ov-tile-value { margin-top: 6px; font-size: 26px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; color: var(--tone, var(--ov-text)); }
  .ov-tile-note { margin-top: 5px; font-size: 10.5px; color: var(--ov-muted); min-height: 13px; }
  .ov-tile-bar { margin-top: 6px; height: 3px; border-radius: 3px; background: var(--ov-line); overflow: hidden; }
  .ov-tile-bar > span { display: block; height: 100%; width: 0; border-radius: 3px; background: var(--tone, var(--accent)); transition: width .8s cubic-bezier(.2,.8,.2,1); }
  .tone-good { --tone: var(--ov-good); } .tone-warn { --tone: var(--ov-warn); } .tone-bad { --tone: var(--ov-bad); } .tone-info { --tone: var(--ov-info); } .tone-accent { --tone: var(--accent); }

  .ov-chart { flex: 1 1 auto; display: flex; flex-direction: column; padding: 12px 12px 8px; border-radius: 16px; background: var(--ov-tile); border: 1px solid var(--ov-line); }
  .ov-chart-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
  .ov-chart-title { font-size: 12px; font-weight: 600; color: var(--ov-text); }
  .ov-chart-total { font-size: 11px; color: var(--ov-muted); }
  .ov-chart-total b { color: var(--accent); font-size: 13px; }
  .ov-chart-body { flex: 1 1 auto; min-height: 108px; position: relative; }
  .ov-chart.ov-chart-bld { padding: 4px 6px; } .ov-chart-body.ov-bld { min-height: 190px; }
  .ov-chart-body.ov-bld .b3d { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ov-chart svg { display: block; width: 100%; height: 100%; min-height: 108px; overflow: visible; position: absolute; inset: 0; }
  .ov-bar { transform-origin: bottom; transform-box: fill-box; transform: scaleY(0); animation: ovGrow .7s cubic-bezier(.2,.8,.2,1) forwards; }
  @keyframes ovGrow { to { transform: scaleY(1); } }
  .ov-bar-label { font-size: 9.5px; fill: var(--ov-muted); text-anchor: middle; }
  .ov-bar-label.is-today { fill: var(--accent); font-weight: 700; }
  .ov-bar-value { font-size: 10px; font-weight: 700; fill: var(--ov-text); text-anchor: middle; }

  .ov-occ { display: grid; gap: 6px; }
  .ov-occ-row { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--ov-muted); }
  .ov-occ-row b { color: var(--ov-text); }
  .ov-occ-track { height: 8px; border-radius: 8px; background: var(--ov-line); overflow: hidden; }
  .ov-occ-track > span { display: block; height: 100%; width: 0; border-radius: 8px; background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 60%, #fff 0%), var(--accent)); transition: width .9s cubic-bezier(.2,.8,.2,1); }

  .ov-money { display: grid; grid-template-columns: 1.35fr 1fr; gap: 9px; }
  .ov-money-main { padding: 12px 13px; border-radius: 14px; background: linear-gradient(150deg, color-mix(in srgb, var(--accent) 22%, transparent), color-mix(in srgb, var(--accent) 6%, transparent)); border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent); }
  .ov-money-label { font-size: 10.5px; letter-spacing: .7px; text-transform: uppercase; color: var(--ov-muted); }
  .ov-money-value { margin-top: 5px; font-size: 24px; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--ov-text); line-height: 1.05; }
  .ov-money-side { display: grid; gap: 9px; }
  .ov-money-mini { padding: 8px 11px; border-radius: 12px; background: var(--ov-tile); border: 1px solid var(--ov-line); }
  .ov-money-mini .ov-money-value { font-size: 15px; margin-top: 2px; }
  .ov-money-mini.is-credit .ov-money-value { color: var(--ov-warn); }

  .ov-skeleton { background: linear-gradient(90deg, var(--ov-tile) 25%, var(--ov-tile-hover) 37%, var(--ov-tile) 63%); background-size: 400% 100%; animation: ovShimmer 1.4s ease infinite; border-radius: 12px; }
  @keyframes ovShimmer { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
  .ov-error { padding: 14px; border-radius: 14px; font-size: 12px; color: var(--ov-bad); background: color-mix(in srgb, var(--ov-bad) 10%, transparent); border: 1px solid color-mix(in srgb, var(--ov-bad) 35%, transparent); text-align: center; }

  /* ===== entry: every card rises in, then each stat of it comes in one after the other (--c = card, --i = stat) ===== */
  .ov-grid.is-enter .ov-card { animation: ovCardIn .75s cubic-bezier(.16,.84,.3,1) both; animation-delay: calc(var(--c, 0) * 120ms); }
  .ov-grid.is-enter .ov-a { animation: ovItemIn .6s cubic-bezier(.16,.84,.3,1) both; animation-delay: calc(var(--c, 0) * 120ms + 240ms + var(--i, 0) * 42ms); }
  .ov-grid.is-enter .ov-logo.ov-a img { animation: ovLogoIn .9s cubic-bezier(.16,.84,.3,1) both; animation-delay: calc(var(--c, 0) * 120ms + 180ms); }
  @keyframes ovCardIn { from { opacity: 0; transform: translateY(30px) scale(.965); filter: blur(7px); } to { opacity: 1; transform: none; filter: blur(0); } }
  @keyframes ovItemIn { from { opacity: 0; transform: translateY(14px) scale(.94); } to { opacity: 1; transform: none; } }
  @keyframes ovLogoIn { from { opacity: 0; transform: scale(.55) rotate(-8deg); filter: blur(6px); } to { opacity: 1; transform: none; filter: blur(0); } }
  .ov-grid.is-enter .ov-bar { animation-delay: calc(var(--c, 0) * 120ms + 700ms + var(--bi, 0) * 60ms); }
  .ov-tile-bar > span, .ov-occ-track > span { transition-delay: var(--d, 0ms); }

  /* ===== click: the other cards fall back, the picked one lifts and the whole screen opens from it (see openCard) ===== */
  .ov-grid.is-leaving .ov-card:not(.is-picked) { opacity: 0; transform: scale(.93); filter: blur(8px); transition: opacity .4s ease, transform .45s cubic-bezier(.4,0,.2,1), filter .4s ease; pointer-events: none; }
  .ov-card.is-picked { transform: scale(1.018); z-index: 3; transition: transform .35s cubic-bezier(.2,.8,.2,1); }
  .ov-morph { position: fixed; z-index: 100000; display: grid; place-items: center; overflow: hidden; pointer-events: none;
    background: radial-gradient(90% 70% at 50% 20%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%), linear-gradient(165deg, #131c33, #0a0f1f);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 55%, transparent), 0 30px 80px -20px color-mix(in srgb, var(--accent) 60%, transparent);
    transition: left .6s cubic-bezier(.7,0,.2,1), top .6s cubic-bezier(.7,0,.2,1), width .6s cubic-bezier(.7,0,.2,1), height .6s cubic-bezier(.7,0,.2,1), border-radius .6s cubic-bezier(.7,0,.2,1), box-shadow .6s ease; }
  .ov-morph.is-full { box-shadow: none; }
  .ov-morph-inner { display: grid; justify-items: center; gap: 14px; opacity: 0; transform: translateY(10px) scale(.96); transition: opacity .35s ease .22s, transform .5s cubic-bezier(.2,.8,.2,1) .22s; }
  .ov-morph.is-full .ov-morph-inner { opacity: 1; transform: none; }
  .ov-morph-inner img { max-height: 92px; max-width: 220px; filter: drop-shadow(0 8px 22px color-mix(in srgb, var(--accent) 55%, transparent)); }
  .ov-morph-inner b { font-size: 22px; letter-spacing: .6px; color: #eef2ff; font-weight: 700; text-transform: uppercase; }
  .ov-morph-inner i { font-size: 38px; color: var(--accent); }
  /* light theme: the growing panel is light too (it was always dark) */
  [data-theme="white"] .ov-morph { background: radial-gradient(90% 70% at 50% 20%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 70%), linear-gradient(165deg, #ffffff, #eef2fb); }
  [data-theme="white"] .ov-morph-inner b { color: #0f172a; }
  [data-theme="white"] .ov-morph-bar { background: rgba(15,23,42,.12); }
  [data-theme="white"] .ov-morph[data-code="main"] .ov-morph-inner img { filter: invert(1) hue-rotate(180deg) drop-shadow(0 8px 22px color-mix(in srgb, var(--accent) 40%, transparent)); }
  .ov-morph-bar { width: 140px; height: 3px; border-radius: 3px; background: rgba(255,255,255,.12); overflow: hidden; } .ov-morph-bar span { display: block; height: 100%; width: 40%; border-radius: 3px; background: var(--accent); animation: ovLoad 1s ease-in-out infinite; }
  @keyframes ovLoad { 0% { transform: translateX(-100%); } 100% { transform: translateX(350%); } }
  @media (max-width: 560px) { .ov-grid { grid-template-columns: 1fr; } .ov-tile-value { font-size: 23px; } }
  @media (prefers-reduced-motion: reduce) { .ov-grid.is-enter .ov-card, .ov-grid.is-enter .ov-a, .ov-grid.is-enter .ov-logo.ov-a img { animation: none !important; } .ov-bar, .ov-dot, .ov-skeleton { animation: none; } .ov-bar { transform: none; } .ov-card { transition: none; } }
</style>

<div class="ov-page" id="ovPage">
  <div class="ov-head">
    <div class="ov-live"><span class="ov-dot"></span><span>Live &middot; updated <b id="ovUpdated">just now</b></span></div>
  </div>
  <div class="ov-grid" id="ovGrid"></div>
</div>

<script src="/js/dashboard/building3d.js?v=21"></script>
<script>
(function () {
  var INITIAL = <%- JSON.stringify(cards || []).replace(/</g, '\\u003c') %>;
  var CURRENT = <%- JSON.stringify((typeof currentProperty !== 'undefined' && currentProperty) ? currentProperty.CODE : '') %>;
  var grid = document.getElementById('ovGrid');
  var state = {};   // code -> last numbers drawn (to animate only what changed)

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); }
  function peso(n) { return '₱' + Number(n || 0).toLocaleString('en-US', { maximumFractionDigits: 0 }); }
  function pct(a, b) { return b > 0 ? Math.min(100, Math.round((a / b) * 100)) : 0; }

  function tile(label, icon, value, tone, note, barPct, focus) {
    return '<div class="ov-tile ov-a tone-' + tone + (focus ? ' is-link' : '') + '"' + (focus ? ' data-focus="' + focus + '" title="Show them on the calendar" role="link" tabindex="0"' : '') + '>' +
      '<div class="ov-tile-label"><span>' + label + '</span><i class="fas ' + icon + '"></i></div>' +
      '<div class="ov-tile-value" data-count="' + value + '">' + value + '</div>' +
      '<div class="ov-tile-note">' + (note || '&nbsp;') + '</div>' +
      (barPct != null ? '<div class="ov-tile-bar"><span data-w="' + barPct + '"></span></div>' : '') +
    '</div>';
  }

  function chart(week, accent, hh) {
    var W = 300, H = hh || 108, padB = 20, padT = 16, gap = 10;
    var max = 1;
    week.forEach(function (d) { max = Math.max(max, d.count + (d.expected || 0)); });
    var bw = (W - gap * (week.length - 1)) / week.length;
    var inner = H - padB - padT;
    var total = 0, parts = '';
    week.forEach(function (d, i) {
      total += d.count;
      var x = i * (bw + gap);
      var h = Math.max(d.count ? 4 : 2, Math.round((d.count / max) * inner));
      var y = H - padB - h;
      var cls = d.isToday ? 'is-today' : '';
      parts += '<g><title>' + esc(d.short) + ': ' + d.count + ' check-in' + (d.count === 1 ? '' : 's') + (d.expected ? ' (+' + d.expected + ' expected)' : '') + '</title>';
      parts += '<rect class="ov-bar" style="--bi:' + i + '" x="' + x.toFixed(1) + '" y="' + y + '" width="' + bw.toFixed(1) + '" height="' + h + '" rx="5" fill="url(#g-' + accent.replace('#', '') + ')" opacity="' + (d.count ? (d.isToday ? 1 : .8) : .25) + '"/>';
      if (d.expected) {
        var eh = Math.max(4, Math.round((d.expected / max) * inner)), ey = y - eh - 2;
        parts += '<rect x="' + x.toFixed(1) + '" y="' + ey + '" width="' + bw.toFixed(1) + '" height="' + eh + '" rx="5" fill="none" stroke="' + accent + '" stroke-dasharray="3 3" opacity=".8"/>';
      }
      if (d.count) parts += '<text class="ov-bar-value" x="' + (x + bw / 2).toFixed(1) + '" y="' + (y - 4) + '">' + d.count + '</text>';
      parts += '<text class="ov-bar-label ' + cls + '" x="' + (x + bw / 2).toFixed(1) + '" y="' + (H - 5) + '">' + (d.isToday ? 'Today' : esc(d.label)) + '</text></g>';
    });
    return { total: total, svg: '<svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none" role="img" aria-label="Check-ins per day, last 7 days">' +
      '<defs><linearGradient id="g-' + accent.replace('#', '') + '" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="' + accent + '"/><stop offset="1" stop-color="' + accent + '" stop-opacity=".35"/></linearGradient></defs>' + parts + '</svg>' };
  }

  function cardHtml(c) {
    var d = c.data, accent = c.color || '#4361ee';
    var mark = c.logo ? '<div class="ov-logo ov-a"><img src="' + esc(c.logo) + '" alt="' + esc(c.displayName) + '"></div>'
                      : '<div class="ov-badge ov-a"><i class="fas ' + esc(c.icon) + '"></i></div>';
    var head = '<div class="ov-card-top">' + mark +
      '<h3 class="ov-name ov-a">' + esc(c.displayName) + '</h3>' +
      '<div class="ov-tags ov-a"><span class="ov-tag">' + esc(c.code.replace('_', ' ')) + '</span>' + (c.code === CURRENT ? '<span class="ov-tag is-here">Active</span>' : '') + '</div></div>';
    if (!d) return head + '<div class="ov-error">Could not load the numbers of this property.</div>';
    var r = d.rooms, res = d.reservation, hk = d.housekeeping;
    // a property with a 3D building (Clark Central) shows it here instead of the check-ins chart
    var ch = d.building ? null : chart(d.week, accent);
    var chartHtml = d.building
      ? '<div class="ov-chart ov-a ov-chart-bld"><div class="ov-chart-body ov-bld"></div></div>'
      : '<div class="ov-chart ov-a"><div class="ov-chart-head"><span class="ov-chart-title">Check-ins per day</span><span class="ov-chart-total">last 7 days &middot; <b>' + ch.total + '</b></span></div><div class="ov-chart-body">' + ch.svg + '</div></div>';
    return head +
      '<div class="ov-section"><div class="ov-section-title ov-a">Reservation</div><div class="ov-tiles">' +
        tile('Occupied', 'fa-bed', res.occupied, 'accent', 'of ' + r.total + ' rooms', pct(res.occupied, r.total)) +
        tile('Check-in', 'fa-sign-in-alt', res.checkIn.total, 'good', res.checkIn.done ? res.checkIn.done + ' already in' : 'still to arrive', pct(res.checkIn.done, res.checkIn.planned), 'arrivals') +
        tile('Check-out', 'fa-sign-out-alt', res.checkOut.total, 'info', res.checkOut.done ? res.checkOut.done + ' already out' : 'still to leave', pct(res.checkOut.done, res.checkOut.planned), 'departures') +
      '</div></div>' +
      '<div class="ov-section"><div class="ov-section-title ov-a">Housekeeping</div><div class="ov-tiles">' +
        tile('Available', 'fa-check-circle', hk.available, 'good', 'ready to sell', null) +
        tile('Dirty', 'fa-broom', hk.dirty, 'warn', hk.dirty ? 'to clean' : 'all clean', null) +
        tile('Out of order', 'fa-ban', hk.outOfOrder, 'bad', hk.outOfOrder ? 'maintenance' : 'none', null) +
      '</div></div>' +
      chartHtml +
      (d.building ? '' : '<div class="ov-occ ov-a"><div class="ov-occ-row"><span>Occupancy</span><span><b>' + r.occupancyPct + '%</b> &middot; ' + r.occupied + ' / ' + r.total + '</span></div><div class="ov-occ-track"><span data-w="' + r.occupancyPct + '"></span></div></div>') +
      '<div class="ov-money"><div class="ov-money-main ov-a"><div class="ov-money-label">Revenue today</div><div class="ov-money-value">' + peso(d.revenue.today) + '</div></div>' +
        '<div class="ov-money-side"><div class="ov-money-mini ov-a"><div class="ov-money-label">This month</div><div class="ov-money-value">' + peso(d.revenue.month) + '</div></div>' +
        '<div class="ov-money-mini is-credit ov-a"><div class="ov-money-label">Credit to collect</div><div class="ov-money-value">' + peso(d.revenue.credit) + '</div></div></div></div>' +
      '';
  }

  var entering = true;                 // the first draw only: everything comes in one after the other
  var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function countUp(el, delay) {
    var to = parseInt(el.getAttribute('data-count'), 10) || 0, start = null, dur = 900;
    if (to === 0 || calm) { el.textContent = to; return; }
    el.textContent = '0';
    function step(ts) { if (!start) start = ts; var p = Math.min(1, (ts - start) / dur); el.textContent = Math.round(to * (1 - Math.pow(1 - p, 4))); if (p < 1) requestAnimationFrame(step); }
    setTimeout(function () { requestAnimationFrame(step); }, delay || 0);
  }

  function animate(card, index) {
    var base = entering ? index * 120 + 240 : 0;
    card.querySelectorAll('.ov-a').forEach(function (e, i) { e.style.setProperty('--i', i); });
    requestAnimationFrame(function () {
      card.querySelectorAll('[data-w]').forEach(function (b, i) {
        b.style.setProperty('--d', (entering ? base + 400 + i * 60 : 0) + 'ms');
        requestAnimationFrame(function () { b.style.width = b.getAttribute('data-w') + '%'; });
      });
      card.querySelectorAll('.ov-tile-value[data-count]').forEach(function (v, i) { countUp(v, entering ? base + 120 + i * 60 : 0); });
    });
  }

  // The cards are as tall as the page: the extra height is given to the chart, so it is drawn again at that height.
  function fitChart(card) {
    var c = card._c, body = card.querySelector('.ov-chart-body');
    if (!c || !c.data || !body) return;
    if (c.data.building) {                                  // the 3D building: it scales itself to the box (svg 100% x 100%)
      if (!card._bd && window.Building3D) { card._bd = true; window.Building3D.render(body, c.data.building, { name: c.displayName || c.name, mode: 'card', animate: entering }); }
      return;
    }
    var h = Math.max(108, Math.round(body.clientHeight));
    if (Math.abs(h - (card._h || 108)) < 6) return;
    card._h = h;
    body.innerHTML = chart(c.data.week, c.color || '#4361ee', h).svg;
  }
  function fitAll() { Array.prototype.forEach.call(grid.children, fitChart); }
  var rz = null;
  window.addEventListener('resize', function () { clearTimeout(rz); rz = setTimeout(fitAll, 150); });

  function render(cards) {
    var existing = {};
    var index = 0;
    Array.prototype.forEach.call(grid.children, function (el) { existing[el.getAttribute('data-code')] = el; });
    cards.forEach(function (c, ci) {
      index = ci;
      var sig = JSON.stringify(c.data && (function (d) { var x = JSON.parse(JSON.stringify(d)); delete x.updatedAt; return x; })(c.data)) + '|' + (c.code === CURRENT);
      var el = existing[c.code];
      if (!el) {
        el = document.createElement('article'); el.className = 'ov-card'; el.setAttribute('data-code', c.code); grid.appendChild(el);
        el.setAttribute('tabindex', '0'); el.setAttribute('role', 'link'); el.setAttribute('title', 'Open the full dashboard of ' + (c.displayName || c.name));
      } else if (state[c.code] === sig) { return; }          // nothing changed: leave it (no flicker)
      state[c.code] = sig;
      el.style.setProperty('--accent', c.color || '#4361ee');
      el.classList.toggle('is-current', c.code === CURRENT);
      el.style.setProperty('--c', index);
      el.innerHTML = cardHtml(c);
      el._c = c; el._h = 108;
      animate(el, index);
      fitChart(el);
    });
    if (entering) { grid.classList.add('is-enter'); setTimeout(function () { grid.classList.remove('is-enter'); entering = false; }, 2600); }
    var u = document.getElementById('ovUpdated'); if (u) u.textContent = new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
  }

  // Click anywhere on a card (or Enter on it): switch to that property and open its full dashboard.
  // The transition: the other cards fall back, the picked one lifts, and a panel grows from the card to the whole screen
  // (showing the property's logo) while the property is switched; the full dashboard then fades it away and comes in.
  var opening = false;
  function openCard(card) {
    if (!card || opening) return;
    opening = true;
    var c = card._c || {}, code = card.getAttribute('data-code');
    var accent = (card.style.getPropertyValue('--accent') || '').trim() || '#4361ee';
    var go = function () { return fetch('/property/switch', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code: code }) }).then(function (r) { return r.json(); }); };
    if (calm) { go().then(function (j) { if (j && j.success) window.location.href = '/dashboard/full'; else opening = false; }).catch(function () { opening = false; }); return; }

    var rc = card.getBoundingClientRect();
    var morph = document.createElement('div');
    morph.className = 'ov-morph';
    morph.setAttribute('data-code', code);
    morph.style.cssText = '--accent:' + accent + ';left:' + rc.left + 'px;top:' + rc.top + 'px;width:' + rc.width + 'px;height:' + rc.height + 'px;border-radius:26px;';
    morph.innerHTML = '<div class="ov-morph-inner">' + (c.logo ? '<img src="' + esc(c.logo) + '" alt="">' : '<i class="fas ' + esc(c.icon || 'fa-building') + '"></i>') + '<b>' + esc(c.displayName || '') + '</b><div class="ov-morph-bar"><span></span></div></div>';
    document.body.appendChild(morph);
    grid.classList.add('is-leaving'); card.classList.add('is-picked');
    void morph.offsetWidth;                                    // start from the card, then open to the full screen
    var t0 = Date.now();
    requestAnimationFrame(function () {
      morph.classList.add('is-full');
      var ar = (document.querySelector('.page-content') || document.body).getBoundingClientRect();   // only the page area: header and sidebar stay visible
      var hd = document.querySelector('.page-header'), top0 = hd ? hd.getBoundingClientRect().bottom : ar.top;   // from under the header to the bottom of the window
      morph.style.left = ar.left + 'px'; morph.style.top = top0 + 'px'; morph.style.width = ar.width + 'px'; morph.style.height = (window.innerHeight - top0) + 'px'; morph.style.borderRadius = '0px';
    });
    go().then(function (j) {
      if (!j || !j.success) throw new Error('switch');
      try { var lg = document.querySelector('.page-logo .page-logo-img-dark'); if (lg) sessionStorage.setItem('logoFlipFrom', lg.getAttribute('src')); } catch (e) { /* no flip */ }
      try { sessionStorage.setItem('fdEnter', JSON.stringify({ code: code, color: accent, name: c.displayName || '', logo: c.logo || '', icon: c.icon || '' })); } catch (e) { /* the page just opens */ }
      setTimeout(function () { window.location.href = '/dashboard/full'; }, Math.max(0, 640 - (Date.now() - t0)));
    }).catch(function () {                                      // could not switch: close the panel again
      morph.style.opacity = '0'; setTimeout(function () { morph.remove(); }, 300);
      grid.classList.remove('is-leaving'); card.classList.remove('is-picked'); opening = false;
    });
  }
  // Check-in / Check-out tile: switch to that property, then open its calendar with today's arrivals / departures highlighted
  function openFocus(tile) {
    var card = tile.closest('.ov-card'); if (!card || opening) return;
    opening = true;
    fetch('/property/switch', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code: card.getAttribute('data-code') }) })
      .then(function (r) { return r.json(); })
      .then(function (j) {
        opening = false;
        if (!j || !j.success) return;
        // the calendar opens in its own shared tab; this tab stays on the overview
        var q = '?focus=' + encodeURIComponent(tile.getAttribute('data-focus'));
        var ok = false;
        try { ok = typeof openInOwnTab === 'function' && openInOwnTab('/calendar', q); } catch (e) { ok = false; }
        if (!ok) { var w = window.open('/calendar' + q, '_blank'); if (!w) window.location.href = '/calendar' + q; }
      })
      .catch(function () { opening = false; });
  }
  grid.addEventListener('click', function (e) {
    var t = e.target.closest('.ov-tile[data-focus]');
    if (t) { openFocus(t); return; }
    openCard(e.target.closest('.ov-card'));
  });
  grid.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { var t = e.target.closest('.ov-tile[data-focus]'); if (t) { e.preventDefault(); openFocus(t); return; } var c = e.target.closest('.ov-card'); if (c) { e.preventDefault(); openCard(c); } } });

  var busy = false, timer = null;
  function refresh() {
    if (busy || document.hidden) return; busy = true;
    fetch('/dashboard/overview-data', { credentials: 'same-origin' }).then(function (r) { return r.json(); })
      .then(function (j) { if (j && j.success) render(j.cards); })
      .catch(function () { /* keep what is shown */ })
      .then(function () { busy = false; });
  }
  function soon() { clearTimeout(timer); timer = setTimeout(refresh, 800); }

  render(INITIAL);
  setInterval(refresh, 30000);
  document.addEventListener('visibilitychange', function () { if (!document.hidden) refresh(); });
  try {
    var sock = window.dashboardSocket || (typeof io !== 'undefined' ? io() : null);
    if (sock && sock.on) { ['dashboard-updated', 'calendar-updated', 'booking-updated', 'payment-updated'].forEach(function (ev) { sock.on(ev, soon); }); }
  } catch (e) { /* the 30 s refresh still runs */ }
})();
</script>
