        '<button type="button" class="done" data-rq="done" data-id="' + q.id + '">Done</button><button type="button" class="cancel" data-rq="cancel" data-id="' + q.id + '" title="Cancel the request">&times;</button></div>';
    }).join('') : '<div class="hkr-empty">No request is waiting.</div>';
