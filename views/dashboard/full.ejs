    var state = String(r.status) === '2' ? (r.guest ? esc(r.guest) : 'Occupied') : String(r.status) === '4' ? 'To be cleaned' : String(r.status) === '3' ? 'Out of order' : 'Vacant';
    document.getElementById('hkrSub').innerHTML = 'Room <b>' + esc(r.no) + '</b> &middot; ' + state;
