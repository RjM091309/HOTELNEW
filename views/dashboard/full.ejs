  /* ===== Housekeeping (what the Housekeeping app did, here in the Housekeeping view): the room panel's actions, the work list, minibar / laundry ===== */
  .hkw-wrap, .hkc-wrap { --accent: <%= (typeof currentProperty !== 'undefined' && currentProperty && currentProperty.COLOR) ? currentProperty.COLOR : '#4361ee' %>;
    --fd-card: #141b2e; --fd-card-2: #19223a; --fd-line: rgba(255,255,255,.07); --fd-line-2: rgba(255,255,255,.13); --fd-text: #eef2ff; --fd-muted: #8b97b8;
    --fd-good: #34d399; --fd-warn: #fbbf24; --fd-bad: #fb7185; --fd-info: #60a5fa; }
  [data-theme="white"] .hkw-wrap, [data-theme="white"] .hkc-wrap { --fd-card: #ffffff; --fd-card-2: #ffffff; --fd-line: rgba(15,23,42,.08); --fd-line-2: rgba(15,23,42,.16); --fd-text: #0f172a; --fd-muted: #64748b;
    --fd-good: #059669; --fd-warn: #b45309; --fd-bad: #e11d48; --fd-info: #2563eb; }
  [data-theme="white"] .hkr-wrap { --fd-good: #059669; --fd-warn: #b45309; --fd-bad: #e11d48; --fd-info: #2563eb; }
  .hkr-wrap { --fd-good: #34d399; --fd-warn: #fbbf24; --fd-bad: #fb7185; --fd-info: #60a5fa; }
  .hk-chips { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 4px; }
  .hk-chip { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; color: var(--c, var(--fd-muted)); background: color-mix(in srgb, var(--c, var(--fd-muted)) 14%, transparent); border: 1px solid color-mix(in srgb, var(--c, var(--fd-muted)) 30%, transparent); white-space: nowrap; }
  .hk-chip.good { --c: var(--fd-good); } .hk-chip.warn { --c: var(--fd-warn); } .hk-chip.bad { --c: var(--fd-bad); } .hk-chip.info { --c: var(--fd-info); } .hk-chip.acc { --c: var(--accent); } .hk-chip.req { --c: #a78bfa; }
  .hk-btn { border: 1px solid var(--fd-line-2, var(--fd-line)); background: transparent; color: var(--fd-text); border-radius: 10px; padding: 7px 12px; font-size: 12.5px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
