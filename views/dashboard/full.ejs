      tile('Occupied', 'fa-bed', pad(r.occupied), 'acc', 'of ' + D.totalRooms + ' rooms') +
      tile('Check in', 'fa-sign-in-alt', pad(r.checkIn.total), 'good', r.checkIn.done ? r.checkIn.done + ' already in' : 'still to arrive', '/calendar?focus=arrivals') +
      tile('Check out', 'fa-sign-out-alt', pad(r.checkOut.total), 'info', r.checkOut.done ? r.checkOut.done + ' already out' : 'still to leave', '/calendar?focus=departures') + '</div>' +
      '<div class="fd-sec">Housekeeping</div><div class="fd-tiles">' +
      tile('Available', 'fa-check-circle', pad(h.available), 'good', 'ready to sell') +
      tile('Dirty', 'fa-broom', pad(h.dirty), 'warn', h.dirty ? 'to clean' : 'all clean', h.dirty ? '/calendar?cleaning=all' : '') +
      tile('Out of order', 'fa-ban', pad(h.outOfOrder), 'bad', h.outOfOrder ? 'maintenance' : 'none') + '</div>';
  }

  function cardRooms() {
    var s = D.byStatus, t = D.totalRooms || 1;
    var rows = [['Available', s.available, 'var(--fd-good)'], ['Occupied', s.occupied, 'var(--accent)'], ['Dirty', s.dirty, 'var(--fd-warn)'], ['Out of order', s.outOfOrder, 'var(--fd-bad)']];
    var pct = Math.round((s.occupied / t) * 100);
    return '<div class="fd-card-head"><div class="fd-card-title">Total rooms</div><span class="fd-card-note">' + D.totalRooms + ' rooms</span></div>' +
      '<div class="fd-card-note">Occupied now</div><div class="fd-occ"><b>' + pct + '</b><span>%</span><em>' + s.occupied + ' of ' + D.totalRooms + '</em></div>' +
      '<div class="fd-seg">' + rows.map(function (r) { return '<span style="--k:' + rows.indexOf(r) + ';width:' + (r[1] / t * 100) + '%;background:' + r[2] + '"></span>'; }).join('') + '</div>' +
      '<div class="fd-legend">' + rows.map(function (r) { return '<div><i class="fd-dot" style="background:' + r[2] + '"></i><span>' + r[0] + '</span><span class="n">' + pad(r[1]) + '</span><span class="p">' + Math.round(r[1] / t * 100) + '%</span></div>'; }).join('') + '</div>';
  }

  function cardRev() {
    var days = D.revenue.days, max = 1, W = 300, H = 110, bw = 30, gap = (W - 7 * bw) / 6;
    days.forEach(function (d) { max = Math.max(max, d.amount); });
    var bars = days.map(function (d, i) {
      var h = d.amount ? Math.max(5, Math.round(d.amount / max * (H - 24))) : 2, x = i * (bw + gap), y = H - 16 - h;
      return '<g><title>' + esc(d.short) + ': ₱' + peso(d.amount) + '</title><rect class="fd-bar" style="--bi:' + i + '" x="' + x.toFixed(1) + '" y="' + y + '" width="' + bw + '" height="' + h + '" rx="6" fill="' + (d.isToday ? 'var(--accent)' : 'color-mix(in srgb, var(--fd-text) 22%, transparent)') + '"/>' +
        '<text class="fd-axis ' + (d.isToday ? 'today' : '') + '" x="' + (x + bw / 2).toFixed(1) + '" y="' + (H - 2) + '">' + esc(d.letter) + '</text></g>';
    }).join('');
    return '<div class="fd-card-head"><div class="fd-card-title">Revenue</div><a class="fd-card-link" href="/payments">Details »</a></div>' +
      '<div class="fd-money-l">Today</div><div class="fd-money-v"><small>PHP</small>' + peso(D.revenue.today) + '</div>' +
      '<div class="fd-bars"><svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none">' + bars + '</svg></div>' +
      '<div class="fd-money-foot"><div><div class="fd-money-l">Yesterday</div><div class="fd-money-v"><small>PHP</small>' + peso(D.revenue.yesterday) + '</div></div>' +
      '<div><div class="fd-money-l">Last 30 days</div><div class="fd-money-v"><small>PHP</small>' + peso(D.revenue.last30) + '<em>≈ ' + peso(D.revenue.perDay) + '/day</em></div></div></div>';
  }

  function smooth(pts) {      // points -> a smooth svg path
    if (pts.length < 2) return '';
    var d = 'M' + pts[0][0] + ',' + pts[0][1];
    for (var i = 0; i < pts.length - 1; i++) {
      var p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
      d += ' C' + (p1[0] + (p2[0] - p0[0]) / 6).toFixed(1) + ',' + (p1[1] + (p2[1] - p0[1]) / 6).toFixed(1) + ' ' + (p2[0] - (p3[0] - p1[0]) / 6).toFixed(1) + ',' + (p2[1] - (p3[1] - p1[1]) / 6).toFixed(1) + ' ' + p2[0] + ',' + p2[1];
    }
    return d;
  }

  function cardBook() {
    var rows = D.bookings.slice(-ui.days), W = BV ? 400 : 760, H = 230, L = 34, B = 26, T = 10, R = 8;
    var max = 4; rows.forEach(function (r) { max = Math.max(max, r.checkIns, r.reserved); });
    max = Math.ceil(max / 4) * 4; var step = max / 4;
    var iw = W - L - R, ih = H - B - T;
    function X(i) { return L + (rows.length === 1 ? iw / 2 : i * iw / (rows.length - 1)); }
    function Y(v) { return T + ih - (v / max) * ih; }
    var grid = '';
    for (var g = 0; g <= 4; g++) { var gy = Y(step * g); grid += '<line class="fd-grid-l" x1="' + L + '" x2="' + (W - R) + '" y1="' + gy + '" y2="' + gy + '"/><text class="fd-grid-t" x="' + (L - 8) + '" y="' + (gy + 3) + '">' + (step * g) + '</text>'; }
    var every = rows.length > 14 ? 4 : (rows.length > 7 ? 2 : 1), xl = '';
    rows.forEach(function (r, i) { if (i % every === 0 || i === rows.length - 1) xl += '<text class="fd-axis ' + (r.isToday ? 'today' : '') + '" x="' + X(i) + '" y="' + (H - 6) + '">' + esc(r.short) + '</text>'; });
    var ci = rows.map(function (r, i) { return [X(i), Y(r.checkIns)]; }), rs = rows.map(function (r, i) { return [X(i), Y(r.reserved)]; });
    var area = smooth(ci) + ' L' + X(rows.length - 1) + ',' + (T + ih) + ' L' + X(0) + ',' + (T + ih) + ' Z';
    var dots = rows.map(function (r, i) { return '<circle class="fd-dotp" style="--bi:' + i + '" cx="' + X(i) + '" cy="' + Y(r.checkIns) + '" r="' + (r.isToday ? 4.5 : 3) + '" fill="var(--accent)" stroke="var(--fd-card)" stroke-width="2"><title>' + esc(r.short) + ' — ' + r.checkIns + ' check-in(s), ' + r.reserved + ' reservation(s) made</title></circle>'; }).join('');
    return '<div class="fd-card-head"><div style="display:flex;align-items:baseline;gap:10px"><div class="fd-card-title">Bookings</div><span class="fd-card-note"><i class="fas fa-sync-alt"></i> Last update <span id="fdUpd">just now</span></span></div>' +
      '<select class="fd-select" id="fdDays"><option value="7"' + (ui.days === 7 ? ' selected' : '') + '>Last 7 days</option><option value="14"' + (ui.days === 14 ? ' selected' : '') + '>Last 14 days</option><option value="30"' + (ui.days === 30 ? ' selected' : '') + '>Last 30 days</option></select></div>' +
      '<div class="fd-line"><svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none"><defs><linearGradient id="fdArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--accent)" stop-opacity=".32"/><stop offset="1" stop-color="var(--accent)" stop-opacity="0"/></linearGradient></defs>' +
      grid + '<path class="fd-area" d="' + area + '" fill="url(#fdArea)"/><path d="' + smooth(rs) + '" fill="none" stroke="var(--fd-grey)" stroke-width="2" stroke-dasharray="5 5" opacity=".8"/><path class="fd-draw" pathLength="1" d="' + smooth(ci) + '" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"/>' + dots + xl + '</svg></div>' +
      '<div class="fd-line-key"><span><i style="background:var(--accent)"></i>Check-ins</span><span><i style="background:var(--fd-grey)"></i>Reservations made</span></div>';
  }

  function cardCal() {
    var types = []; D.rooms.forEach(function (r) { var t = types.filter(function (x) { return x.id === r.typeId; })[0]; if (!t) { t = { id: r.typeId, name: r.type, n: 0 }; types.push(t); } t.n++; });
    if (ui.typeId == null || !types.some(function (t) { return t.id === ui.typeId; })) ui.typeId = types.length ? types[0].id : null;
    var rooms = D.rooms.filter(function (r) { return r.typeId === ui.typeId; });
    if (!rooms.some(function (r) { return r.id === ui.roomId; })) ui.roomId = rooms.length ? rooms[0].id : null;
    var tabs = types.map(function (t) { return '<button type="button" class="fd-tab' + (t.id === ui.typeId ? ' on' : '') + '" data-type="' + t.id + '">' + esc(t.name) + '<b>' + t.n + '</b></button>'; }).join('');
    var opts = rooms.map(function (r) { return '<option value="' + r.id + '"' + (r.id === ui.roomId ? ' selected' : '') + '>Room #' + esc(r.no) + '</option>'; }).join('');
    var month = new Date().toLocaleDateString('en-US', { month: 'long' });
    var html = '<div class="fd-card-head"><div class="fd-card-title">Calendar</div><a class="fd-card-link" href="/calendar">' + month + ' »</a></div>' +
      '<div class="fd-tabs" id="fdTabs">' + tabs + '</div>' +
      '<div class="fd-roompick"><button class="fd-nav" id="fdPrev" type="button"><i class="fas fa-chevron-left"></i></button><select class="fd-select" id="fdRoom">' + opts + '</select><button class="fd-nav" id="fdNext" type="button"><i class="fas fa-chevron-right"></i></button></div>';
    var list = '';
    for (var i = 0; i < 12; i++) {
      var dt = new Date(D.today + 'T12:00:00'); dt.setDate(dt.getDate() + i);
      var key = dt.getFullYear() + '-' + pad(dt.getMonth() + 1) + '-' + pad(dt.getDate());
      var b = D.agenda.filter(function (x) { return x.roomId === ui.roomId && x.ci <= key && key < x.co; })[0];
      var slot;
      if (b) { var st = STATUS[b.status] || ['', '#94a3b8']; slot = '<a class="fd-slot busy" href="/calendar" style="--c:' + st[1] + '"><span style="display:flex;align-items:center;gap:8px;color:var(--fd-text);font-size:12.5px;font-weight:600"><i class="fd-av" style="--c:' + st[1] + '">' + esc(initials(b.guest)) + '</i>' + esc(b.guest) + '</span><span>' + st[0] + '</span></a>'; }
      else { slot = '<a class="fd-slot" href="/calendar">Available for booking <i class="fas fa-plus"></i></a>'; }
      list += '<div class="fd-day' + (i === 0 ? ' today' : '') + '"><div class="fd-day-d"><b>' + dt.getDate() + '</b><span>' + dt.toLocaleDateString('en-US', { weekday: 'short' }) + '</span></div>' + slot + '</div>';
    }
    return html + '<div class="fd-agenda">' + list + '</div>';
  }

  // the 3D building: the property's rooms with their status; a click opens the booking (or the cleaning list) in the calendar
  function bldSig() { var s = JSON.stringify(D.building || []), h = 0; for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return h; }
  function cardBld() {
    var B = window.Building3D, c = B.counts(D.building);
    function sw(bg) { return '<i class="fd-sw" style="background:' + bg + '"></i>'; }
    return '<div class="fd-card-head"><div class="fd-card-title">Building</div><span class="fd-card-note">' + (D.building || []).length + ' rooms &middot; click a room to open it</span></div>' +
      '<div class="fd-bld" id="fdBld" data-sig="' + bldSig() + '"></div>' +
      '<div class="fd-bld-legend">' +
      '<span>' + sw('linear-gradient(#fff4d6,#ffc65e)') + 'Occupied <b>' + c.occupied + '</b></span>' +
      '<span>' + sw('#2c2430') + 'Clean, empty <b>' + c.vacant + '</b></span>' +
      '<span>' + sw('#ffb59a') + 'To be cleaned <b>' + c.dirty + '</b></span>' +
      '<span>' + sw('repeating-linear-gradient(45deg,#b3aaa6 0 3px,#5a4a42 3px 4px)') + 'Out of order <b>' + c.ooo + '</b></span>' +
      '<span><i class="fd-sd" style="background:' + B.ARRIVE + '"></i>Arriving today <b>' + c.arriving + '</b></span>' +
      '<span><i class="fd-sd" style="background:' + B.LEAVE + '"></i>Leaving today <b>' + c.leaving + '</b></span></div>';
  }
  // The Booking details open right here on the dashboard: the calendar page is loaded invisibly in a frame (?embed=1 shows only its modal),
  // so every button of the details (Edit, Move room, Billing, Payment, Check in...) works as in the calendar, and the dashboard stays.
  function openBookingHere(id, kind) {
    kind = kind || 'openBooking';   // 'cleaning' = the Cleaning Rooms list instead of a booking (id is the room number)
    if (document.getElementById('bdFrameWrap')) return;
    var wrap = document.createElement('div'); wrap.id = 'bdFrameWrap';
    wrap.style.cssText = 'position:fixed;inset:0;z-index:100000;background:rgba(2,6,16,.55)';
    wrap.innerHTML = '<div id="bdFrameSpin" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#e8ecef;font:600 14px Poppins,sans-serif">Opening booking&hellip;</div>' +
      '<iframe title="Booking details" style="position:absolute;inset:0;width:100%;height:100%;border:0;background:transparent;opacity:0" allowtransparency="true"></iframe>';
    document.body.appendChild(wrap);
    var frame = wrap.querySelector('iframe'), done = false;
    function close(reload) {
      if (done) return; done = true; window.removeEventListener('message', onMsg); clearTimeout(guard);
      wrap.remove(); if (reload !== false) { try { load(); } catch (e) {} }
    }
    function onMsg(e) {
      if (e.origin !== window.location.origin || !e.data || e.source !== frame.contentWindow) return;
      if (e.data.type === 'bd-ready') { clearTimeout(guard); frame.style.opacity = '1'; var sp = document.getElementById('bdFrameSpin'); if (sp) sp.remove(); wrap.style.background = 'transparent'; }
      else if (e.data.type === 'bd-closed') close(true);
      else if (e.data.type === 'bd-failed') close(false);
    }
    window.addEventListener('message', onMsg);
    var guard = setTimeout(function () { close(false); calendarTab('/calendar', '?' + kind + '=' + encodeURIComponent(id)); }, 20000); // frame never answered: the shared calendar tab opens it (this tab stays the dashboard)
    frame.src = '/calendar?embed=1&' + kind + '=' + encodeURIComponent(id);
  }
  // Check in / Check out open the calendar in the SAME tab the sidebar's Calendar uses (openInOwnTab, footer.ejs): never a second calendar tab.
  document.addEventListener('click', function (e) {
    var t = e.target.closest && e.target.closest('a[data-own-tab]'); if (!t || typeof openInOwnTab !== 'function') return;
    var q = t.getAttribute('href').split('?');
    if (openInOwnTab(q[0], q[1] ? '?' + q[1] : '')) e.preventDefault();
  });
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a.fd-link[href^="/calendar?openBooking="]'); if (!a) return;
    e.preventDefault(); openBookingHere(decodeURIComponent(a.getAttribute('href').split('=')[1]));
  });

  function calendarTab(path, query) {
    if (typeof openInOwnTab === 'function' && openInOwnTab(path, query)) return;
    window.open(path + query, '_blank');
  }

  function paintBld(animate) {
    var el = document.getElementById('fdBld'); if (!el || !D.building) return;
    window.Building3D.render(el, D.building, { name: PNAME, mode: 'full', animate: !!animate, onRoom: function (r) {
      if (r.bookingId) openBookingHere(r.bookingId);
      // a room with no booking (clean and empty, to be cleaned, out of order) goes to the shared calendar tab, never away from the dashboard
      else if (String(r.status) === '4') openBookingHere(r.no, 'cleaning');
      else calendarTab('/calendar', '?room=' + encodeURIComponent(r.no));
    } });
  }

  function cardCust() {
    var items = (BV ? D.customers.slice(0, 4) : D.customers).map(function (c) {
      var st = STATUS[c.status] || [c.status, '#94a3b8'];
      return '<a class="fd-item fd-link" href="/calendar?openBooking=' + encodeURIComponent(c.id) + '" title="Open the booking details"><div class="fd-avatar" style="--c:' + hue(c.name) + '">' + esc(initials(c.name)) + '</div><div class="fd-item-main"><div class="fd-item-t">' + esc(c.name) + '</div>' +
        '<div class="fd-item-s">Room #' + esc(c.room || '-') + ' · ' + (c.nights || 1) + ' night' + ((c.nights || 1) > 1 ? 's' : '') + '</div></div>' +
        '<div class="fd-item-r">' + shortDate(c.ci) + ' – ' + shortDate(c.co) + '<br><span class="fd-badge" style="--c:' + st[1] + '">' + st[0] + '</span></div></a>';
    }).join('');
    return '<div class="fd-card-head"><div class="fd-card-title">New customers</div><a class="fd-card-link" href="/booking">View all »</a></div><div class="fd-list">' + (items || '<div class="fd-empty">No bookings yet.</div>') + '</div>';
  }

  var ACT = {
    BOOKING_CREATE: ['created a booking', 'fa-calendar-plus', '#60a5fa'], BOOKING_UPDATE: ['changed a booking', 'fa-sliders-h', '#94a3b8'], CHECKOUT: ['checked out', 'fa-sign-out-alt', '#fbbf24'],
    CHECK_IN_WITH_DEPOSIT: ['checked in', 'fa-sign-in-alt', '#34d399'], PAYMENT_ADD: ['received a payment', 'fa-coins', '#34d399'], BOOKING_EXTEND: ['extended a stay', 'fa-calendar-plus', '#a78bfa'],
    BOOKING_CANCEL: ['cancelled a booking', 'fa-ban', '#fb7185'], BOOKING_STATUS_UPDATE: ['updated a booking', 'fa-sync-alt', '#94a3b8']
  };
  function cardAct() {
    var items = (BV ? D.activities.slice(0, 4) : D.activities).map(function (a) {
      var m = ACT[a.action] || [String(a.action || '').toLowerCase().replace(/_/g, ' '), 'fa-circle', '#94a3b8'];
      var title = a.guest ? '<b>' + esc(a.guest) + '</b> ' + m[0] : esc(a.description || m[0]);
      return '<div class="fd-item"><div class="fd-ico" style="--c:' + m[2] + '"><i class="fas ' + m[1] + '"></i></div><div class="fd-item-main"><div class="fd-item-t" style="font-weight:500">' + title + '</div>' +
        '<div class="fd-item-s">' + (a.room ? 'Room #' + esc(a.room) + ' · ' : '') + 'by ' + esc(a.who) + '</div></div><div class="fd-item-r">' + ago(a.at) + '</div></div>';
    }).join('');
    return '<div class="fd-card-head"><div class="fd-card-title">Recent activities</div><a class="fd-card-link" href="/activity-log">View all »</a></div><div class="fd-list">' + (items || '<div class="fd-empty">No activity yet.</div>') + '</div>';
  }

  var CALM = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var entering = false, sigs = {};
  var SEL = '.fd-tile,.fd-sec,.fd-occ,.fd-seg,.fd-legend > div,.fd-money-l,.fd-money-v,.fd-money-foot > div,.fd-item,.fd-day,.fd-tabs,.fd-roompick,.fd-line,.fd-line-key,.fd-bars,.fd-card-head';

  // every stat of a card gets its own place in the entry order; the numbers count up
  function stagger(card, ci) {
    card.style.setProperty('--c', ci);
    card.querySelectorAll(SEL).forEach(function (e, i) { e.classList.add('fd-a'); e.style.setProperty('--i', i); });
    card.querySelectorAll('.fd-tile-v, .fd-occ b').forEach(function (e, i) { countUp(e, ci * 90 + 260 + i * 70); });
  }
  function countUp(el, delay) {
    var raw = el.textContent.trim(), n = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    if (!entering || CALM || isNaN(n) || n === 0) return;
    var padTo = /^0\d/.test(raw) ? raw.length : 0, start = null, dur = 900;
    el.textContent = padTo ? '0'.repeat(padTo) : '0';
    function step(ts) { if (!start) start = ts; var p = Math.min(1, (ts - start) / dur), v = Math.round(n * (1 - Math.pow(1 - p, 4))); el.textContent = padTo ? String(v).padStart(padTo, '0') : String(v); if (p < 1) requestAnimationFrame(step); }
    setTimeout(function () { requestAnimationFrame(step); }, delay);
  }

  function draw(force) {
    if (!D) return;
    var cards = { 'c-res': cardRes, 'c-rooms': cardRooms, 'c-rev': cardRev, 'c-book': cardBook, 'c-cal': cardCal, 'c-bld': cardBld, 'c-cust': cardCust, 'c-act': cardAct };
    var order = BV ? ['c-res', 'c-rev', 'c-book', 'c-bld', 'c-cust', 'c-act'] : ['c-res', 'c-rooms', 'c-rev', 'c-book', 'c-cal', 'c-cust', 'c-act'];
    order.forEach(function (k, ci) {
      var el = grid.querySelector('.' + k); if (!el) return;
      var html = cards[k]().replace(/Last update <span id="fdUpd">[^<]*<\/span>/, 'Last update');
      if (!force && sigs[k] === html) return;                    // nothing changed in this card: leave it alone (no flicker)
      sigs[k] = html;
      el.innerHTML = cards[k]();
      if (k === 'c-bld') paintBld(entering);
      if (entering) stagger(el, ci);
    });
    bind();
  }
  function redrawCard(sel, fn) { var el = grid.querySelector(sel); if (!el) return; el.classList.remove('re'); el.innerHTML = fn(); void el.offsetWidth; el.classList.add('re'); setTimeout(function () { el.classList.remove('re'); }, 1600); }

  function bind() {
    var days = document.getElementById('fdDays'); if (days) days.onchange = function () { ui.days = parseInt(days.value, 10) || 7; redrawCard('.c-book', cardBook); bind(); };
    var tabs = document.getElementById('fdTabs'); if (tabs) tabs.onclick = function (e) { var b = e.target.closest('.fd-tab'); if (!b) return; ui.typeId = parseInt(b.getAttribute('data-type'), 10); ui.roomId = null; redrawCard('.c-cal', cardCal); bind(); };
    var room = document.getElementById('fdRoom'); if (room) room.onchange = function () { ui.roomId = parseInt(room.value, 10); redrawCard('.c-cal', cardCal); bind(); };
    function step(dir) { var list = D.rooms.filter(function (r) { return r.typeId === ui.typeId; }), i = list.findIndex(function (r) { return r.id === ui.roomId; }); if (i < 0) return; ui.roomId = list[(i + dir + list.length) % list.length].id; redrawCard('.c-cal', cardCal); bind(); }
    var p = document.getElementById('fdPrev'), n = document.getElementById('fdNext'); if (p) p.onclick = function () { step(-1); }; if (n) n.onclick = function () { step(1); };
  }

  function clock() {
    var d = new Date(), h = d.getHours();
    document.getElementById('fdGreet').textContent = h < 12 ? 'Good morning' : (h < 18 ? 'Good afternoon' : 'Good evening');
    document.getElementById('fdDate').textContent = d.toLocaleDateString('en-US', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' });
    document.getElementById('fdTime').textContent = d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
    var u = document.getElementById('fdUpd'); if (u && D) u.textContent = ago(D.updatedAt);
  }

  var busy = false;
  function load() {
    if (busy || document.hidden) return; busy = true;
    fetch('/dashboard/full-data', { credentials: 'same-origin' }).then(function (r) { return r.json(); })
      .then(function (j) { if (j && j.success) { D = j.data; if (firstLoad) { firstLoad = false; startEntry(); } else draw(); } })
      .catch(function () { /* keep what is shown */ })
      .then(function () { busy = false; clock(); });
  }
  var root = document.getElementById('fd');
  var splash = null, enter = null;
  try { enter = JSON.parse(sessionStorage.getItem('fdEnter') || 'null'); sessionStorage.removeItem('fdEnter'); } catch (e) { enter = null; }
  if (enter && !CALM) {                                           // we come from a card: keep its panel up until the numbers are here
    splash = document.createElement('div'); splash.className = 'fd-splash'; splash.style.setProperty('--sp', enter.color || '#4361ee'); splash.setAttribute('data-code', enter.code || '');
    splash.innerHTML = '<div class="fd-splash-in">' + (enter.logo ? '<img src="' + esc(enter.logo) + '" alt="">' : '<i class="fas ' + esc(enter.icon || 'fa-building') + '"></i>') + '<b>' + esc(enter.name || '') + '</b><div class="fd-splash-bar"><span></span></div></div>';
    document.body.appendChild(splash);
    // only over the page area (the red box): the header and the sidebar stay visible
    var area = document.querySelector('.page-content') || root;
    var fit = function () { if (!splash) return; var r = area.getBoundingClientRect(); splash.style.inset = 'auto'; var hd = document.querySelector('.page-header'), t0 = hd ? hd.getBoundingClientRect().bottom : r.top; splash.style.top = t0 + 'px'; splash.style.left = r.left + 'px'; splash.style.width = r.width + 'px'; splash.style.height = (window.innerHeight - t0) + 'px'; };
    fit(); window.addEventListener('resize', fit);
  }
  function startEntry() {
    entering = true; root.classList.add('is-enter');
    draw(true);
    if (splash) { var sp = splash; splash = null; requestAnimationFrame(function () { sp.classList.add('is-out'); setTimeout(function () { sp.remove(); }, 800); }); }
    setTimeout(function () { root.classList.remove('is-enter'); entering = false; }, 3200);
  }
  var firstLoad = true;
  window.__refreshOnShow = load;     // back in view after a change in another tab (footer.ejs)
  clock(); setInterval(clock, 15000); load(); setInterval(load, 30000);
  document.addEventListener('visibilitychange', function () { if (!document.hidden) load(); });
  try {
    var sock = window.dashboardSocket || (typeof io !== 'undefined' ? io() : null);
    if (sock && sock.on) { var t = null; ['dashboard-updated', 'calendar-updated', 'booking-updated', 'payment-updated'].forEach(function (ev) { sock.on(ev, function () { clearTimeout(t); t = setTimeout(load, 800); }); }); }
  } catch (e) { /* the 30 s refresh still runs */ }
})();
</script>
