<!-- ============================================================
     FULL DASHBOARD of the active property ("Expand Full Dashboard" on the overview).
     Data: /dashboard/full-data (models/propertyDashboardModel.js). Refreshes itself every 30 s.
     ============================================================ -->
<style>
  .fd { --accent: <%= (typeof currentProperty !== 'undefined' && currentProperty && currentProperty.COLOR) ? currentProperty.COLOR : '#4361ee' %>;
    --fd-card: #141b2e; --fd-card-2: #19223a; --fd-line: rgba(255,255,255,.07); --fd-line-2: rgba(255,255,255,.13); --fd-text: #eef2ff; --fd-muted: #8b97b8;
    --fd-good: #34d399; --fd-warn: #fbbf24; --fd-bad: #fb7185; --fd-info: #60a5fa; --fd-grey: #94a3b8; color: var(--fd-text); padding: 2px 2px 28px; }
  [data-theme="white"] .fd { --fd-card: #ffffff; --fd-card-2: #f1f5fb; --fd-line: rgba(15,23,42,.08); --fd-line-2: rgba(15,23,42,.16); --fd-text: #0f172a; --fd-muted: #64748b;
    --fd-good: #059669; --fd-warn: #d97706; --fd-bad: #e11d48; --fd-info: #2563eb; --fd-grey: #64748b; }
  .fd * { box-sizing: border-box; }
  .fd-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin: 4px 2px 16px; }
  .fd-hello { margin: 0; font-size: 13px; color: var(--fd-muted); }
  .fd-hello b { color: var(--fd-text); font-weight: 600; }
  .fd-title { margin: 2px 0 0; font-size: 26px; font-weight: 700; letter-spacing: .2px; color: var(--fd-text); display: flex; align-items: center; gap: 12px; }
  .fd-title small { font-size: 12px; font-weight: 600; letter-spacing: .8px; text-transform: uppercase; color: var(--accent); padding: 4px 10px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .fd-clock { display: inline-flex; align-items: center; gap: 12px; padding: 9px 14px; border-radius: 12px; background: var(--fd-card); border: 1px solid var(--fd-line); font-size: 13px; color: var(--fd-muted); }
  .fd-clock b { color: var(--fd-text); font-variant-numeric: tabular-nums; }
  .fd-clock i { color: var(--accent); }
  .fd-back { display: inline-flex; align-items: center; gap: 8px; margin-right: 10px; padding: 9px 13px; border-radius: 12px; background: transparent; border: 1px solid var(--fd-line-2); color: var(--fd-muted); font-size: 13px; text-decoration: none; transition: all .2s; }
  .fd-back:hover { color: var(--fd-text); border-color: var(--accent); }

  .fd-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px; }
  .fd-card { background: linear-gradient(170deg, var(--fd-card-2), var(--fd-card)); border: 1px solid var(--fd-line); border-radius: 18px; padding: 18px; min-width: 0; box-shadow: 0 14px 30px -20px rgba(0,0,0,.6); }
  .fd-card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
  .fd-card-title { margin: 0; font-size: 15px; font-weight: 600; color: var(--fd-text); }
  .fd-card-note { font-size: 12px; color: var(--fd-muted); }
  .fd-card-link { font-size: 12px; color: var(--fd-muted); text-decoration: none; } .fd-card-link:hover { color: var(--accent); }
  .fd-item.fd-link { color: inherit; text-decoration: none; cursor: pointer; border-radius: 10px; transition: background .18s ease; }
  .fd-item.fd-link:hover { background: color-mix(in srgb, var(--accent) 9%, transparent); color: inherit; text-decoration: none; }
  .fd-card.c-act { cursor: pointer; user-select: none; -webkit-user-select: none; transition: border-color .2s ease; }
  .fd-card.c-act:hover { border-color: var(--accent); }
  .fd-card.c-act:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fd-card.c-rev { cursor: pointer; user-select: none; -webkit-user-select: none; transition: border-color .2s ease, transform .2s ease; }
  .fd-card.c-rev:hover { border-color: var(--accent); }
  .fd-card.c-rev:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .c-res { grid-column: span 4; } .c-rooms { grid-column: span 4; } .c-rev { grid-column: span 4; }
  .c-book { grid-column: span 8; } .c-cal { grid-column: span 4; grid-row: span 2; }
  .c-cust { grid-column: span 4; } .c-act { grid-column: span 4; }
  @media (max-width: 1280px) { .c-res, .c-rooms { grid-column: span 6; } .c-rev { grid-column: span 12; } .c-book { grid-column: span 12; } .c-cal { grid-column: span 12; grid-row: auto; } .c-cust, .c-act { grid-column: span 6; } }
  @media (max-width: 760px) { .c-res, .c-rooms, .c-rev, .c-book, .c-cal, .c-cust, .c-act { grid-column: span 12; } .fd-title { font-size: 22px; } }

  /* a property with a 3D building (BUILDING_VIEW): reservation | revenue | bookings, then the building beside the newest customers and activities */
  .fd-bv .c-res, .fd-bv .c-rev, .fd-bv .c-book { grid-column: span 4; }
  .fd-bv .c-bld { grid-column: 1 / span 8; grid-row: span 2; display: flex; flex-direction: column; }
  .fd-bv .c-cust, .fd-bv .c-act { grid-column: 9 / span 4; }
  @media (max-width: 1280px) { .fd-bv .c-res, .fd-bv .c-rev, .fd-bv .c-book { grid-column: span 12; } .fd-bv .c-bld { grid-column: span 12; grid-row: auto; } .fd-bv .c-cust, .fd-bv .c-act { grid-column: span 6; } }
  @media (max-width: 760px) { .fd-bv .c-cust, .fd-bv .c-act { grid-column: span 12; } }
  .fd-bld { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; min-height: 0; padding: 0 0 56px;   /* the extra bottom padding lifts the building a little */ }
  .fd-bld-legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; padding-top: 12px; margin-top: 6px; border-top: 1px solid var(--fd-line); font-size: 12px; color: var(--fd-muted); }
  .fd-bld-legend span { display: inline-flex; align-items: center; gap: 7px; } .fd-bld-legend b { color: var(--fd-text); font-variant-numeric: tabular-nums; }
  .fd-sw { width: 15px; height: 11px; border-radius: 3px; border: 1px solid var(--fd-line-2); display: inline-block; } .fd-sd { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid #fff; display: inline-block; }
  .fd-sec { margin: 0 0 8px; font-size: 13px; font-weight: 600; color: var(--fd-text); }
  .fd-sec + .fd-tiles { margin-bottom: 16px; }
  .fd-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; }
  .fd-tile { padding: 11px 12px; border-radius: 12px; background: color-mix(in srgb, var(--fd-text) 5%, transparent); border: 1px solid var(--fd-line); min-width: 0; }
  .fd-tile-l { display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--fd-muted); white-space: nowrap; gap: 6px; }
  .fd-tile-l i { color: var(--t, var(--fd-muted)); font-size: 12px; }
  .fd-tile-v { margin-top: 8px; font-size: 28px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; color: var(--fd-text); }
  .fd-tile-s { margin-top: 5px; font-size: 11px; color: var(--fd-muted); min-height: 14px; }
  a.fd-tile.is-link { text-decoration: none; color: inherit; cursor: pointer; transition: border-color .2s, transform .2s, background .2s; } a.fd-tile.is-link:hover { border-color: var(--t); background: color-mix(in srgb, var(--t) 8%, transparent); transform: translateY(-2px); }
  .t-good { --t: var(--fd-good); } .t-warn { --t: var(--fd-warn); } .t-bad { --t: var(--fd-bad); } .t-info { --t: var(--fd-info); } .t-acc { --t: var(--accent); }

  .fd-occ { display: flex; align-items: baseline; gap: 6px; margin: 2px 0 10px; }
  .fd-occ b { font-size: 38px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; } .fd-occ span { font-size: 15px; color: var(--fd-muted); } .fd-occ em { font-style: normal; font-size: 12px; color: var(--fd-muted); margin-left: 4px; }
  .fd-seg { display: flex; height: 10px; border-radius: 8px; overflow: hidden; gap: 2px; background: var(--fd-line); }
  .fd-seg > span { display: block; height: 100%; transition: width .8s cubic-bezier(.2,.8,.2,1); min-width: 0; }
  .fd-legend { margin-top: 14px; display: grid; gap: 0; }
  .fd-legend > div { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--fd-line); font-size: 13px; }
  .fd-legend > div:last-child { border-bottom: 0; }
  .fd-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .fd-legend .n { margin-left: auto; font-weight: 600; font-variant-numeric: tabular-nums; } .fd-legend .p { width: 42px; text-align: right; color: var(--fd-muted); font-variant-numeric: tabular-nums; }

  .fd-money-l { font-size: 12px; color: var(--fd-muted); } .fd-money-v { font-size: 30px; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.1; margin-top: 2px; }
  .fd-money-v small { font-size: 14px; color: var(--fd-muted); font-weight: 600; margin-right: 4px; }
  .fd-bars { margin: 12px 0 8px; } .fd-bars svg { display: block; width: 100%; height: 110px; overflow: visible; }
  .fd-bar { transform-origin: bottom; transform-box: fill-box; } @keyframes fdGrow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  .fd-axis { font-size: 10px; fill: var(--fd-muted); text-anchor: middle; } .fd-axis.today { fill: var(--accent); font-weight: 700; }
  .fd-money-foot { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding-top: 12px; border-top: 1px solid var(--fd-line); }
  .fd-money-foot .fd-money-v { font-size: 17px; } .fd-money-foot em { font-style: normal; font-size: 11px; color: var(--fd-muted); margin-left: 4px; font-weight: 500; }

  .fd-select { background: var(--fd-card-2); color: var(--fd-text); border: 1px solid var(--fd-line-2); border-radius: 10px; padding: 7px 28px 7px 11px; font-size: 12.5px; outline: none; cursor: pointer; }
  .fd-line svg { display: block; width: 100%; height: 230px; overflow: visible; }
  .fd-grid-l { stroke: var(--fd-line); stroke-width: 1; } .fd-grid-t { font-size: 10px; fill: var(--fd-muted); text-anchor: end; }
  .fd-line-key { display: flex; gap: 14px; font-size: 11.5px; color: var(--fd-muted); margin-top: 8px; } .fd-line-key i { display: inline-block; width: 14px; height: 3px; border-radius: 3px; margin-right: 6px; vertical-align: middle; }

  .fd-tabs { display: flex; gap: 4px; padding: 4px; border-radius: 12px; background: color-mix(in srgb, var(--fd-text) 6%, transparent); overflow-x: auto; scrollbar-width: none; }
  .fd-tab { flex: 1 0 auto; padding: 8px 10px; border: 0; border-radius: 9px; background: transparent; color: var(--fd-muted); font-size: 12px; cursor: pointer; white-space: nowrap; transition: all .2s; }
  .fd-tab b { font-weight: 600; margin-left: 5px; color: var(--accent); font-size: 11px; }
  .fd-tab.on { background: var(--fd-card); color: var(--fd-text); box-shadow: 0 2px 10px rgba(0,0,0,.25); }
  .fd-roompick { display: flex; gap: 8px; margin: 12px 0; } .fd-roompick .fd-select { flex: 1; } .fd-nav { width: 36px; border-radius: 10px; border: 1px solid var(--fd-line-2); background: transparent; color: var(--fd-muted); cursor: pointer; } .fd-nav:hover { color: var(--accent); border-color: var(--accent); }
  .fd-agenda { display: grid; gap: 8px; max-height: 470px; overflow-y: auto; padding-right: 4px; }
  .fd-day { display: grid; grid-template-columns: 38px 1fr; gap: 10px; align-items: stretch; }
  .fd-day-d { text-align: center; line-height: 1.15; padding-top: 6px; } .fd-day-d b { display: block; font-size: 15px; } .fd-day-d span { font-size: 10.5px; color: var(--fd-muted); } .fd-day.today .fd-day-d b { color: var(--accent); }
  .fd-slot { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 12px; border-radius: 11px; font-size: 12.5px; min-height: 40px; text-decoration: none; color: var(--fd-muted); border: 1px dashed var(--fd-line-2); transition: all .2s; }
  a.fd-slot:hover { color: var(--accent); border-color: var(--accent); }
  .fd-slot.busy { border-style: solid; border-color: color-mix(in srgb, var(--c) 45%, transparent); background: color-mix(in srgb, var(--c) 14%, transparent); color: var(--fd-text); font-weight: 600; }
  .fd-slot.busy span { font-weight: 400; font-size: 10.5px; color: var(--fd-muted); }
  .fd-av { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font-size: 10px; font-weight: 700; background: color-mix(in srgb, var(--c) 28%, transparent); color: var(--c); flex: none; }

  .fd-list { display: grid; }
  .fd-item { display: flex; align-items: center; gap: 12px; padding: 11px 2px; border-bottom: 1px solid var(--fd-line); } .fd-item:last-child { border-bottom: 0; }
  .fd-avatar { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; font-weight: 700; flex: none; background: color-mix(in srgb, var(--c, var(--accent)) 22%, transparent); color: var(--c, var(--accent)); }
  .fd-ico { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; flex: none; font-size: 13px; background: color-mix(in srgb, var(--c, var(--accent)) 16%, transparent); color: var(--c, var(--accent)); }
  .fd-item-main { min-width: 0; flex: 1; } .fd-item-t { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .fd-item-s { font-size: 11.5px; color: var(--fd-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
  .fd-item-r { text-align: right; flex: none; font-size: 11.5px; color: var(--fd-muted); }
  .fd-badge { display: inline-block; margin-top: 4px; padding: 3px 9px; border-radius: 7px; font-size: 11px; font-weight: 600; color: var(--c); background: color-mix(in srgb, var(--c) 16%, transparent); border: 1px solid color-mix(in srgb, var(--c) 35%, transparent); }
  .fd-empty { padding: 26px 8px; text-align: center; color: var(--fd-muted); font-size: 12.5px; }
  .fd-skel { height: 160px; border-radius: 14px; background: linear-gradient(90deg, transparent 25%, color-mix(in srgb, var(--fd-text) 7%, transparent) 37%, transparent 63%); background-size: 400% 100%; animation: fdSh 1.4s ease infinite; } @keyframes fdSh { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
  /* ===== entry: the cards rise in one after the other, then every stat of a card comes in on its own (--c card, --i stat) ===== */
  .fd.is-enter .fd-card { animation: fdCardIn .75s cubic-bezier(.16,.84,.3,1) both; animation-delay: calc(var(--c, 0) * 90ms); }
  .fd.is-enter .fd-a { animation: fdItemIn .55s cubic-bezier(.16,.84,.3,1) both; animation-delay: calc(var(--c, 0) * 90ms + 230ms + var(--i, 0) * 36ms); }
  .fd.is-enter .fd-head > * { animation: fdItemIn .6s cubic-bezier(.16,.84,.3,1) both; }
  .fd.is-enter .fd-head > *:nth-child(2) { animation-delay: 120ms; }
  @keyframes fdCardIn { from { opacity: 0; transform: translateY(26px) scale(.97); filter: blur(6px); } to { opacity: 1; transform: none; filter: blur(0); } }
  @keyframes fdItemIn { from { opacity: 0; transform: translateY(12px) scale(.95); } to { opacity: 1; transform: none; } }
  .fd.is-enter .fd-bar, .fd-card.re .fd-bar { animation: fdGrow .75s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(var(--c, 0) * 90ms + 520ms + var(--bi, 0) * 55ms); }
  .fd-card.re .fd-bar { animation-delay: calc(var(--bi, 0) * 40ms); }
  .fd.is-enter .fd-seg > span, .fd-card.re .fd-seg > span { animation: fdGrowX .9s cubic-bezier(.2,.8,.2,1) both; transform-origin: left; animation-delay: calc(var(--c, 0) * 90ms + 420ms + var(--k, 0) * 70ms); } @keyframes fdGrowX { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .fd.is-enter .fd-draw, .fd-card.re .fd-draw { stroke-dasharray: 1; stroke-dashoffset: 1; animation: fdDraw 1.3s cubic-bezier(.4,0,.2,1) forwards; animation-delay: calc(var(--c, 0) * 90ms + 450ms); } @keyframes fdDraw { to { stroke-dashoffset: 0; } }
  .fd.is-enter .fd-area, .fd-card.re .fd-area { animation: fdFade .9s ease both; animation-delay: calc(var(--c, 0) * 90ms + 1000ms); } @keyframes fdFade { from { opacity: 0; } to { opacity: 1; } }
  .fd.is-enter .fd-dotp { animation: fdPop .4s cubic-bezier(.2,.9,.3,1.4) both; animation-delay: calc(var(--c, 0) * 90ms + 900ms + var(--bi, 0) * 60ms); transform-box: fill-box; transform-origin: center; } @keyframes fdPop { from { opacity: 0; transform: scale(0); } to { opacity: 1; transform: scale(1); } }
  /* the panel that opened from the card on the overview stays up until the page is ready, then melts away */
  .fd-splash { position: fixed; inset: 0; z-index: 100000; display: grid; place-items: center; background: radial-gradient(90% 70% at 50% 20%, color-mix(in srgb, var(--sp, #4361ee) 30%, transparent), transparent 70%), linear-gradient(165deg, #131c33, #0a0f1f); transition: opacity .55s ease, transform .7s cubic-bezier(.4,0,.2,1), filter .55s ease; }
  .fd-splash.is-out { opacity: 0; filter: blur(6px); pointer-events: none; }
  .fd-splash-in { display: grid; justify-items: center; gap: 14px; transition: transform .6s cubic-bezier(.4,0,.2,1), opacity .4s ease; } .fd-splash.is-out .fd-splash-in { transform: translateY(-14px) scale(.96); opacity: 0; }
  .fd-splash-in img { max-height: 92px; max-width: 220px; filter: drop-shadow(0 8px 22px color-mix(in srgb, var(--sp, #4361ee) 55%, transparent)); } .fd-splash-in i { font-size: 38px; color: var(--sp, #4361ee); }
  .fd-splash-in b { font-size: 22px; letter-spacing: .6px; color: #eef2ff; font-weight: 700; text-transform: uppercase; }
  [data-theme="white"] .fd-splash { background: radial-gradient(90% 70% at 50% 20%, color-mix(in srgb, var(--sp, #4361ee) 18%, transparent), transparent 70%), linear-gradient(165deg, #ffffff, #eef2fb); }
  [data-theme="white"] .fd-splash-in b { color: #0f172a; }
  [data-theme="white"] .fd-splash-bar { background: rgba(15,23,42,.12); }
  [data-theme="white"] .fd-splash[data-code="main"] .fd-splash-in img { filter: invert(1) hue-rotate(180deg) drop-shadow(0 8px 22px color-mix(in srgb, var(--sp, #4361ee) 40%, transparent)); }
  .fd-splash-bar { width: 140px; height: 3px; border-radius: 3px; background: rgba(255,255,255,.12); overflow: hidden; } .fd-splash-bar span { display: block; height: 100%; width: 40%; border-radius: 3px; background: var(--sp, #4361ee); animation: fdLoad 1s ease-in-out infinite; } @keyframes fdLoad { 0% { transform: translateX(-100%); } 100% { transform: translateX(350%); } }
  @media (prefers-reduced-motion: reduce) { .fd.is-enter .fd-card, .fd.is-enter .fd-a, .fd.is-enter .fd-head > *, .fd.is-enter .fd-bar, .fd-card.re .fd-bar, .fd.is-enter .fd-seg > span, .fd.is-enter .fd-draw, .fd.is-enter .fd-area, .fd.is-enter .fd-dotp { animation: none !important; } .fd.is-enter .fd-draw { stroke-dasharray: none; stroke-dashoffset: 0; } .fd-skel { animation: none; } .fd-splash { transition: none; } }
</style>

<script src="/js/dashboard/building3d.js?v=21"></script>
<% var BV = !!(typeof currentProperty !== 'undefined' && currentProperty && currentProperty.BUILDING_VIEW); %>
<div class="fd<%= BV ? ' fd-bv' : '' %>" id="fd">
  <div class="fd-head">
    <div>
      <p class="fd-hello"><span id="fdGreet">Hello</span>, <b><%= user && user.FULLNAME ? user.FULLNAME : 'there' %></b></p>
      <h2 class="fd-title">Dashboard <small><%= (typeof currentProperty !== 'undefined' && currentProperty) ? (currentProperty.DISPLAY_NAME || currentProperty.NAME) : '' %></small></h2>
    </div>
    <div style="display:flex;align-items:center;flex-wrap:wrap;gap:8px;">
      
      <div class="fd-clock"><span><i class="far fa-calendar"></i>&nbsp; <span id="fdDate">&nbsp;</span></span><span><i class="far fa-clock"></i>&nbsp; <b id="fdTime">&nbsp;</b></span></div>
    </div>
  </div>

  <div class="fd-grid" id="fdGrid">
    <% if (BV) { %>
    <section class="fd-card c-res"><div class="fd-skel"></div></section>
    <section class="fd-card c-rev" role="link" tabindex="0" title="Open Payments"><div class="fd-skel"></div></section>
    <section class="fd-card c-book"><div class="fd-skel"></div></section>
    <section class="fd-card c-bld"><div class="fd-skel" style="height:460px"></div></section>
    <section class="fd-card c-cust"><div class="fd-skel"></div></section>
    <section class="fd-card c-act" role="link" tabindex="0" title="Open the Activity Log"><div class="fd-skel"></div></section>
    <% } else { %>
    <section class="fd-card c-res"><div class="fd-skel"></div></section>
    <section class="fd-card c-rooms"><div class="fd-skel"></div></section>
    <section class="fd-card c-rev" role="link" tabindex="0" title="Open Payments"><div class="fd-skel"></div></section>
    <section class="fd-card c-book"><div class="fd-skel"></div></section>
    <section class="fd-card c-cal"><div class="fd-skel" style="height:420px"></div></section>
    <section class="fd-card c-cust"><div class="fd-skel"></div></section>
    <section class="fd-card c-act" role="link" tabindex="0" title="Open the Activity Log"><div class="fd-skel"></div></section>
    <% } %>
  </div>
</div>

<script>
(function () {
  var D = null;                    // the last data
  var ui = { days: 7, typeId: null, roomId: null };
  var grid = document.getElementById('fdGrid');
  // the whole Revenue card opens Payments, the whole Recent activities card opens the Activity Log (links inside a card keep their own target)
  var CARD_LINKS = { 'c-rev': '/payments', 'c-act': '/activity-log' };
  grid.addEventListener('click', function (e) {
    if (e.target.closest('a')) return;
    for (var k in CARD_LINKS) { if (e.target.closest('.' + k)) { window.location.href = CARD_LINKS[k]; return; } }
  });
  grid.addEventListener('keydown', function (e) {
    if ((e.key !== 'Enter' && e.key !== ' ') || !e.target.classList) return;
    for (var k in CARD_LINKS) { if (e.target.classList.contains(k)) { e.preventDefault(); window.location.href = CARD_LINKS[k]; return; } }
  });
  var BV = <%= BV ? 'true' : 'false' %>;
  var PNAME = <%- JSON.stringify((typeof currentProperty !== 'undefined' && currentProperty) ? (currentProperty.DISPLAY_NAME || currentProperty.NAME) : '') %>;

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); }
  function peso(n) { return Number(n || 0).toLocaleString('en-US', { maximumFractionDigits: 0 }); }
  function pad(n) { return String(n).padStart(2, '0'); }
  function initials(name) { var p = String(name || '?').trim().split(/\s+/); return ((p[0] || '?')[0] + ((p[1] || '')[0] || (p[0] || '')[1] || '')).toUpperCase(); }
  function shortDate(s) { var d = new Date(s + 'T12:00:00'); return d.toLocaleDateString('en-US', { day: '2-digit', month: 'short' }); }
  function ago(ts) { var m = Math.max(0, Math.round((Date.now() - new Date(ts).getTime()) / 60000)); if (m < 1) return 'just now'; if (m < 60) return m + ' min'; var h = Math.round(m / 60); if (h < 24) return h + ' h'; return Math.round(h / 24) + ' d'; }
  var STATUS = { 'pending': ['Reserved', '#60a5fa'], 'check-In': ['Checked in', '#34d399'], 'check-Out': ['Checked out', '#94a3b8'] };
  var HUES = ['#34d399', '#60a5fa', '#fbbf24', '#fb7185', '#a78bfa', '#2dd4bf', '#f472b6'];
  function hue(s) { var h = 0; String(s || '').split('').forEach(function (c) { h = (h * 31 + c.charCodeAt(0)) >>> 0; }); return HUES[h % HUES.length]; }

  function tile(label, icon, value, tone, sub, href) {
    var tag = href ? 'a href="' + href + '" target="_blank" title="Open on the calendar (the same calendar tab as the sidebar)" data-own-tab="1" ' : 'div ';
    return '<' + tag + 'class="fd-tile t-' + tone + (href ? ' is-link' : '') + '"><div class="fd-tile-l"><span>' + label + '</span><i class="fas ' + icon + '"></i></div><div class="fd-tile-v">' + value + '</div><div class="fd-tile-s">' + (sub || '') + '</div></' + (href ? 'a' : 'div') + '>';
  }

  function cardRes() {
    var o = D.overview, r = o.reservation, h = o.housekeeping;
