<% var BV = !!(typeof currentProperty !== 'undefined' && currentProperty && currentProperty.BUILDING_VIEW); %>
<div class="fd<%= BV ? ' fd-bv' : '' %>" id="fd">
  <div class="fd-head">
    <div>
      <p class="fd-hello"><span id="fdGreet">Hello</span>, <b><%= user && user.FULLNAME ? user.FULLNAME : 'there' %></b></p>
      <h2 class="fd-title">Dashboard <small><%= (typeof currentProperty !== 'undefined' && currentProperty) ? (currentProperty.DISPLAY_NAME || currentProperty.NAME) : '' %></small></h2>
    </div>
    <div style="display:flex;align-items:center;flex-wrap:wrap;gap:8px;">
      
      <div class="fd-clock" id="fdClock"><span class="fd-datebtn" id="fdDateBtn" role="button" tabindex="0" title="Pick a date: the building shows how it is planned for that day"><i class="far fa-calendar"></i>&nbsp; <span id="fdDate">&nbsp;</span><input type="date" id="fdPick" tabindex="-1" aria-hidden="true"></span><span><i class="far fa-clock"></i>&nbsp; <b id="fdTime">&nbsp;</b></span></div>
    </div>
  </div>

  <div class="fd-grid" id="fdGrid">
    <% if (BV) { %>
    <section class="fd-card c-bld"><div class="fd-skel" style="height:520px"></div></section>
    <% } else { %>
    <section class="fd-card c-res"><div class="fd-skel"></div></section>
    <section class="fd-card c-rooms"><div class="fd-skel"></div></section>
    <section class="fd-card c-rev" role="link" tabindex="0" title="Open Payments"><div class="fd-skel"></div></section>
    <section class="fd-card c-book"><div class="fd-skel"></div></section>
    <section class="fd-card c-cal"><div class="fd-skel" style="height:420px"></div></section>
    <section class="fd-card c-cust"><div class="fd-skel"></div></section>
    <section class="fd-card c-act" role="link" tabindex="0" title="Open the Activity Log"><div class="fd-skel"></div></section>
    <% } %>
  </div>
</div>

<script>
(function () {
  var D = null;                    // the last data
  var ui = { days: 7, typeId: null, roomId: null, view: 'frontdesk', hkFocus: null, reqs: [], reqMap: {}, reqSig: '', date: null };
  // The views of the Building card: each one shows only its own indicators. To add another one (maintenance, another building...) add it here and
  // give cardBld() its tiles / legend.
  var BLD_VIEWS = [
    { id: 'frontdesk', label: 'Front desk', icon: 'fa-concierge-bell' },
    { id: 'housekeeping', label: 'Housekeeping', icon: 'fa-broom' }
  ];
  try { var savedView = localStorage.getItem('fdBuildingView'); if (BLD_VIEWS.some(function (v) { return v.id === savedView; })) ui.view = savedView; } catch (e) { /* the default view */ }
  var grid = document.getElementById('fdGrid');
  // the whole Revenue card opens Payments, the whole Recent activities card opens the Activity Log (links inside a card keep their own target)
  var CARD_LINKS = { 'c-rev': '/payments', 'c-act': '/activity-log' };
  grid.addEventListener('click', function (e) {
    if (e.target.closest('a')) return;
    for (var k in CARD_LINKS) { if (e.target.closest('.' + k)) { window.location.href = CARD_LINKS[k]; return; } }
  });
  grid.addEventListener('keydown', function (e) {
    if ((e.key !== 'Enter' && e.key !== ' ') || !e.target.classList) return;
    for (var k in CARD_LINKS) { if (e.target.classList.contains(k)) { e.preventDefault(); window.location.href = CARD_LINKS[k]; return; } }
  });
  var BV = <%= BV ? 'true' : 'false' %>;
  var PNAME = <%- JSON.stringify((typeof currentProperty !== 'undefined' && currentProperty) ? (currentProperty.DISPLAY_NAME || currentProperty.NAME) : '') %>;
  var PCODE = <%- JSON.stringify((typeof currentProperty !== 'undefined' && currentProperty) ? currentProperty.CODE : '') %>;
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); }
  function peso(n) { return Number(n || 0).toLocaleString('en-US', { maximumFractionDigits: 0 }); }
  function pad(n) { return String(n).padStart(2, '0'); }
  function initials(name) { var p = String(name || '?').trim().split(/\s+/); return ((p[0] || '?')[0] + ((p[1] || '')[0] || (p[0] || '')[1] || '')).toUpperCase(); }
  function shortDate(s) { var d = new Date(s + 'T12:00:00'); return d.toLocaleDateString('en-US', { day: '2-digit', month: 'short' }); }
  function ago(ts) { var m = Math.max(0, Math.round((Date.now() - new Date(ts).getTime()) / 60000)); if (m < 1) return 'just now'; if (m < 60) return m + ' min'; var h = Math.round(m / 60); if (h < 24) return h + ' h'; return Math.round(h / 24) + ' d'; }
  var STATUS = { 'pending': ['Reserved', '#60a5fa'], 'check-In': ['Checked in', '#34d399'], 'check-Out': ['Checked out', '#94a3b8'] };
  var HUES = ['#34d399', '#60a5fa', '#fbbf24', '#fb7185', '#a78bfa', '#2dd4bf', '#f472b6'];
  function hue(s) { var h = 0; String(s || '').split('').forEach(function (c) { h = (h * 31 + c.charCodeAt(0)) >>> 0; }); return HUES[h % HUES.length]; }

  function tile(label, icon, value, tone, sub, href) {
    var tag = href ? 'a href="' + href + '" target="_blank" title="Open on the calendar (the same calendar tab as the sidebar)" data-own-tab="1" ' : 'div ';
    return '<' + tag + 'class="fd-tile t-' + tone + (href ? ' is-link' : '') + '"><div class="fd-tile-l"><span>' + label + '</span><i class="fas ' + icon + '"></i></div><div class="fd-tile-v">' + value + '</div><div class="fd-tile-s">' + (sub || '') + '</div></' + (href ? 'a' : 'div') + '>';
  }

  function cardRes() {
    var o = D.overview, r = o.reservation, h = o.housekeeping;
    return '<div class="fd-sec">Reservation</div><div class="fd-tiles">' +
      tile('Occupied', 'fa-bed', pad(r.occupied), 'acc', 'of ' + D.totalRooms + ' rooms') +
      tile('Arrival', 'fa-sign-in-alt', pad(r.checkIn.total), 'good', r.checkIn.done ? r.checkIn.done + ' already in' : 'still to arrive', '/calendar?focus=arrivals') +
      tile('Check out', 'fa-sign-out-alt', pad(r.checkOut.total), 'info', r.checkOut.done ? r.checkOut.done + ' already out' : 'still to leave', '/calendar?focus=departures') + '</div>' +
      '<div class="fd-sec">Housekeeping</div><div class="fd-tiles">' +
      tile('Available', 'fa-check-circle', pad(h.available), 'good', 'ready to sell') +
      tile('Dirty', 'fa-broom', pad(h.dirty), 'warn', h.dirty ? 'to clean' : 'all clean', h.dirty ? '/calendar?cleaning=all' : '') +
      tile('Out of order', 'fa-ban', pad(h.outOfOrder), 'bad', h.outOfOrder ? 'maintenance' : 'none') + '</div>';
  }

  function cardRooms() {
    var s = D.byStatus, t = D.totalRooms || 1;
    var rows = [['Available', s.available, 'var(--fd-good)'], ['Occupied', s.occupied, 'var(--accent)'], ['Dirty', s.dirty, 'var(--fd-warn)'], ['Out of order', s.outOfOrder, 'var(--fd-bad)']];
    var pct = Math.round((s.occupied / t) * 100);
    return '<div class="fd-card-head"><div class="fd-card-title">Total rooms</div><span class="fd-card-note">' + D.totalRooms + ' rooms</span></div>' +
      '<div class="fd-card-note">Occupied now</div><div class="fd-occ"><b>' + pct + '</b><span>%</span><em>' + s.occupied + ' of ' + D.totalRooms + '</em></div>' +
      '<div class="fd-seg">' + rows.map(function (r) { return '<span style="--k:' + rows.indexOf(r) + ';width:' + (r[1] / t * 100) + '%;background:' + r[2] + '"></span>'; }).join('') + '</div>' +
      '<div class="fd-legend">' + rows.map(function (r) { return '<div><i class="fd-dot" style="background:' + r[2] + '"></i><span>' + r[0] + '</span><span class="n">' + pad(r[1]) + '</span><span class="p">' + Math.round(r[1] / t * 100) + '%</span></div>'; }).join('') + '</div>';
  }

  function cardRev() {
    var days = D.revenue.days, max = 1, W = 300, H = 110, bw = 30, gap = (W - 7 * bw) / 6;
    days.forEach(function (d) { max = Math.max(max, d.amount); });
    var bars = days.map(function (d, i) {
      var h = d.amount ? Math.max(5, Math.round(d.amount / max * (H - 24))) : 2, x = i * (bw + gap), y = H - 16 - h;
      return '<g><title>' + esc(d.short) + ': ₱' + peso(d.amount) + '</title><rect class="fd-bar" style="--bi:' + i + '" x="' + x.toFixed(1) + '" y="' + y + '" width="' + bw + '" height="' + h + '" rx="6" fill="' + (d.isToday ? 'var(--accent)' : 'color-mix(in srgb, var(--fd-text) 22%, transparent)') + '"/>' +
        '<text class="fd-axis ' + (d.isToday ? 'today' : '') + '" x="' + (x + bw / 2).toFixed(1) + '" y="' + (H - 2) + '">' + esc(d.letter) + '</text></g>';
    }).join('');
    return '<div class="fd-card-head"><div class="fd-card-title">Revenue</div><a class="fd-card-link" href="/payments">Details »</a></div>' +
      '<div class="fd-money-l">Today</div><div class="fd-money-v"><small>PHP</small>' + peso(D.revenue.today) + '</div>' +
      '<div class="fd-bars"><svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none">' + bars + '</svg></div>' +
      '<div class="fd-money-foot"><div><div class="fd-money-l">Yesterday</div><div class="fd-money-v"><small>PHP</small>' + peso(D.revenue.yesterday) + '</div></div>' +
      '<div><div class="fd-money-l">Last 30 days</div><div class="fd-money-v"><small>PHP</small>' + peso(D.revenue.last30) + '<em>≈ ' + peso(D.revenue.perDay) + '/day</em></div></div></div>';
  }

  function smooth(pts) {      // points -> a smooth svg path
    if (pts.length < 2) return '';
    var d = 'M' + pts[0][0] + ',' + pts[0][1];
    for (var i = 0; i < pts.length - 1; i++) {
      var p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
      d += ' C' + (p1[0] + (p2[0] - p0[0]) / 6).toFixed(1) + ',' + (p1[1] + (p2[1] - p0[1]) / 6).toFixed(1) + ' ' + (p2[0] - (p3[0] - p1[0]) / 6).toFixed(1) + ',' + (p2[1] - (p3[1] - p1[1]) / 6).toFixed(1) + ' ' + p2[0] + ',' + p2[1];
    }
    return d;
  }

  function cardBook() {
    var rows = D.bookings.slice(-ui.days), W = BV ? 400 : 760, H = 230, L = 34, B = 26, T = 10, R = 8;
    var max = 4; rows.forEach(function (r) { max = Math.max(max, r.checkIns, r.reserved); });
    max = Math.ceil(max / 4) * 4; var step = max / 4;
    var iw = W - L - R, ih = H - B - T;
    function X(i) { return L + (rows.length === 1 ? iw / 2 : i * iw / (rows.length - 1)); }
    function Y(v) { return T + ih - (v / max) * ih; }
    var grid = '';
    for (var g = 0; g <= 4; g++) { var gy = Y(step * g); grid += '<line class="fd-grid-l" x1="' + L + '" x2="' + (W - R) + '" y1="' + gy + '" y2="' + gy + '"/><text class="fd-grid-t" x="' + (L - 8) + '" y="' + (gy + 3) + '">' + (step * g) + '</text>'; }
    var every = rows.length > 14 ? 4 : (rows.length > 7 ? 2 : 1), xl = '';
    rows.forEach(function (r, i) { if (i % every === 0 || i === rows.length - 1) xl += '<text class="fd-axis ' + (r.isToday ? 'today' : '') + '" x="' + X(i) + '" y="' + (H - 6) + '">' + esc(r.short) + '</text>'; });
    var ci = rows.map(function (r, i) { return [X(i), Y(r.checkIns)]; }), rs = rows.map(function (r, i) { return [X(i), Y(r.reserved)]; });
    var area = smooth(ci) + ' L' + X(rows.length - 1) + ',' + (T + ih) + ' L' + X(0) + ',' + (T + ih) + ' Z';
    var dots = rows.map(function (r, i) { return '<circle class="fd-dotp" style="--bi:' + i + '" cx="' + X(i) + '" cy="' + Y(r.checkIns) + '" r="' + (r.isToday ? 4.5 : 3) + '" fill="var(--accent)" stroke="var(--fd-card)" stroke-width="2"><title>' + esc(r.short) + ' — ' + r.checkIns + ' check-in(s), ' + r.reserved + ' reservation(s) made</title></circle>'; }).join('');
    return '<div class="fd-card-head"><div style="display:flex;align-items:baseline;gap:10px"><div class="fd-card-title">Bookings</div><span class="fd-card-note"><i class="fas fa-sync-alt"></i> Last update <span id="fdUpd">just now</span></span></div>' +
      '<select class="fd-select" id="fdDays"><option value="7"' + (ui.days === 7 ? ' selected' : '') + '>Last 7 days</option><option value="14"' + (ui.days === 14 ? ' selected' : '') + '>Last 14 days</option><option value="30"' + (ui.days === 30 ? ' selected' : '') + '>Last 30 days</option></select></div>' +
      '<div class="fd-line"><svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none"><defs><linearGradient id="fdArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--accent)" stop-opacity=".32"/><stop offset="1" stop-color="var(--accent)" stop-opacity="0"/></linearGradient></defs>' +
      grid + '<path class="fd-area" d="' + area + '" fill="url(#fdArea)"/><path d="' + smooth(rs) + '" fill="none" stroke="var(--fd-grey)" stroke-width="2" stroke-dasharray="5 5" opacity=".8"/><path class="fd-draw" pathLength="1" d="' + smooth(ci) + '" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"/>' + dots + xl + '</svg></div>' +
      '<div class="fd-line-key"><span><i style="background:var(--accent)"></i>Check-ins</span><span><i style="background:var(--fd-grey)"></i>Reservations made</span></div>';
  }

  function cardCal() {
    var types = []; D.rooms.forEach(function (r) { var t = types.filter(function (x) { return x.id === r.typeId; })[0]; if (!t) { t = { id: r.typeId, name: r.type, n: 0 }; types.push(t); } t.n++; });
    if (ui.typeId == null || !types.some(function (t) { return t.id === ui.typeId; })) ui.typeId = types.length ? types[0].id : null;
    var rooms = D.rooms.filter(function (r) { return r.typeId === ui.typeId; });
    if (!rooms.some(function (r) { return r.id === ui.roomId; })) ui.roomId = rooms.length ? rooms[0].id : null;
    var tabs = types.map(function (t) { return '<button type="button" class="fd-tab' + (t.id === ui.typeId ? ' on' : '') + '" data-type="' + t.id + '">' + esc(t.name) + '<b>' + t.n + '</b></button>'; }).join('');
    var opts = rooms.map(function (r) { return '<option value="' + r.id + '"' + (r.id === ui.roomId ? ' selected' : '') + '>Room #' + esc(r.no) + '</option>'; }).join('');
    var month = new Date().toLocaleDateString('en-US', { month: 'long' });
    var html = '<div class="fd-card-head"><div class="fd-card-title">Calendar</div><a class="fd-card-link" href="/calendar">' + month + ' »</a></div>' +
      '<div class="fd-tabs" id="fdTabs">' + tabs + '</div>' +
      '<div class="fd-roompick"><button class="fd-nav" id="fdPrev" type="button"><i class="fas fa-chevron-left"></i></button><select class="fd-select" id="fdRoom">' + opts + '</select><button class="fd-nav" id="fdNext" type="button"><i class="fas fa-chevron-right"></i></button></div>';
    var list = '';
    for (var i = 0; i < 12; i++) {
      var dt = new Date(D.today + 'T12:00:00'); dt.setDate(dt.getDate() + i);
      var key = dt.getFullYear() + '-' + pad(dt.getMonth() + 1) + '-' + pad(dt.getDate());
      var b = D.agenda.filter(function (x) { return x.roomId === ui.roomId && x.ci <= key && key < x.co; })[0];
      var slot;
      if (b) { var st = STATUS[b.status] || ['', '#94a3b8']; slot = '<a class="fd-slot busy" href="/calendar" style="--c:' + st[1] + '"><span style="display:flex;align-items:center;gap:8px;color:var(--fd-text);font-size:12.5px;font-weight:600"><i class="fd-av" style="--c:' + st[1] + '">' + esc(initials(b.guest)) + '</i>' + esc(b.guest) + '</span><span>' + st[0] + '</span></a>'; }
      else { slot = '<a class="fd-slot" href="/calendar">Available for booking <i class="fas fa-plus"></i></a>'; }
      list += '<div class="fd-day' + (i === 0 ? ' today' : '') + '"><div class="fd-day-d"><b>' + dt.getDate() + '</b><span>' + dt.toLocaleDateString('en-US', { weekday: 'short' }) + '</span></div>' + slot + '</div>';
    }
    return html + '<div class="fd-agenda">' + list + '</div>';
  }

  // the 3D building: the property's rooms with their status; a click opens the booking (or the cleaning list) in the calendar
  function bldSig() { var s = JSON.stringify(D.building || []), h = 0; for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return h; }
  // one tile of the Housekeeping view: a click shows only its rooms in the building (a second click shows all again)
  function hkTile(key, label, icon, value, tone, sub) {
    return '<div class="fd-tile t-' + tone + ' is-link' + (ui.hkFocus === key ? ' is-on' : '') + '" data-hk="' + key + '" role="button" tabindex="0" title="Show only these rooms">' +
      '<div class="fd-tile-l"><span>' + label + '</span><i class="fas ' + icon + '"></i></div><div class="fd-tile-v">' + pad(value) + '</div><div class="fd-tile-s">' + (sub || '') + '</div></div>';
  }
  function cardBld() {
    var B = window.Building3D, c = B.counts(D.building, PCODE), S = B.swatches(PCODE), lost = B.unplaced(D.building, PCODE);
    function sw(bg) { return '<i class="fd-sw" style="background:' + bg + '"></i>'; }
    var o = D.overview, r = o.reservation, h = o.housekeeping, hk = ui.view === 'housekeeping';
    var bedsKey = '<span class="fd-beds-key"><i class="fd-bed-dot"></i>1 bed</span><span class="fd-beds-key"><i class="fd-bed-dots"><i class="fd-bed-dot"></i><i class="fd-bed-dot"></i></i>2 beds</span>';
    if (B.isVillas && B.isVillas(PCODE)) bedsKey = '';   // (a villa has no bed dots)
    var vipN = (D.building || []).filter(function (x) { return x.vip; }).length;
    var vipKey = vipN ? '<span><i class="fd-vip-v">V</i>VIP room <b>' + vipN + '</b></span>' : '';
    // the Tenant rooms (status Tenant, any property: shown only when there are some), and the rooms of the system the building has no place for (not drawn: said here instead of hidden)
    var tenantKey = c.tenant ? '<span>' + sw(S.tenant) + 'Tenant <b>' + c.tenant + '</b></span>' : '';
    var warn = lost.length ? ' &middot; <span class="fd-bld-warn" title="These rooms exist in the system but have no place on the building">not on the building: ' + lost.map(function (x) { return esc(x.no); }).join(', ') + '</span>' : '';
    if (!(D.building || []).length) {   // no rooms yet: say so (an empty building would leave the tiles piled up)
      return '<div class="fd-card-head"><div class="fd-card-title">Building</div><span class="fd-card-note"></span></div>' +
        '<div style="padding:60px 20px;text-align:center;color:var(--fd-muted);font-size:14px;"><i class="fas fa-door-open" style="font-size:30px;display:block;margin-bottom:12px;opacity:.6;"></i>No rooms yet for this property.<br><small>Add them in Rooms &rarr; Room Management.</small></div>';
    }
    var side, legend, note;
    if (hk) {
      // HOUSEKEEPING: the work first. Dirty rooms, rooms that are about to be left (late ones too), who stays, who arrives (a dirty room with an arrival is URGENT)
      var goingOut = c.leaving - c.late;
      side = hkTile('dirty', 'To clean', 'fa-broom', c.dirty, 'warn', c.urgent ? c.urgent + ' urgent: arrives today' : (c.dirty ? 'dirty rooms' : 'all clean')) +
        hkTile('leaving', 'Going to check out', 'fa-sign-out-alt', c.leaving, 'bad', c.leaving ? (goingOut + ' regular &middot; ' + c.late + ' late') : 'none today') +
        hkTile('late', 'Late check-out', 'fa-clock', c.late, 'info', c.late ? 'leave later today' : 'none') +
        hkTile('stay', 'Occupied', 'fa-bed', c.stay, 'acc', 'guests staying') +
        hkTile('arriving', 'Arriving today', 'fa-sign-in-alt', c.arriving, 'good', 'rooms to be ready by 3 PM') +
        hkTile('requests', 'Requests', 'fa-concierge-bell', ui.reqs.length, 'req', ui.reqs.length ? 'waiting: MUR / custom' : 'none waiting') +
        hkTile('ooo', 'Out of order', 'fa-ban', h.outOfOrder, 'bad', h.outOfOrder ? 'not to be cleaned' : 'none');
      legend = '<span>' + sw('#8a7433') + 'To clean <b>' + c.dirty + '</b></span>' +
        '<span>' + sw('linear-gradient(#ff8f8f,#e8343a)') + 'Check-out today <b>' + goingOut + '</b></span>' +
        '<span>' + sw('linear-gradient(90deg,#f0494e 0 72%,' + B.LATE + ' 72% 100%)') + 'Late check-out <b>' + c.late + '</b></span>' +
        '<span>' + sw('linear-gradient(#fff4d6,#ffc65e)') + 'Occupied <b>' + c.stay + '</b></span>' +
        '<span><i class="fd-sd" style="background:' + B.ARRIVE + '"></i>Arrives today <b>' + c.arriving + '</b></span>' +
        '<span><i class="fd-urgent-mark">!</i>Urgent <b>' + c.urgent + '</b></span>' +
        '<span><i class="fd-btb-pill">BTB</i>Back-to-back <b>' + c.btb + '</b></span>' +
        '<span><i class="fd-req-pill">MUR</i>Request <b>' + ui.reqs.length + '</b></span>' +
        '<span>' + sw('repeating-linear-gradient(45deg,#b3aaa6 0 3px,#5a4a42 3px 4px)') + 'Out of order <b>' + c.ooo + '</b></span>' + tenantKey + vipKey;
      note = warn;
    } else if (ui.date) {
      // a later day: planned from the bookings (every guest leaves on his check-out date; dirty rooms cannot be predicted, so none)
      var lateIn = (D.building || []).filter(function (x) { return x.arriving && x.arrivingLate; }).length;
      var freeN = (D.building || []).filter(function (x) { return String(x.status) === '1' && !x.arriving; }).length;   // clean, nobody in it and nobody arriving
      side = tile('Occupied', 'fa-bed', pad(c.occupied), 'acc', 'of ' + (D.building || []).length + ' rooms') +
        tile('Arrival', 'fa-sign-in-alt', pad(c.arriving), 'good', c.arriving ? ((c.arriving - lateIn) + ' regular &middot; ' + lateIn + ' late' + (c.btb ? ' &middot; ' + c.btb + ' back-to-back' : '')) : 'none arriving') +
        tile('Check out', 'fa-sign-out-alt', pad(c.leaving), 'info', c.leaving ? ((c.leaving - c.late) + ' regular &middot; ' + c.late + ' late') : 'none leaving') +
        tile('Back-to-back', 'fa-exchange-alt', pad(c.btb), 'warn', c.btb ? 'late check-out then late check-in' : 'none') +
        tile('Available', 'fa-check-circle', pad(freeN), 'good', 'free all day, no arrival') +
        tile('Out of order', 'fa-ban', pad(c.ooo), 'bad', c.ooo ? 'maintenance' : 'none');
      legend = '<span>' + sw('linear-gradient(#fff4d6,#ffc65e)') + 'Occupied <b>' + c.occupied + '</b></span>' +
        '<span>' + sw(S.vacant) + 'Free <b>' + (D.building || []).filter(function (x) { return String(x.status) === '1' && !x.arriving; }).length + '</b></span>' +
        '<span>' + sw('repeating-linear-gradient(45deg,#b3aaa6 0 3px,#5a4a42 3px 4px)') + 'Out of order <b>' + c.ooo + '</b></span>' +
        '<span><i class="fd-sd" style="background:' + B.ARRIVE + '"></i>Arriving <b>' + c.arrReg + '</b></span>' +
        '<span><i class="fd-sd" style="background:' + B.LATE_IN + '"></i>Late check-in <b>' + c.arrLate + '</b></span>' +
        '<span><i class="fd-btb-pill">BTB</i>Back-to-back <b>' + c.btb + '</b></span>' +
        '<span>' + sw('linear-gradient(#ff8f8f,#e8343a)') + 'Leaving <b>' + (c.leaving - c.late) + '</b></span>' +
        '<span>' + sw('linear-gradient(90deg,#f0494e 0 72%,' + B.LATE + ' 72% 100%)') + 'Late check-out <b>' + c.late + '</b></span>' + bedsKey + tenantKey + vipKey;
      note = warn;
    } else {
      side = tile('Occupied', 'fa-bed', pad(r.occupied), 'acc', 'of ' + D.totalRooms + ' rooms') +
        tile('Arrival', 'fa-sign-in-alt', pad(r.checkIn.total), 'good', r.checkIn.done ? r.checkIn.done + ' already in' : 'still to arrive', '/calendar?focus=arrivals') +
        tile('Check out', 'fa-sign-out-alt', pad(r.checkOut.total), 'info', r.checkOut.done ? r.checkOut.done + ' already out' : 'still to leave', '/calendar?focus=departures') +
        tile('Available', 'fa-check-circle', pad(h.available), 'good', 'ready to sell') +
        tile('Dirty', 'fa-broom', pad(h.dirty), 'warn', h.dirty ? 'to clean' : 'all clean', h.dirty ? '/calendar?cleaning=all' : '') +
        tile('Out of order', 'fa-ban', pad(h.outOfOrder), 'bad', h.outOfOrder ? 'maintenance' : 'none');
      legend = '<span>' + sw('linear-gradient(#fff4d6,#ffc65e)') + 'Occupied <b>' + c.occupied + '</b></span>' +
        '<span>' + sw(S.vacant) + 'Clean, empty <b>' + c.vacant + '</b></span>' +
        '<span>' + sw('#8a7433') + 'To be cleaned <b>' + c.dirty + '</b></span>' +
        '<span>' + sw('repeating-linear-gradient(45deg,#b3aaa6 0 3px,#5a4a42 3px 4px)') + 'Out of order <b>' + c.ooo + '</b></span>' +
        '<span><i class="fd-sd" style="background:' + B.ARRIVE + '"></i>Arriving today <b>' + c.arrReg + '</b></span>' +
        '<span><i class="fd-sd" style="background:' + B.LATE_IN + '"></i>Late check-in <b>' + c.arrLate + '</b></span>' +
        '<span><i class="fd-btb-pill">BTB</i>Back-to-back <b>' + c.btb + '</b></span>' +
        '<span>' + sw('linear-gradient(#ff8f8f,#e8343a)') + 'Leaving today <b>' + (c.leaving - c.late) + '</b></span>' +
        '<span>' + sw('linear-gradient(90deg,#f0494e 0 72%,' + B.LATE + ' 72% 100%)') + 'Late check-out <b>' + c.late + '</b></span>' + tenantKey + bedsKey + vipKey;
      note = (D.building || []).length + ' rooms &middot; click a room to open it' + warn;
    }
    // Housekeeping view: the work list (what the Housekeeping app showed) - rooms to clean in order, the requests, today's arrivals
    var workN = hk ? hkWorkCount() : 0;
    var reqBtn = hk ? '<button type="button" class="fd-req-btn" id="fdHkWorkBtn" title="Rooms to clean, requests and arrivals"><i class="fas fa-clipboard-list" style="font-size:14px"></i>Work list <b class="' + (workN ? '' : 'is-zero') + '">' + workN + '</b></button>' : '';
    if (ui.date) note = '<span class="fd-plan-note">Planned for <b>' + new Date(ui.date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', day: '2-digit', month: 'short' }) + '</b> from the bookings: every guest leaves on the check-out date &middot; <a id="fdToday">back to today</a></span>';
    var views = '<div class="fd-views" id="fdViews">' + BLD_VIEWS.map(function (v) {
      return '<button type="button" data-view="' + v.id + '" class="' + (v.id === ui.view ? 'is-on' : '') + '"><i class="fas ' + v.icon + '"></i>' + v.label + '</button>';
    }).join('') + '</div>';
    return '<div class="fd-card-head"><div class="fd-card-title">Building</div>' + views + reqBtn + '<span class="fd-card-note">' + note + '</span></div>' +
      '<div class="fd-bv-body"><div class="fd-bv-main">' +
      '<div class="fd-bld" id="fdBld" data-sig="' + bldSig() + ui.view + (ui.hkFocus || '') + '"></div>' +
      '<div class="fd-bld-legend">' + legend + '</div>' +
      '</div><div class="fd-bv-side">' + side + '</div></div>';
  }
  // ---------------- HOUSEKEEPING (the Housekeeping view): what the Housekeeping app did, here on the dashboard.
  //  - Requests for a room: MUR (make up room) or a custom request. Waiting -> in progress (someone took it) -> done (or cancelled).
  //  - A room (a click in the building or in the work list): its state, Mark cleaned / Mark dirty, Minibar / laundry on the guest's bill, a new request.
  //  - The work list: the rooms to clean in the order to clean them, the requests, today's arrivals with their room ready or not.
  var reqFirst = true, seenReq = {};
  ui.reqsDone = []; ui.me = null;
  function buildReqMap() {
    var m = {};
    ui.reqs.forEach(function (q) { var e = m[q.roomNumber] || (m[q.roomNumber] = { mur: false, custom: 0, items: [] }); if (q.type === 'MUR') e.mur = true; else e.custom++; e.items.push(q); });
    ui.reqMap = m;
  }
  function loadRequests() {
    fetch('/room-requests' + (hkwOpen ? '?done=1' : ''), { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (j) {
      if (!j || !j.success) return;
      ui.me = j.me;
      if (j.done) ui.reqsDone = j.done;
      // a new request while the Housekeeping view is open is said at once (the app's pop-up)
      var fresh = j.requests.filter(function (q) { return !seenReq[q.id]; });
      j.requests.forEach(function (q) { seenReq[q.id] = true; });
      if (!reqFirst && fresh.length && ui.view === 'housekeeping') toast('New request: Room ' + fresh.map(function (q) { return q.roomNumber; }).join(', '));
      reqFirst = false;
      var sig = j.requests.map(function (q) { return q.id + ':' + q.status + ':' + (q.acceptedBy || ''); }).join(',');
      if (sig === ui.reqSig) { if (hkwOpen) renderWork(); return; }
      ui.reqSig = sig; ui.reqs = j.requests; buildReqMap();
      if (ui.view === 'housekeeping' && D) {   // (while the switch animation is still playing, the redraw waits for it to end)
        var bc = grid.querySelector('.c-bld');
        if (bc && bc.classList.contains('bv-swap')) setTimeout(function () { if (ui.view === 'housekeeping') repaintBuildingCard(); }, 1400); else repaintBuildingCard();
      }
      if (hkrRoom) renderRoomPanel();
      if (hkrListOpen) renderRequestList();
      if (hkwOpen) renderWork();
    }).catch(function () { /* keep what is shown */ });
  }
  function toast(msg, err) {
    var t = document.createElement('div'); t.className = 'fd-toast' + (err ? ' is-err' : ''); t.textContent = msg; document.body.appendChild(t);
    setTimeout(function () { t.remove(); }, 2600);
  }
  function postJson(url, body) {
    return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) }).then(function (r) { return r.json(); });
  }
  function byNo(a, b) { return String(a).localeCompare(String(b), undefined, { numeric: true }); }
  function roomOf(no) { return ((D && D.building) || []).filter(function (x) { return String(x.no) === String(no); })[0] || null; }

  // ----- requests
  function reqLine(q) {
    return '<span class="hkr-badge' + (q.type === 'MUR' ? ' mur' : '') + '">' + (q.type === 'MUR' ? 'MUR' : 'REQUEST') + '</span>' + (q.type === 'MUR' ? 'Make up room' : esc(q.text || ''));
  }
  function reqMeta(q) {
    var t = ago(q.requestedAt), s = esc(q.requestedBy || 'someone') + ' &middot; ' + (t === 'just now' ? t : t + ' ago');
    if (q.status === 'accepted') s += ' &middot; <span class="who"><i class="fas fa-user-clock"></i> ' + esc(q.acceptedBy || 'someone') + ' is on it</span>';
    if (q.status === 'done') s += ' &middot; <span class="who"><i class="fas fa-check"></i> ' + esc(q.doneBy || 'someone') + ', ' + ago(q.doneAt) + '</span>';
    return s;
  }
  function reqActs(q) {
    if (q.status === 'done') return '';
    if (q.status === 'accepted') return '<button type="button" class="done" data-rq="done" data-id="' + q.id + '">Done</button>' +
      '<button type="button" class="cancel" data-rq="release" data-id="' + q.id + '" title="Give it back: it waits again for anyone">Give back</button>';
    return '<button type="button" data-rq="accept" data-id="' + q.id + '" title="Take it: it is yours (in progress)">Take</button>' +
      '<button type="button" class="done" data-rq="done" data-id="' + q.id + '">Done</button>' +
      '<button type="button" class="cancel" data-rq="cancel" data-id="' + q.id + '" title="Cancel the request">&times;</button>';
  }
  function reqItem(q, withRoom) {
    return '<div class="hkr-item">' + (withRoom ? '<span class="rm">' + esc(q.roomNumber) + '</span>' : '') + '<div class="t">' + reqLine(q) + '<small>' + reqMeta(q) + '</small></div>' + reqActs(q) + '</div>';
  }
  var REQ_WORD = { done: 'Request done', cancel: 'Request cancelled', accept: 'Request taken: it is yours', release: 'Request given back' };
  function closeRequest(id, kind) {
    postJson('/room-requests/' + id + '/' + kind).then(function (j) {
      if (j && j.success) toast(REQ_WORD[kind] || 'Request updated');
      else toast((j && j.message) || 'Could not update the request', true);
      ui.reqSig = ''; loadRequests();
    }).catch(function () { toast('Could not update the request', true); });
  }

  // ----- a room: its state and what housekeeping can do
  function roomChips(r) {
    var s = String(r.status), c = [], q = ui.reqMap[r.no];
    if (s === '3') c.push(['Out of order', 'bad']);
    else if (s === '5') c.push(['Tenant', '']);
    else if (s === '2') c.push(['Occupied', 'acc']);
    else if (s === '4') c.push(['To clean', 'warn']);
    else c.push(['Clean &middot; vacant', 'good']);
    if (r.leaving) c.push([r.late ? 'Late check-out today' : 'Check-out today', 'bad']);
    if (r.arriving) c.push([(r.arrivingEarly ? 'Early arrival' : r.arrivingLate ? 'Late arrival' : 'Arriving') + ' today', 'info']);
    if (r.arriving && r.leaving) c.push(['Back-to-back', 'info']);
    if (r.arriving && s === '4') c.push(['Urgent', 'bad']);
    if (q && q.mur) c.push(['MUR', 'req']);
    if (q && q.custom) c.push([q.custom + ' request' + (q.custom > 1 ? 's' : ''), 'req']);
    if (r.vip) c.push(['VIP', 'warn']);
    return c;
  }
  function chipsHtml(list) { return list.map(function (x) { return '<span class="hk-chip ' + x[1] + '">' + x[0] + '</span>'; }).join(''); }
  function roomActs(r) {
    var s = String(r.status), q = ui.reqMap[r.no], h = '';
    if (s === '4') h += '<button type="button" class="hk-btn ok" data-act="clean"><i class="fas fa-check"></i>Mark cleaned</button>';
    if ((s === '2' || s === '1') && q && q.mur) h += '<button type="button" class="hk-btn ok" data-act="clean" title="The room was made up: the MUR is done"><i class="fas fa-check"></i>Room made up</button>';
    if (s === '1') h += '<button type="button" class="hk-btn" data-act="dirty" title="It needs another cleaning"><i class="fas fa-undo"></i>Mark dirty</button>';
    if (s === '2' && r.guest) h += '<button type="button" class="hk-btn" data-act="charge"><i class="fas fa-wine-bottle"></i>Minibar / laundry</button>';
    if (s === '3') h += '<span class="hkr-note"><i class="fas fa-ban"></i> Out of order: not cleaned until it is back in service.</span>';
    if (s === '5') h += '<span class="hkr-note">Tenant room: not cleaned by housekeeping.</span>';
    return h;
  }
  var roomBusy = false;
  function setRoom(no, status) {
    if (roomBusy) return; roomBusy = true;
    postJson('/room-requests/rooms/' + encodeURIComponent(no) + '/status', { status: status }).then(function (j) {
      if (j && j.success) {
        toast(status === 'dirty' ? 'Room ' + no + ' marked dirty' : Number(j.status) === 2 ? 'Room ' + no + ' made up (MUR done)' : 'Room ' + no + ' is clean');
        var r = roomOf(no); if (r) r.status = String(j.status);              // shown at once; the reload below brings the rest
        if (j.closedMur) { ui.reqs = ui.reqs.filter(function (q) { return !(q.roomNumber === String(no) && q.type === 'MUR'); }); buildReqMap(); }
        ui.reqSig = '';
        if (D && ui.view === 'housekeeping') repaintBuildingCard();
        if (hkrRoom) renderRoomPanel();
        if (hkwOpen) renderWork();
        load();
      } else toast((j && j.message) || 'Could not update the room', true);
    }).catch(function () { toast('Could not update the room', true); }).then(function () { roomBusy = false; });
  }

  var hkrEl = null, hkrRoom = null, hkrPick = null, hkrListEl = null, hkrListOpen = false;
  function hkrBuild() {
    if (hkrEl) return;
    hkrEl = document.createElement('div'); hkrEl.className = 'hkr-wrap'; hkrEl.id = 'hkReq';
    hkrEl.innerHTML = '<div class="hkr-card" role="dialog" aria-labelledby="hkrTitle">' +
      '<div class="hkr-head"><h3 id="hkrTitle">Room</h3><button type="button" class="hkr-x" data-x aria-label="Close">&times;</button></div>' +
      '<div class="hkr-sub" id="hkrSub"></div><div class="hk-chips hkr-state" id="hkrState"></div>' +
      '<div class="hkr-acts" id="hkrActs"></div>' +
      '<div class="hkw-sec">New request</div>' +
      '<div class="hkr-opts"><button type="button" class="hkr-opt" data-opt="MUR"><b>MUR</b><small>Make up room</small></button>' +
      '<button type="button" class="hkr-opt" data-opt="CUSTOM"><b>Custom request</b><small>Write what the room needs</small></button></div>' +
      '<div class="hkr-custom" id="hkrCustom" style="display:none"><textarea id="hkrText" maxlength="300" placeholder="e.g. extra towels, extra pillow, change the bed linen..."></textarea></div>' +
      '<div class="hkr-actions"><button type="button" class="hkr-send" id="hkrSend" disabled>Send request</button><span class="hkr-msg" id="hkrMsg"></span></div>' +
      '<div class="hkr-sec" id="hkrSec" style="display:none">Open for this room</div><div class="hkr-list" id="hkrRoomList"></div></div>';
    document.body.appendChild(hkrEl);
    hkrEl.addEventListener('click', function (e) {
      if (e.target === hkrEl || e.target.closest('[data-x]')) { closeRequestModal(); return; }
      var opt = e.target.closest('.hkr-opt');
      if (opt) { hkrPick = opt.getAttribute('data-opt'); hkrRefresh(); if (hkrPick === 'CUSTOM') document.getElementById('hkrText').focus(); return; }
      if (e.target.id === 'hkrSend') { sendRequest(); return; }
      var act = e.target.closest('[data-act]');
      if (act && hkrRoom) {
        var a = act.getAttribute('data-act');
        if (a === 'charge') openCharge(roomOf(hkrRoom.no) || hkrRoom); else setRoom(hkrRoom.no, a);
        return;
      }
      var b = e.target.closest('[data-rq]'); if (b) closeRequest(b.getAttribute('data-id'), b.getAttribute('data-rq'));
    });
    document.getElementById('hkrText').addEventListener('input', hkrRefresh);
  }
  function hkrRefresh() {
    var send = document.getElementById('hkrSend'), txt = document.getElementById('hkrText');
    [].forEach.call(hkrEl.querySelectorAll('.hkr-opt'), function (b) { b.classList.toggle('is-on', b.getAttribute('data-opt') === hkrPick); });
    document.getElementById('hkrCustom').style.display = hkrPick === 'CUSTOM' ? '' : 'none';
    send.disabled = !(hkrPick === 'MUR' || (hkrPick === 'CUSTOM' && txt.value.trim()));
  }
  function renderRoomRequests() {
    var list = document.getElementById('hkrRoomList'), sec = document.getElementById('hkrSec'); if (!list || !hkrRoom) return;
    var items = ui.reqs.filter(function (q) { return q.roomNumber === String(hkrRoom.no); });
    sec.style.display = items.length ? '' : 'none';
    list.innerHTML = items.map(function (q) { return reqItem(q, false); }).join('');
  }
  // the room panel: drawn again whenever the room or its requests change (it stays open)
  function renderRoomPanel() {
    if (!hkrEl || !hkrRoom) return;
    var r = roomOf(hkrRoom.no) || hkrRoom; hkrRoom = r;
    var s = String(r.status);
    var who = s === '2' ? (r.guest ? esc(r.guest) : 'Guest in house') : r.arriving ? 'Arriving: ' + esc(r.arrivalGuest || 'a guest') : s === '3' ? 'Not in use' : 'No guest';
    document.getElementById('hkrTitle').textContent = 'Room ' + r.no;
    document.getElementById('hkrSub').innerHTML = (r.type ? esc(r.type) + ' &middot; ' : '') + who;
    document.getElementById('hkrState').innerHTML = chipsHtml(roomChips(r));
    document.getElementById('hkrActs').innerHTML = roomActs(r);
    renderRoomRequests();
  }
  function openRequestModal(r) {
    hkrBuild(); hkrRoom = r; hkrPick = null;
    document.getElementById('hkrText').value = ''; document.getElementById('hkrMsg').textContent = ''; document.getElementById('hkrMsg').className = 'hkr-msg';
    hkrRefresh(); renderRoomPanel();
    hkrEl.style.display = 'flex';
  }
  function closeRequestModal() { if (hkrEl) hkrEl.style.display = 'none'; hkrRoom = null; }
  function sendRequest() {
    if (!hkrRoom || !hkrPick) return;
    var send = document.getElementById('hkrSend'), msg = document.getElementById('hkrMsg'), room = hkrRoom.no;
    send.disabled = true; msg.className = 'hkr-msg'; msg.textContent = 'Sending...';
    postJson('/room-requests', { roomNumber: room, type: hkrPick, text: document.getElementById('hkrText').value }).then(function (j) {
      if (j && j.success) {
        toast(j.duplicate ? 'MUR is already requested for Room ' + room : (hkrPick === 'MUR' ? 'MUR requested for Room ' : 'Request sent for Room ') + room);
        if (!j.duplicate) seenReq[j.id] = true;                             // (our own request is not announced as new)
        ui.reqSig = ''; loadRequests(); closeRequestModal();
      } else { msg.className = 'hkr-msg is-err'; msg.textContent = (j && j.message) || 'Could not send the request'; hkrRefresh(); }
    }).catch(function () { msg.className = 'hkr-msg is-err'; msg.textContent = 'Could not send the request'; hkrRefresh(); });
  }
  // the list of every open request (the Requests button)
  function renderRequestList() {
    var box = document.getElementById('hkrListBody'); if (!box) return;
    box.innerHTML = ui.reqs.length ? ui.reqs.map(function (q) { return reqItem(q, true); }).join('') : '<div class="hkr-empty">No request is waiting.</div>';
  }
  function openRequestList() {
    if (!hkrListEl) {
      hkrListEl = document.createElement('div'); hkrListEl.className = 'hkr-wrap'; hkrListEl.id = 'hkReqList';
      hkrListEl.innerHTML = '<div class="hkr-card" role="dialog" aria-label="Requests"><div class="hkr-head"><h3>Requests</h3><button type="button" class="hkr-x" data-x aria-label="Close">&times;</button></div>' +
        '<div class="hkr-sub">Waiting for housekeeping &middot; oldest first</div><div class="hkr-list" id="hkrListBody"></div></div>';
      document.body.appendChild(hkrListEl);
      hkrListEl.addEventListener('click', function (e) {
        if (e.target === hkrListEl || e.target.closest('[data-x]')) { hkrListEl.style.display = 'none'; hkrListOpen = false; return; }
        var b = e.target.closest('[data-rq]'); if (b) closeRequest(b.getAttribute('data-id'), b.getAttribute('data-rq'));
      });
    }
    hkrListOpen = true; renderRequestList(); hkrListEl.style.display = 'flex';
  }

  // ----- the work list (a panel on the right; full width on a phone)
  var hkwEl = null, hkwOpen = false, hkwTab = 'clean', hkwSeg = 'pending';
  try { var savedTab = localStorage.getItem('fdHkWorkTab'); if (['clean', 'requests', 'arrivals'].indexOf(savedTab) >= 0) hkwTab = savedTab; } catch (e) { /* the first tab */ }
  // the rooms to clean, in the order to clean them: an arrival today first (early ones before), then what a guest asked for, then the other dirty rooms
  function workClean() {
    var out = [];
    ((D && D.building) || []).forEach(function (r) {
      var s = String(r.status), q = ui.reqMap[r.no];
      if (s === '4') out.push({ r: r, p: r.arriving ? (r.arrivingEarly ? 0 : 1) : (q ? 2 : 3),
        why: r.arriving ? (r.arrivingEarly ? 'Early arrival today' : r.arrivingLate ? 'Late arrival today' : 'Arrives today') + (r.arrivalGuest ? ' &middot; ' + esc(r.arrivalGuest) : '') : q ? 'Guest request' : 'To be cleaned' });
      else if ((s === '2' || s === '1') && q && q.mur) out.push({ r: r, p: 2, why: 'Make up room' + (r.guest ? ' &middot; ' + esc(r.guest) : '') });
    });
    return out.sort(function (a, b) { return a.p - b.p || byNo(a.r.no, b.r.no); });
  }
  // occupied rooms that check out today: cleaned once the guest is gone (back-to-back first, late ones last)
  function workLeaving() {
    return ((D && D.building) || []).filter(function (r) { return String(r.status) === '2' && r.leaving; })
      .sort(function (a, b) { return (b.arriving ? 1 : 0) - (a.arriving ? 1 : 0) || (a.late ? 1 : 0) - (b.late ? 1 : 0) || byNo(a.no, b.no); });
  }
  var READY = { '1': ['Room ready', 'good', 'ok', 3], '4': ['Room not ready', 'warn', 'dirty', 0], '2': ['Guest still in', 'bad', 'occ', 1], '3': ['Out of order', 'bad', 'bad', 2] };
  function workArrivals() {
    return ((D && D.building) || []).filter(function (r) { return r.arriving; })
      .sort(function (a, b) { return ((READY[a.status] || [])[3] || 0) - ((READY[b.status] || [])[3] || 0) || (b.arrivingEarly ? 1 : 0) - (a.arrivingEarly ? 1 : 0) || byNo(a.no, b.no); });
  }
  function hkWorkCount() { return workClean().length + ui.reqs.filter(function (q) { return q.status === 'pending'; }).length; }
  function wRow(r, cls, title, sub, chips, acts) {
    return '<div class="hkw-row" role="button" tabindex="0" data-room="' + esc(r.no) + '" title="Open room ' + esc(r.no) + '"><span class="hkw-no ' + cls + '">' + esc(r.no) + '</span>' +
      '<div class="hkw-main"><div class="hkw-t">' + title + '</div>' + (sub ? '<div class="hkw-s">' + sub + '</div>' : '') + (chips ? '<div class="hk-chips">' + chips + '</div>' : '') + '</div>' +
      (acts ? '<div class="hkw-acts">' + acts + '</div>' : '') + '</div>';
  }
  function wEmpty(icon, text) { return '<div class="hkw-empty"><i class="far ' + icon + '"></i>' + text + '</div>'; }
  function cleanBtn(r, label) { return '<button type="button" class="hk-btn ok sm" data-clean="' + esc(r.no) + '" title="Mark room ' + esc(r.no) + ' cleaned"><i class="fas fa-check"></i>' + (label || 'Cleaned') + '</button>'; }
  function renderWork() {
    if (!hkwEl || !D) return;
    var clean = workClean(), leaving = workLeaving(), arr = workArrivals();
    var waiting = ui.reqs.filter(function (q) { return q.status === 'pending'; }), prog = ui.reqs.filter(function (q) { return q.status === 'accepted'; });
    var notReady = arr.filter(function (r) { return String(r.status) !== '1'; }).length;
    function tab(id, label, n, hot) { return '<button type="button" data-tab="' + id + '" class="' + (hkwTab === id ? 'is-on' : '') + '">' + label + ' <b class="' + (hot ? 'hot' : '') + '">' + n + '</b></button>'; }
    document.getElementById('hkwTabs').innerHTML = tab('clean', 'To clean', clean.length, clean.length > 0) + tab('requests', 'Requests', waiting.length, waiting.length > 0) + tab('arrivals', 'Arrivals', arr.length, notReady > 0);
    document.getElementById('hkwSub').innerHTML = (clean.length ? clean.length + ' room' + (clean.length > 1 ? 's' : '') + ' to clean' : 'All rooms are clean') +
      (waiting.length ? ' &middot; ' + waiting.length + ' request' + (waiting.length > 1 ? 's' : '') + ' waiting' : '') + (notReady ? ' &middot; ' + notReady + ' arrival' + (notReady > 1 ? 's' : '') + ' not ready' : '');
    var h = '';
    if (hkwTab === 'clean') {
      h += '<div class="hkw-sec"><span>In this order</span><span>' + clean.length + '</span></div>';
      h += clean.length ? '<div class="hkw-list">' + clean.map(function (w) {
        var r = w.r, s = String(r.status), q = ui.reqMap[r.no], ch = [];
        if (r.arriving && s === '4') ch.push(['Urgent', 'bad']);
        if (q && q.mur) ch.push(['MUR', 'req']);
        if (q && q.custom) ch.push([q.custom + ' request' + (q.custom > 1 ? 's' : ''), 'req']);
        if (r.vip) ch.push(['VIP', 'warn']);
        return wRow(r, w.p <= 1 ? 'urgent' : s === '4' ? 'dirty' : 'occ', esc(r.type || 'Room ' + r.no), w.why, chipsHtml(ch), cleanBtn(r, s === '4' ? 'Cleaned' : 'Made up'));
      }).join('') + '</div>' : wEmpty('fa-check-circle', 'Nothing to clean right now.<br>Check-outs and guest requests show up here.');
      if (leaving.length) {
        h += '<div class="hkw-sec"><span>Checking out today &middot; clean after the guest leaves</span><span>' + leaving.length + '</span></div><div class="hkw-list">' +
          leaving.map(function (r) {
            var ch = [[r.late ? 'Late check-out' : 'Check-out today', r.late ? 'info' : 'bad']]; if (r.arriving) ch.push(['Back-to-back', 'info']);
            return wRow(r, 'occ', esc(r.guest || 'Guest in house'), esc(r.type || ''), chipsHtml(ch), '');
          }).join('') + '</div>';
      }
    } else if (hkwTab === 'requests') {
      var done = ui.reqsDone || [];
      var seg = function (id, label, n) { return '<button type="button" data-seg="' + id + '" class="' + (hkwSeg === id ? 'is-on' : '') + '">' + label + (n != null ? ' &middot; ' + n : '') + '</button>'; };
      h += '<div class="hkw-seg">' + seg('pending', 'Waiting', waiting.length) + seg('accepted', 'In progress', prog.length) + seg('done', 'Done today', done.length) + '</div>';
      var list = hkwSeg === 'accepted' ? prog : hkwSeg === 'done' ? done : waiting;
      h += list.length ? '<div class="hkr-list">' + list.map(function (q) { return reqItem(q, true); }).join('') + '</div>'
        : wEmpty('fa-bell', hkwSeg === 'accepted' ? 'Nothing in progress.' : hkwSeg === 'done' ? 'Nothing done yet today.' : 'No waiting requests.<br>Click a room in the building to send a MUR or a request.');
    } else {
      h += '<div class="hkw-sec"><span>Arriving today &middot; rooms to be ready by 3 PM</span><span>' + arr.length + '</span></div>';
