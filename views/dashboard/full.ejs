  @media (max-width: 760px) { .c-res, .c-rooms, .c-rev, .c-book, .c-cal, .c-cust, .c-act { grid-column: span 12; } .fd-title { font-size: 22px; } }

  /* a property with a 3D building (BUILDING_VIEW): ONE container - the building is the main display (left), the six numbers (reservation + housekeeping) are stacked beside it (right) */
