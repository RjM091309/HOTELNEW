								<!-- Render Today Check-In Cards -->
								<% todayCheckInDetails.forEach(checkedIn => { 
									const variables = calculateCardVariables(checkedIn);
									if (variables) { // Only render if variables are valid
								%>
									<%- include('../partials/booking-card', {
										booking: checkedIn,
										...variables,
										showToggle: true,
										toggleType: 'checkin',
										showBadges: true,
										showProgressBars: true
									}) %>
