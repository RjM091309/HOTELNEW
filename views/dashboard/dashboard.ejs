                        year: 'numeric', 
                        month: 'short', 
                        day: 'numeric', 
                        hour: '2-digit', 
                        minute: '2-digit',
                        hour12: false
                    });
                }
            },
            {
                data: 'ENCODED_BY_NAME',
                title: 'Created By',
                className: 'text-center',
                render: function(data) {
                    return data || '-';
                }
            },
            {
                data: 'COMPLETED_BY_NAME',
                title: 'Completed By',
                className: 'text-center',
                render: function(data) {
                    return data || '-';
                }
            },
            {
                data: 'COMPLETED_DT',
                title: 'Completed',
                className: 'text-center',
                render: function(data) {
                    if (!data) return '-';
                    return new Date(data).toLocaleString('en-US', { 
                        year: 'numeric', 
                        month: 'short', 
                        day: 'numeric', 
                        hour: '2-digit', 
                        minute: '2-digit',
                        hour12: false
                    });
                }
            },
            {
                data: null,
                title: 'Actions',
                className: 'text-center',
                orderable: false,
                searchable: false,
                render: function(data, type, row) {
                    const status = Number(row.STATUS) === 1 ? 1 : 0;
                    const markAction = status === 1
                        ? `<i class="fas fa-undo-alt text-warning" title="Mark Not Complete" style="cursor:pointer; margin: 0 5px;" onclick="toggleRequestStatus(${row.IDNo}, 0)"></i>`
                        : `<i class="fas fa-check-circle text-success" title="Mark Completed" style="cursor:pointer; margin: 0 5px;" onclick="toggleRequestStatus(${row.IDNo}, 1)"></i>`;
                    
                    // Escape details for use in JavaScript string
                    const detailsEscaped = String(row.DETAILS || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;').replace(/\n/g, '\\n').replace(/\r/g, '');
                    const typeEscaped = String(row.TYPE || 'request').toLowerCase();
                    return `
                        <i class="fas fa-edit text-primary" title="Edit" style="cursor:pointer; margin: 0 5px;" onclick="editRequestFromModal(${row.IDNo}, '${typeEscaped}', '${detailsEscaped}')"></i>
