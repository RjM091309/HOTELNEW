<!-- Remarks Modal JavaScript Functions -->
<script>
// Global variables for remarks modal
let currentRemarksData = {
    bookingId: null,
    roomNumber: null,
    guestName: null,
    currentRemarks: null
};

// Open remarks modal
function openRemarksModal(bookingId, roomNumber, guestName, currentRemarks) {
    // Store current data
    currentRemarksData = {
        bookingId: bookingId,
        roomNumber: roomNumber,
        guestName: guestName,
        currentRemarks: currentRemarks
    };
    
    // Update modal title with room number
    document.getElementById('remarksRoomNumber').textContent = roomNumber;
    
    // Display full remarks text
    const fullRemarksText = document.getElementById('fullRemarksText');
    if (currentRemarks && currentRemarks.trim() !== '') {
        fullRemarksText.textContent = currentRemarks;
        fullRemarksText.style.color = '#fff';
    } else {
        fullRemarksText.textContent = 'No remarks available for this room.';
        fullRemarksText.style.color = '#adb5bd';
        fullRemarksText.style.fontStyle = 'italic';
    }
    
    // Show modal
    const remarksModal = new bootstrap.Modal(document.getElementById('remarksModal'));
    remarksModal.show();
}

// New function to open remarks modal from data attributes
function openRemarksModalFromData(element) {
    const bookingId = element.getAttribute('data-booking-id');
    const roomNumber = element.getAttribute('data-room-number');
    const customerName = element.getAttribute('data-customer-name');
    const currentRemarks = element.getAttribute('data-remarks');
    const dataType = element.getAttribute('data-type');
    
    // Check if this is from M (Memo) button
    if (dataType === 'M') {
        // Use the room-menu modal with Memo preset
        if (typeof window.openRemarksModalWithMemo === 'function') {
            window.openRemarksModalWithMemo(bookingId);
            return;
        }
    }
    
    // Call the existing function for other cases
    openRemarksModal(bookingId, roomNumber, customerName, currentRemarks);
}

 

</script>
					
					
					
