<div class="dashboard-btn-row-item mb-4">
	<div class="col-xl-12 col-md-12 col-12 " >
		<div class="dashboard-card" >
			<div class="dashboard-card-header" style="padding: 20px 25px; min-height: 80px; display: flex; justify-content: space-between; align-items: center;">
				<div class="dashboard-card-header-title">Real-Time Booking Monitor</div>
				<div class="filter-btn-group" >
				
					<!-- Filter Group Buttons -->
					<div class="btn-group">
						<button type="button" class="filter-btn" id="moveToOccupiedBtn">Move to Occupied</button>
						<button type="button" class="filter-btn" id="sort-button">Sort</button>
						<button type="button" class="filter-btn" id="filter-newest">Newest Booking</button>
						<button type="button" class="filter-btn" id="filter-all">All Floors</button>
					</div>
			
					<!-- Floor Filter Dropdown - Separate from button group -->
					<div class="dropdown-container" style="position: relative; display: inline-block;">
						<button type="button" class="filter-btn dropdown-toggle">
							Select Floor <span class="caret"></span>
						</button>
						<ul class="dropdown-menu" role="menu">
							<% floors.forEach(floor => { %>
								<li><a href="#" class="floor-option" data-floor="<%= floor.floor %>">
									<% if (floor.floor === 1) { %>1st Floor<% } %>
									<% if (floor.floor === 2) { %>2nd Floor<% } %>
									<% if (floor.floor === 3) { %>3rd Floor<% } %>
									<% if (floor.floor === 4) { %>4th Floor<% } %>
									<% if (floor.floor === 5) { %>5th Floor<% } %>
									<% if (floor.floor === 6) { %>6th Floor<% } %>
									<% if (floor.floor === 7) { %>7th Floor<% } %>
									<% if (floor.floor === 8) { %>8th Floor<% } %>
									<% if (floor.floor === 9) { %>9th Floor<% } %>
									<% if (floor.floor === 10) { %>10th Floor<% } %>
								</a></li>
							<% }); %>
						</ul>
					</div>
			
				
					</div>
			
			</div>
			
			<div class="dashboard-card-body">
