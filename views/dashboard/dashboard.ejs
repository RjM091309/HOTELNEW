						<div class="scrollable-container">
							<% if (!lateInOutDetails || lateInOutDetails.length === 0) { %>
								<div class="no-data-message">
									<i class="fas fa-clock" style="font-size: 3rem; color: #6c757d; margin-bottom: 1rem;"></i>
									<h4 style="color: #6c757d; margin-bottom: 0.5rem;">No Late Check-ins/Check-outs</h4>
									<p style="color: #6c757d; font-size: 0.9rem;">All guests are on time with their check-ins and check-outs.</p>
								</div>
							<% } else { %>
								<!-- Special dual-card structure for LCO/LCI -->
							<% lateInOutDetails.forEach(lateInOut => { 
								const checkInDate = new Date(lateInOut.NextCheckInDate);
								const checkOutDate = new Date(lateInOut.CurrentCheckoutDate);
								
								// Determine the card class based on the ROOM_FLOOR
								const cardClass = getFloorColorClass(lateInOut.ROOM_FLOOR);
							%>
									<!-- LCO/LCI Card Container -->
								<div class="card <%= cardClass %>" data-floor="<%= lateInOut.ROOM_FLOOR %>" data-checkin="<%= lateInOut.CHECK_IN_DATE %>">
										<!-- Room Header -->
									<div class="card-head" style="text-align: center;">
										<header><%= lateInOut.ROOM_NUMBER %></header>
									</div>
					
										<!-- Current Guest Section (LCO) -->
									<div class="card-body">
											<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
											<p style="margin: 0;"><%= lateInOut.CurrentGuest %></p>
											<p class="dates" style="margin: 0;">Out: <%= checkOutDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %></p>
										</div>
										<div style="display: flex; justify-content: flex-end; gap: 5px; margin-top: 10px; margin-bottom: 10px;">
											<% if (lateInOut.CurrentBookingStatus === 'pending') { %>
												<span class="badge badge-success">Pending</span>
											<% } else if (lateInOut.CurrentBookingStatus === 'check-In') { %>
												<span class="badge badge-success">Checked-In</span>
											<% } else if (lateInOut.CurrentBookingStatus === 'check-Out') { %>
												<span class="badge badge-success">Check-Out</span>
											<% } %>

											<% if (lateInOut.CurrentLateCheckout === 1) { %>
												<span class="badge badge-success" style="margin-left: auto;">LCO</span>
											<% } %>
										</div>

											<!-- Separator Line -->
										<hr class="section-divider">
									</div>
										
										<!-- Next Guest Section (LCI) -->
									<div class="card-body">
										<div style="display: flex; justify-content: space-between; align-items: center;">
											<p style="margin: 0;"><%= lateInOut.NextGuest %></p>
											<p class="dates" style="margin: 0;">In: <%= checkInDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %></p>
										</div>
										<div style="display: flex; justify-content: flex-end; gap: 5px; margin-top: 10px;">
											<% if (lateInOut.NextBookingStatus === 'pending') { %>
												<span class="badge badge-primary">Pending</span>
											<% } else if (lateInOut.NextBookingStatus === 'check-In') { %>
												<span class="badge badge-primary">Check-In</span>
											<% } else if (lateInOut.NextBookingStatus === 'check-Out') { %>
												<span class="badge badge-primary">Check-Out</span>
											<% } %>

											<% if (lateInOut.NextCheckInStatus === 0) { %>
												<span class="badge badge-primary" style="margin-left: auto;">LCI</span>
											<% } %>
										</div>
									</div>
								</div>
							<% }) %>
							<% } %>
						</div>
					</div>
						
						<!-- ======================================== -->
						<!-- TAB 3: TODAY CHECK-OUT -->
						<!-- ======================================== -->
					 <div id="checkout-content" class="tab-content">
						<div class="scrollable-container">
							<% if (!todayCheckedOutDetails || todayCheckedOutDetails.length === 0) { %>
								<div class="no-data-message">
									<i class="fas fa-sign-out-alt" style="font-size: 3rem; color: #6c757d; margin-bottom: 1rem;"></i>
									<h4 style="color: #6c757d; margin-bottom: 0.5rem;">No Check-outs Today</h4>
									<p style="color: #6c757d; font-size: 0.9rem;">No guests are scheduled to check out today.</p>
								</div>
							<% } else { %>
								<!-- Render Today Check-Out Cards -->
							<% todayCheckedOutDetails.forEach(checkedOut => { 
									const variables = calculateCardVariables(checkedOut);
									if (variables) { // Only render if variables are valid
								%>
									<%- include('../partials/booking-card', {
										booking: checkedOut,
										...variables,
										showToggle: true,
										toggleType: 'checkout',
										showBadges: true,
										showProgressBars: true
									}) %>
								<% } %>
							<% }) %>
							<% } %>
						</div>
					</div>

						<!-- ======================================== -->
						<!-- TAB 4: GROUP BOOKING -->
						<!-- ======================================== -->
					 <div id="group-booking-content" class="tab-content">
						<div class="scrollable-container">
							<% if (!groupBookingDetails || groupBookingDetails.length === 0) { %>
								<div class="no-data-message">
									<i class="fas fa-users" style="font-size: 3rem; color: #6c757d; margin-bottom: 1rem;"></i>
									<h4 style="color: #6c757d; margin-bottom: 0.5rem;">No Group Bookings</h4>
									<p style="color: #6c757d; font-size: 0.9rem;">No group bookings are currently active.</p>
								</div>
							<% } else { %>
							<% 
								// Group booking color management - PER GROUP, NOT PER FLOOR
							const colorClasses = ['card-topline-green', 'card-topline-blue', 'card-topline-red', 'card-topline-violet', 'card-topline-orange', 'card-topline-pink','card-topline-yellow', 'card-topline-gray', 'card-topline-green2', 'card-topline-sky'];
							const groupColors = {};
							let colorIndex = 0;

								// Render Group Booking Cards
                            groupBookingDetails.forEach(groupBooking => { 
								if (!groupColors[groupBooking.GROUP_BOOKING_ID]) {
									groupColors[groupBooking.GROUP_BOOKING_ID] = colorClasses[colorIndex % colorClasses.length];
									colorIndex++;
								}
									// Override the cardClass for group bookings - PER GROUP
									groupBooking.cardClass = groupColors[groupBooking.GROUP_BOOKING_ID];
									const variables = calculateCardVariables(groupBooking);
									if (variables) { // Only render if variables are valid
										// Override cardClass from calculateCardVariables to use group-based color
										variables.cardClass = groupColors[groupBooking.GROUP_BOOKING_ID];
										
										// Override memoClass to match group color - SAME AS card-topline colors
										const groupColorClass = groupColors[groupBooking.GROUP_BOOKING_ID];
										if (groupColorClass === 'card-topline-green') {
											variables.memoClass = 'memo-green';
										} else if (groupColorClass === 'card-topline-blue') {
											variables.memoClass = 'memo-blue';
										} else if (groupColorClass === 'card-topline-red') {
											variables.memoClass = 'memo-red';
										} else if (groupColorClass === 'card-topline-violet') {
											variables.memoClass = 'memo-violet';
										} else if (groupColorClass === 'card-topline-orange') {
											variables.memoClass = 'memo-orange';
										} else if (groupColorClass === 'card-topline-pink') {
											variables.memoClass = 'memo-pink';
										} else if (groupColorClass === 'card-topline-yellow') {
											variables.memoClass = 'memo-yellow';
										} else if (groupColorClass === 'card-topline-gray') {
											variables.memoClass = 'memo-gray';
										} else if (groupColorClass === 'card-topline-green2') {
											variables.memoClass = 'memo-green2';
										} else if (groupColorClass === 'card-topline-sky') {
											variables.memoClass = 'memo-sky';
										} else {
											variables.memoClass = 'memo-default';
										}
								%>
									<%- include('../partials/booking-card', {
										booking: groupBooking,
										...variables,
										showToggle: false,
										showBadges: false,
										showProgressBars: true
									}) %>
								<% } %>
							<% }) %>
							<% } %>
						</div>
					</div>
					

						<!-- ======================================== -->
						<!-- TAB 5: EXTENDED BOOKINGS -->
						<!-- ======================================== -->
					 <div id="extended-content" class="tab-content">
						<div class="scrollable-container">
							<% if (!extendedDetails || extendedDetails.length === 0) { %>
								<div class="no-data-message">
									<i class="fas fa-calendar-plus" style="font-size: 3rem; color: #6c757d; margin-bottom: 1rem;"></i>
									<h4 style="color: #6c757d; margin-bottom: 0.5rem;">No Extended Bookings</h4>
