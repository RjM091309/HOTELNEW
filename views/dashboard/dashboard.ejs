								<% } else { %>
								<!-- Render Occupied Room Cards -->
								<% occupiedRoomDetails.forEach(occupiedRoom => { 
									const variables = calculateCardVariables(occupiedRoom);
									if (variables) { // Only render if variables are valid
								%>
									<%- include('../partials/booking-card', {
										booking: occupiedRoom,
										...variables,
										showToggle: false,
										showBadges: true,
										showDeviceStatus: true,
										showProgressBars: true
									}) %>
								<% } %>
								<% }) %>
								<% } %>
								</div>
										</div>
						
						<!-- ======================================== -->
						<!-- TAB 10: CLEANING ROOMS -->
						<!-- ======================================== -->
						<div id="cleaning-content" class="tab-content">
							<div class="scrollable-container">
								<% if (!cleaningRoomDetails || cleaningRoomDetails.length === 0) { %>
									<div class="no-data-message">
