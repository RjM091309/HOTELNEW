								{ name: "Late Check-out", target: "late-checkout-content" },
								{ name: "LCO/LCI", target: "late-in-out-content" },								
								{ name: "Transferred Room", target: "transferred-content" },
								{ name: "Group Booking", target: "group-booking-content" },
								{ name: "Cleaning Room", target: "cleaning-content" },
								{ name: "Extended", target: "extended-content" },
								{ name: "Available Room", target: "available-content" },
							];
					
							let userTabOrder = tabOrder && tabOrder.length ? tabOrder : defaultTabs.map(tab => tab.target);
							let firstActiveTab = userTabOrder[0]; // Set first tab as active
					
							userTabOrder.forEach((tabTarget, index) => {
								let tabData = defaultTabs.find(tab => tab.target === tabTarget);
								if (tabData) { %>
