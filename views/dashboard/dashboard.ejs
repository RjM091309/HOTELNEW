<!-- start widget -->
<%
// Helper function to get floor color class
function getFloorColorClass(floorNumber) {
	const colorMap = {
		1: 'card-topline-yellow',
		2: 'card-topline-gray', 
		3: 'card-topline-green',
		4: 'card-topline-blue',
		5: 'card-topline-red',
		6: 'card-topline-violet',
		7: 'card-topline-orange',
		8: 'card-topline-pink',
		9: 'card-topline-green2',
		10: 'card-topline-sky'
	};
	return colorMap[floorNumber] || '';
}

// Helper function to calculate common card variables - moved to global scope
function calculateCardVariables(booking) {
	// Validate dates first
	if (!booking.CHECK_IN_DATE || !booking.CHECK_OUT_DATE) {
		console.warn('Invalid booking dates:', booking);
		return null;
	}
	
	const checkInDate = new Date(booking.CHECK_IN_DATE);
	const checkOutDate = new Date(booking.CHECK_OUT_DATE);
	
	// Check if dates are valid
	if (isNaN(checkInDate.getTime()) || isNaN(checkOutDate.getTime())) {
		console.warn('Invalid date format:', booking);
		return null;
	}
	
	checkInDate.setHours(0, 0, 0, 0); // Remove time
	checkOutDate.setHours(0, 0, 0, 0); // Remove time
	
	const today = new Date();
	const totalDays = Math.max(1, Math.ceil((checkOutDate - checkInDate) / (1000 * 60 * 60 * 24))); // Total days of booking
	
	// Fix: Ensure check-in day shows only one bar for occupied rooms
	const isTodayCheckInDate = checkInDate.toDateString() === today.toDateString();
	const daysStayed = isTodayCheckInDate ? 1 : Math.min(Math.ceil((today - checkInDate) / (1000 * 60 * 60 * 24)), totalDays); // Days already stayed
	
	const daysRemaining = totalDays - daysStayed; // Remaining days
	const maxBars = booking.IS_GROUP == 1 ? 10 : 8; // Maximum bars visible (10 for group bookings, 8 for others)
	const visibleBars = Math.min(totalDays, maxBars); // Total bars visible
	const visibleStayed = Math.min(daysStayed, visibleBars); // Stayed bars to display
	const visibleRemaining = visibleBars - visibleStayed; // Remaining bars to display
	const extraDays = Math.max(0, daysRemaining - visibleRemaining); // Calculate extra days

	// Determine the card class based on the ROOM_FLOOR
	const cardClass = getFloorColorClass(booking.ROOM_FLOOR);
	
	// Determine the memo background color based on ROOM_FLOOR
	const memoClass = booking.ROOM_FLOOR === 3 ? 'memo-1' : 
					booking.ROOM_FLOOR === 4 ? 'memo-2' : 
					booking.ROOM_FLOOR === 5 ? 'memo-3' : 
					booking.ROOM_FLOOR === 6 ? 'memo-4' : 'memo-default';

	return {
		checkInDate,
		checkOutDate,
		totalDays,
		daysStayed,
		daysRemaining,
		visibleBars,
		visibleStayed,
		visibleRemaining,
		extraDays,
		cardClass,
		memoClass
	};
}
