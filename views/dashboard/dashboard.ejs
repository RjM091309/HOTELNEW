<!-- Socket.IO for Dashboard -->
<script src="/socket.io/socket.io.js"></script>
<script src="/js/dashboard/socket-config.js"></script>

<script>
	document.addEventListener('DOMContentLoaded', function() {
		
		// Load room_data.js immediately - this is critical for room display
		var roomScript = document.createElement('script');
		roomScript.src = '/js/dashboard/room_data.js';
		document.body.appendChild(roomScript);
		
		// Load main_data.js
		var mainScript = document.createElement('script');
		mainScript.src = '/js/dashboard/main_data.js';
		document.body.appendChild(mainScript);
		
		// Load other scripts
		var script2 = document.createElement('script');
		script2.src = '/js/dashboard/room-menu_data.js';
		document.body.appendChild(script2);
		// var script3 = document.createElement('script');
		// script3.src = '/js/dashboard/late-checkout_data.js';
		// document.body.appendChild(script3);
		var script4 = document.createElement('script');
		script4.src = '/js/dashboard/extend_data.js';
		document.body.appendChild(script4);
		var script5 = document.createElement('script');
		script5.src = '/js/dashboard/billing_data.js';
		document.body.appendChild(script5);
		var script7 = document.createElement('script');
		script7.src = '/js/dashboard/booking_data.js';
		document.body.appendChild(script7);
    var script8 = document.createElement('script');
		script8.src = '/js/dashboard/unassigned_room.js';
		document.body.appendChild(script8);

		// ================= Socket.IO realtime cleaning indicator =================
		// Safely acquire socket instance created by socket-config.js; fall back to io()
		var sock = window.socket || (window.io ? window.io() : null);
		if (sock) {
			function normalizeRoom(text) { return String(text).trim(); }

			function updateCleaningIconByRoom(roomNumber, isOn) {
				try {
					var targetRoom = normalizeRoom(roomNumber);
					var cards = Array.from(document.querySelectorAll('.card'))
						.filter(function(card){
							var header = card.querySelector('.card-head header');
							return header && normalizeRoom(header.textContent) === targetRoom;
						});
					cards.forEach(function(card){
						var body = card.querySelector('.card-body');
						if (!body) return;
						// Ensure container + icon + note exist at the ORIGINAL broom position
						// The original broom placeholder uses <i class="fa fa-broom"> inside the middle meta row
						var iconPlaceholder = body.querySelector('i.fa-broom, i.fas.fa-broom');
						var container = iconPlaceholder ? iconPlaceholder.parentElement : body.querySelector('.rc-cleaning-container');
						if (!container) {
							container = document.createElement('div');
							container.className = 'rc-cleaning-container';
							// Try to attach at the same parent where the original broom lived
							var metaRow = body.querySelector('div > div');
							(metaRow || body).appendChild(container);
							var icon = document.createElement('i');
							icon.className = 'fas fa-broom broom-off';
							container.appendChild(icon);
							var span = document.createElement('span');
							span.className = 'cleaning-note';
							container.appendChild(span);
						}

						var broomIcon = iconPlaceholder || container.querySelector('i.fa-broom');
						var note = container.querySelector('.cleaning-note');
						// Ensure note exists right after the broom icon
						if (!note && broomIcon) {
							note = document.createElement('span');
							note.className = 'cleaning-note';
							broomIcon.insertAdjacentElement('afterend', note);
						}
						if (broomIcon) {
							broomIcon.classList.remove('broom-on','broom-off');
							broomIcon.classList.add(isOn ? 'broom-on' : 'broom-off');
						}
						if (note) {
							note.classList.remove('cleaning-note--on');
							if (isOn) note.classList.add('cleaning-note--on');
							note.textContent = isOn ? 'Request Cleaning' : '';
						}
					});
				} catch(e){ console.warn('Cleaning icon update failed:', e); }
			}

			// Initial state: mark broom icons as off if no class yet
			Array.from(document.querySelectorAll('i.fa-broom')).forEach(function(el){
				if (!el.classList.contains('broom-on')) el.classList.add('broom-off');
			});

			// Fetch initial HA cleaning state so indicators persist after refresh (Room 304 default)
			fetch('/api/room-control/cleaning-status')
				.then(function(resp){ return resp.ok ? resp.json() : null; })
				.then(function(data){
					if (!data || !data.success) return;
					var isOn = String(data.state).toUpperCase() === 'ON';
					updateCleaningIconByRoom('304', isOn);
				})
				.catch(function(){ /* ignore */ });

			// From housekeeping mark-cleaned
			sock.on('cleaning-status-update', function(data){
				if (!data || !data.roomNumber) return;
				var isOn = String(data.cleaningRelayStatus).toUpperCase() === 'ON';
				updateCleaningIconByRoom(data.roomNumber, isOn);
			});

			// From guest room control toggle
			sock.on('guest-cleaning-toggle', function(data){
				if (!data || !data.roomNumber) return;
				var isOn = String(data.newState).toUpperCase() === 'ON';
				updateCleaningIconByRoom(data.roomNumber, isOn);
			});
		}
		
		// Load complaint/request counts for all booking cards after scripts are loaded
		setTimeout(function() {
			if (typeof window.loadAllBookingCardComplaintCounts === 'function') {
				window.loadAllBookingCardComplaintCounts();
			}
		}, 1000);
	});
</script>

