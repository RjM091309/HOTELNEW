function filterRequests(filter) {
    currentRequestsFilter = filter;
    updateRequestsFilterButtons();
    
    let filteredData = [];
    
    if (filter === 'all') {
        filteredData = allRequestsData;
    } else if (filter === 'completed') {
        filteredData = allRequestsData.filter(r => Number(r.STATUS) === 1);
    } else if (filter === 'not-completed') {
        filteredData = allRequestsData.filter(r => Number(r.STATUS) === 0);
    }
    
    // Update count
    document.getElementById('requestsTotalCount').textContent = allRequestsData.length;
    
    // Update DataTable with filtered data
    if (requestsDataTable) {
        requestsDataTable.clear();
        requestsDataTable.rows.add(filteredData);
        requestsDataTable.order([[4, 'desc']]).draw(); // Always sort by Created date descending (latest first)
        
        if (filteredData.length > 0) {
            document.getElementById('requestsListContent').style.display = 'block';
            document.getElementById('requestsEmpty').style.display = 'none';
        } else {
            document.getElementById('requestsListContent').style.display = 'none';
            document.getElementById('requestsEmpty').style.display = 'block';
        }
    } else {
        // Render filtered data (fallback if DataTable not initialized)
        if (filteredData.length > 0) {
            document.getElementById('requestsListContent').style.display = 'block';
            document.getElementById('requestsEmpty').style.display = 'none';
        } else {
            document.getElementById('requestsListContent').style.display = 'none';
            document.getElementById('requestsEmpty').style.display = 'block';
        }
    }
}

async function loadAllRequests() {
    try {
        const url = window.location.pathname.startsWith('/dashboard')
            ? '/dashboard/requests'
            : '/requests';

        const response = await fetch(url);
        const result = await response.json();

        // Hide loading
        document.getElementById('requestsLoading').style.display = 'none';

        if (result.success && result.data && result.data.length > 0) {
            // Store all requests data
            allRequestsData = result.data;

            // Show filters
            const filtersDiv = document.getElementById('requestsFilters');
            filtersDiv.style.display = 'block';

            // Update count
            document.getElementById('requestsTotalCount').textContent = result.data.length;

            // Initialize DataTable if not already initialized
            if (!requestsDataTable) {
                initializeRequestsDataTable();
            }

            // Apply current filter
            filterRequests(currentRequestsFilter);
        } else {
            document.getElementById('requestsFilters').style.display = 'none';
            document.getElementById('requestsListContent').style.display = 'none';
            document.getElementById('requestsEmpty').style.display = 'block';
        }
    } catch (error) {
        console.error('Error loading requests:', error);
        document.getElementById('requestsLoading').style.display = 'none';
        document.getElementById('requestsFilters').style.display = 'none';
        document.getElementById('requestsListContent').style.display = 'none';
        document.getElementById('requestsEmpty').style.display = 'block';
        document.getElementById('requestsEmpty').innerHTML = `
            <i class="fas fa-exclamation-circle" style="font-size: 3rem; color: #dc3545; margin-bottom: 1rem;"></i>
            <h4 style="color: #dc3545; margin-bottom: 0.5rem;">Error Loading Requests</h4>
            <p style="color: #6c757d; font-size: 0.9rem;">Failed to load requests. Please try again.</p>
        `;
    }
}

