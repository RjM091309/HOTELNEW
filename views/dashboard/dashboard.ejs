<script>
// Global variables for remarks modal
let currentRemarksData = {
    bookingId: null,
    roomNumber: null,
    guestName: null,
    currentRemarks: null
};

// Open remarks modal
function openRemarksModal(bookingId, roomNumber, guestName, currentRemarks) {
    // Store current data
    currentRemarksData = {
        bookingId: bookingId,
        roomNumber: roomNumber,
        guestName: guestName,
        currentRemarks: currentRemarks
    };
    
    // Update modal title with room number
    document.getElementById('remarksRoomNumber').textContent = roomNumber;
    
    // Display full remarks text
    const fullRemarksText = document.getElementById('fullRemarksText');
    if (currentRemarks && currentRemarks.trim() !== '') {
        fullRemarksText.textContent = currentRemarks;
        fullRemarksText.style.color = '#fff';
    } else {
        fullRemarksText.textContent = 'No remarks available for this room.';
        fullRemarksText.style.color = '#adb5bd';
        fullRemarksText.style.fontStyle = 'italic';
    }
    
    // Show modal
    const remarksModal = new bootstrap.Modal(document.getElementById('remarksModal'));
    remarksModal.show();
}

// New function to open remarks modal from data attributes
function openRemarksModalFromData(element) {
    const bookingId = element.getAttribute('data-booking-id');
    const roomNumber = element.getAttribute('data-room-number');
    const customerName = element.getAttribute('data-customer-name');
    const currentRemarks = element.getAttribute('data-remarks');
    const dataType = element.getAttribute('data-type');
    
    // Check if this is from M (Memo) button
    if (dataType === 'M') {
        // Use the room-menu modal with Memo preset
        if (typeof window.openRemarksModalWithMemo === 'function') {
            window.openRemarksModalWithMemo(bookingId);
            return;
        }
    }
    
    // Call the existing function for other cases
    openRemarksModal(bookingId, roomNumber, customerName, currentRemarks);
}

// Complaints Modal Functions
let allComplaintsData = []; // Store all complaints data
let currentFilter = 'all'; // Current filter state
let complaintsDataTable = null; // DataTable instance

function openComplaintsModal() {
    const modal = new bootstrap.Modal(document.getElementById('complaintsModal'));
    
    // Show loading state
    document.getElementById('complaintsLoading').style.display = 'block';
    document.getElementById('complaintsListContent').style.display = 'none';
    document.getElementById('complaintsEmpty').style.display = 'none';
    document.getElementById('complaintsFilters').style.display = 'none';
    
    // Reset filter to 'all'
    currentFilter = 'all';
    updateFilterButtons();
    
    // Destroy existing DataTable if it exists
    if (complaintsDataTable) {
        complaintsDataTable.destroy();
        complaintsDataTable = null;
    }
    
    // Show modal
    modal.show();
    
    // Load complaints
    loadAllComplaints();
    
    // Destroy DataTable when modal is closed
    $('#complaintsModal').on('hidden.bs.modal', function() {
        if (complaintsDataTable) {
            complaintsDataTable.destroy();
            complaintsDataTable = null;
        }
    });
}

function updateFilterButtons() {
    const buttons = document.querySelectorAll('#complaintsFilters .btn-filter');
    buttons.forEach(btn => {
        if (btn.getAttribute('data-filter') === currentFilter) {
            btn.classList.add('active');
        } else {
            btn.classList.remove('active');
        }
    });
}

function filterComplaints(filter) {
    currentFilter = filter;
    updateFilterButtons();
    
    let filteredData = [];
    
    if (filter === 'all') {
        filteredData = allComplaintsData;
    } else if (filter === 'completed') {
        filteredData = allComplaintsData.filter(c => Number(c.STATUS) === 1);
    } else if (filter === 'not-completed') {
        filteredData = allComplaintsData.filter(c => Number(c.STATUS) === 0);
    }
    
    // Update count
    document.getElementById('totalCount').textContent = allComplaintsData.length;
    
    // Update DataTable with filtered data
    if (complaintsDataTable) {
        complaintsDataTable.clear();
        complaintsDataTable.rows.add(filteredData);
        complaintsDataTable.order([[4, 'asc']]).draw(); // Always sort by Created date descending (latest first)
        
        if (filteredData.length > 0) {
            document.getElementById('complaintsListContent').style.display = 'block';
            document.getElementById('complaintsEmpty').style.display = 'none';
        } else {
            document.getElementById('complaintsListContent').style.display = 'none';
            document.getElementById('complaintsEmpty').style.display = 'block';
        }
    } else {
        // Render filtered data (fallback if DataTable not initialized)
        if (filteredData.length > 0) {
            renderComplaintsList(filteredData);
            document.getElementById('complaintsListContent').style.display = 'block';
            document.getElementById('complaintsEmpty').style.display = 'none';
        } else {
            document.getElementById('complaintsListContent').style.display = 'none';
            document.getElementById('complaintsEmpty').style.display = 'block';
        }
    }
}

async function loadAllComplaints() {
    try {
        const url = window.location.pathname.startsWith('/dashboard') 
            ? '/dashboard/complaints' 
            : '/complaints';
        
        const response = await fetch(url);
        const result = await response.json();
        
        // Hide loading
        document.getElementById('complaintsLoading').style.display = 'none';
        
        if (result.success && result.data && result.data.length > 0) {
            // Store all complaints data
            allComplaintsData = result.data;
            
            // Show filters
            const filtersDiv = document.getElementById('complaintsFilters');
            filtersDiv.style.display = 'block';
            
            // Update count
            document.getElementById('totalCount').textContent = result.data.length;
            
            // Initialize DataTable if not already initialized
            if (!complaintsDataTable) {
                initializeComplaintsDataTable();
            }
            
            // Apply current filter
            filterComplaints(currentFilter);
        } else {
            document.getElementById('complaintsFilters').style.display = 'none';
            document.getElementById('complaintsListContent').style.display = 'none';
            document.getElementById('complaintsEmpty').style.display = 'block';
        }
    } catch (error) {
        console.error('Error loading complaints:', error);
        document.getElementById('complaintsLoading').style.display = 'none';
        document.getElementById('complaintsFilters').style.display = 'none';
        document.getElementById('complaintsListContent').style.display = 'none';
        document.getElementById('complaintsEmpty').style.display = 'block';
        document.getElementById('complaintsEmpty').innerHTML = `
            <i class="fas fa-exclamation-circle" style="font-size: 3rem; color: #dc3545; margin-bottom: 1rem;"></i>
            <h4 style="color: #dc3545; margin-bottom: 0.5rem;">Error Loading Complaints</h4>
            <p style="color: #6c757d; font-size: 0.9rem;">Failed to load complaints. Please try again.</p>
        `;
    }
}

function renderComplaintsList(complaints) {
    // This function is kept as fallback but DataTable will handle rendering
    if (complaintsDataTable) {
        complaintsDataTable.clear();
        complaintsDataTable.rows.add(complaints);
        complaintsDataTable.draw();
    }
}

function initializeComplaintsDataTable() {
    complaintsDataTable = $('#complaintsTable').DataTable({
        paging: true,
        pageLength: 10,
        lengthChange: true,
        lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
        searching: true,
        ordering: true,
        order: [[4, 'desc']], // Sort by Created date descending
        info: true,
        autoWidth: false,
        serverSide: false,
        data: [],
        columns: [
            {
                data: 'ROOM_NUMBER',
                title: 'Room',
                className: 'text-center',
                render: function(data) {
                    return data ? `<span style="font-weight: 600;">${data}</span>` : '-';
                }
            },
            {
                data: 'CUSTOMER_NAME',
                title: 'Guest',
                className: 'text-center',
                render: function(data) {
                    return data || '-';
                }
            },
            {
                data: 'DETAILS',
                title: 'Details',
                render: function(data) {
                    const details = data || 'No details provided';
                    const truncatedDetails = details.length > 100 ? details.substring(0, 100) + '...' : details;
                    return `<div style="white-space: pre-wrap; word-wrap: break-word; font-size: 13px; line-height: 1.4; max-width: 300px;" title="${(details || '').replace(/"/g, '&quot;')}">${truncatedDetails}</div>`;
                }
            },
            {
                data: 'STATUS',
                title: 'Status',
                className: 'text-center',
                render: function(data, type, row) {
                    const status = Number(row.STATUS) === 1 ? 'COMPLETED' : 'NOT COMPLETE';
                    const statusClass = Number(row.STATUS) === 1 ? 'label-success' : 'label-danger';
                    return `<div style="text-align: center;"><span class="label label-sm ${statusClass} complaints-status-badge">${status}</span></div>`;
                }
            },
            {
                data: 'ENCODED_DT',
                title: 'Created',
                className: 'text-center',
                render: function(data) {
                    if (!data) return 'N/A';
                    return new Date(data).toLocaleString('en-US', { 
                        year: 'numeric', 
                        month: 'short', 
                        day: 'numeric', 
                        hour: '2-digit', 
                        minute: '2-digit',
                        hour12: false
                    });
                }
            },
            {
                data: 'ENCODED_BY_NAME',
                title: 'Created By',
                className: 'text-center',
                render: function(data) {
                    return data || '-';
                }
            },
            {
                data: 'COMPLETED_BY_NAME',
                title: 'Completed By',
                className: 'text-center',
                render: function(data) {
                    return data || '-';
                }
            },
            {
                data: 'COMPLETED_DT',
                title: 'Completed',
                className: 'text-center',
                render: function(data) {
                    if (!data) return '-';
                    return new Date(data).toLocaleString('en-US', { 
                        year: 'numeric', 
                        month: 'short', 
                        day: 'numeric', 
                        hour: '2-digit', 
                        minute: '2-digit',
                        hour12: false
                    });
                }
            },
            {
                data: null,
                title: 'Actions',
                className: 'text-center',
                orderable: false,
                searchable: false,
                render: function(data, type, row) {
                    const status = Number(row.STATUS) === 1 ? 1 : 0;
                    const markAction = status === 1
                        ? `<i class="fas fa-undo-alt text-warning" title="Mark Not Complete" style="cursor:pointer; margin: 0 5px;" onclick="toggleComplaintStatus(${row.IDNo}, 0)"></i>`
                        : `<i class="fas fa-check-circle text-success" title="Mark Completed" style="cursor:pointer; margin: 0 5px;" onclick="toggleComplaintStatus(${row.IDNo}, 1)"></i>`;
                    
                    // Escape details for use in JavaScript string
                    const detailsEscaped = String(row.DETAILS || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;').replace(/\n/g, '\\n').replace(/\r/g, '');
                    const typeEscaped = String(row.TYPE || 'complaint').toLowerCase();
                    return `
                        <i class="fas fa-edit text-primary" title="Edit" style="cursor:pointer; margin: 0 5px;" onclick="editComplaintFromModal(${row.IDNo}, '${typeEscaped}', '${detailsEscaped}')"></i>
                        ${markAction}
                        <i class="fas fa-trash text-danger" title="Delete" style="cursor:pointer; margin: 0 5px;" onclick="deleteComplaintFromModal(${row.IDNo})"></i>
                    `;
                }
            }
        ],
        rowCallback: function(row, data) {
            if (Number(data.STATUS) === 0) {
                $(row).css('background-color', 'rgba(220, 53, 69, 0.1)');
            }
        },
        language: {
            emptyTable: "No complaints available",
            lengthMenu: "Show _MENU_ entries",
            info: "Showing _START_ to _END_ of _TOTAL_ entries",
            infoEmpty: "Showing 0 to 0 of 0 entries",
            infoFiltered: "(filtered from _MAX_ total entries)",
            search: "Search:",
            paginate: {
                first: "First",
                last: "Last",
                next: "Next",
                previous: "Previous"
            }
        },
        dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
    });
}

// Complaints Actions Functions
async function editComplaintFromModal(id, type, details) {
    const modalId = `editComplaintModal_${id}`;
    const existing = document.getElementById(modalId);
    if (existing) existing.remove();
    
    // Decode HTML entities and escape sequences
    const decodedDetails = details
        .replace(/&quot;/g, '"')
        .replace(/\\n/g, '\n')
        .replace(/\\r/g, '\r')
        .replace(/\\\\/g, '\\')
        .replace(/\\'/g, "'");
    
    const html = `
    <div class="modal fade" id="${modalId}" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
            <div class="modal-content" style="background-color:#2a3135; color:#fff; border:1px solid #495057;">
                <div class="modal-header" style="background-color:#2a3135; border-bottom:1px solid #495057;">
                    <h5 class="modal-title" style="color:#fff;"><i class="fas fa-edit me-2"></i>Edit Complaint/Request</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="background-color:#2a3135;">
                    <div class="mb-3">
                        <label class="form-label" style="color:#fff;">Type</label>
                        <select class="form-select" id="complaintEditType_${id}" style="background-color:#41474c; color:#fff; border:1px solid #495057;">
                            <option value="complaint" ${type === 'complaint' ? 'selected' : ''}>Complaint</option>
                            <option value="request" ${type === 'request' ? 'selected' : ''}>Request</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="color:#fff;">Details</label>
                        <textarea class="form-control" id="complaintEditDetails_${id}" rows="4" style="background-color:#41474c; color:#fff; border:1px solid #495057;">${decodedDetails.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</textarea>
                    </div>
                </div>
                <div class="modal-footer" style="background-color:#2a3135; border-top:1px solid #495057;">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="updateComplaintFromModal(${id})">Update</button>
                </div>
            </div>
        </div>
    </div>`;
    document.body.insertAdjacentHTML('beforeend', html);
    const modal = new bootstrap.Modal(document.getElementById(modalId));
    modal.show();
}

async function updateComplaintFromModal(id) {
    const type = document.getElementById(`complaintEditType_${id}`).value;
    const details = document.getElementById(`complaintEditDetails_${id}`).value.trim();
    if (!type || !details) {
        if (typeof toastError === 'function') {
            toastError('Error', 'Please fill all fields');
        } else {
            alert('Please fill all fields');
        }
        return;
    }
    try {
        const resp = await fetch(`/booking/complaint-request/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: type, details: details })
        });
        const result = await resp.json();
        if (!result.success) throw new Error(result.message || 'Failed');
        
        // Close edit modal
        const editModal = bootstrap.Modal.getInstance(document.getElementById(`editComplaintModal_${id}`));
        if (editModal) editModal.hide();
        
        // Reload complaints data
        await loadAllComplaints();
        
        if (typeof toastSuccess === 'function') {
            toastSuccess('Updated', 'Complaint updated');
        } else {
            alert('Complaint updated');
        }
    } catch (e) {
        console.error('Update complaint failed:', e);
        if (typeof toastError === 'function') {
            toastError('Error', 'Could not update complaint');
        } else {
            alert('Could not update complaint');
        }
    }
}

async function toggleComplaintStatus(id, toStatus) {
    try {
        // Confirm action
        if (typeof Swal !== 'undefined') {
            const verb = Number(toStatus) === 1 ? 'mark as completed' : 'mark as not complete';
            const res = await Swal.fire({
                title: 'Are you sure?',
                text: `Do you want to ${verb}?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#6f9c40',
                cancelButtonColor: '#6c757d'
            });
            if (!res.isConfirmed) return;
        } else if (!confirm('Continue with this change?')) {
            return;
        }

        const upd = await fetch(`/booking/complaint-request/${id}/status`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: Number(toStatus) })
        });
        const ok = await upd.json();
        if (!ok.success) throw new Error(ok.message || 'Failed');
        
        // Reload complaints data
        await loadAllComplaints();
        
        if (typeof toastSuccess === 'function') {
            toastSuccess('Updated', 'Status updated');
        } else {
            alert('Status updated');
        }
    } catch (e) {
        console.error('Toggle status failed:', e);
        if (typeof toastError === 'function') {
            toastError('Error', 'Could not update status');
        } else {
            alert('Could not update status');
        }
    }
}

async function deleteComplaintFromModal(id) {
    try {
        // Confirm deletion
        if (typeof Swal !== 'undefined') {
            const res = await Swal.fire({
                title: 'Delete this complaint?',
                text: 'This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Delete',
                cancelButtonText: 'Cancel'
            });
            if (!res.isConfirmed) return;
        } else if (!confirm('Delete this complaint?')) {
            return;
        }

        const del = await fetch(`/booking/complaint-request/${id}`, {
            method: 'DELETE'
        });
        const ok = await del.json();
        if (!ok.success) throw new Error(ok.message || 'Failed');
        
        // Reload complaints data
        await loadAllComplaints();
        
        if (typeof toastSuccess === 'function') {
            toastSuccess('Deleted', 'Complaint deleted');
        } else {
            alert('Complaint deleted');
        }
    } catch (e) {
        console.error('Delete complaint failed:', e);
        if (typeof toastError === 'function') {
            toastError('Error', 'Could not delete complaint');
        } else {
            alert('Could not delete complaint');
        }
    }
}

// Requests Modal Functions
let allRequestsData = []; // Store all requests data
let currentRequestsFilter = 'all'; // Current filter state
let requestsDataTable = null; // DataTable instance

function openRequestsModal() {
    const modal = new bootstrap.Modal(document.getElementById('requestsModal'));
    
    // Show loading state
    document.getElementById('requestsLoading').style.display = 'block';
    document.getElementById('requestsListContent').style.display = 'none';
    document.getElementById('requestsEmpty').style.display = 'none';
    document.getElementById('requestsFilters').style.display = 'none';
    
    // Reset filter to 'all'
    currentRequestsFilter = 'all';
    updateRequestsFilterButtons();
    
    // Destroy existing DataTable if it exists
    if (requestsDataTable) {
        requestsDataTable.destroy();
        requestsDataTable = null;
    }
    
    // Show modal
    modal.show();
    
    // Load requests
    loadAllRequests();
    
    // Destroy DataTable when modal is closed
    $('#requestsModal').on('hidden.bs.modal', function() {
        if (requestsDataTable) {
            requestsDataTable.destroy();
            requestsDataTable = null;
        }
    });
}

function updateRequestsFilterButtons() {
    const buttons = document.querySelectorAll('#requestsFilters .btn-filter');
    buttons.forEach(btn => {
        if (btn.getAttribute('data-filter') === currentRequestsFilter) {
            btn.classList.add('active');
        } else {
            btn.classList.remove('active');
        }
    });
}

// Remarks List Modal logic
let remarksDataTable = null;

function openRemarksListModal() {
    const modal = new bootstrap.Modal(document.getElementById('remarksListModal'));
    document.getElementById('remarksLoading').style.display = 'block';
    document.getElementById('remarksListContent').style.display = 'none';
    document.getElementById('remarksEmpty').style.display = 'none';
    if (remarksDataTable) {
        remarksDataTable.destroy();
        remarksDataTable = null;
    }
    modal.show();
    loadAllRemarks();
    $('#remarksListModal').on('hidden.bs.modal', function() {
        if (remarksDataTable) { remarksDataTable.destroy(); remarksDataTable = null; }
    });
}

async function loadAllRemarks() {
    try {
        const url = window.location.pathname.startsWith('/dashboard') ? '/dashboard/remarks' : '/remarks';
        const resp = await fetch(url);
        const result = await resp.json();
        document.getElementById('remarksLoading').style.display = 'none';
        const rows = (result && result.success && Array.isArray(result.data)) ? result.data : [];
        if (!remarksDataTable) initializeRemarksDataTable();
        remarksDataTable.clear();
        remarksDataTable.rows.add(rows);
        remarksDataTable.order([[4, 'desc']]).draw();
        if (rows.length > 0) {
            document.getElementById('remarksListContent').style.display = 'block';
            document.getElementById('remarksEmpty').style.display = 'none';
        } else {
            document.getElementById('remarksListContent').style.display = 'none';
            document.getElementById('remarksEmpty').style.display = 'block';
        }
    } catch (e) {
        console.error('Error loading remarks:', e);
        document.getElementById('remarksLoading').style.display = 'none';
        document.getElementById('remarksListContent').style.display = 'none';
        const empty = document.getElementById('remarksEmpty');
        empty.style.display = 'block';
        empty.innerHTML = `
            <i class="fas fa-exclamation-circle" style="font-size: 3rem; color: #dc3545; margin-bottom: 1rem;"></i>
            <h4 style="color: #dc3545; margin-bottom: 0.5rem;">Error Loading Remarks</h4>
            <p style="color: #6c757d; font-size: 0.9rem;">Please try again.</p>
        `;
    }
}

