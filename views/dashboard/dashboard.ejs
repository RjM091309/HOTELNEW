                    Complaints List
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="background: #2a3135; color: #fff; padding: 25px;">
                <!-- Filter Buttons -->
                <div id="complaintsFilters" style="display: none; margin-bottom: 20px;">
                    <div class="filter-btn-group" role="group">
                        <button type="button" class="filter-btn btn-filter active" data-filter="all">
                            All (<span id="totalCount">0</span>)
                        </button>
                        <button type="button" class="filter-btn btn-filter" data-filter="completed">
                            Completed
                        </button>
                        <button type="button" class="filter-btn btn-filter" data-filter="not-completed">
                            Not Complete
                        </button>
                    </div>
