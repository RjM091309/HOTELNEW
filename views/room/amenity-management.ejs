<!-- ======================================== -->
<!-- AMENITY MANAGEMENT -->
<!-- ======================================== -->

<!-- Amenities Management Modal -->
<div class="modal fade" id="amenitiesManagementModal" tabindex="-1" role="dialog" aria-labelledby="amenitiesManagementModalLabel" aria-hidden="true" data-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="amenitiesManagementModalLabel">Amenities Management</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6>Manage Amenities</h6>
                    <button class="btn btn-primary btn-sm" id="addAmenityBtn" title="Add New Amenity">
                        <i class="fa fa-plus"></i> Add New Amenity
                    </button>
                </div>
                <div class="table-scrollable">
                    <table id="amenityTable" class="table table-hover table-bordered full-width">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Type</th>
                                <th>Cost</th>
                                <th>Availability</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data loaded dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Amenity Modal -->
<div class="modal fade" id="addAmenityModal" tabindex="-1" role="dialog" aria-labelledby="addAmenityModalLabel" aria-hidden="true" data-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="addAmenityModalLabel">Add New Amenity</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addAmenityForm">
                <div class="modal-body">
                    <!-- Amenity Name -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addAmenityName" name="NAME" required>
                                <label class="mdl-textfield__label">Amenity Name *</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Description -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <textarea class="mdl-textfield__input" type="text" rows="3" id="addAmenityDescription" name="DESCRIPTION"></textarea>
                                <label class="mdl-textfield__label">Description</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Type Selection -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addAmenityType" name="IS_PAID" value="" readonly tabIndex="-1" required>
                                <label for="addAmenityType" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="addAmenityType" class="mdl-textfield__label">Type *</label>
                                <ul data-mdl-for="addAmenityType" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="Free">Free</li>
                                    <li class="mdl-menu__item" data-val="Paid">Paid</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Cost Field (Conditional) -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="form-group" id="costFieldGroup" style="display: none;">
                                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                    <input class="mdl-textfield__input" type="number" step="0.01" id="addAmenityCost" name="COST" placeholder="Enter cost (required for paid amenity)">
                                    <label class="mdl-textfield__label">Cost *</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Availability -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="addAmenityAvailability" name="AVAILABILITY" value="" readonly tabIndex="-1" required>
                                <label for="addAmenityAvailability" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="addAmenityAvailability" class="mdl-textfield__label">Availability *</label>
                                <ul data-mdl-for="addAmenityAvailability" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="Available">Available</li>
                                    <li class="mdl-menu__item" data-val="Not Available">Not Available</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-10">Add Amenity</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Amenity Modal -->
<div class="modal fade" id="editAmenityModal" tabindex="-1" role="dialog" aria-labelledby="editAmenityModalLabel" aria-hidden="true" data-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="editAmenityModalLabel">Edit Amenity</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editAmenityForm">
                <div class="modal-body">
                    <input type="hidden" id="editAmenityId" name="IDNo">
                    
                    <!-- Amenity Name -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editAmenityName" name="NAME" required>
                                <label class="mdl-textfield__label">Amenity Name</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Description -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                <textarea class="mdl-textfield__input" type="text" rows="3" id="editAmenityDescription" name="DESCRIPTION"></textarea>
                                <label class="mdl-textfield__label">Description</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Type Selection -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editAmenityType" name="IS_PAID" value="" readonly tabIndex="-1" required>
                                <label for="editAmenityType" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="editAmenityType" class="mdl-textfield__label">Type</label>
                                <ul data-mdl-for="editAmenityType" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="Free">Free</li>
                                    <li class="mdl-menu__item" data-val="Paid">Paid</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Cost Field (Conditional) -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="form-group" id="editCostFieldGroup" style="display: none;">
                                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                                    <input class="mdl-textfield__input" type="number" step="0.01" id="editAmenityCost" name="COST" placeholder="Enter cost (required for paid amenity)">
                                    <label class="mdl-textfield__label">Cost *</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Availability -->
                    <div class="row">
                        <div class="col-lg-12 p-t-20">
                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                                <input class="mdl-textfield__input" type="text" id="editAmenityAvailability" name="AVAILABILITY" value="" readonly tabIndex="-1" required>
                                <label for="editAmenityAvailability" class="pull-right margin-0">
                                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                                </label>
                                <label for="editAmenityAvailability" class="mdl-textfield__label">Availability</label>
                                <ul data-mdl-for="editAmenityAvailability" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                                    <li class="mdl-menu__item" data-val="Available">Available</li>
                                    <li class="mdl-menu__item" data-val="Not Available">Not Available</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-10">Update Amenity</button>
                </div>
            </form>
        </div>
    </div>
</div> 

