<style>
    /* Fix modal z-index stacking for nested modals */
    .modal-backdrop {
        z-index: 9997 !important;
    }
    
    .modal-backdrop + .modal-backdrop {
        z-index: 9998 !important;
    }
    
    /* Ensure add/edit modals appear on top */
    #addRoomTypeModal,
    #editRoomTypeModal,
    #addAmenityModal,
    #editAmenityModal,
    #addSeasonModal,
    #editSeasonModal,
    #addRoomModal,
    #editRoomModal {
        z-index: 9999 !important;
    }
    
    /* Ensure management modals are below add/edit modals */
    #roomTypesManagementModal,
    #amenitiesManagementModal,
    #seasonsManagementModal {
        z-index: 9998 !important;
    }
    
    /* Force modal backdrop to be behind all modals */
    .modal-backdrop.show {
        z-index: 9997 !important;
    }
    

    
    /* Ensure MDL dropdowns appear above modal content */
    .mdl-menu {
        z-index: 9999 !important;
    }
    
    .mdl-menu__container {
        z-index: 9999 !important;
    }
    
    /* Fix dropdown positioning */
    .mdl-menu--bottom-left,
    .mdl-menu--bottom-right {
        z-index: 9999 !important;
    }
    
    /* Ensure dropdowns are not clipped by modal boundaries */
    .modal .mdl-textfield {
        overflow: visible !important;
    }
    
    .modal .getmdl-select {
        overflow: visible !important;
    }
    
    /* Force dropdowns to render above modal backdrop */
    .modal-backdrop + .mdl-menu,
    .modal-backdrop + .mdl-menu__container {
        z-index: 9999 !important;
    }

    /* Add/Edit Room input text was invisible in dark mode (default theme) -
       every color rule for these two modals in theme-color.css/card.css is
       scoped to [data-theme="white"]/body.white-sidebar-color only, so dark
       mode fell back to the browser/Bootstrap default (near-black) text
       color on these dark fields. Same fix/colors already used successfully
       in the Add Booking modal (views/booking/modal/add_booking.ejs). */
    #addRoomModal input[type="text"],
    #addRoomModal input[type="number"],
    #addRoomModal input[type="email"],
    #addRoomModal select,
    #addRoomModal textarea,
    #editRoomModal input[type="text"],
    #editRoomModal input[type="number"],
    #editRoomModal input[type="email"],
    #editRoomModal select,
    #editRoomModal textarea {
        background-color: #41474c;
        color: #ffffff;
        border: 1px solid #41474c;
        border-bottom: 1px solid #a6aeb1 !important;
    }

    #addRoomModal input::placeholder,
    #addRoomModal textarea::placeholder,
    #editRoomModal input::placeholder,
    #editRoomModal textarea::placeholder {
        color: #bbbbbb;
    }

    #addRoomModal select option,
    #editRoomModal select option {
        background-color: #41474c;
        color: #ffffff;
    }

</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Load scripts with proper timing
        setTimeout(function() {
            var roomScript = document.createElement('script');
            roomScript.src = '/js/room/room_data.js?v=grid-3';
            document.body.appendChild(roomScript);

