<!-- ======================================== -->
<!-- SCRIPT LOADING -->
<!-- ======================================== -->

<style>
    /* Fix modal z-index stacking for nested modals */
    .modal-backdrop {
        z-index: 9997 !important;
    }
    
    .modal-backdrop + .modal-backdrop {
        z-index: 9998 !important;
    }
    
    /* Ensure add/edit modals appear on top */
    #addRoomTypeModal,
    #editRoomTypeModal,
    #addAmenityModal,
    #editAmenityModal,
    #addSeasonModal,
    #editSeasonModal,
    #addRoomModal,
    #editRoomModal {
        z-index: 9999 !important;
    }
    
    /* Ensure management modals are below add/edit modals */
    #roomTypesManagementModal,
    #amenitiesManagementModal,
    #seasonsManagementModal {
        z-index: 9998 !important;
    }
    
    /* Force modal backdrop to be behind all modals */
    .modal-backdrop.show {
        z-index: 9997 !important;
    }
    

    
    /* Ensure MDL dropdowns appear above modal content */
    .mdl-menu {
        z-index: 9999 !important;
    }
    
    .mdl-menu__container {
        z-index: 9999 !important;
    }
    
    /* Fix dropdown positioning */
    .mdl-menu--bottom-left,
    .mdl-menu--bottom-right {
        z-index: 9999 !important;
    }
    
    /* Ensure dropdowns are not clipped by modal boundaries */
    .modal .mdl-textfield {
        overflow: visible !important;
    }
    
    .modal .getmdl-select {
        overflow: visible !important;
    }
    
    /* Force dropdowns to render above modal backdrop */
    .modal-backdrop + .mdl-menu,
    .modal-backdrop + .mdl-menu__container {
        z-index: 9999 !important;
    }
    

</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Load scripts with proper timing
        setTimeout(function() {
            var roomScript = document.createElement('script');
            roomScript.src = '/js/room/room_data.js?v=room-rates-3';
            document.body.appendChild(roomScript);

            setTimeout(function() {
                var roomTypeScript = document.createElement('script');
                roomTypeScript.src = '/js/room/room-type-maintenance.js?v=room-rates-3';
                document.body.appendChild(roomTypeScript);
            }, 100);

            setTimeout(function() {
                var amenityScript = document.createElement('script');
                amenityScript.src = '/js/room/amenity-maintenance.js';
                document.body.appendChild(amenityScript);
            }, 200);
        }, 300);
    });
</script> 