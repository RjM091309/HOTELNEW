<div class="modal fade" id="edit-expense-modal" tabindex="-1" aria-labelledby="edit-expense-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form id="edit-expense-form">
          <div class="modal-header">
            <h5 class="modal-title" id="edit-expense-modal-label">Edit Expense</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <!-- Hidden Field for Expense ID -->
            <input type="hidden" id="edit-expense-id" name="id">

            <div class="row">
              <!-- Date of Expense (flatpickr - opens on click anywhere in the field) -->
              <div class="col-lg-6 p-t-15">
                <div class="expense-plain-field">
                  <label class="expense-plain-label" for="edit-expense-date">Date of Expense</label>
                  <input class="expense-plain-input" type="text" id="edit-expense-date" name="expenseDate" placeholder="Select date" required>
                </div>
              </div>

              <!-- Company Name -->
              <div class="col-lg-6 p-t-15">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <input class="mdl-textfield__input" type="text" id="edit-expense-company" name="companyName">
                  <label class="mdl-textfield__label" for="edit-expense-company">Company Name</label>
                </div>
              </div>

              <!-- SI No. -->
              <div class="col-lg-6 p-t-15">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <input class="mdl-textfield__input" type="text" id="edit-expense-sino" name="siNo">
                  <label class="mdl-textfield__label" for="edit-expense-sino">SI No.</label>
                </div>
              </div>

              <!-- Amount -->
              <div class="col-lg-6 p-t-15">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <input class="mdl-textfield__input" type="number" id="edit-expense-amount" name="amount" step="0.01" min="0" required>
                  <label class="mdl-textfield__label" for="edit-expense-amount">Amount</label>
                </div>
              </div>

              <!-- Details of Expense -->
              <div class="col-lg-12 p-t-15">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <textarea class="mdl-textfield__input" id="edit-expense-details" name="details" rows="3" required></textarea>
                  <label class="mdl-textfield__label" for="edit-expense-details">Details of Expense</label>
                </div>
              </div>
            </div>
          </div>

          <!-- Modal Footer -->
          <div class="modal-footer">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </form>
      </div>
    </div>
  </div>
