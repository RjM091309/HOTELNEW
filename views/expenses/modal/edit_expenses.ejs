<div class="modal fade" id="edit-expense-modal" tabindex="-1" aria-labelledby="edit-expense-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form id="edit-expense-form">
          <div class="modal-header">
            <h5 class="modal-title" id="edit-expense-modal-label">Edit Expense</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <!-- Hidden Field for Expense ID -->
            <input type="hidden" id="edit-expense-id" name="id">
  
            <!-- Category Dropdown -->
            <div class="col-lg-6 p-t-15">
              <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                <select class="mdl-textfield__input" id="edit-expense-category" name="category" required>
                  <option value="" disabled>Select Category</option>
                  <option value="Major Expenses">Major Expenses</option>
                  <option value="Regular Expenses">Regular Expenses</option>
                  <option value="Marketing Expenses">Marketing Expenses</option>
                </select>
                <label class="mdl-textfield__label">Category</label>
              </div>
            </div>
  
            <!-- Receipt Number -->
            <div class="col-lg-6 p-t-15">
              <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                <input class="mdl-textfield__input" type="text" id="edit-expense-receipt" name="receipt">
                <label class="mdl-textfield__label">Expense Items</label>
              </div>
            </div>
  
            <!-- Description -->
            <div class="col-lg-12 p-t-15">
              <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                <textarea class="mdl-textfield__input" id="edit-expense-description" name="description" rows="3" required></textarea>
                <label class="mdl-textfield__label">Description</label>
              </div>
            </div>
  
            <!-- Amount -->
            <div class="col-lg-6 p-t-15">
              <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                <input class="mdl-textfield__input" type="number" id="edit-expense-amount" name="amount" step="0.01" required>
                <label class="mdl-textfield__label">Amount</label>
              </div>
            </div>
          </div>
  
          <!-- Modal Footer -->
          <div class="modal-footer">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </form>
      </div>
    </div>
  </div> 