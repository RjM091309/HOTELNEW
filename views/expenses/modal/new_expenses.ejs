<form id="new-expense-form" method="POST">
    <div class="modal fade" id="new-expense-modal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h4 class="modal-title">Add New Expense</h4>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="row">
              <!-- Category Dropdown -->
              <div class="col-lg-6 p-t-20">
                <div class="mdl-textfield mdl-js-textfield txt-full-width">
                  <select class="mdl-textfield__input" id="expenseCategory" name="category" required>
                    <option value="" disabled selected>Select Category</option>
                    <option value="Major Expenses">Major Expenses</option>
                    <option value="Regular Expenses">Regular Expenses</option>
                    <option value="Marketing Expenses">Marketing Expenses</option>
                  </select>
                </div>
              </div>
  
              <!-- Receipt Number -->
              <div class="col-lg-6 p-t-20">
                <div class="mdl-textfield mdl-js-textfield txt-full-width">
                  <input class="mdl-textfield__input" type="text" id="expenseReceipt" name="receipt">
                  <label class="mdl-textfield__label">Expense Items</label>
                </div>
              </div>
  
              <!-- Description -->
              <div class="col-lg-12 p-t-20">
                <div class="mdl-textfield mdl-js-textfield txt-full-width">
                  <textarea class="mdl-textfield__input" id="expenseDescription" name="description" rows="3" required></textarea>
                  <label class="mdl-textfield__label">Description</label>
                </div>
              </div>
  
              <!-- Amount -->
              <div class="col-lg-6 p-t-20">
                <div class="mdl-textfield mdl-js-textfield txt-full-width">
                  <input class="mdl-textfield__input" type="number" id="expenseAmount" name="amount" step="0.01" required>
                  <label class="mdl-textfield__label">Amount</label>
                </div>
              </div>
            </div>
          </div>
  
          <!-- Submit Button -->
          <div class="modal-footer">
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>
  </form> 