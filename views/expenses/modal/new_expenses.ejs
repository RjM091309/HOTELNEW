<form id="new-expense-form" method="POST">
    <div class="modal fade" id="new-expense-modal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h4 class="modal-title">Add New Expense</h4>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="row">
              <!-- Category Dropdown -->
              <div class="col-lg-6 p-t-20">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label getmdl-select getmdl-select__fix-height txt-full-width">
                  <input class="mdl-textfield__input" type="text" id="expenseCategory" name="category" value="" readonly tabIndex="-1" required>
                  <label for="expenseCategory" class="pull-right margin-0">
                    <i class="mdl-icon-toggle__label material-icons">keyboard_arrow_down</i>
                  </label>
                  <label for="expenseCategory" class="mdl-textfield__label">Category</label>
                  <ul data-mdl-for="expenseCategory" class="mdl-menu mdl-menu--bottom-left mdl-js-menu">
                    <li class="mdl-menu__item" data-val="Major Expenses">Major Expenses</li>
                    <li class="mdl-menu__item" data-val="Regular Expenses">Regular Expenses</li>
                    <li class="mdl-menu__item" data-val="Marketing Expenses">Marketing Expenses</li>
                  </ul>
                </div>
              </div>
  
              <!-- Receipt Number -->
              <div class="col-lg-6 p-t-20">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <input class="mdl-textfield__input" type="text" id="expenseReceipt" name="receipt">
                  <label class="mdl-textfield__label">Expense Items</label>
                </div>
              </div>
  
              <!-- Description -->
              <div class="col-lg-12 p-t-20">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <textarea class="mdl-textfield__input" id="expenseDescription" name="description" rows="3" required></textarea>
                  <label class="mdl-textfield__label">Description</label>
                </div>
              </div>
  
              <!-- Amount -->
              <div class="col-lg-6 p-t-20">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <input class="mdl-textfield__input" type="number" id="expenseAmount" name="amount" step="0.01" required>
                  <label class="mdl-textfield__label">Amount</label>
                </div>
              </div>
            </div>
          </div>
  
          <!-- Submit Button -->
          <div class="modal-footer">
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>
  </form> 