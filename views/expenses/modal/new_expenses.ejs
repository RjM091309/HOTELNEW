<form id="new-expense-form" method="POST">
    <div class="modal fade" id="new-expense-modal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h4 class="modal-title">Add New Expense</h4>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="row">
              <!-- Date of Expense (flatpickr - opens on click anywhere in the field) -->
              <div class="col-lg-6 p-t-20">
                <div class="expense-plain-field">
                  <label class="expense-plain-label" for="expenseDate">Date of Expense</label>
                  <input class="expense-plain-input" type="text" id="expenseDate" name="expenseDate" placeholder="Select date" required>
                </div>
              </div>

              <!-- Company Name -->
              <div class="col-lg-6 p-t-20">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <input class="mdl-textfield__input" type="text" id="expenseCompany" name="companyName">
                  <label class="mdl-textfield__label" for="expenseCompany">Company Name</label>
                </div>
              </div>

              <!-- SI No. -->
              <div class="col-lg-6 p-t-20">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <input class="mdl-textfield__input" type="text" id="expenseSiNo" name="siNo">
                  <label class="mdl-textfield__label" for="expenseSiNo">SI No.</label>
                </div>
              </div>

              <!-- Amount -->
              <div class="col-lg-6 p-t-20">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <input class="mdl-textfield__input" type="number" id="expenseAmount" name="amount" step="0.01" min="0" required>
                  <label class="mdl-textfield__label" for="expenseAmount">Amount</label>
                </div>
              </div>

              <!-- Details of Expense -->
              <div class="col-lg-12 p-t-20">
                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label txt-full-width">
                  <textarea class="mdl-textfield__input" id="expenseDetails" name="details" rows="3" required></textarea>
                  <label class="mdl-textfield__label" for="expenseDetails">Details of Expense</label>
                </div>
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="modal-footer">
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>
  </form>
