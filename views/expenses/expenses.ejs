<!-- start page content -->
<!--
  Expenses, laid out like the cage system's expense page (data entry only, no settlement):
  date range | total expenses / return money / net | selected total + breakdown by category |
  main category | sub category | expenses table. Return money ("sukli") is its own green main category.
-->
<link rel="stylesheet" href="/css/expenses.css?v=cage-concept-1">

<div class="xp">
  <!-- Date range + export -->
  <div class="xp-card xp-bar">
    <span class="xp-caption">Date range</span>
    <div class="xp-range">
      <i class="far fa-calendar-alt xp-range__icon"></i>
      <input type="text" id="xp-range" class="xp-range__input" placeholder="Any date" readonly>
      <button type="button" id="xp-range-clear" class="xp-range__clear" title="Any date" aria-label="Any date"><i class="fa fa-times"></i></button>
    </div>
    <button id="exportToExcel" type="button" class="btn btn-primary xp-bar__export">
      <i class="fa fa-download"></i> Export
    </button>
  </div>

  <!-- Total expenses, return money and the net -->
  <div class="xp-kpis">
    <div class="xp-card xp-kpi">
      <span class="xp-kpi__icon"><i class="fa fa-wallet"></i></span>
      <div class="xp-kpi__text">
        <div class="xp-kpi__label">Total expenses</div>
        <div class="xp-kpi__value" id="xp-total">₱0.00</div>
      </div>
      <div class="xp-kpi__meta" id="xp-total-meta"></div>
    </div>
    <div class="xp-card xp-kpi xp-kpi--return">
      <span class="xp-kpi__icon"><i class="fa fa-undo"></i></span>
      <div class="xp-kpi__text">
        <div class="xp-kpi__label">Total return money</div>
        <div class="xp-kpi__value" id="xp-returned">₱0.00</div>
      </div>
      <div class="xp-kpi__meta" id="xp-returned-meta"></div>
    </div>
    <div class="xp-card xp-kpi">
      <span class="xp-kpi__icon"><i class="fa fa-calculator"></i></span>
      <div class="xp-kpi__text">
        <div class="xp-kpi__label">Net expenses</div>
        <div class="xp-kpi__value" id="xp-net">₱0.00</div>
      </div>
      <div class="xp-kpi__meta" id="xp-net-meta"></div>
    </div>
  </div>

  <!-- Selected total + breakdown by main category -->
  <div class="xp-summary">
    <div class="xp-card xp-kpi xp-kpi--tall" id="xp-selected-card">
      <span class="xp-kpi__icon"><i class="fa fa-filter"></i></span>
      <div class="xp-kpi__text">
        <div class="xp-kpi__label">Selected total</div>
        <div class="xp-kpi__value" id="xp-selected">₱0.00</div>
        <div class="xp-kpi__sub" id="xp-selected-meta">All categories</div>
      </div>
    </div>
    <div class="xp-card xp-breakdown">
      <div class="xp-breakdown__head">
        <div class="xp-caption">Expense breakdown</div>
        <div class="xp-muted">By category</div>
      </div>
      <div id="xp-breakdown-body"><div class="xp-muted xp-small">No expense data yet.</div></div>
    </div>
  </div>

  <!-- Main category | Sub category | expenses -->
  <div class="xp-explorer">
    <div class="xp-card xp-panel xp-panel--main">
      <div class="xp-panel__head">
        <span class="xp-caption">Main category</span>
        <button type="button" class="xp-icon-btn" id="xp-add-main" title="Add main category" aria-label="Add main category"><i class="fa fa-plus"></i></button>
      </div>
      <div class="xp-panel__body" id="xp-main-list"></div>
    </div>
    <div class="xp-card xp-panel xp-panel--sub">
      <div class="xp-panel__head">
        <span class="xp-caption">Sub category</span>
        <button type="button" class="xp-icon-btn" id="xp-add-sub" title="Add sub category" aria-label="Add sub category" disabled><i class="fa fa-plus"></i></button>
      </div>
      <div class="xp-panel__body" id="xp-sub-list"></div>
    </div>
    <div class="xp-card xp-table-panel">
      <div class="xp-table-panel__head">
        <span class="xp-table-panel__title">Expenses <span class="xp-muted xp-small" id="xp-table-scope"></span></span>
        <div class="xp-table-panel__actions">
          <!-- As in the cage system, the buttons follow the selected main category. -->
          <button type="button" class="btn btn-outline-secondary btn-sm xp-hidden" id="xp-btn-vehicles"><i class="fa fa-car"></i> Vehicles</button>
          <button type="button" class="btn btn-success btn-sm xp-hidden" id="xp-btn-return"><i class="fa fa-undo"></i> Return money</button>
          <button type="button" class="btn btn-primary btn-sm xp-hidden" id="xp-btn-new"><i class="fa fa-plus"></i> New expense</button>
        </div>
      </div>
      <div class="table-scrollable xp-table-wrap">
        <table id="expenses_tbl" class="table table-hover full-width xp-table">
          <thead>
            <tr>
              <th>Category</th>
              <th>Description</th>
              <th>In-Charge</th>
              <th class="text-end">Amount</th>
              <th>Date &amp; Time</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>

  <%- include('modal/expense_form') %>
  <%- include('modal/return_money') %>
  <%- include('modal/vehicles') %>
  <%- include('modal/breakdown') %>
</div>

<!-- ExcelJS: styled Excel export (fills / bold / number formats) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
<script src="/js/expenses/expenses.js?v=cage-concept-2"></script>
