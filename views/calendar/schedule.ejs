function populateScheduleTypeForm(schedule) {
    $('#schedule_description').val(schedule.description);
    
    // Helper function to safely format time values
    function formatTimeForInput(timeValue) {
        if (!timeValue || timeValue === null || timeValue === undefined) {
            return '';
        }
        
        // Convert to string and handle different formats
        const timeStr = String(timeValue);
        
        // If it's already in HH:MM format, return it
        if (/^\d{2}:\d{2}$/.test(timeStr)) {
            return timeStr;
        }
        
        // If it's in HH:MM:SS format, extract HH:MM
        if (/^\d{2}:\d{2}:\d{2}/.test(timeStr)) {
            return timeStr.substring(0, 5);
        }
        
        // Handle datetime format like "1970-01-01T08:00:00.000Z"
        if (timeStr.includes('T') && timeStr.includes('1970-')) {
            try {
                const date = new Date(timeStr);
                const hours = date.getUTCHours().toString().padStart(2, '0');
                const minutes = date.getUTCMinutes().toString().padStart(2, '0');
                return `${hours}:${minutes}`;
            } catch (e) {
                return '';
            }
        }
        
        // If it's just numbers, assume it's HHMM format
        if (/^\d{4}$/.test(timeStr)) {
            return timeStr.substring(0, 2) + ':' + timeStr.substring(2, 4);
        }
        
        return '';
    }
    
    // Format time values for HTML time inputs (HH:MM format)
    const timeIn = formatTimeForInput(schedule.time_in);
    const timeOut = formatTimeForInput(schedule.time_out);
    const breakStart = formatTimeForInput(schedule.break_time_start);
    const breakEnd = formatTimeForInput(schedule.break_time_end);
    
    $('#schedule_time_in').val(timeIn);
    $('#schedule_time_out').val(timeOut);
    $('#schedule_break_start').val(breakStart);
    $('#schedule_break_end').val(breakEnd);
    $('#schedule_overnight').prop('checked', schedule.overnight == 1);
    
    // Set color dropdown if custom_color exists
    if (schedule.custom_color) {
        $('#schedule_color').val(schedule.custom_color);
    } else {
        $('#schedule_color').val('');
    }
    
    // Handle DAY OFF checkbox
    const isDayOff = (timeIn === '00:00' && timeOut === '00:00') || 
                     (schedule.description && schedule.description.toLowerCase().includes('day off'));
    $('#schedule_is_dayoff').prop('checked', isDayOff);
    
    if (isDayOff) {
        $('#schedule_time_in').prop('disabled', true);
        $('#schedule_time_out').prop('disabled', true);
        $('#schedule_time_in').closest('.form-group').addClass('bg-light');
        $('#schedule_time_out').closest('.form-group').addClass('bg-light');
    }
    
    // Store the schedule ID for update
    $('#scheduleTypeForm').data('edit-id', schedule.id);
}

