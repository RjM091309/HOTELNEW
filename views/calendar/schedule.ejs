// Helper function to format time values
function formatTimeForDisplay(timeValue) {
    if (!timeValue) return '-';
    
    // If it's already in HH:MM format, return as is
    if (typeof timeValue === 'string' && timeValue.match(/^\d{2}:\d{2}$/)) {
        return timeValue;
    }
    
    // Format time to 12-hour format (same as approve_ob.js)
    return formatTimeTo12Hour(timeValue);
}

// Format time to 12-hour format (from approve_ob.js)
function formatTimeTo12Hour(timeStr) {
    if (!timeStr) return '';
    let date;
    if (/^\d{2}:\d{2}/.test(timeStr)) {
      date = new Date(`1970-01-01T${timeStr}Z`); // Add Z to force UTC
      var hour = date.getUTCHours();
      var minute = date.getUTCMinutes();
    } else {
      date = new Date(timeStr);
      var hour = date.getUTCHours();
      var minute = date.getUTCMinutes();
    }
    const ampm = hour >= 12 ? 'PM' : 'AM';
    let displayHour = hour % 12;
    if (displayHour === 0) displayHour = 12;
    minute = minute.toString().padStart(2, '0');
    const formatted = `${displayHour.toString().padStart(2, '0')}:${minute}${ampm}`;
  
    return formatted;
}

function updateScheduleTypesTableFromData(scheduleTypes) {
    // Check if DataTable is initialized
    if (!$.fn.DataTable.isDataTable('#scheduleTypesTable')) {
        console.error('DataTable not initialized for scheduleTypesTable');
        return;
    }
    
    const dataTable = $('#scheduleTypesTable').DataTable();
    dataTable.clear();

    if (scheduleTypes && scheduleTypes.length > 0) {
        const allRows = [];
        
        scheduleTypes.forEach(schedule => {
            // Format time values for display
            const timeIn = formatTimeForDisplay(schedule.time_in);
            const timeOut = formatTimeForDisplay(schedule.time_out);
            
            const breakTime = schedule.break_time_start && schedule.break_time_end 
                ? `${formatTimeForDisplay(schedule.break_time_start)} - ${formatTimeForDisplay(schedule.break_time_end)}`
                : 'No break';
                
            const overnight = schedule.overnight == 1 ? 'Yes' : 'No';
            const status = schedule.status == 1 ? '<span class="bg-success-focus text-success-main px-16 py-4 rounded-pill fw-medium text-xs">Active</span>' : '<span class="bg-danger-focus text-danger-main px-16 py-4 rounded-pill fw-medium text-xs">Inactive</span>';
            
            const actions = `
                ${schedule.status == 1 ? 
                    `<button type="button" class="w-32-px h-32-px bg-info-focus text-info-main d-inline-flex align-items-center justify-content-center js-bs-tooltip-enabled edit-schedule-type-btn" data-schedule-id="${schedule.id}" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="Edit" data-bs-original-title="Edit">
                        <iconify-icon icon="mingcute:edit-line" class="text-md"></iconify-icon>
                    </button>` : ''
                }
                ${schedule.status == 0 ? 
                    `<button type="button" class="w-32-px h-32-px bg-success-focus text-success-main d-inline-flex align-items-center justify-content-center js-bs-tooltip-enabled reactivate-schedule-type-btn" data-schedule-id="${schedule.id}" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="Reactivate" data-bs-original-title="Reactivate">
                        <iconify-icon icon="mdi:refresh" class="text-md"></iconify-icon>
                    </button>` : 
                    `<button type="button" class="w-32-px h-32-px bg-danger-focus text-danger-main d-inline-flex align-items-center justify-content-center js-bs-tooltip-enabled delete-schedule-type-btn" data-schedule-id="${schedule.id}" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="Delete" data-bs-original-title="Delete">
                        <iconify-icon icon="fluent:delete-24-regular" class="text-md"></iconify-icon>
                    </button>`
                }
            `;
            
            allRows.push([
                schedule.description,
                timeIn,
                timeOut,
                breakTime,
                overnight,
                status,
                actions
            ]);
        });
        
        // Batch add all rows at once
        dataTable.rows.add(allRows).draw();
    } else {
        dataTable.row.add(['No data available', '', '', '', '', '', '']).draw();
    }
}



