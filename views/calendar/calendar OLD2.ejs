<link rel="stylesheet" href="/css/calendar.css">
<script src="/js/calendar/calendar_booking_data.js"></script>
<script src="/js/calendar/calendar_room_data.js"></script>
<script src="/js/calendar/calendar_data.js"></script>

<div class="calendar-container">
  <!-- Top Navigation Bar -->
  <div class="calendar-nav">
    <div class="nav-left">
      <div class="date-range-selector">
        <div class="nav-arrow">‹</div>
        <div class="current-range">8 Aug - 14 Sep</div>
        <div class="nav-arrow">›</div>
      </div>
      
      <div class="year-selector">
        <div class="nav-arrow">‹</div>
        <div class="current-range">2025</div>
        <div class="nav-arrow">›</div>
      </div>
      
      <button class="today-btn">today</button>
      
      <div class="month-nav">
        <div class="month-btn">Jan</div>
        <div class="month-btn">Feb</div>
        <div class="month-btn">Mar</div>
        <div class="month-btn">Apr</div>
        <div class="month-btn">May</div>
        <div class="month-btn">Jun</div>
        <div class="month-btn">Jul</div>
        <div class="month-btn">Aug</div>
        <div class="month-btn">Sep</div>
        <div class="month-btn">Oct</div>
        <div class="month-btn">Nov</div>
        <div class="month-btn">Dec</div>
      </div>
    </div>
    
    <div class="nav-right">
      <div class="nav-icon"><i class="fa-solid fa-calendar-days"></i></div>
      <div class="nav-icon"><i class="fa-solid fa-print"></i></div>
    </div>
  </div>

  <!-- Main Calendar -->
  <div class="calendar-main">
    <!-- Calendar Grid -->
    <div class="calendar-grid">
      <!-- Combined Header Row -->
      <div class="header-row">
        <!-- Room List Header -->
        <div class="room-list-header">
          
          <span>Rooms</span>
        </div>
        
        <!-- Date Header -->
        <div class="date-header">
          <!-- Dynamic content will be generated by JavaScript -->
        </div>
        </div>
        
      <!-- Combined Room and Grid Container -->
      <div class="room-grid-container">
        <!-- Dynamic room items and grid rows will be generated by JavaScript -->
      </div>
    </div>
  </div>
</div>
