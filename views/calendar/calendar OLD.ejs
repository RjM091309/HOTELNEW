	// 2. Function para i-toggle ang fullscreen + i-update size ng calendar
	function toggleFullScreen() {
	  var calendarContainer = document.getElementById('calendar');
  
	  // Kung wala pa sa fullscreen
	  if (!document.fullscreenElement) {
		// requestFullscreen ay nagre-return ng Promise (modern browsers)
		calendarContainer.requestFullscreen()
		  .then(() => {
			// Pagkatapos pumasok sa fullscreen, i-update layout
			calendar.updateSize();
		  })
		  .catch(err => console.error("Fullscreen error:", err));
	  } else {
		// Kung naka-fullscreen na, i-exit
		document.exitFullscreen()
		  .then(() => {
			// Pagkatapos lumabas sa fullscreen, i-update ulit layout
			calendar.updateSize();
		  })
		  .catch(err => console.error("Exit fullscreen error:", err));
	  }
	}

	function globalOverlapCheck(calendar) {
	const allEvents = calendar.getEvents();

	allEvents.forEach(event => {
	  let assignedResources = event.getResources();
	  let assignedResourceId = assignedResources.length && assignedResources[0] ? assignedResources[0].id : undefined;

	  let eventStartDate = new Date(event.start).toISOString().split('T')[0];
	  let eventEndDate   = new Date(event.end).toISOString().split('T')[0];

	  let sameRoomEvents = allEvents.filter(e => {
		let eResources = e.getResources();
		let eResourceId = eResources.length && eResources[0] ? eResources[0].id : undefined;
		return String(assignedResourceId) === String(eResourceId) && event.id !== e.id;
	  });

	  let overlappingEvents = sameRoomEvents.filter(e => {
		let eStartDate = new Date(e.start).toISOString().split('T')[0];
		let eEndDate   = new Date(e.end).toISOString().split('T')[0];
		return (eventStartDate <= eEndDate && eventEndDate >= eStartDate);
	  });

	  // I-access ang naka-store na DOM element para sa event na ito
	  let el = window.eventElements[event.id];
	  if (el) {
		if (overlappingEvents.length > 0) {
		  el.classList.add("overlapping-event");
		} else {
		  el.classList.remove("overlapping-event");
		}
	  }
	});
  }

  
