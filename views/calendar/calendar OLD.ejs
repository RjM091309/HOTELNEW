// Function to extract date from clicked cell
function getDateFromCell(cellElement) {
    if (!cellElement) return null;
    
    // Method 1: Check aria-label attribute
    const ariaLabel = cellElement.getAttribute('aria-label');
    if (ariaLabel) {
        const dateMatch = ariaLabel.match(/(\w+)\s+(\d+),\s+(\d+)/);
        if (dateMatch) {
            const [_, month, day, year] = dateMatch;
            const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                'July', 'August', 'September', 'October', 'November', 'December'];
            const monthIndex = monthNames.indexOf(month);
            if (monthIndex !== -1) {
                return new Date(year, monthIndex, parseInt(day));
            }
        }
    }

    // Method 2: Check data-date attribute
    const dataDate = cellElement.getAttribute('data-date');
    if (dataDate) {
        return new Date(dataDate);
    }

    // Method 3: For timeline views, check the slot's date
    const slotDate = cellElement.getAttribute('data-date');
    if (slotDate) {
        return new Date(slotDate);
    }

    // Method 4: Try to find date in child elements
    const dateElements = cellElement.querySelectorAll('[data-date]');
    for (let element of dateElements) {
        const date = element.getAttribute('data-date');
        if (date) {
            return new Date(date);
        }
    }

    // Method 5: Check for timeline slot date in the DOM structure
    const timelineSlot = cellElement.closest('.fc-timeline-slot');
    if (timelineSlot) {
        const slotDate = timelineSlot.getAttribute('data-date');
        if (slotDate) {
            return new Date(slotDate);
        }
    }

    console.log('🔍 Debug - cell element:', cellElement);
    console.log('🔍 Debug - cell attributes:', cellElement.attributes);
    console.log('🔍 Debug - cell classes:', cellElement.className);
    
    return null;
}

