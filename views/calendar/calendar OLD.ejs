								  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
								  
								  <!-- JavaScript Functions for Booking Details and Extra Services -->
							<script>
								// When any room modal is shown, load its services and booking details.
								$(document).ready(function () {
								$('.room-modal').on('shown.bs.modal', function () {
									var roomId = $(this).data('room-id');
									// Initialize the added services for this room if not already set.
									if (!addedServicesMap[roomId]) {
									addedServicesMap[roomId] = [];
									var bookingId = $('#bookingID-' + roomId).val(); // Ensure bookingId is correctly fetched
									}
									getServices(roomId);
									loadGuestDetails(roomId);
									loadBookingDetails(roomId);
									calculateTotalCost(roomId);
									calculateBalance(roomId, bookingId);  // 🔹 Add this line
									
								});
								});

								// Object to hold added services per room.
								let addedServicesMap = {};

								// ------------------------------------------------------------------
								// 1. Load Dropdown Options for Extra Services
								// ------------------------------------------------------------------
								function getServices(roomId) {
								$.ajax({
									url: '/booking/extra_service_dropdown',
									method: 'GET',
									dataType: 'json',
									success: function (services) {
									const serviceSelect = $('#extra-service-select-' + roomId);
									serviceSelect.empty();
									serviceSelect.append('<option value="" selected disabled>Select a service</option>');
									if (services.length === 0) {
										serviceSelect.append('<option value="" disabled>No services available</option>');
									} else {
										services.forEach(service => {
										const option = `<option value='${JSON.stringify({
											SERVICE_ID: service.IDNo,
											SERVICE_NAME: service.SERVICE_NAME,
											SERVICE_COST: service.SERVICE_COST
										})}'>${service.SERVICE_NAME}</option>`;
										serviceSelect.append(option);
										});
									}
									},
									error: function (xhr, status, error) {
									console.error('Error fetching services:', error);
									Swal.fire({
										icon: 'error',
										title: 'Hindi ma-load ang mga serbisyo. Subukan ulit.'
									});
									}
								});
								}

								// ------------------------------------------------------------------
								// 2. Add a Service to the Booking (for a specific room)
								// ------------------------------------------------------------------
								function addService(roomId) {
								const serviceSelect = $('#extra-service-select-' + roomId);
								const selectedService = serviceSelect.val();
								const quantityInput = $('#service-quantity-' + roomId).val();
								const bookingId = $('#bookingID-' + roomId).val();
								
								if (selectedService) {
									const service = JSON.parse(selectedService);
									const quantity = parseInt(quantityInput, 10);
								
									let roomServices = addedServicesMap[roomId];
									const existingUnpaid = roomServices.find(s => s.SERVICE_ID === service.SERVICE_ID && s.STATUS !== 'paid');

									// Convert SERVICE_COST to number using parseFloat.
									const serviceCost = parseFloat(service.SERVICE_COST);
									if (existingUnpaid) {
										existingUnpaid.QUANTITY += quantity;
										existingUnpaid.SERVICE_COST = serviceCost;
										} else {
										roomServices.push({
											SERVICE_ID: service.SERVICE_ID,
											SERVICE_NAME: service.SERVICE_NAME,
											SERVICE_COST: serviceCost,
											QUANTITY: quantity,
											STATUS: "unpaid"
										});
										}
									// Save the updated services to the backend.
									saveServices(bookingId, roomId);
								
									// Refresh the list and recalc totals.
									updateAddedServicesList(roomId);
									calculateTotalCost(roomId);
									calculateBalance(roomId, bookingId);  // 🔹 Add this line

									// Reset the dropdown and quantity.
									serviceSelect.val('');
									$('#service-quantity-' + roomId).val('1');
									
									// Ipakita ang success message gamit ang SweetAlert2 na may OK button sa center.
									Swal.fire({
									icon: 'success',
									title: 'Service added successfully!',
									confirmButtonText: 'OK'
									});
								} else {
									Swal.fire({
									icon: 'warning',
									title: 'Please select a service before adding!',
									confirmButtonText: 'OK'
									});
								}
								}


								// ------------------------------------------------------------------
								// 3. Save Services to the Backend
								// ------------------------------------------------------------------
								function saveServices(bookingId, roomId) {
									let roomServices = addedServicesMap[roomId];

									if (!roomServices || roomServices.length === 0) {
										Swal.fire({
										icon: 'warning',
										title: 'No services added to save!'
										});
										return;
									}

									// ✅ Group services by SERVICE_ID and STATUS to avoid duplication
									const serviceMap = new Map();

									const ignoredServiceIds = [-999, -101, -102];

									roomServices.forEach(service => {
									if (service.STATUS === 'paid') return;
									if (ignoredServiceIds.includes(parseInt(service.SERVICE_ID))) return;

									const key = `${service.SERVICE_ID}-${service.STATUS}`;
									const cost = service.SERVICE_COST;

									if (!serviceMap.has(key)) {
										serviceMap.set(key, {
										SERVICE_ID: service.SERVICE_ID,
										QUANTITY: service.QUANTITY,
										TOTAL_COST: cost * service.QUANTITY
										});
									} else {
										const existing = serviceMap.get(key);
										existing.QUANTITY += service.QUANTITY;
										existing.TOTAL_COST += cost * service.QUANTITY;
										serviceMap.set(key, existing);
									}
									});


									const servicesData = Array.from(serviceMap.values());

									// ✅ If no unpaid services to save, skip saving
									if (servicesData.length === 0) {
										Swal.fire({
										icon: 'info',
										title: 'No new unpaid services to save.'
										});
										return;
									}

									// 🔁 Proceed with saving
									$.ajax({
										url: '/booking/save-booking-services',
										method: 'POST',
										contentType: 'application/json',
										data: JSON.stringify({
										bookingId: bookingId,
										services: servicesData
										}),
										success: function (response) {
										// Optional: confirm or reload if needed
										console.log('✅ Services saved:', response);
										},
										error: function (xhr, status, error) {
										console.error('Error saving services:', error);
										Swal.fire({
											icon: 'error',
											title: 'Failed to save services. Please try again.'
										});
										}
									});
									}


								// ------------------------------------------------------------------
								// 4. Load Previously Added Guest Services (if any)
								// ------------------------------------------------------------------
								function loadGuestDetails(roomId) {
									const bookingId = $('#bookingID-' + roomId).val();
									if (!bookingId) {
										console.error('Booking ID is missing.');
										return;
									}

									$.ajax({
										url: `/booking/get-booking-services/${bookingId}`,
										method: 'GET',
										dataType: 'json',
										success: function (services) {
											if (!addedServicesMap[roomId]) {
												addedServicesMap[roomId] = [];
											}
											let roomServices = addedServicesMap[roomId];
											roomServices.length = 0; // Clear old items before pushing fresh data

											services.forEach(service => {
												roomServices.push({
													SERVICE_ID: service.SERVICE_ID,
													SERVICE_NAME: service.SERVICE_NAME,
													SERVICE_COST: parseFloat(service.TOTAL_COST) / service.QTY,
													QUANTITY: service.QTY,
													STATUS: service.STATUS
												});
											});

											updateAddedServicesList(roomId);
										},
										error: function (xhr, status, error) {
											console.error('Error fetching saved services:', error);
											Swal.fire({
												icon: 'error',
												title: 'Failed to load saved services. Please try again.'
											});
										}
									});
								}

								// ------------------------------------------------------------------
								// 5. Update the Added Services List
								// ------------------------------------------------------------------
								function updateAddedServicesList(roomId) {
								const serviceList = $('#added-services-list-' + roomId);
								serviceList.empty();

								let roomServices = addedServicesMap[roomId] || [];
								if (roomServices.length === 0) {
									serviceList.hide();
								} else {
									serviceList.show();
									const headerRow = `
									<li class="list-group-item d-flex justify-content-between align-items-center text-center">
										<span style="flex: 1;"><strong>Service Name</strong></span>
										<span style="flex: 1;"><strong>Quantity</strong></span>
										<span style="flex: 1;"><strong>Total Cost</strong></span>
										<span style="flex: 1;"><strong>Action</strong></span>
									</li>`;
									serviceList.append(headerRow);

									roomServices.forEach((service, index) => {
									// Compute total cost (Ensure SERVICE_COST and QUANTITY are numbers)
									const totalCost = Number(service.SERVICE_COST) * Number(service.QUANTITY);
									// Format total cost with comma separator and 2 decimal places
									const costDisplay = totalCost === 0
										? '<span class="badge bg-success">FREE</span>'
										: `₱${totalCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
									 // **Ensure STATUS conditionally changes the button or badge**
									 let statusDisplay;
										if (service.STATUS === 'unpaid') {
											// statusDisplay = `<button class="status-btn" onclick="updateServiceStatus('${roomId}', '${service.SERVICE_ID}', this)">Unpaid</button>`;
											statusDisplay = `<span class="badge bg-warning">${service.STATUS}</span>`;
										} else if (service.STATUS === 'paid') {
											statusDisplay = `<span class="badge bg-success">${service.STATUS}</span>`;
										} else {
											statusDisplay = `<span class="badge bg-secondary">${service.STATUS}</span>`; // Default for unknown status
										}
									
										const isDeletable = service.STATUS !== 'paid';

										const deleteButton = isDeletable
										? `<button 
												class="btn-sm btn-alt-danger" 
												onclick="removeService(${index}, '${roomId}')"
												title="Remove Order">
												<i class="fa fa-trash-alt"></i>
											</button>`
										: `<button 
												class="btn-sm btn-secondary" 
												disabled 
												title="Paid item cannot be removed">
												<i class="fa fa-trash-alt"></i>
											</button>`;

										const listItem = `
										<li class="list-group-item d-flex justify-content-between align-items-center text-center">
											<td>
											<span style="flex: 1;">${service.SERVICE_NAME}</span>
											${statusDisplay}
											</td>
											<span style="flex: 1;">${service.QUANTITY}</span>
											<span style="flex: 1;">${costDisplay}</span>
											<span style="flex: 1;">
											${deleteButton}
											</span>
										</li>`;

									serviceList.append(listItem);
									});
								}
								
								// Tawagin ang calculateTotalCost para siguradong updated agad ang grand total
								calculateTotalCost(roomId);
								const bookingId = $('#bookingID-' + roomId).val();
								calculateBalance(roomId, bookingId);  // 🔹 Add this line
								}

								function updateServiceStatus(roomId, serviceId, button) {
									Swal.fire({
										title: "Are you sure?",
										text: "You are about to mark this service as PAID.",
										icon: "warning",
