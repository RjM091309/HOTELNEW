								// ------------------------------------------------------------------
								// 6. Remove a Service from the List
								// ------------------------------------------------------------------
								function removeService(index, roomId) {
								let roomServices = addedServicesMap[roomId];
								const serviceToRemove = roomServices[index];
								if (!serviceToRemove || !serviceToRemove.SERVICE_ID) {
									Swal.fire({
									icon: 'warning',
									title: 'Service not found.',
									confirmButtonText: 'OK'
									});
									return;
								}
								
								// Ipakita ang confirmation prompt
								Swal.fire({
									title: 'Are you sure?',
									text: "Are you sure to remove this service?",
									icon: 'warning',
									showCancelButton: true,
									confirmButtonText: 'Yes, remove it!',
									cancelButtonText: 'Cancel'
								}).then((result) => {
									if (result.isConfirmed) {
									const bookingId = $('#bookingID-' + roomId).val();
									// 🔍 Identify if it's an extension or transport
									const isExtension = serviceToRemove.SERVICE_NAME === 'Extended Day' || serviceToRemove.SERVICE_ID === -999;
									const isTransport = serviceToRemove.SERVICE_ID === -101 || serviceToRemove.SERVICE_ID === -102;
									
									$.ajax({
										url: '/booking/remove-service',
										method: 'POST',
										contentType: 'application/json',
										data: JSON.stringify({
										bookingId: bookingId,
										serviceId: serviceToRemove.SERVICE_ID,
										isExtension: isExtension,
										isTransport: isTransport
										}),
										success: function (response) {
										// console.log('Service removed successfully:', response);
										roomServices.splice(index, 1);
										updateAddedServicesList(roomId);
										calculateTotalCost(roomId);
										calculateBalance(roomId, bookingId);  // 🔹 Add this line
										Swal.fire({
