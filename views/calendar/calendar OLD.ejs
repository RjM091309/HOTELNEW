}

.custom-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #ccc;
    transition: 0.4s;
    border-radius: 20px; /* Adjusted for a more compact rounded look */
}

/* Inner Circle */
.custom-slider:before {
    position: absolute;
    content: '';
    height: 12px; /* Adjusted size for inner circle */
    width: 12px; /* Adjusted size for inner circle */
    left: 1.5px; /* Adjusted position to match new dimensions */
    bottom: 1.5px; /* Adjusted position to match new dimensions */
    background-color: white;
    transition: 0.4s;
    border-radius: 50%;
}

/* Checked Styles for IN */
.custom-switch.input-in input:checked + .custom-slider {
    background-color: #4caf50; /* Green for IN */
}

.custom-switch.input-in input:checked + .custom-slider:before {
    transform: translateX(15px); /* Adjusted translation for smaller width */
}

.custom-switch.input-in input:checked + .custom-slider:after {
    content: 'IN'; /* Show IN */
    position: absolute;
    color: white;
    font-size: 10px; /* Adjusted font size to fit smaller toggle */
    top: 50%;
    left: 9px; /* Adjusted position for smaller size */
    transform: translate(-50%, -50%);
    opacity: 1; /* Show text */
    transition: 0.4s;
}

/* Default Styles for OUT */
.custom-switch.input-out input:checked+ .custom-slider {
    background-color: red; /* Red for OUT */
}

