  <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>

  <script>
	document.addEventListener("DOMContentLoaded", function () {
    var tabBar = document.querySelector("#tabBar");
    var tabs = tabBar.querySelectorAll(".mdl-tabs__tab");
    var activeTabKey = "activeTab"; // Local storage key

    function getUserId() {
        let userId = document.body.dataset.userId;
        if (!userId || userId === "") {
            console.warn("⚠️ No user ID found in <body>, but stopping reload to prevent loop.");
            return null;
        }
        return userId;
    }

    function showTabContent(target) {
        // Hide all tab contents
        document.querySelectorAll(".tab-content").forEach(content => {
            content.style.display = "none"; // Ensure all contents are hidden first
        });

        // Show the active tab content
        let activeContent = document.getElementById(target);
        if (activeContent) {
            activeContent.style.display = "block";
        }
    }

    function setActiveTab(target) {
        tabs.forEach(tab => tab.classList.remove("is-active"));
        let selectedTab = tabBar.querySelector(`[data-target="${target}"]`);
        if (selectedTab) {
            selectedTab.classList.add("is-active");
            localStorage.setItem(activeTabKey, target); // Save active tab in local storage
            showTabContent(target); // Ensure correct tab content is shown
        }
    }

    function restoreActiveTab() {
        let savedTab = localStorage.getItem(activeTabKey);
        if (savedTab && tabBar.querySelector(`[data-target="${savedTab}"]`)) {
            setActiveTab(savedTab);
        } else {
            // Set first tab active if no saved tab found
            let firstTab = tabs[0];
            if (firstTab) {
                let firstTabTarget = firstTab.getAttribute("data-target");
                setActiveTab(firstTabTarget);
            }
        }
    }

    // Ensure clicking a tab switches content
    tabs.forEach(tab => {
        tab.addEventListener("click", function () {
            setActiveTab(this.getAttribute("data-target"));
        });
    });

    restoreActiveTab(); // Restore active tab and ensure correct content is visible

    function saveTabOrder() {
        let userId = getUserId();
        if (!userId) {
            console.warn("❌ No user ID found, cannot save tab order");
            return;
        }

        let tabs = Array.from(tabBar.children).map(tab => tab.getAttribute("data-target"));

        console.log("🔹 User dragged and saved tab order:", tabs);

        fetch('/auth/save-tab-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId, tabOrder: tabs })
        }).then(response => response.json())
        .then(data => console.log("✅ Tab order saved:", data))
        .catch(error => console.error('❌ Error saving tab order:', error));
    }

    function loadTabOrder() {
        let userId = getUserId();
        if (!userId) {
            console.warn("❌ No user ID found, cannot load tab order");
            return;
        }

        fetch(`/auth/get-tab-order?userId=${userId}`)
            .then(response => response.json())
            .then(data => {
                console.log("📥 Retrieved tab order from DB:", data);

                if (data.tabOrder && data.tabOrder.length > 0) {  
                    let savedOrder = data.tabOrder;
                    let currentTabs = Array.from(tabBar.children);

                    console.log("🔹 Applying tab order:", savedOrder);

                    savedOrder.forEach(target => {
                        let tab = currentTabs.find(tab => tab.getAttribute("data-target") === target);
                        if (tab) tabBar.appendChild(tab);
                    });

                    // Restore the active tab after reordering
                    restoreActiveTab();
                } else {
                    console.log("⚠️ No saved tab order found in DB, using default order.");
                }
            })
            .catch(error => console.error('❌ Error loading tab order:', error));
    }

    // Load the user's tab order
    loadTabOrder();

    // Enable drag sorting
    new Sortable(tabBar, {
        animation: 250,
        swapThreshold: 0.5,
        chosenClass: "sortable-chosen",
        dragClass: "sortable-drag",
        easing: "cubic-bezier(0.25, 1, 0.5, 1)",
        forceFallback: true,
        fallbackOnBody: true,
        removeCloneOnHide: true,
        ghostClass: "sortable-ghost",
        fallbackTolerance: 3,
        fallbackOffset: { x: -10, y: -10 },
        onEnd: function () {
            console.log("🔄 Tab drag ended, saving order...");
            saveTabOrder();
        }
    });
});

	







