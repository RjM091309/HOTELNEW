	content: 'OUT'; /* Show IN */
    position: absolute;
    color: white;
    font-size: 8px; /* Adjusted font size to fit smaller toggle */
    top: 50%;
    left: 9px; /* Adjusted position for smaller size */
    transform: translate(-50%, -50%);
    opacity: 1; /* Show text */
    transition: 0.4s;
}

.custom-switch.input-out input:checked + .custom-slider:before {
    transform: translateX(15px); /* Adjusted translation for smaller width */
}

/* Cleaning Toggle Styles */
.custom-switch.input-cleaning input:checked + .custom-slider {
    background-color: #4caf50; /* Green for CHECK */
}

.custom-switch.input-cleaning input:checked + .custom-slider:before {
    transform: translateX(15px); /* Adjusted translation for smaller width */
}

.custom-switch.input-cleaning input:checked + .custom-slider:after {
    content: '✔'; /* Checkmark symbol */
    position: absolute;
    color: white;
    font-size: 10px; /* Adjusted font size */
    top: 50%;
    left: 35%;
    transform: translate(-50%, -50%);
    opacity: 1; /* Show text */
    transition: 0.4s;
}

