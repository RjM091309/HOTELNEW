    const clickSelector = '.fc-daygrid-day, .fc-timeline-slot-cushion, .fc-timeline-slot';

    $(calendarEl).on('click.scrollToDate', clickSelector, function (e) {
        // Stop event propagation to prevent conflicts
        e.stopPropagation();
        
        let cell = this;
        
        // For timeline views, try to get the closest timeline slot
        if ($(this).hasClass('fc-timeline-slot-cushion')) {
            cell = $(this).closest('.fc-timeline-slot').get(0);
        } else if ($(this).hasClass('fc-timeline-slot')) {
            cell = this;
        }

        let clickedDate = getDateFromCell(cell);
        
        // Fallback: If we can't extract date from DOM, try to get it from calendar API
        if (!clickedDate && calendar) {
            const currentView = calendar.view.type;
            if (currentView === 'resourceTimeline') {
                // For resourceTimeline, try to get the date from the clicked position
                const rect = cell.getBoundingClientRect();
                const calendarRect = calendarEl.getBoundingClientRect();
                const relativeX = rect.left - calendarRect.left;
                
                // Estimate the date based on the position
                const viewData = calendar.view.getCurrentData();
                const startDate = viewData.dateProfile.currentRange.start;
                const endDate = viewData.dateProfile.currentRange.end;
                const totalDays = (endDate - startDate) / (1000 * 60 * 60 * 24);
                const dayWidth = calendarEl.offsetWidth / totalDays;
                const daysFromStart = Math.floor(relativeX / dayWidth);
                
                clickedDate = new Date(startDate);
                clickedDate.setDate(startDate.getDate() + daysFromStart);
                
                console.log(`📊 Fallback: Estimated date from position: ${clickedDate.toDateString()}`);
            }
        }
        
        if (clickedDate) {
            console.log(`🖱️ Clicked on date: ${clickedDate.toDateString()}`);
            scrollToDate(clickedDate);
        } else {
            console.log('❌ Could not extract date from clicked element:', cell);
        }
    });
}

setupScrollOnClick();

