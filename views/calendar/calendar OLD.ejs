													text: "Could not update payment status. Please try again.",
												});
											}
										});
									}
								});
							}




								// ------------------------------------------------------------------
								// 8. Calculate the Grand Total (Room Cost + Extra Services)
								// ------------------------------------------------------------------
								// ✅ Function to Calculate Total Cost (Including Late Check-Out Charge When Applicable)
								function calculateTotalCost(roomId) {
								// 📌 1. Fetch & parse total room cost (already includes extension)
								let roomCostText = $('#hidden-total-room-cost-' + roomId).val().trim();
								let roomCost = parseFloat(roomCostText.replace('₱', '').replace(/,/g, '')) || 0;

								// 📌 2. Fetch & parse late checkout charge
								let lateCheckoutChargeText = $('#late-checkout-charge-' + roomId).text().trim();
								let lateCheckoutCharge = (lateCheckoutChargeText !== "Free" && lateCheckoutChargeText !== "")
									? parseFloat(lateCheckoutChargeText.replace('₱', '').replace(/,/g, '')) || 0
									: 0;

								// 📌 3. Compute total extra services cost
								let roomServices = addedServicesMap[roomId] || [];
								let extraServicesCost = roomServices.reduce((sum, service) => {
									// Optional: exclude extended day if needed
									if (service.SERVICE_ID === -999 || service.SERVICE_NAME === 'Extended Day') return sum;
									return sum + (Number(service.SERVICE_COST) * Number(service.QUANTITY));
								}, 0);

								// 📌 4. Compute final grand total
								let grandTotal = roomCost + extraServicesCost + lateCheckoutCharge;

								// 📌 5. Format grand total with currency format
								let formattedGrandTotal = grandTotal.toLocaleString('en-US', {
									minimumFractionDigits: 2,
									maximumFractionDigits: 2
								});

								// 📌 6. Update Grand Total Display
								$('#grand-total-' + roomId).text(`₱${formattedGrandTotal}`);
							}



								function calculateBalance(roomId, bookingId) {
								$.ajax({
									url: `/booking/unpaid_balance/${bookingId}`, 
									method: 'GET',
									dataType: 'json',
									success: function (data) {
										let totalUnpaid = data.total_unpaid_balance || 0;

										console.log(`🔹 Balance for Room ${roomId} (Booking ${bookingId}): ₱${totalUnpaid}`);

										// Format Balance with Comma Separator
										let formattedBalance = totalUnpaid.toLocaleString('en-US', {
											minimumFractionDigits: 2,
											maximumFractionDigits: 2
										});

										// Display Balance in UI
										let balanceElement = totalUnpaid > 0 
											? `<span class="text-danger"><strong>₱${formattedBalance}</strong></span>` 
											: `<span class="text-success"><strong>₱0.00</strong></span>`;

										$(`#Balance-${roomId}`).html(balanceElement);
									},
									error: function (xhr, status, error) {
										console.error('❌ Error fetching balance:', error);
									}
								});
							}

</script>

							


