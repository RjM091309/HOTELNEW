								  <!-- AUTO-REFRESH SCRIPT FOR OCCUPIED -->


 <script>
	let lastUpdatedContent = ''; // Store the last known content to compare with
  
	async function fetchUpdates() {
	  try {
		// Fetch the current page HTML
		const response = await fetch(window.location.href);
		const html = await response.text();
  
		// Parse the HTML
		const parser = new DOMParser();
		const doc = parser.parseFromString(html, "text/html");
  
		// Get the updated occupied content
		const updatedOccupied = doc.querySelector("#occupied-content-wrapper1");
  
		if (updatedOccupied) {
		  // Compare the new content with the last updated content
		  const newContent = updatedOccupied.innerHTML;
  
		  if (newContent !== lastUpdatedContent) {
			// If content is different, update the page and store the new content
			lastUpdatedContent = newContent; // Update the stored content
  
			// Update the "occupied-content-wrapper1"
			const currentOccupied = document.querySelector("#occupied-content-wrapper1");
			currentOccupied.innerHTML = newContent;
  
			// Update device status container if it has changed
			const updatedStatuses = doc.querySelectorAll(".device-status-container");
			const currentStatuses = document.querySelectorAll(".device-status-container");
  
			updatedStatuses.forEach((updated, index) => {
			  if (currentStatuses[index] && updated.innerHTML !== currentStatuses[index].innerHTML) {
				currentStatuses[index].innerHTML = updated.innerHTML;
			  }
			});
		  }
		}
	  } catch (error) {
		console.error("Error updating content:", error);
	  }
	}
  
	// Poll every 10 seconds for updates but only fetch data if content changes
	setInterval(fetchUpdates, 1000); // Interval set to 10 seconds
  </script>

