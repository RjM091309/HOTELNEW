setTimeout(() => {
  // 1) find the real overflowing container
  const scs = Array.from(
    document.querySelectorAll('#calendar .fc-scroller')
  );
  const bodyScroller = scs.find(s => s.scrollWidth > s.clientWidth);
  if (!bodyScroller) return console.warn('No horizontal scroller found');

  // 2) build & insert the top scrollbar
  const top = document.createElement('div');
  top.id = 'top-scroller';
  top.innerHTML = '<div></div>';
  const grid = document.querySelector('#calendar .fc-scrollgrid');
  grid.parentNode.insertBefore(top, grid);

  // 3) size & two-way sync
  const inner = top.firstElementChild;
  inner.style.width    = bodyScroller.scrollWidth + 'px';
  top.scrollLeft       = bodyScroller.scrollLeft;
  top  .addEventListener('scroll',  () => bodyScroller.scrollLeft = top.scrollLeft);
  bodyScroller.addEventListener('scroll', () => top.scrollLeft       = bodyScroller.scrollLeft);

  // 4) hook up the header-update on the *same* bodyScroller
  const toolbarTitle = document.querySelector('.fc-toolbar-title');
  let throttle;
  bodyScroller.addEventListener('scroll', () => {
    clearTimeout(throttle);
    throttle = setTimeout(() => {
      // fraction through the scroll
      const maxScroll = bodyScroller.scrollWidth - bodyScroller.clientWidth;
      const frac      = bodyScroller.scrollLeft / maxScroll;

      // use the view’s activeStart/activeEnd
      const startMs = calendar.view.activeStart.getTime();
      const endMs   = calendar.view.activeEnd.getTime();

      // estimate the “current” date
      const m        = startMs + frac * (endMs - startMs);
      const visible  = new Date(m);

      // format “Month Year”
      toolbarTitle.textContent =
        visible.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    }, 50);
  });
}, 100);




			  
			  
