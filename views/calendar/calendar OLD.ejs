    if (!targetDate || !calendar) return;

    const currentView = calendar.view.type;
    if (currentView === 'resourceTimeline' || currentView === 'month') {
        currentRangeStart = new Date(targetDate);
        currentRangeStart.setHours(0, 0, 0, 0);

        showCalendarLoading();
        fadeOutCalendar(() => {
