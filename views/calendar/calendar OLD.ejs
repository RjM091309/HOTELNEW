<!-- Dashboard -->

<%- include('partials/header') %>

<body data-user-id="<%= typeof userId !== 'undefined' ? userId : '' %>">


  <%- include('partials/sidebar') %>
  <%- include('partials/topbar') %>
  
  <main>
 
    <div class="page-content-wrapper">
      <div class="page-content">
        
       <!-- start widget -->
        <div class="state-overview">
          <div class="row mb-4">
			<div class="col-xl-3 col-md-6 col-8">
			<div class="dashboard-card naranja ">
				<div class="dashboard-card-header bg-blue">
				  <div class="dashboard-card-header-title ">Booking Overview</div>
				  <span class="info-box-icon push-bottom"><i class="material-icons">style</i></span>
				</div>
				<div class="dashboard-card-body">
				  <a class="dashboard-btn-row">
					<span class="dashboard-btn-row-item">Today's Check-in</span>
					<span class="dashboard-btn-row-metric"><%= totalBookingsToday || 0 %></span>
				  </a>
				  <a class="dashboard-btn-row">
					<span class="dashboard-btn-row-item">Checked-in</span>
					<span class="dashboard-btn-row-metric"><%= TODAY_CHECKEDIN %></span>
				  </a>
				  <a class="dashboard-btn-row">
					<span class="dashboard-btn-row-item">Late Check-out/Check-in</span>
					<span class="dashboard-btn-row-metric"><%= LATE_IN_OUT %></span>
				  </a>
				  
			  
				</div>
			  
			  </div>
			</div>


			<div class="col-xl-3 col-md-6 col-8">
				<div class="dashboard-card naranja">
					<div class="dashboard-card-header">
					  <div class="dashboard-card-header-title">Check-out Overview</div>
					  <span class="info-box-icon push-bottom"><i class="material-icons">card_travel</i></span>
					</div>
					<div class="dashboard-card-body">
					  <a class="dashboard-btn-row">
						<span class="dashboard-btn-row-item">Today's Check-out</span>
						<span class="dashboard-btn-row-metric"><%= TODAY_CHECKEDOUT || 0 %></span>
					  </a>
					  <a class="dashboard-btn-row">
						<span class="dashboard-btn-row-item">Late Check-out</span>
						<span class="dashboard-btn-row-metric"><%= LATE_CHECKOUT || 0 %></span>
					  </a>
					  <a class="dashboard-btn-row">
						<span class="dashboard-btn-row-item">Extended</span>
						<span class="dashboard-btn-row-metric"><%= EXTENDED || 0 %></span>
					  </a>
					</div>
				  </div>
				</div>

			<div class="col-xl-3 col-md-6 col-8">
					<div class="dashboard-card naranja">
						<div class="dashboard-card-header">
						  <div class="dashboard-card-header-title">Rooms Overview</div>
						  <span class="info-box-icon push-bottom"><i class="material-icons">local_hotel</i></span>
						</div>
						<div class="dashboard-card-body">
							<a class="dashboard-btn-row1">
								<span class="dashboard-btn-row-item1">Rooms</span>
								<span class="dashboard-btn-row-metric1"><%= totalRooms %></span>
								<span class="dashboard-btn-row-item2">Available</span>
								<span class="dashboard-btn-row-metric2"><%= Number(availableRooms) + Number(OccupiedNotMove)  %></span>
							  </a>
							  <a class="dashboard-btn-row1">
								<span class="dashboard-btn-row-item1">Occupied</span>
								<span class="dashboard-btn-row-metric1"><%= Number(occupiedRooms) - Number(OccupiedNotMove) %></span>
								<span class="dashboard-btn-row-item2">Cleaning</span>
								<span class="dashboard-btn-row-metric2"><%= cleaningRooms %></span>
							  </a>
							  <a class="dashboard-btn-row1">
								<span class="dashboard-btn-row-item1">Under Maintenance</span>
								<span class="dashboard-btn-row-metric2"><%= underMaintenanceRooms %></span>
							  </a>
							  
						</div>
					  
					  </div>
					</div>
<style>

	/* Fix Swal being hidden behind modals */
.swal2-container {
  z-index: 99999 !important;
}
.modal-backdrop {
  z-index: 1040 !important;
}
.modal {
  z-index: 1050 !important;
}
.dashboard-btn-row1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 35px;
  color: #0000008a;
  border-bottom: 1px solid #eaeaec;
  position: relative; /* Needed for ::after positioning */
  cursor: pointer; /* Pointer to indicate interactivity */
  transition: color 0.3s ease-in-out; /* Smooth color transition */
}

.dashboard-btn-row1::after {
  content: ""; /* Create pseudo-element */
  position: absolute;
  bottom: -1px; /* Position under the row */
  left: 0;
  width: 0; /* Start with no width */
  height: 2px; /* Height of the underline */
  background-color: #3598dc; /* Blue underline */
  transition: width 0.7s ease-in-out; /* Animation transition */
}

.dashboard-btn-row1:hover {
  color: #070007; /* Darker text on hover */
}

.dashboard-btn-row1:hover::after {
  width: 100%; /* Expand the underline to full width */
}

.dashboard-btn-row-item1 {
  flex: 1; /* Left-side content */
  text-align: left;
  padding-left: 5px;
}

.dashboard-btn-row-metric1 {
  flex: 0 0 50px; /* Fixed width for left-side numbers */
  text-align: left;
  font-weight: 700;
  padding-left: 5px;
}

.dashboard-btn-row-item2 {
  flex: 1; /* Right-side content */
  text-align: right;
  padding-right: 5px;
}

.dashboard-btn-row-metric2 {
  flex: 0 0 50px; /* Fixed width for right-side numbers */
  text-align: right;
  font-weight: 700;
  padding-right: 5px;
}


</style>

					<div class="col-xl-3 col-md-6 col-8">
						<div class="dashboard-card naranja">
							<div class="dashboard-card-header">
								
							<div class="dashboard-card-header-title">Monthly Booking Overview</div>
							<span class="info-box-icon push-bottom"><i class="material-icons">date_range</i></span>
							</div>
							<div class="dashboard-card-body">
							  <a class="dashboard-btn-row">
								<span class="dashboard-btn-row-item">Monthly Booking</span>
								<span class="dashboard-btn-row-metric"><%= totalBookingsMonthly %></span>
							  </a>
							  <a class="dashboard-btn-row">
								<span class="dashboard-btn-row-item">Completed</span>
								<span class="dashboard-btn-row-metric"><%= completedBookingsMonthly || 0 %></span>
							  </a>
							  <a class="dashboard-btn-row">
								<span class="dashboard-btn-row-item">Pending</span>
								<span class="dashboard-btn-row-metric"><%= pendingBookingsMonthly || 0 %></span>
							  </a>
							</div>
						  </div>
						</div>
					</div>
        		</div>
        <!-- end widget -->
         <!-- LATEST BOOKING -->
		<div class="dashboard-btn-row-item ">
			<div class="col-md-12 " >
				<div class="card mb-4">
					<div class="card-head" style="display: flex; justify-content: space-between; align-items: center;">
						<!-- Left Section: Latest Booking -->
						<div style="flex-grow: 1;">
							<header>Latest Booking</header>
						</div>
					
						<!-- Right Section: Filter and Tools -->
						<div style="display: flex; align-items: center; gap: 0px;">
						
							<span style="font-size: 14px; margin-right: 10px; cursor: pointer; margin-top: 5px;" id="moveToOccupiedBtn">
								Move to Occupied
							  </span>

							<span style="font-size: 14px; margin-right: 10px; cursor: pointer; margin-top: 5px;" id="sort-button">
								Sort
							  </span>
						 <!-- Newest (Clickable Link) -->
							<span style="font-size: 14px; margin-right: 10px; cursor: pointer;  margin-top: 5px;" id="filter-newest">
								Newest Booking
							</span>
						 <!-- All Floors (Clickable Link) -->
							<span style="font-size: 14px; margin-right: 10px; cursor: pointer; margin-top: 5px;" id="filter-all">
								All Floors
							</span>

							<!-- Filter by Floor -->
							 
							<div style="display: flex; align-items: center;">
								<select id="floor-filter" class="form-control" style="width: 85px; font-size: 12px; padding: 2px 5px; margin-right: 1px; margin-top: 5px;">
									<option value="" disabled selected>Select Floor</option>
									<% floors.forEach(floor => { %>
										<option value="<%= floor.floor %>">
											<% if (floor.floor === 1) { %>1st<% } %>
											<% if (floor.floor === 2) { %>2nd<% } %>
											<% if (floor.floor === 3) { %>3rd<% } %>
											<% if (floor.floor === 4) { %>4th<% } %>
											<% if (floor.floor === 5) { %>5th<% } %>
											<% if (floor.floor === 6) { %>6th<% } %>
											<% if (floor.floor === 7) { %>7th<% } %>
											<% if (floor.floor === 8) { %>8th<% } %>
											<% if (floor.floor === 9) { %>9th<% } %>
											<% if (floor.floor === 10) { %>10th<% } %>
										</option>
									<% }); %>
								</select>
							</div>
					
							<!-- Tools -->
							<div class="tools">
								<a class="fa fa-repeat btn-color box-refresh" href="javascript:;"></a>
								<a class="t-close btn-color fa fa-times" href="javascript:;"></a>
							</div>
						</div>
					</div>
					
					<div class="card-body">
						<!-- Tab Panel -->
						 <div>
							<div class="mdl-tabs mdl-js-tabs">
								<div class="mdl-tabs__tab-bar tab-left-side" id="tabBar">
									<% 
									let defaultTabs = [
										{ name: "Today Check-in", target: "checked-in-content" },
										{ name: "LCO/LCI", target: "late-in-out-content" },
										{ name: "Today Check-out", target: "checkout-content" },
										{ name: "Extended", target: "extended-content" },
										{ name: "Late Check-out", target: "late-checkout-content" },
										{ name: "Available Room", target: "available-content" },
										{ name: "Transferred Room", target: "transferred-content" },
										{ name: "Occupied Room", target: "occupied-content" },
										{ name: "Cleaning Room", target: "cleaning-content" },
										{ name: "Group Booking", target: "group-booking-content" },
									];
							
									let userTabOrder = tabOrder && tabOrder.length ? tabOrder : defaultTabs.map(tab => tab.target);
									let firstActiveTab = userTabOrder[0]; // Set first tab as active
							
									userTabOrder.forEach((tabTarget, index) => {
										let tabData = defaultTabs.find(tab => tab.target === tabTarget);
										if (tabData) { %>
											<div class="mdl-tabs__tab tabs_three <%= index === 0 ? 'is-active' : '' %>" data-target="<%= tabData.target %>">
												<%= tabData.name %>
											</div>
										<% }
									}); %>
								</div>
							
								<!-- TAB CONTENTS -->
								
							</div>
							
							
						<!-- Wrapper inside card -->
					<!-- Tab Content Sections -->
							<!-- TODAY CHECKED IN START -->
							<div id="checked-in-content" class="tab-content active-tab">
								<div class="scrollable-container">
									<% todayCheckInDetails.forEach(checkedIn => { 
										const checkInDate = new Date(checkedIn.CHECK_IN_DATE);
										checkInDate.setHours(0, 0, 0, 0); // Remove time

										const checkOutDate = new Date(checkedIn.CHECK_OUT_DATE);
										checkOutDate.setHours(0, 0, 0, 0); // Remove time
										const today = new Date();
										const totalDays = Math.max(1, Math.ceil((checkOutDate - checkInDate) / (1000 * 60 * 60 * 24))); // Total days of booking
										const daysStayed = Math.min(Math.ceil((today - checkInDate) / (1000 * 60 * 60 * 24)), totalDays); // Days already stayed
										const daysRemaining = totalDays - daysStayed; // Remaining days
										const maxBars = 10; // Maximum bars visible
										const visibleBars = Math.min(totalDays, maxBars); // Total bars visible (up to 10)
										const visibleStayed = Math.min(daysStayed, visibleBars); // Stayed bars to display
										const visibleRemaining = visibleBars - visibleStayed; // Remaining bars to display
										const extraDays = Math.max(0, daysRemaining - visibleRemaining); // Calculate extra days
							
										// Determine the card class based on the ROOM_FLOOR
										const cardClass = checkedIn.ROOM_FLOOR === 1 ? 'card-topline-yellow' : 
										checkedIn.ROOM_FLOOR === 2 ? 'card-topline-gray' : 
										checkedIn.ROOM_FLOOR === 3 ? 'card-topline-green' : 
										checkedIn.ROOM_FLOOR === 4 ? 'card-topline-blue' : 
										checkedIn.ROOM_FLOOR === 5 ? 'card-topline-red' :
										checkedIn.ROOM_FLOOR === 6 ? 'card-topline-violet' :
										checkedIn.ROOM_FLOOR === 7 ? 'card-topline-orange' :
										checkedIn.ROOM_FLOOR === 8 ? 'card-topline-pink' :
										checkedIn.ROOM_FLOOR === 9 ? 'card-topline-green2' :
										checkedIn.ROOM_FLOOR === 10 ? 'card-topline-sky' :
										'';

							
										// Determine the memo background color based on ROOM_FLOOR
										const memoClass = checkedIn.ROOM_FLOOR === 3 ? 'memo-1' : 
														  checkedIn.ROOM_FLOOR === 4 ? 'memo-2' : 
														  checkedIn.ROOM_FLOOR === 5 ? 'memo-3' : 
													      checkedIn.ROOM_FLOOR === 6 ? 'memo-4' : 'memo-default';
									%>
									<div class="card <%= cardClass %>" data-floor="<%= checkedIn.ROOM_FLOOR %>" data-checkin="<%= checkedIn.CHECK_IN_DATE %>"  data-checkin-status="<%= checkedIn.CHECK_IN_STATUS %>" data-booking-status="<%= checkedIn.BookingStatus %>">
										<!-- Header with Toggle -->
										<div class="card-head" style="text-align: center; display: flex; align-items: center; justify-content: space-between;">
											<!-- Toggle Button -->
											<label class="custom-switch input-in">
												<input 
													type="checkbox" 
													class="custom-toggle-checkin" 
													data-idno="<%= checkedIn.BookingID %>"
													<%= checkedIn.BookingStatus === 'check-In' ? 'checked disabled' : '' %> 
												>
												<span class="custom-slider"></span>
											</label>
											
											<!-- Room Number -->
											<header style="flex-grow: 1; text-align: center;"><%= checkedIn.ROOM_NUMBER %></header>
											
											<!-- Group Icon (Conditional) -->
											<% if (checkedIn.IS_GROUP == 1) { %>
												<i class="material-icons" style="font-size: 20px; color: #555;">group</i>
											<% } %>
										</div>
										
							
											<!-- Card Body -->
											<div class="card-body">
												<p><%= checkedIn.RoomType %></p>
												<p><%= checkedIn.CustomerName %></p>
												<div style="display: flex; justify-content: space-between; align-items: center;">
													<p style="margin: 0;"><%= Number(checkedIn.TotalCost).toLocaleString('en-US') %></p>
													<% if (checkedIn.CHECK_IN_STATUS === 0) { %>
														<span class="badge badge-success">LCI</span>
													  <% } %>
												  </div>
												  

											
												<!-- Thin Line -->
												<hr class="section-divider">
												
												<div class="dates">
													<span>In: <%= checkInDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %></span>
													<span>Out: <%= checkOutDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %></span>
												</div>
							
												<!-- Progress Bars -->
												<div class="progress-bars-wrapper">
													<div class="progress-bars">
														<% if (checkedIn.BookingStatus === 'check-In') { %>
															<!-- Show orange bars for stayed days -->
															<% for (let i = 0; i < visibleStayed; i++) { %>
																<div class="bar orange">
																	<% if (i === 4 && totalDays >= 5) { %>
																		<span style="color: white; font-size: 12px; display: block; text-align: center;">5</span>
																	<% } %>
																</div>
															<% } %>
															<!-- Show green bars for remaining days -->
															<% for (let i = 0; i < visibleRemaining; i++) { %>
																<div class="bar green"></div>
															<% } %>
														<% } else { %>
															<!-- Booking is not yet checked-in, all bars should be green -->
															<% for (let i = 0; i < visibleBars; i++) { %>
																<div class="bar green"></div>
															<% } %>
														<% } %>
													</div>
													<% if (extraDays > 0) { %>
														<span class="extra-days">+<%= extraDays %></span>
													<% } %>
												</div>
												<!-- Memo Section -->
												<div class="memo <%= memoClass %>">
													<p><%= checkedIn.REMARKS || 'Remarks' %></p>
												</div>
												
											</div>
										</div>
									<% }) %>
								</div>
							</div>
							
							 <!-- TODAY LATE IN OUT START -->
							 <div id="late-in-out-content" class="tab-content">
								<div class="scrollable-container">
									<% lateInOutDetails.forEach(lateInOut => { 
										const checkInDate = new Date(lateInOut.NextCheckInDate);
										const checkOutDate = new Date(lateInOut.CurrentCheckoutDate);
										
										// Determine the card class based on the ROOM_FLOOR
										const cardClass = lateInOut.ROOM_FLOOR === 1 ? 'card-topline-yellow' : 
										lateInOut.ROOM_FLOOR === 2 ? 'card-topline-gray' : 
										lateInOut.ROOM_FLOOR === 3 ? 'card-topline-green' : 
										lateInOut.ROOM_FLOOR === 4 ? 'card-topline-blue' : 
										lateInOut.ROOM_FLOOR === 5 ? 'card-topline-red' :
										lateInOut.ROOM_FLOOR === 6 ? 'card-topline-violet' :
										lateInOut.ROOM_FLOOR === 7 ? 'card-topline-orange' :
										lateInOut.ROOM_FLOOR === 8 ? 'card-topline-pink' :
										lateInOut.ROOM_FLOOR === 9 ? 'card-topline-green2' :
										lateInOut.ROOM_FLOOR === 10 ? 'card-topline-sky' :
										'';
									%>
										<div class="card <%= cardClass %>" data-floor="<%= lateInOut.ROOM_FLOOR %>" data-checkin="<%= lateInOut.CHECK_IN_DATE %>">
											<!-- Header -->
											<div class="card-head" style="text-align: center;">
												<header><%= lateInOut.ROOM_NUMBER %></header>
											</div>
							
											
											<!-- Card Body -->
											<div class="card-body">
												<div style="display: flex; justify-content: space-between; align-items: center;  margin-top: 10px;">
													<p style="margin: 0;"><%= lateInOut.CurrentGuest %></p>
													<p class="dates" style="margin: 0;">Out: <%= checkOutDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %></p>
												</div>
												<div style="display: flex; justify-content: flex-end; gap: 5px; margin-top: 10px; margin-bottom: 10px;">
													<% if (lateInOut.CurrentBookingStatus === 'pending') { %>
														<span class="badge badge-success">Pending</span>
													<% } else if (lateInOut.CurrentBookingStatus === 'check-In') { %>
														<span class="badge badge-success">Checked-In</span>
													<% } else if (lateInOut.CurrentBookingStatus === 'check-Out') { %>
														<span class="badge badge-success">Check-Out</span>
													<% } %>

													<% if (lateInOut.CurrentLateCheckout === 1) { %>
														<span class="badge badge-success" style="margin-left: auto;">LCO</span>
													<% } %>
												</div>

												<!-- Thin Line -->
												<hr class="section-divider">
											</div>
											<div class="card-body">
												<div style="display: flex; justify-content: space-between; align-items: center;">
													<p style="margin: 0;"><%= lateInOut.NextGuest %></p>
													<p class="dates" style="margin: 0;">In: <%= checkInDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %></p>
												</div>
												<div style="display: flex; justify-content: flex-end; gap: 5px; margin-top: 10px;">
													<% if (lateInOut.NextBookingStatus === 'pending') { %>
														<span class="badge badge-primary">Pending</span>
													<% } else if (lateInOut.CurrentBookingStatus === 'check-In') { %>
														<span class="badge badge-primary">Check-In</span>
													<% } else if (lateInOut.CurrentBookingStatus === 'check-Out') { %>
														<span class="badge badge-primary">Check-Out</span>
													<% } %>

													<% if (lateInOut.NextCheckInStatus  === 0) { %>
														<span class="badge badge-primary" style="margin-left: auto;">LCI</span>
													<% } %>
												</div>
											</div>
										</div>
									<% }) %>
								</div>
							</div>
							 <!-- TODAY CHECKED OUT START -->
							 <div id="checkout-content" class="tab-content">
								<div class="scrollable-container">
									<% todayCheckedOutDetails.forEach(checkedOut => { 
										const checkInDate = new Date(checkedOut.CHECK_IN_DATE);
											checkInDate.setHours(0, 0, 0, 0); // Remove time

											const checkOutDate = new Date(checkedOut.CHECK_OUT_DATE);
											checkOutDate.setHours(0, 0, 0, 0); // Remove time
										const today = new Date();
										const totalDays = Math.max(1, Math.ceil((checkOutDate - checkInDate) / (1000 * 60 * 60 * 24))); // Total days of booking
										const daysStayed = Math.min(Math.ceil((today - checkInDate) / (1000 * 60 * 60 * 24)), totalDays); // Days already stayed
										const daysRemaining = totalDays - daysStayed; // Remaining days
										const maxBars = 10; // Maximum bars visible
										const visibleBars = Math.min(totalDays, maxBars); // Total bars visible (up to 10)
										const visibleStayed = Math.min(daysStayed, visibleBars); // Stayed bars to display
										const visibleRemaining = visibleBars - visibleStayed; // Remaining bars to display
										const extraDays = Math.max(0, daysRemaining - visibleRemaining); // Calculate extra days
							
										// Determine the card class based on the ROOM_FLOOR
										const cardClass = checkedOut.ROOM_FLOOR === 1 ? 'card-topline-yellow' : 
														  checkedOut.ROOM_FLOOR === 2 ? 'card-topline-gray' : 
														  checkedOut.ROOM_FLOOR === 3 ? 'card-topline-green' : 
														  checkedOut.ROOM_FLOOR === 4 ? 'card-topline-blue' : 
														  checkedOut.ROOM_FLOOR === 5 ? 'card-topline-red' :
														  checkedOut.ROOM_FLOOR === 6 ? 'card-topline-violet' :
														  checkedOut.ROOM_FLOOR === 7 ? 'card-topline-orange' :
														  checkedOut.ROOM_FLOOR === 8 ? 'card-topline-pink' :
														  checkedOut.ROOM_FLOOR === 9 ? 'card-topline-green2' :
														  checkedOut.ROOM_FLOOR === 10 ? 'card-topline-sky' : '';
							
										// Determine the memo background color based on ROOM_FLOOR
										const memoClass = checkedOut.ROOM_FLOOR === 3 ? 'memo-1' : 
														  checkedOut.ROOM_FLOOR === 4 ? 'memo-2' : 
														  checkedOut.ROOM_FLOOR === 5 ? 'memo-3' : 
														  checkedOut.ROOM_FLOOR === 6 ? 'memo-4' : 'memo-default';
									%>
									<div class="card <%= cardClass %>" data-floor="<%= checkedOut.ROOM_FLOOR %>" data-checkin="<%= checkedOut.CHECK_IN_DATE %>" data-late-checkout="<%= checkedOut.LATE_CHECKOUT %>" data-booking-status="<%= checkedOut.BookingStatus %>">
										<!-- Header with Toggle -->
										<div class="card-head" style="text-align: center; display: flex; align-items: center; justify-content: space-between;">
											<!-- Custom Toggle for Check-Out -->
											<label class="custom-switch input-out">
												<input 
													type="checkbox" 
