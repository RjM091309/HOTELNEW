<div class="row">
  <div class="col-xl-12 col-md-12 col-12">
    <div class="dashboard-card">
      <div class="dashboard-card-header">
        <header>Flight Schedule</header>
        <div class="tools">
          <button type="button" class="btn btn-primary-10 btn-sm" id="addFlightScheduleBtn">
            <i class="fa fa-plus"></i> Add Flight
          </button>
        </div>
      </div>
      <div class="dashboard-card-body">
        <div class="table-scrollable">
          <table id="flightScheduleTable" class="table table-hover table-bordered full-width">
            <thead>
              <tr>
                <th>Airline</th>
                <th>Arrival</th>
                <th>Departure</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="addFlightScheduleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Flight</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="addFlightScheduleForm">
        <div class="modal-body">
          <div class="mb-3">
            <label for="addFlightNumber" class="form-label">Flight No.</label>
            <input type="text" class="form-control" id="addFlightNumber" placeholder="e.g. PR123" required>
          </div>
          <div class="mb-3">
            <label for="addArrival" class="form-label">Arrival</label>
            <input type="text" class="form-control" id="addArrival" placeholder="e.g. 10:30 AM" required>
          </div>
          <div class="mb-3">
            <label for="addDeparture" class="form-label">Departure</label>
            <input type="text" class="form-control" id="addDeparture" placeholder="e.g. 2:45 PM" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="editFlightScheduleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Flight</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editFlightScheduleForm">
        <input type="hidden" id="editFlightScheduleId">
        <div class="modal-body">
          <div class="mb-3">
            <label for="editFlightNumber" class="form-label">Flight No.</label>
            <input type="text" class="form-control" id="editFlightNumber" required>
          </div>
          <div class="mb-3">
            <label for="editArrival" class="form-label">Arrival</label>
            <input type="text" class="form-control flight-datetime-picker" id="editArrival" placeholder="Select date and time" readonly required>
          </div>
          <div class="mb-3">
            <label for="editDeparture" class="form-label">Departure</label>
            <input type="text" class="form-control flight-datetime-picker" id="editDeparture" placeholder="Select date and time" readonly required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Update</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    setTimeout(function () {
      const script = document.createElement('script');
      script.src = '/js/flight/flight_schedule.js';
      document.body.appendChild(script);
    }, 300);
  });
</script>

